(* Probe, point 1: a typecase whose two arms are both self, returned at the type that the comprises clause of self's trait lists. *)
component ProbeTwoSelfArmsComprises
export Executable

trait Q comprises { R }
    both(x: Any): R = typecase x of
        s: String => self
        else => self
      end
end

value object R(n: ZZ32, d: ZZ32) extends Q end

run(): () = do
    println("REACHED")
    q: Q = R(1, 2)
    assert(q.both("s").d, 2, "the String arm")
    assert(q.both(3).d, 2, "the else arm")
    println("PASS")
  end

end

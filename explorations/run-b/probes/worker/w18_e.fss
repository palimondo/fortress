component w18_e
export Executable

log(x: RR64): RR64 = x.log()
cosine(x: RR64): RR64 = x.cos()

run(): () = do
    d: RR64 = 9.0
    a: RR64 = 2.0
    b: RR64 = 16.0
    c: RR64 = 3.0
    std: RR64 = 0.5
    u: RR64 = 0.25
    u2: RR64 = 0.125
    r = a (SQRT b) c
    println("a (SQRT b) c = " r)
  end

end

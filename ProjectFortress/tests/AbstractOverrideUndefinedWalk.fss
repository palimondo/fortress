component AbstractOverrideUndefinedWalk
export Executable

(* An object below a trait whose abstract declaration with the modifier override overrides a concrete one inherits the abstract method only, and declares no body for it, so the program is refused at load, under walk (traits.tex, section "Method Declarations"). *)

trait S
  tag(self, x: ZZ32): ZZ32 = 1
end
trait W extends S
  override tag(self, x: Number): ZZ32
end
object Wo extends W end

run(): () = do
    println(tag(Wo, 3))
  end

end

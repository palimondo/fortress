component SkR02
export Executable

shownR(v: Any): String = typecase v of
    v1: ZZ32 => v1.asString || ":ZZ32"
    v2: ZZ64 => v2.asString || ":ZZ64"
    v3: NN32 => v3.asString || ":NN32"
    v4: RR64 => v4.asString || ":RR64"
    v5: String => v5 || ":String"
    else => "other"
  end

object HolderR
  sameR[\T\](a: T, b: T): String = "[" || shownR(a) || "," || shownR(b) || "]"
end

run(): () = do
    z: ZZ32 = 3
    w: ZZ64 = widen(4)
    println("HolderR.sameR(z, z) = " || HolderR.sameR(z, z))
    println("HolderR.sameR(z, w) = " || HolderR.sameR(z, w))
  end

end

(* A numeral has no sign: -3 at a program's type that declares no prefix minus is refused. *)
component NumeralNegativeNoMinusRefusedWalk
export Executable

value object Plain(k: ZZ)
    coerce[\nat n, nat r, nat v\](x: NaturalNumeral[\n, r, v\]) = Plain(v)
end

minus3: Plain = -3

run() = println("FAIL: -3 at a type without a prefix minus was accepted")

end

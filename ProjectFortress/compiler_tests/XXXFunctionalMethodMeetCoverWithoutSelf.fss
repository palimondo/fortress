(* An object that provides two functional methods of one name whose overlap, self apart, its own declarations cover through comprises clauses is a valid overloading, so the program compiles and each call runs its declaration (row 617). *)
component XXXFunctionalMethodMeetCoverWithoutSelf
export Executable

trait A comprises { X1, X2, Ya } end
trait B comprises { X1, X2, Yb } end
object X1 extends { A, B } end
object X2 extends { A, B } end
object Ya extends A end
object Yb extends B end

trait P
  mark(self, x: A): ZZ32 = 1
end
trait Q
  mark(self, x: B): ZZ32 = 2
end
object Pq extends { P, Q }
  mark(self, x: X1): ZZ32 = 3
  mark(self, x: X2): ZZ32 = 4
end

run(): () = do
    println("mark(Pq, X1) = " mark(Pq, X1))
    println("mark(Pq, X2) = " mark(Pq, X2))
    println("mark(Pq, Ya) = " mark(Pq, Ya))
    println("mark(Pq, Yb) = " mark(Pq, Yb))
  end

end

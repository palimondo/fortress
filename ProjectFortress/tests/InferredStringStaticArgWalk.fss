(* The static argument that walk infers from a string literal is String. *)

component InferredStringStaticArgWalk
export Executable

object Cell[\T extends Any\](v: T) end

run(): () = do
    println("REACHED")
    assert(Cell("s").asString, "Cell[\\String\\]", "the static argument inferred from a string literal is String; Specification/basic/expressions/literals.tex, section \"Literals\"")
    println("PASS")
  end

end

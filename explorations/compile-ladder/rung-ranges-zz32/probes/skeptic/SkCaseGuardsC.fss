component SkCaseGuardsC
export Executable

rangeGuard(x: ZZ32): String = case x of
    1:3 => "low"
    else => "high"
  end

varGuard[\R extends Range\](r: R, x: ZZ32): String = case x of
    r => "in"
    else => "out"
  end

genGuard(g: GeneratorZZ32, x: ZZ32): String = case x of
    g => "in"
    else => "out"
  end

run(): () = println(rangeGuard(2) " " varGuard(1:3, 2) " " genGuard(1:3, 2))
end

  export Executable

  (* Tests that LetFn correctly binds the two local function definitions over its
   * enclosing Block. *)

  run():() = do
    f(x:RR64):ZZ32 = 23
    g(x:Any, y:Any):ZZ32 = 42
    ignore(g(f, g))
    ()
  end

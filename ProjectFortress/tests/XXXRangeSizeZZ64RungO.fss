component XXXRangeSizeZZ64RungO
export Executable

run(): () = do
    println("REACHED")
    one: ZZ32 = 1
    three: ZZ32 = 3
    r = widen(one):widen(three)
    rSize = r.size
    assert(rSize = 3, "ranges.tex:103-106")
    rCard = |r|
    assert(rCard = 3, "ranges.tex:103-106")
    uOne: NN32 = unsigned(one)
    uThree: NN32 = unsigned(three)
    rN = uOne:uThree
    rNCard = |rN|
    assert(rNCard = 3, "ranges.tex:103-106")
    println("PASS")
  end

end

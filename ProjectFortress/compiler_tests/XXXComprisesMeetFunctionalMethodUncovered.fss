(* A functional method declared in two closed traits and not in the one type both comprises clauses list: no declaration covers their overlap, so the overloading is invalid. *)
component XXXComprisesMeetFunctionalMethodUncovered
export Executable

trait S comprises { U, V }
  tag(self): ZZ32 = 1
end
trait T comprises { V, W }
  tag(self): ZZ32 = 2
end
trait U extends S excludes W end
trait V extends { S, T } end
trait W extends T end
object Vo extends V end

run(): () = do
  s: S = Vo
  println("tag(s) = " tag(s))
  println("PASS")
end

end

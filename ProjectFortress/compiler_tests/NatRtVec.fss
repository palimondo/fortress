(* See explorations/compile-ladder/rung-size-runtime/REPORT.md. *)
component NatRtVec
export Executable
object Vec[\T, nat s0\](x: T) end
vec[\T, nat s0\](x: T): Vec[\T,s0\] = Vec[\T,s0\](x)
makeVector[\T, nat s0\](x: T): Vec[\T,s0\] = vec[\T,s0\](x)
len[\T, nat s0\](v: Vec[\T,s0\]): ZZ32 = s0
run() = println(len(makeVector[\ZZ32, 5\](7)))
end

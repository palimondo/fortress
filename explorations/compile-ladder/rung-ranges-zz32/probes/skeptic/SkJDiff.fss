component SkJDiff
export Executable

rangeCase(x: ZZ32): String = case x of
    2:4 => "in 2:4"
    else => "outside"
  end

run(): () = do
    m: ZZ32 = -2
    z: ZZ32 = 0
    var a: ZZ32 := 0
    for i <- seq(3#m) do a := a + 1 end
    println("count 3#-2: " a)
    var b: ZZ32 := 0
    for i <- seq(7#z) do b := b + 1 end
    println("count 7#0: " b)
    var c: ZZ32 := 0
    for i <- seq(5:5) do c := c + i end
    println("sum 5:5: " c)
    var d: ZZ32 := 0
    for i <- seq((-3):2) do d := d + i end
    println("sum -3:2: " d)
    var e: ZZ32 := 0
    for i <- seq(1:10), i > 6 do e := e + i end
    println("sum 1:10 over 6: " e)
    var f: ZZ32 := 0
    for i <- seq(0#3) do
        for j <- seq(i:2) do f := f + 1 end
    end
    println("nested pairs: " f)
    println("case 3 of 2:4: " rangeCase(3))
    println("case 9 of 2:4: " rangeCase(9))
    if (1:3) = (1#3) then println("1:3 = 1#3") else println("1:3 differs from 1#3") end
    if (3:1) = (5:4) then println("3:1 = 5:4") else println("3:1 differs from 5:4") end
    if (2:4) = (2:5) then println("2:4 = 2:5") else println("2:4 differs from 2:5") end
  end

end

component R2ArithParamOk
export Executable
object Box[\nat k\](v: ZZ32) end
object IBox[\int k\](v: ZZ32) end
sz[\nat k\](b: Box[\k\]): ZZ64 = k
isz[\int k\](b: IBox[\k\]): ZZ64 = k
sq[\nat n\](b: Box[\n\]): ZZ64 = sz(Box[\n n\](0))
run(): () = do
  println("p1 65535 65535 = " || sq(Box[\65535\](0)))
  println("END")
end
end

(* Q2 probe 5: the spec's own worked example of dimensioned VALUES, with every
   `dim` given a unit clause so the q3 parser bug is out of the way.
   Specification/basic/dimensions.tex:132-143 (ASCII source in the LaTeX
   comments, verbatim):
       x: RR64 Length = 1.3 m_
       t: RR64 Time = 5 s_
       v: RR64 Velocity = x / t
   Collapsed dim+SI_unit form per defining-dimensions.tex:330. *)
component q5_dimensioned_var
export Executable

dim Length   SI_unit meter meters m_
dim Time     SI_unit second seconds s_
dim Velocity = Length / Time  SI_unit mps = meter/second

run() = do
  x: RR64 Length = 1.3 m_
  t: RR64 Time = 5 s_
  v: RR64 Velocity = x / t
  println("v = " v)
end

end

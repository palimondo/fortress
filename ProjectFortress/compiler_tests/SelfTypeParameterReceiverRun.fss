(* A default body of a trait with a self-type parameter that calls a method on a value of that parameter runs compiled for an object that lists the trait first (traits.tex, section "Trait Declarations"). *)
component SelfTypeParameterReceiverRun
export Executable

trait Shape[\S extends Shape[\S\]\]
    getter tag(): String
    tagOf(other: S): String = other.tag
end

object Pt(t: String) extends Shape[\Pt\]
    getter tag(): String = t
end

run(): () = do
    p = Pt("b")
    assert(p.tagOf(Pt("c")), "c", "the method of the value typed by the self-type parameter")
    println("PASS")
  end

end

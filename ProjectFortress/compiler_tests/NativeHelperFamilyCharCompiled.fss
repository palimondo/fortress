(* On the compiled path, the nativeHelpers that Char's bindings name compile and run when bound at the Java types the compile reads, a Char carried in a ZZ32 code point. *)
component NativeHelperFamilyCharCompiled
export Executable

cToString(x:ZZ32):JavaString = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charToString")
cEq(x:ZZ32, y:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charEQ")
cLt(x:ZZ32, y:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charLT")
cSimEq(x:ZZ32, y:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charSimEq")
cNotSimEq(x:ZZ32, y:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charNotSimEq")
cLessNotSim(x:ZZ32, y:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charLessNotSim")
cLessSim(x:ZZ32, y:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charLessSim")
cGreaterNotSim(x:ZZ32, y:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charGreaterNotSim")
cGreaterSim(x:ZZ32, y:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charGreaterSim")
cJavaDigit(x:ZZ32, radix:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charJavaDigit")
cGetDirectionality(x:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charGetDirectionality")
cGetNumericValue(x:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charGetNumericValue")
cGetType(x:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charGetType")
cIsDefined(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsDefined")
cIsDigit(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsDigit")
cIsFortressIdentifierPart(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsFortressIdentifierPart")
cIsFortressIdentifierStart(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsFortressIdentifierStart")
cIsHighSurrogate(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsHighSurrogate")
cIsIdentifierIgnorable(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsIdentifierIgnorable")
cIsISOControl(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsISOControl")
cIsJavaIdentifierPart(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsJavaIdentifierPart")
cIsJavaIdentifierStart(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsJavaIdentifierStart")
cIsLetter(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsLetter")
cIsLetterOrDigit(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsLetterOrDigit")
cIsLowerCase(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsLowerCase")
cIsLowSurrogate(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsLowSurrogate")
cIsMirrored(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsMirrored")
cIsSpaceChar(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsSpaceChar")
cIsSupplementaryCodePoint(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsSupplementaryCodePoint")
cIsSurrogatePair(x:ZZ32, y:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsSurrogatePair")
cIsTitleCase(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsTitleCase")
cIsUnicodeIdentifierPart(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsUnicodeIdentifierPart")
cIsUnicodeIdentifierStart(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsUnicodeIdentifierStart")
cIsUpperCase(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsUpperCase")
cIsValidCodePoint(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsValidCodePoint")
cIsWhitespace(x:ZZ32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charIsWhitespace")
cToLowerCase(x:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charToLowerCase")
cToTitleCase(x:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charToTitleCase")
cToUpperCase(x:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charToUpperCase")

run():() = do
  a: ZZ32 = 97
  bigA: ZZ32 = 65
  b: ZZ32 = 98
  bigB: ZZ32 = 66
  bigZ: ZZ32 = 90
  z: ZZ32 = 122
  bigF: ZZ32 = 70
  seven: ZZ32 = 55
  space: ZZ32 = 32
  dollar: ZZ32 = 36
  underscore: ZZ32 = 95
  paren: ZZ32 = 40
  sigma: ZZ32 = 931
  sigmaLower: ZZ32 = 963
  longI: ZZ32 = 66560
  longILower: ZZ32 = 66600
  high: ZZ32 = 55296
  low: ZZ32 = 56320
  dz: ZZ32 = 453
  dzUpper: ZZ32 = 452
  dzLower: ZZ32 = 454
  unassigned: ZZ32 = 888
  nul: ZZ32 = 0
  newline: ZZ32 = 10
  ten: ZZ32 = 10
  sixteen: ZZ32 = 16
  assert(cToString(a) = "a", "toString of a letter")
  assert(cToString(seven) = "7", "toString of a digit")
  assert(cToString(space) = " ", "toString of a space")
  assert(cToString(sigma) = "Σ", "toString past U+00FF")
  assert(cToString(dz) = "ǅ", "toString of a title-case letter")
  assert(cEq(a, a), "Eq")
  assert(NOT cEq(a, bigA), "Eq unequal")
  assert(cEq(longI, longI), "Eq past U+FFFF")
  assert(NOT cEq(high, low), "Eq of two surrogates")
  assert(cLt(bigA, a), "Lt")
  assert(NOT cLt(a, bigZ), "Lt not")
  assert(cLt(sigma, longI), "Lt past U+FFFF")
  assert(cLt(high, low), "Lt of two surrogates")
  assert(cSimEq(a, bigA), "SimEq")
  assert(NOT cSimEq(a, b), "SimEq not")
  assert(cSimEq(sigma, sigmaLower), "SimEq past U+00FF")
  assert(cSimEq(longI, longILower), "SimEq past U+FFFF")
  assert(cNotSimEq(a, bigB), "NotSimEq")
  assert(NOT cNotSimEq(bigZ, z), "NotSimEq not")
  assert(cLessNotSim(a, bigB), "LessNotSim")
  assert(NOT cLessNotSim(b, bigA), "LessNotSim not")
  assert(NOT cLessNotSim(a, bigA), "LessNotSim of one letter")
  assert(cLessSim(bigA, a), "LessSim")
  assert(NOT cLessSim(b, bigA), "LessSim not")
  assert(cGreaterNotSim(b, bigA), "GreaterNotSim")
  assert(NOT cGreaterNotSim(a, bigA), "GreaterNotSim of one letter")
  assert(cGreaterSim(a, bigA), "GreaterSim")
  assert(NOT cGreaterSim(bigA, b), "GreaterSim not")
  assert(cJavaDigit(seven, ten), 7, "JavaDigit")
  assert(cJavaDigit(bigF, sixteen), 15, "JavaDigit radix 16")
  assert(cJavaDigit(z, ten), -1, "JavaDigit of a letter")
  assert(cJavaDigit(sigma, ten), -1, "JavaDigit past U+00FF")
  assert(cGetDirectionality(a), 0, "GetDirectionality of a letter")
  assert(cGetDirectionality(seven), 3, "GetDirectionality of a digit")
  assert(cGetDirectionality(space), 12, "GetDirectionality of a space")
  assert(cGetDirectionality(unassigned), -1, "GetDirectionality of an unassigned code point")
  assert(cGetNumericValue(seven), 7, "GetNumericValue of a digit")
  assert(cGetNumericValue(bigZ), 35, "GetNumericValue of a letter")
  assert(cGetNumericValue(space), -1, "GetNumericValue of a space")
  assert(cGetType(a), 2, "GetType of a lower-case letter")
  assert(cGetType(bigZ), 1, "GetType of an upper-case letter")
  assert(cGetType(seven), 9, "GetType of a digit")
  assert(cGetType(space), 12, "GetType of a space")
  assert(cGetType(dz), 3, "GetType of a title-case letter")
  assert(cGetType(high), 19, "GetType of a surrogate")
  assert(cGetType(longI), 1, "GetType past U+FFFF")
  assert(cIsDefined(a), "IsDefined")
  assert(NOT cIsDefined(unassigned), "IsDefined of an unassigned code point")
  assert(cIsDigit(seven), "IsDigit")
  assert(NOT cIsDigit(a), "IsDigit of a letter")
  assert(cIsFortressIdentifierPart(underscore), "IsFortressIdentifierPart of _")
  assert(cIsFortressIdentifierPart(seven), "IsFortressIdentifierPart of a digit")
  assert(NOT cIsFortressIdentifierPart(space), "IsFortressIdentifierPart of a space")
  assert(cIsFortressIdentifierStart(underscore), "IsFortressIdentifierStart of _")
  assert(cIsFortressIdentifierStart(sigma), "IsFortressIdentifierStart past U+00FF")
  assert(NOT cIsFortressIdentifierStart(seven), "IsFortressIdentifierStart of a digit")
  assert(cIsHighSurrogate(high), "IsHighSurrogate")
  assert(NOT cIsHighSurrogate(low), "IsHighSurrogate of a low surrogate")
  assert(NOT cIsHighSurrogate(longI), "IsHighSurrogate past U+FFFF")
  assert(cIsIdentifierIgnorable(nul), "IsIdentifierIgnorable")
  assert(NOT cIsIdentifierIgnorable(a), "IsIdentifierIgnorable of a letter")
  assert(cIsISOControl(newline), "IsISOControl")
  assert(NOT cIsISOControl(a), "IsISOControl of a letter")
  assert(cIsJavaIdentifierPart(dollar), "IsJavaIdentifierPart of $")
  assert(cIsJavaIdentifierPart(seven), "IsJavaIdentifierPart of a digit")
  assert(NOT cIsJavaIdentifierPart(space), "IsJavaIdentifierPart of a space")
  assert(cIsJavaIdentifierStart(dollar), "IsJavaIdentifierStart of $")
  assert(NOT cIsJavaIdentifierStart(seven), "IsJavaIdentifierStart of a digit")
  assert(cIsLetter(sigma), "IsLetter past U+00FF")
  assert(cIsLetter(longI), "IsLetter past U+FFFF")
  assert(NOT cIsLetter(seven), "IsLetter of a digit")
  assert(cIsLetterOrDigit(seven), "IsLetterOrDigit")
  assert(NOT cIsLetterOrDigit(space), "IsLetterOrDigit of a space")
  assert(cIsLowerCase(a), "IsLowerCase")
  assert(cIsLowerCase(longILower), "IsLowerCase past U+FFFF")
  assert(NOT cIsLowerCase(bigZ), "IsLowerCase of an upper-case letter")
  assert(NOT cIsLowerCase(dz), "IsLowerCase of a title-case letter")
  assert(cIsLowSurrogate(low), "IsLowSurrogate")
  assert(NOT cIsLowSurrogate(high), "IsLowSurrogate of a high surrogate")
  assert(cIsMirrored(paren), "IsMirrored")
  assert(NOT cIsMirrored(a), "IsMirrored of a letter")
  assert(cIsSpaceChar(space), "IsSpaceChar")
  assert(NOT cIsSpaceChar(newline), "IsSpaceChar of a newline")
  assert(cIsSupplementaryCodePoint(longI), "IsSupplementaryCodePoint")
  assert(NOT cIsSupplementaryCodePoint(sigma), "IsSupplementaryCodePoint below U+FFFF")
  assert(cIsSurrogatePair(high, low), "IsSurrogatePair")
  assert(NOT cIsSurrogatePair(low, high), "IsSurrogatePair reversed")
  assert(cIsTitleCase(dz), "IsTitleCase")
  assert(NOT cIsTitleCase(bigZ), "IsTitleCase of an upper-case letter")
  assert(cIsUnicodeIdentifierPart(seven), "IsUnicodeIdentifierPart of a digit")
  assert(NOT cIsUnicodeIdentifierPart(space), "IsUnicodeIdentifierPart of a space")
  assert(cIsUnicodeIdentifierStart(sigma), "IsUnicodeIdentifierStart past U+00FF")
  assert(NOT cIsUnicodeIdentifierStart(seven), "IsUnicodeIdentifierStart of a digit")
  assert(cIsUpperCase(bigZ), "IsUpperCase")
  assert(cIsUpperCase(longI), "IsUpperCase past U+FFFF")
  assert(NOT cIsUpperCase(a), "IsUpperCase of a lower-case letter")
  assert(cIsValidCodePoint(a), "IsValidCodePoint")
  assert(cIsValidCodePoint(longI), "IsValidCodePoint past U+FFFF")
  assert(cIsValidCodePoint(high), "IsValidCodePoint of a surrogate")
  assert(cIsWhitespace(space), "IsWhitespace")
  assert(cIsWhitespace(newline), "IsWhitespace of a newline")
  assert(NOT cIsWhitespace(a), "IsWhitespace of a letter")
  assert(cToLowerCase(bigZ), z, "ToLowerCase")
  assert(cToLowerCase(seven), seven, "ToLowerCase of a digit")
  assert(cToLowerCase(sigma), sigmaLower, "ToLowerCase past U+00FF")
  assert(cToLowerCase(longI), longILower, "ToLowerCase past U+FFFF")
  assert(cToLowerCase(dz), dzLower, "ToLowerCase of a title-case letter")
  assert(cToTitleCase(a), bigA, "ToTitleCase")
  assert(cToTitleCase(dzLower), dz, "ToTitleCase of a lower-case digraph")
  assert(cToTitleCase(dzUpper), dz, "ToTitleCase of an upper-case digraph")
  assert(cToUpperCase(a), bigA, "ToUpperCase")
  assert(cToUpperCase(space), space, "ToUpperCase of a space")
  assert(cToUpperCase(dz), dzUpper, "ToUpperCase of a title-case letter")
  assert(cToUpperCase(longILower), longI, "ToUpperCase past U+FFFF")
  println("PASS")
end

end

component SkUnsignedLong
export Executable
run(): () = do
  oneU: NN64 = unsigned(widen(1))
  twoU: NN64 = unsigned(widen(2))
  threeU: NN64 = unsigned(widen(3))
  zeroU: NN64 = unsigned(widen(0))
  maxU: NN64 = BITNOT unsigned(widen(0))
  maxL: ZZ64 = 9223372036854775807
  twoTo63U: NN64 = unsigned(maxL) + oneU
  twoTo32U: NN64 = unsigned(widen(65536)) DOT unsigned(widen(65536))
  e63U: NN64 = unsigned(widen(63))
  e64U: NN64 = unsigned(widen(64))
  println("u1 2^63 " || (try "" || (twoU^e63U) catch e IntegerOverflow => "OVF" end))
  println("u2 2^64 " || (try "" || (twoU^e64U) catch e IntegerOverflow => "OVF" end))
  println("u3 MAX^1 " || (try "" || (maxU^oneU) catch e IntegerOverflow => "OVF" end))
  println("u4 MAX^2 " || (try "" || (maxU^twoU) catch e IntegerOverflow => "OVF" end))
  println("u5 MAX^0 " || (try "" || (maxU^zeroU) catch e IntegerOverflow => "OVF" end))
  println("u6 (2^32)^2 " || (try "" || (twoTo32U^twoU) catch e IntegerOverflow => "OVF" end))
  println("u7 (2^32-1)^2 " || (try "" || ((twoTo32U - oneU)^twoU) catch e IntegerOverflow => "OVF" end))
  println("l1 2^32 LCM (2^32+1) " || (try "" || (twoTo32U LCM (twoTo32U + oneU)) catch e IntegerOverflow => "OVF" end))
  println("l2 MAX LCM MAX " || (try "" || (maxU LCM maxU) catch e IntegerOverflow => "OVF" end))
  println("l3 MAX LCM 2 " || (try "" || (maxU LCM twoU) catch e IntegerOverflow => "OVF" end))
  println("l4 2^63 LCM 2 " || (try "" || (twoTo63U LCM twoU) catch e IntegerOverflow => "OVF" end))
  println("h1 MAX CHOOSE (MAX-1) " || (try "" || (maxU CHOOSE (maxU - oneU)) catch e IntegerOverflow => "OVF" end))
  println("h2 MAX CHOOSE 2 " || (try "" || (maxU CHOOSE twoU) catch e IntegerOverflow => "OVF" end))
  println("h3 2^63 CHOOSE 1 " || (try "" || (twoTo63U CHOOSE oneU) catch e IntegerOverflow => "OVF" end))
  println("h4 2^32 CHOOSE 2 " || (try "" || (twoTo32U CHOOSE twoU) catch e IntegerOverflow => "OVF" end))
  println("h5 (2^32+1) CHOOSE 2 " || (try "" || ((twoTo32U + oneU) CHOOSE twoU) catch e IntegerOverflow => "OVF" end))
  println("h6 3 CHOOSE MAX " || (try "" || (threeU CHOOSE maxU) catch e IntegerOverflow => "OVF" end))
  println("END")
end
end

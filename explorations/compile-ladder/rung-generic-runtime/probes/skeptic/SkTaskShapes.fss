component SkTaskShapes
export Executable

object BoxT[\T\](v: ZZ32) end
object Box[\nat k\](v: ZZ32) end
which(x: Any): String = typecase x of
    BoxT[\String\] => "string"
    BoxT[\ZZ32\] => "zz32"
    BoxT[\Boolean\] => "bool"
    Box[\3\] => "three"
    Box[\4\] => "four"
    else => "other"
  end
lbl(x: Any): String = which(x)
idz(n: ZZ32): ZZ32 = n

twice[\T\](x: T, g: T -> String): String = g(x) || g(x)

pairOf[\T\](): String = do
  (a, b) = (BoxT[\T\](1), BoxT[\T\](2))
  which(a) || which(b)
end

nestedT[\T\](): String = do
  var r1: String := ""
  var r2: String := ""
  var r3: String := ""
  do
    r1 := lbl(BoxT[\T\](1))
  also do
    k = fn (): String => which(BoxT[\T\](2))
    do r2 := k() also do r3 := lbl(BoxT[\T\](3)) end
  end
  r1 || r2 || r3
end

object Hs[\nat k\](v: ZZ32)
  m[\nat j\](): ZZ32 = idz(k) + idz(j)
end

object Ht[\T\](v: ZZ32)
  m[\U\](): String = do
    var s: String := ""
    var s2: String := ""
    do s := which(BoxT[\T\](1)) also do s2 := lbl(BoxT[\U\](2)) end
    s || s2 || twice[\BoxT[\U\]\](BoxT[\U\](0) , fn (b: BoxT[\U\]): String => which(b))
  end
end

seen: ZZ32 := 0
forT[\T\](): ZZ32 = do
  for i <- 0#8 do
    if which(BoxT[\T\](i)) = "bool" then atomic do seen := seen + 1 end end
  end
  seen
end

run(): () = do
  println("twice: " twice[\String\]("s", fn (s: String): String => s))
  println("pairOf: " pairOf[\String\]() " " pairOf[\ZZ32\]())
  println("nestedT: " nestedT[\Boolean\]())
  println("Hs.m: " Hs[\3\](0).m[\4\]())
  println("Ht.m: " Ht[\String\](0).m[\ZZ32\]())
  println("forT: " forT[\Boolean\]())
end

end

(* c16: spellings the model layer wants, each tried in isolation:
   (1) a map comprehension { k |-> f(a) | (k, a) <- m } for Adam over the
       parameter record;  (2) a column-block subscript Q[:, c] on a user
       carrier;  (3) the prefix form BIG MAX z over a generator carrier;
   (4) the Range getters a column slice needs;  (5) a runtime-sized block
       subarray m[(a,b)#(c,d)];  (6) SQRT of a ZZ32;  (7) an object field
       named like a top-level variable (shadowing). *)
component c16_model_spellings
import List.{...}
import Map.{...}
export Executable

epsilon: RR64 = 10.0^(-5)

object Q(v: Array[\RR64,(ZZ32,ZZ32)\])
  opr [_: TrivialOpenRange, c: Range[\ZZ32\]]: String = "columns " c
end
object Z(v: Array[\RR64,ZZ32\]) extends { ZeroIndexed[\RR64\], DelegatedIndexed[\RR64, ZZ32\] }
  getter indices(): Generator[\ZZ32\] = 0 # |v|
  opr |self|: ZZ32 = |v|
  opr [i: ZZ32]: RR64 = v[i]
end
object Adam(epsilon: RR64)
  show(): String = "Adam's epsilon = " epsilon
end

run(): () = do
  m: Map[\String, RR64\] = {[\String, RR64\] "a" |-> 1.0, "b" |-> 2.0 }
  m2 = { k |-> 10.0 x | (k, x) <- m }
  println("(1) map comprehension: " m2)
  q = Q(array[\RR64\](2, 4).fill(fn (i, j) => 1.0 (4 i + j)))
  println("(2) Q[:, 1#2] = " q[:, 1#2])
  z = Z(array[\RR64\](3).fill(fn i => 1.0 (i + 1)))
  println("(3) BIG MAX[z_i <- z] z_i = " (BIG MAX[z_i <- z] z_i) "   (the prefix form BIG MAX z: no applicable overload, see c16_model_spellings.prefixmax.out)")
  c = 2#3
  println("(4) range 2#3: lower " c.lower "  upper " c.upper "  |c| = " |c|)
  A = array[\RR64\](3, 4).fill(fn (i, j) => 1.0 (4 i + j))
  n: ZZ32 = 3; w: ZZ32 = 2; s: ZZ32 = 1
  B = A[(0, s)#(n, w)]
  println("(5) block A[(0,1)#(3,2)] = " B "  copy: " B.copy())
  d: ZZ32 = 4
  println("(6) SQRT d = " (SQRT d) "  SQRT(d) = " (SQRT(d)))
  println("(7) " Adam(10.0^(-8)).show() "  top-level epsilon = " epsilon)
end
end

component TiePicks
export Executable
(* Which declaration each tie takes, printed rather than asserted: the numeral ties of InferNumeralTie
   and the non-numeral tie of XXXInferAmbiguousCoercion (ledger row 391's shape). *)
trait N
  getter n(): ZZ32
end
object NOf(k: ZZ32) extends N
  getter n(): ZZ32 = k
end
trait A excludes { B, N }
  coerce(x: N) = AOf(x.n)
end
trait B excludes { A, N }
  coerce(x: N) = BOf(x.n)
end
object AOf(k: ZZ32) extends A end
object BOf(k: ZZ32) extends B end
f(x: A): String = "f(A)"
f(x: B): String = "f(B)"
pickn(x: NN32): String = "NN32"
pickn(x: ZZ32): String = "ZZ32"
typeOf(x: Any): String = typecase x of
    ZZ64 => "ZZ64"
    NN64 => "NN64"
    else => "other"
  end
run(): () = do
    println("pickn(3): " || pickn(3))
    println("typeOf(widen(0)): " || typeOf(widen(0)))
    println("typeOf(widen(1)): " || typeOf(widen(1)))
    println("f(NOf(1)): " || f(NOf(1)))
end
end

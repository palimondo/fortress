(* Decision A, way A1 at a size: WayACast.fss with the store and the trait sized, as
   Vector[\T, nat s0\] and __DefaultVector are (Library/FortressLibrary.fss:2320-2346),
   and the factory generic in the element type and the size, as vector[\T,s0\]() is. *)
component WayACastSized
export Executable

trait Vec[\T, nat n\]
  abstract get(i: ZZ32): T
end
object DVec[\nat n\](v: RR64) extends Vec[\RR64, n\]
  get(i: ZZ32): RR64 = v
end
object BVec[\T, nat n\](x: T) extends Vec[\T, n\]
  get(i: ZZ32): T = x
end

witness[\T\](): T = throw InvalidRange

vec[\T, nat n\](x: T): Vec[\T, n\] =
  typecase witness[\T\] of
    () -> RR64 => cast[\Vec[\T, n\]\](DVec[\n\](cast[\RR64\](x)))
    else => BVec[\T, n\](x)
  end

same[\T, nat n\](a: Vec[\T, n\], b: Vec[\T, n\]): T = b.get(0)

which(a: Any): String =
  typecase a of
    DVec[\16\] => "DVec16"
    else => "other"
  end

run(): () = do
  r: RR64 = 1.5
  z: ZZ32 = 7
  a = vec[\RR64, 16\](r)
  b = vec[\ZZ32, 16\](z)
  c = vec[\RR64, 16\](r)
  println("WayACastSized RR64 " which(a) " " a.get(0))
  println("WayACastSized ZZ32 " which(b) " " b.get(0))
  println("WayACastSized shared size " same(a, c))
end

end

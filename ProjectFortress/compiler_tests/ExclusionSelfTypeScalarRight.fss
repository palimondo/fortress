component ExclusionSelfTypeScalarRight
export Executable

(* An operator on an array of a number and that number beside the additive group's own operator is a valid overloading, since the group's self is also the implementing type, a number, which no array is (traits.tex, section "Trait Declarations"; overloading.tex, section "Overloaded Functional Declarations"). *)

trait AnyAddG end
trait AddG[\T extends AddG[\T\]\] extends AnyAddG
    opr PLUS(self, other: T): T
end
trait Numb end
trait HasRk excludes { Numb } end
object Rr extends { Numb, AddG[\Rr\] }
    opr PLUS(self, other: Rr): Rr = self
end
trait Arry[\E\] extends HasRk end
object Vv extends { Arry[\Rr\], AddG[\Vv\] }
    opr PLUS(self, other: Vv): Vv = self
end

opr PLUS(x: Arry[\Rr\], y: Rr): Arry[\Rr\] = x

run(): () = ()

end

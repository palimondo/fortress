+     * types, their supertypes, the types a coercion takes them into and n's plain bounds, the
+     * types that every argument matches or converts into and that n's bounds admit, the one that
+     * is a subtype of, or convertible into, every other.
+     */
+    private static FType narrowest(String n, List<FValue> vals,
+                                   BoundingMap<String, FType, TypeLatticeOps> abm,
+                                   List<StaticParam> rechecks, Set<String> tp_set, Environment env,
+                                   List<FType> bounds, Environment within) {
+        LinkedHashSet<FType> cands = new LinkedHashSet<FType>();
+        for (FValue v : vals) {
+            FType t = v.type();
+            cands.add(t);
+            cands.addAll(t.getTransitiveExtends());
+        }
+        for (FValue v : vals) cands.addAll(Coercions.coercionTargets(v, within));
+        if (bounds != null) cands.addAll(bounds);
+        List<FType> ok = new ArrayList<FType>();
+        for (FType c : cands) {
+            if (c instanceof BottomType || c instanceof FTypeTop) continue;
+            boolean all = true;
+            for (FValue v : vals) {
+                if (!Coercions.admits(c, v)) {
+                    all = false;
+                    break;
+                }
+            }
+            if (!all) continue;
+            BoundingMap<String, FType, TypeLatticeOps> trial = abm.copy();
+            try {
+                trial.joinPut(n, c);
+                if (rechecks != null) {
+                    for (StaticParam tp : rechecks) {
+                        if (!NodeUtil.getName(tp).equals(n)) continue;
+                        for (Type tr : tp.getExtendsClause()) c.unify(env, tp_set, trial, tr);
+                    }
+                }
+            }
+            catch (RuntimeException ex) {
+                ProbeK.fault("candidate " + c + " for " + n, ex);
+                continue;
+            }
+            catch (Error ex) {
+                ProbeK.fault("candidate " + c + " for " + n, ex);
+                continue;
+            }
+            ok.add(c);
+        }
+        FType best = null;
+        for (FType c : ok) {
+            boolean narrower = true;
+            for (FType d : ok) {
+                if (d != c && !c.subtypeOf(d) && !Coercions.convertsInto(c, d)) {
+                    narrower = false;
+                    break;
+                }
+            }
+            if (narrower) {
+                if (best != null && best != c) return null;   // two: none is the narrowest
+                best = c;
+            }
+        }
+        return best;
+    }

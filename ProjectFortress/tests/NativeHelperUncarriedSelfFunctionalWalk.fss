(* Under walk, a builtinPrimitive helper bound in a functional method of a trait that no Java type carries stops the program at load, naming the trait. *)
component NativeHelperUncarriedSelfFunctionalWalk
export Executable

trait Shape
  opr |self| : ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleConcatenate.nativeStrlen")
end

object Square extends Shape end

run():() = println(|Square|)

end

component XXXUnionOfThreeRungK
export Executable

(*) explorations/compile-ladder/rung-inference-walk/REPORT.md

trait KindK end
object OneK extends KindK end
object TwoK extends KindK end
object ThreeK extends KindK end

kindK(x: Any): String = typecase x of
    OneK => "OneK"
    TwoK => "TwoK"
    ThreeK => "ThreeK"
    else => "other"
  end

triK[\T\](a: T, b: T, c: T): String = kindK(a) || " " || kindK(b) || " " || kindK(c)

run(): () = do
    println("REACHED")
    assert(triK(OneK, TwoK, ThreeK), "OneK TwoK ThreeK", "a generic call whose static argument joins three types; overloading.tex:191-199")
    println("PASS")
  end

end

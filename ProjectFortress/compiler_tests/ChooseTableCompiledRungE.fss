(* On the compiled path, CHOOSE on ZZ32 and on ZZ64 throws IntegerOverflow where k is past its helper's safe-bound table. *)
component ChooseTableCompiledRungE
export Executable

cz(a: ZZ32, b: ZZ32): String = try "" || (a CHOOSE b) catch e IntegerOverflow => "OVF" end
cl(a: ZZ64, b: ZZ64): String = try "" || (a CHOOSE b) catch e IntegerOverflow => "OVF" end

run(): () = do
    println("REACHED")
    assert(cz(34, 17), "OVF", "ZZ32 34 CHOOSE 17 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"")
    assert(cl(widen(68), widen(34)), "OVF", "ZZ64 68 CHOOSE 34 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"")
    println("PASS")
  end

end

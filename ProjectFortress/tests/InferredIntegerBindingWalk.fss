(* A generic object built from a ZZ32 value, directly or through a generic function, is built at ZZ32, and a binding declared at that instance admits it. *)

component InferredIntegerBindingWalk
export Executable

object BoxT[\T\](v: T) end

wrap[\T\](x: T): BoxT[\T\] = BoxT[\T\](x)

run(): () = do
    println("REACHED")
    z: ZZ32 = 5
    a: BoxT[\ZZ32\] = BoxT(z)
    assert(a.v = 5, "BoxT(z) for z: ZZ32 is a BoxT[\\ZZ32\\]; inference.tex, section \"The Static Arguments of a Call\"")
    b: BoxT[\ZZ32\] = wrap(z)
    assert(b.v = 5, "wrap(z) for z: ZZ32 is a BoxT[\\ZZ32\\]; inference.tex, section \"The Static Arguments of a Call\"")
    println("PASS")
  end

end

(* Q1e (retry): list literal needs an explicit element static arg, because
   <|...|> infers the carrier type __DefaultVector and List[\T\] is invariant. *)
component p06
import List.{...}
export Executable

run(): () = do
    r0: Vector[\RR64,4\] = [ 0.0 1.0 2.0 3.0 ]
    r1: Vector[\RR64,4\] = [ 4.0 5.0 6.0 7.0 ]
    r2: Vector[\RR64,4\] = [ 8.0 9.0 10.0 11.0 ]
    rows: List[\Vector[\RR64,4\]\] = <|[\Vector[\RR64,4\]\] r0, r1, r2 |>
    println("rows = " rows "  |rows| = " |rows|)

    m = matrix[\RR64,3,4\]().fill(fn (i:ZZ32,j:ZZ32):RR64 => rows[i].get(j))
    println("matrix from rows = " m)
    typecase m of
        AnyMatrix => println("  IS an AnyMatrix")
        else      => println("  is NOT an AnyMatrix")
    end
    x: Vector[\RR64,4\] = [ 1.0 1.0 1.0 1.0 ]
    println("m x = " (m x))

    h0 = matrix[\RR64,2,2\]().fill(fn (i:ZZ32,j:ZZ32):RR64 => 1.0 (i+j+1))
    h1 = matrix[\RR64,2,2\]().fill(fn (i:ZZ32,j:ZZ32):RR64 => 10.0 (i+j+1))
    heads: List[\Matrix[\RR64,2,2\]\] = <|[\Matrix[\RR64,2,2\]\] h0, h1 |>
    println("|heads| = " |heads|)
    y: Vector[\RR64,2\] = [ 1.0 2.0 ]
    for h <- seq(heads) do println("  head y = " (h y)) end
    println("heads[1] = " heads[1])
    println("heads[1] y = " (heads[1] y))
    (* concatenate head outputs back into one vector, 2 heads x 2 = 4 *)
    cat = vector[\RR64,4\](fn (i:ZZ32):RR64 => (heads[i DIV 2] y).get(i MOD 2))
    println("concat of head outputs = " cat)
  end
end

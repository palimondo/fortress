component SkR2ROAnyInnerCtx
export Executable

object BoxT[\T extends Any\]() end

object Fac
  mkA[\T extends Any\](): BoxT[\T\] = BoxT[\T\]()
end

isZZ64Box(b: Any): String =
  typecase b of
    BoxT[\ZZ64\] => "BoxT[ZZ64]"
    else => "other"
  end

run(): () = do
  a: BoxT[\ZZ64\] = Fac.mkA()
  println("fixed by the expected type: " isZZ64Box(a))
end

end

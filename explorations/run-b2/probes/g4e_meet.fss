component g4e_meet
import List.{...}
export Executable
(* Fix 3, the spec's own remedy: supply the disambiguating declaration
   f(Ps INTERSECT Qs).  advanced/overloading.tex:260-262.  There is no
   nameable intersection of List[\ZZ32\] and Range[\ZZ32\], so the closest
   spelling is a third, more specific overload at the meet.  Recorded as an
   attempt: Fortress has no syntax for an intersection type parameter. *)
object Box(xs: Array[\ZZ32, ZZ32\])
  opr[ts: List[\ZZ32\]]: ZZ32 = |ts|
  opr[r: Range[\ZZ32\]]: ZZ32 = 999
  opr[b: BottomType]: ZZ32 = 0
end
run(): () = do
  a = array[\ZZ32\](4).fill(fn (i: ZZ32): ZZ32 => i)
  b = Box(a)
  println("b[list] = " b[<|[\ZZ32\] 1, 2, 3|>])
end
end

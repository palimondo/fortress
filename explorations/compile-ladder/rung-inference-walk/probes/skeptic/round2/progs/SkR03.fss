component SkR03
export Executable

shownR(v: Any): String = typecase v of
    v1: ZZ32 => v1.asString || ":ZZ32"
    v2: ZZ64 => v2.asString || ":ZZ64"
    v3: NN32 => v3.asString || ":NN32"
    v4: RR64 => v4.asString || ":RR64"
    v5: String => v5 || ":String"
    else => "other"
  end

appR[\T\](f: T -> T, x: T): String = shownR(f(x))
dblR(y: ZZ64): ZZ64 = y + y

run(): () = do
    z: ZZ32 = 3
    w: ZZ64 = widen(4)
    println("appR(dblR, w) = " || appR(dblR, w))
    println("appR(dblR, z) = " || appR(dblR, z))
  end

end

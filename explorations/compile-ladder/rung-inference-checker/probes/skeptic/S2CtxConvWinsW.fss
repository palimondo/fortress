component S2CtxConvWinsW
export Executable

trait N
  getter n(): ZZ32
end
object NOf(k: ZZ32) extends N
  getter n(): ZZ32 = k
end
trait V excludes { N }
  coerce(x: N) = VOf(x.n)
  getter n(): ZZ32
end
object VOf(k: ZZ32) extends V
  getter n(): ZZ32 = k
end

k[\T extends N\](x: T): T = x
k(x: V): V = VOf(99)


run(): () = do
    a: V = k(NOf(1))
    println("k(NOf(1)) into V: " || a.n)
    b = k(NOf(1))
    println("k(NOf(1)) untyped: " || b.n)
end

end

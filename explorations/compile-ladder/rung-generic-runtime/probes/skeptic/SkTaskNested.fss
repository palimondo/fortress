component SkTaskNested
export Executable

object BoxT[\T\](v: ZZ32) end
object Box[\nat k\](v: ZZ32) end
which(x: Any): String = typecase x of
    BoxT[\String\] => "string"
    BoxT[\ZZ32\] => "zz32"
    BoxT[\Boolean\] => "bool"
    Box[\3\] => "three"
    Box[\4\] => "four"
    else => "other"
  end
lbl(x: Any): String = which(x)
idz(n: ZZ32): ZZ32 = n

nestedT[\T\](): String = do
  var r1: String := ""
  var r2: String := ""
  var r3: String := ""
  do
    r1 := lbl(BoxT[\T\](1))
  also do
    k = fn (): String => which(BoxT[\T\](2))
    do r2 := k() also do r3 := lbl(BoxT[\T\](3)) end
  end
  r1 || r2 || r3
end

run(): () = do
  println("nestedT: " nestedT[\Boolean\]())
end

end

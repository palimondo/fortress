(* See explorations/compile-ladder/rung-integer-minmax/REPORT.md. *)
component XXXMaxNN32IntoZZ64RungM
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    NN32 => "NN32"
    NN64 => "NN64"
    ZZ => "ZZ"
    else => "other"
  end

run(): () = do
  println("REACHED")
  five: ZZ32 = 5
  u: NN32 = unsigned(five)
  z: ZZ32 = 3
  w: ZZ64 = 4
  assert(typeOf(u MAX z), "ZZ64", "row 442, basic-integers.tex:25: ZZ64 coerces from NN32 and ZZ32, so NN32 MAX ZZ32 answers at ZZ64; conversions-coercions.tex:546-574")
  assert(typeOf(z MAX u), "ZZ64", "row 442, basic-integers.tex:25: ZZ32 MAX NN32 answers at ZZ64; conversions-coercions.tex:546-574")
  assert(typeOf(u MAX w), "ZZ64", "row 442, basic-integers.tex:25: NN32 MAX ZZ64 answers at ZZ64; conversions-coercions.tex:546-574")
  assert(typeOf(w MAX u), "ZZ64", "row 442, basic-integers.tex:25: ZZ64 MAX NN32 answers at ZZ64; conversions-coercions.tex:546-574")
  println("PASS")
end

end

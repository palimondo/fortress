component SizeBoundsW
export Executable

object Box[\nat k\](v: ZZ32) end
object IBox[\int i\](v: ZZ32) end
natOf[\nat k\](b: Box[\k\]): ZZ64 = k
intOf[\int i\](b: IBox[\i\]): ZZ64 = i
natW[\nat k\](): ZZ64 = k
intW[\int i\](): ZZ64 = i
g(b: Box[\4294967295\]): String = "top of NN32"
g(b: Box[\2147483648\]): String = "2^31"
g(x: Any): String = "other"
h(b: IBox[\2147483647\]): String = "top of ZZ32"
h(x: Any): String = "other"

run(): () = do
  println("nat 2147483647 value " || natOf(Box[\2147483647\](0)))
  println("nat 2147483648 value " || natOf(Box[\2147483648\](0)))
  println("nat 4294967295 value " || natOf(Box[\4294967295\](0)))
  println("nat 4294967295 written " || natW[\4294967295\]())
  println("int 2147483647 value " || intOf(IBox[\2147483647\](0)))
  println("int 2147483647 written " || intW[\2147483647\]())
  a: Any = Box[\4294967295\](0)
  b: Any = Box[\2147483648\](0)
  c: Any = Box[\2147483647\](0)
  d: Any = IBox[\2147483647\](0)
  e: Any = IBox[\2147483646\](0)
  println("dispatch " || g(a) || ", " || g(b) || ", " || g(c) || ", " || h(d) || ", " || h(e))
  println("end")
end

end

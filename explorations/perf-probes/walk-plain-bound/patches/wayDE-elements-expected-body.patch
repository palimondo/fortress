+(* Walk's desugaring of a clause form by its elements' type: the elements that
+   the clauses give, in their order, typed at the join of their types. *)
+trait __ElemsAny
+    __replay(r: Any, u: Any): Any
+end
+object __ElemsNone extends __ElemsAny
+    __replay(r: Any, u: Any): Any = r.empty()
+end
+trait __Elems[\T\] extends __ElemsAny end
+object __ElemsOne[\T\](v: T) extends __Elems[\T\]
+    __replay(r: Any, u: Any): Any = u(v)
+end
+object __ElemsTwo[\T\](a: __ElemsAny, b: __ElemsAny) extends __Elems[\T\]
+    __replay(r: Any, u: Any): Any = r.join(a.__replay(r, u), b.__replay(r, u))
+end
+__elemsJoin[\T, A extends T, B extends T\](a: __Elems[\A\], b: __Elems[\B\]): __Elems[\T\] =
+    __ElemsTwo[\T\](a, b)
+object __ElemsReduction extends MonoidReduction[\__ElemsAny\]
+    getter asString(): String = "elements"
+    empty(): __ElemsAny = __ElemsNone
+    join(a: __ElemsAny, b: __ElemsAny): __ElemsAny =
+        typecase a of
+            __ElemsNone => b
+            else => typecase b of
+                        __ElemsNone => a
+                        else => __elemsJoin(a, b)
+                    end
+        end
+end
+__elemsOne(x: Any): __ElemsAny = __ElemsOne(x)
+__elemsOf(desugaredClauses: Any): __ElemsAny = desugaredClauses(__ElemsReduction, __elemsOne)
+__replayOf(e: __ElemsAny): Any = fn (r, u) => e.__replay(r, u)
+

component XXXIndexBesideTupleOverloadWalk
export Executable

(* A function over Index beside a function over a pair of a trait that neither excludes Index nor lies below it is no valid overloading, so the program is refused at load, under walk (overloading.tex, section "Meet Rule"; types-vals-vars.tex, section "Tuple Types"). *)

trait Foo end
object G extends { Foo, Index } end

h(x: Index): String = "index"
h(x: (Foo, Foo)): String = "pair"

run(): () = do
    println(h((G, G)))
  end

end

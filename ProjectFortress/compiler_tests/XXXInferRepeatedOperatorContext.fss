(* An operator repeated between three operands with no multifix declaration is left-associated, and its outer application has the expected type, which fixes a static argument that only the result mentions. *)
component XXXInferRepeatedOperatorContext
export Executable

object BoxV[\T\](v: T) end
opr OPLUS[\T\](a: Any, b: ZZ32): BoxV[\T\] = throw InvalidRange
three(): String = try
    y: BoxV[\ZZ64\] = 1 OPLUS 2 OPLUS 3
    "value"
  catch e
    InvalidRange => "thrown"
  end

run(): () = do
    assert(three(), "thrown", "1 OPLUS 2 OPLUS 3 is (1 OPLUS 2) OPLUS 3, whose outer application is instantiated at ZZ64 and throws; Specification/basic/inference.tex, section \"The Static Arguments of a Call\"")
    println("PASS")
  end

end

(* Q2 probe 21: companion to q19.  q19's explicit unit static argument
   SQRTU[\meter\](9.0) was a Syntax Error; here the call is written without
   static arguments so the unit would have to be inferred from the argument
   type -- the ordinary way the spec's SQRT[\unit U\] would be used
   (Specification/basic/trait-parameters.tex:147-149). *)
component q21_unit_param_infer
export Executable

dim Length  SI_unit meter meters m_ = 1.0

opr SQRTU[\unit U\](x: RR64 U^2): RR64 U = numericalsqrt(x/U^2) U

numericalsqrt(x: RR64): RR64 = x^0.5

run() = println("SQRTU = " SQRTU(9.0))

end

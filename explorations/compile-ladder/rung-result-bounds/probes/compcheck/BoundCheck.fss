component BoundCheck
export Executable

(*) explorations/compile-ladder/rung-result-bounds/REPORT.md, section 6

g[\T extends Object\](s: String): T = throw FailCalled(s)
n[\T extends Number\](s: String): T = throw FailCalled(s)
k[\T extends Object\](x: T): T = x
object Box[\T extends Object\](x: T) end

gTuple(): (ZZ32, ZZ32) = g[\(ZZ32, ZZ32)\]("a")
gArrow(): ZZ32 -> ZZ32 = g[\ZZ32 -> ZZ32\]("b")
gString(): String = g[\String\]("c")
nString(): String = n[\String\]("d")
kTuple(): (ZZ32, ZZ32) = k((1, 2))
kTupleWritten(): (ZZ32, ZZ32) = k[\(ZZ32, ZZ32)\]((1, 2))
boxTuple(): Box[\(ZZ32, ZZ32)\] = Box[\(ZZ32, ZZ32)\]((1, 2))

run(): () = println "done"

end

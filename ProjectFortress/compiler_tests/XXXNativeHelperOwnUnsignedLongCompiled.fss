(* On the compiled path, a program's own trait named UnsignedLong takes no transfer: a declaration over it bound to a long helper is refused at the helper's own parameter type, ZZ64, which the message names. *)
component XXXNativeHelperOwnUnsignedLongCompiled
export Executable

trait UnsignedLong end
object U extends UnsignedLong end

code(u: UnsignedLong): ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleLongArith.longNeg")

run():() = do
  println(code(U))
  println("PASS")
end

end

(* An atomic block reads x and its nested block reads y while other blocks change both together: no nested block sees them differ, in one body and in the arms of the outer block. atomic.tex, section "Atomic Expressions". *)
component AtomicNestedViewCompiled
export Executable

x: ZZ32 := 0
y: ZZ32 := 0
seen: ZZ32 := 0
seenInArms: ZZ32 := 0

look(p: ZZ32): () =
  atomic do
    q: ZZ32 = y
    if p =/= q then
      println("FAIL: a nested block in an arm saw x = " p " and y = " q)
    end
    seenInArms := seenInArms + 1
  end

change(): () =
  for j <- 1#20000 do
    atomic do
      x := x + 1
      y := y + 1
    end
  end

run(): () = do
  do
    for i <- 1#3000 do
      atomic do
        p: ZZ32 = x
        atomic do
          q: ZZ32 = y
          if p =/= q then
            println("FAIL: a nested block saw x = " p " and y = " q)
          end
          seen := seen + 1
        end
      end
    end
  also do
    change()
  end
  do
    for i <- 1#3000 do
      atomic do
        p: ZZ32 = x
        do
          look(p)
        also do
          look(p)
        end
      end
    end
  also do
    change()
  end
  if seen = 3000 AND seenInArms = 6000 AND x = 40000 AND y = 40000 then
    println("PASS")
  else
    println("FAIL: seen = " seen ", seenInArms = " seenInArms ", x = " x ", y = " y)
  end
end

end

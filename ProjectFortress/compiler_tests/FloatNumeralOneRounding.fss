(* On the compiled path, a numeral with a radix point becomes an RR64 or an RR32 by one rounding of its rational value, also below the least normal value, so 0.9999999999999999 is below 1.0. *)
component FloatNumeralOneRounding
export Executable

rawBits(x: RR32): ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatRawBits")

run():() = do
  x: RR64 = 0.9999999999999999
  assert(x < 1.0, "0.9999999999999999 rounds to the double below 1.0")
  y: RR64 = 1.2246467991473532
  assert(y > 1.224646799147353, "1.2246467991473532 rounds to its nearest double, above 1.224646799147353")
  t: RR32 = 0.0000000000000000000000000000000000000000000035032461608120427
  assert(rawBits(t), 3, "a numeral just above the midpoint of two subnormal RR32 values rounds once, up")
  s: RR64 = 0.
  assert(s = 0., "a numeral just above the midpoint of two subnormal RR64 values rounds once, up")
  println("PASS")
end

end

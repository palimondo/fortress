(* See explorations/compile-ladder/rung-size-range/REPORT.md. *)
component XXXNatRangeChecker
export Executable

object Box[\nat k\](v: ZZ32) end
object IBox[\int i\](v: ZZ32) end

sz64[\nat k\](b: Box[\k\]): ZZ64 = k
szZ[\nat k\](b: Box[\k\]): ZZ = k
iv64[\int i\](b: IBox[\i\]): ZZ64 = i
natOf[\nat k\](): ZZ64 = k
intOf[\int i\](): ZZ64 = i
gNat(b: Box[\4294967296\]): String = "a nat parameter beyond NN32 in a type"
gInt(b: IBox[\2147483648\]): String = "an int parameter beyond ZZ32 in a type"

run(): () = do
  println(sz64(Box[\9223372036854775807\](0)))
  println(szZ(Box[\9223372036854775808\](0)))
  println(szZ(Box[\18446744073709551615\](0)))
  println(natOf[\4294967296\]())
  println(intOf[\2147483648\]())
  println(iv64(IBox[\2147483648\](0)))
  println("PASS")
end

end

component SkCrossedRenamed
export Executable
trait Box[\T\] comprises { Full[\T\] } end
trait Full[\T\] extends Box[\T\] end
trait Tag[\T, U\] extends Box[\T\] end
trait Odd[\V\] extends { Full[\V\], Tag[\ZZ32, V\] } end
object O[\V\](x: V) extends Odd[\V\] end
isFullZZ(b: Box[\ZZ32\]): String = typecase b of
    Full[\ZZ32\] => "a Full[ZZ32]"
    else => "a Box[ZZ32] that is no Full[ZZ32]"
  end
run(): () = println(isFullZZ(O[\String\]("a")))
end

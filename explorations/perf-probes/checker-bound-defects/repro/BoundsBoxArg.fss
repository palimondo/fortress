(* Row 686: a call whose argument's type holds the caller's own type parameter, under the callee's two bounds. *)
component BoundsBoxArg
export Executable
trait R[\T extends R[\T\]\] end
trait K comprises { A, B, C } end
object A extends { K, R[\A\] } end
object B extends { K, R[\B\] } end
object C extends K end
object Box[\T extends { K, R[\T\] }\](v: T) end
h[\T extends { K, R[\T\] }\](x: Box[\T\]): T = x.v
g[\T extends { K, R[\T\] }\](x: Box[\T\]): T = h(x)
tag(a: A): String = "A"
tag(b: B): String = "B"
run(): () = do
    assert(tag(g(Box[\A\](A))), "A", "h(x) at h's instance T")
    println("PASS")
  end
end

component probe08_types
export Executable

(* Abbreviated array types with nat parameters: which positions work? *)
object V(x: RR64) end

f1[\nat n\](x: V[n]): Array1[\V,0,n\] = x
f2[\nat n\](x: Array1[\V,0,n\]): V[n] = x
f3[\nat m, nat n\](w: V[m,n]): V = w[0,0]

run(): () = do
  x = array1[\V,3\](fn (i: ZZ32) => V(i))
  y1 = f1(x)
  println("f1 ok " y1[2].x)
  y2 = f2(x)
  println("f2 ok " y2[2].x)
  w = array2[\V,2,3\]().fill(V(7.0))
  println("f3 ok " (f3(w)).x)
end
end

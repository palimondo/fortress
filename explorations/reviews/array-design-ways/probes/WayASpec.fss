(* Decision A, way A2: specialisation by overloading, the designers' "monomorphic and
   polymorphic versions of functions" (Naden 2011, reviews/mie-probes/literature.md
   section 1): a plain factory for one element type beside the generic one, told apart
   by the witness the library already passes (__arr1(__thrower[\E\], reflect(x)),
   Library/FortressLibrary.fss:2047), chosen at run time when generic code calls it. *)
component WayASpec
export Executable

trait Arr[\T\]
  abstract get(i: ZZ32): T
end
object DStore(v: RR64) extends Arr[\RR64\]
  get(i: ZZ32): RR64 = v
end
object BStore[\T\](x: T) extends Arr[\T\]
  get(i: ZZ32): T = x
end

witness[\T\](): T = throw InvalidRange

mk[\T\](w: () -> T, x: T): Arr[\T\] = BStore[\T\](x)
mk(w: () -> RR64, x: RR64): Arr[\RR64\] = DStore(x)

gen[\T\](x: T): Arr[\T\] = mk(witness[\T\], x)

which(a: Any): String =
  typecase a of
    DStore => "DStore"
    else => "BStore"
  end

run(): () = do
  r: RR64 = 1.5
  z: ZZ32 = 7
  a = gen[\RR64\](r)
  b = gen[\ZZ32\](z)
  println("WayASpec RR64 through generic code " which(a) " " a.get(0))
  println("WayASpec ZZ32 through generic code " which(b) " " b.get(0))
end

end

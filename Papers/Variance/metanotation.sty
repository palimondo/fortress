\def\leftharpoonfill@{\arrowfill@{\copy\lowered@leftharpoonup}{\copy\lowered@relbar}{\copy\lowered@relbar}}
\def\rightharpoonfill@{\arrowfill@{\copy\lowered@relbar}{\copy\lowered@relbar}{\copy\lowered@rightharpoonup}}

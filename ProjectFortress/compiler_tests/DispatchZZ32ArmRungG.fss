(* See explorations/compile-ladder/rung-generic-runtime/REPORT.md. *)
component DispatchZZ32ArmRungG
export Executable

trait Tag[\X\] end
trait Sub[\X\] extends Tag[\X\] end
object IntSub extends Sub[\ZZ32\] end
object IntTag extends Tag[\ZZ32\] end
trait Marker[\X\] end
object TagM[\X\] extends Marker[\X\] end
object SubM[\X\] extends Marker[\X\] end

grab[\X\](t: Tag[\X\]): Marker[\X\] = TagM[\X\]
grab[\X\](t: Sub[\X\]): Marker[\X\] = SubM[\X\]

name(m: Any): String = typecase m of
    SubM[\ZZ32\] => "SubM[ZZ32]"
    TagM[\ZZ32\] => "TagM[ZZ32]"
    else => "other"
  end

run(): () = do
  println("REACHED")
  t: Tag[\ZZ32\] = IntSub
  assert(name(grab(t)), "SubM[ZZ32]", "a generic arm dispatched at ZZ32, Specification/basic/overloading.tex:100-107, :262-276")
  u: Tag[\ZZ32\] = IntTag
  assert(name(grab(u)), "TagM[ZZ32]", "Specification/basic/overloading.tex:100-107, :262-276")
  println("PASS")
end

end

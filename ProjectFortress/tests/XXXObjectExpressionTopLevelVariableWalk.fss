component XXXObjectExpressionTopLevelVariableWalk
export Executable

(* A top-level variable initialized with an object expression holds the object value that the object expression denotes, under walk. *)

trait A
  pick(self): String = "A"
end

zz = object extends A end

run(): () = do
    assert(pick(zz), "A", "a top-level variable initialized with an object expression holds its object, whose functional method pick answers A (object.tex, section \"Object Expressions\"; variables.tex, section \"Top-Level Variable Declarations\")")
    println("PASS")
  end

end

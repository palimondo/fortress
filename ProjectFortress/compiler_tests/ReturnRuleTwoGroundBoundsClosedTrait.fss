(* A generic declaration whose type parameter is bounded by a trait with a comprises clause and by a trait without static parameters that excludes one of its listed types, beside a declaration on the first trait with the same return type, is a valid overloading, the generic one the more specific. *)
component ReturnRuleTwoGroundBoundsClosedTrait
export Executable

trait Q excludes { C } end
trait K comprises { A, B, C } end
object A extends { K, Q } end
object B extends { K, Q } end
object C extends K end

f[\T extends { K, Q }\](x: T): String = "KQ"
f(x: K): String = "K"

run(): () = do
    assert(f(A), "KQ", "f(A) runs the generic declaration, the more specific, whose return type String is the other's; Specification/advanced/overloading.tex, section \"Declarations with Static Parameters\"")
    assert(f(C), "K", "f(C) runs the declaration on K, the only one applicable; Specification/advanced/overloading.tex, section \"Declarations with Static Parameters\"")
    println("PASS")
  end

end

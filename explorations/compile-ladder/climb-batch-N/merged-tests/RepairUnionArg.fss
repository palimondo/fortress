(*) explorations/compile-ladder/climb-batch-N/REPAIR-review.md
component RepairUnionArg
export Executable

object BoxT[\T\]() end
object Apple end
object Berry end

pick0[\T\](x: T, y: T): BoxT[\T\] = BoxT[\T\]()
one[\T\](a: BoxT[\T\]): String = "one"
idt[\T\](x: T): String = "idt"

run(): () = do
  w: ZZ64 = 4
  r: RR64 = 2.5
  println("u1 " || one(pick0(w, r)))
  println("u2 " || one(pick0(Apple, Berry)))
  println("u3 " || idt(pick0(w, r)))
  println("u4 " || one(pick0(w, w)))
end

end

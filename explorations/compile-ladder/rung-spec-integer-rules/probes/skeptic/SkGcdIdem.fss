component SkGcdIdem
export Executable

(*) Skeptic's probe of algebraic-constraints.tex:1154, which names GCD and LCM among idempotent operators, against the absolute value on negative integers.
run(): () = do
  mFour: ZZ32 = -4
  mFourL: ZZ64 = -4
  println("ZZ32 -4 GCD -4 = " (mFour GCD mFour) ", idempotent: " ((mFour GCD mFour) = mFour))
  println("ZZ32 -4 LCM -4 = " (mFour LCM mFour) ", idempotent: " ((mFour LCM mFour) = mFour))
  println("ZZ64 -4 GCD -4 = " (mFourL GCD mFourL) ", idempotent: " ((mFourL GCD mFourL) = mFourL))
end

end

(* D6: spec 8.3 matrix unpasting, literal spelling [ q1 q2 q3 q4 ] = Q. *)
component g1d_unpaste1
export Executable

run(): () = do
    Q: Matrix[\RR64,3,16\] =
        matrix[\RR64,3,16\]().fill(fn (i:ZZ32,j:ZZ32):RR64 => 1.0 (16 i + j))
    [ q1 q2 q3 q4 ] = Q
    println("q1 = " q1)
    println("q4 = " q4)
  end
end

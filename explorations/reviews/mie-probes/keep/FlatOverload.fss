component FlatOverload
export Executable

(* The same flat tower; the called name is overloaded, so dispatch goes through
   OverloadedFunction.bestMatch, where the team left "TODO add checks for COERCE, right here". *)
trait Num excludes { String } end
trait Wide extends { Num, Equality[\Wide\] } excludes { Narrow }
  coerce(x: Narrow) = WideOf(x.small)
  getter big(): ZZ64
  opr =(self, other: Wide): Boolean = self.big = other.big
end
trait Narrow extends { Num, Equality[\Narrow\] } excludes { Wide }
  getter small(): ZZ32
  opr =(self, other: Narrow): Boolean = self.small = other.small
end
object WideOf(b: ZZ64) extends Wide
  getter big(): ZZ64 = b
end
object NarrowOf(s: ZZ32) extends Narrow
  getter small(): ZZ32 = s
end

g(x: Wide): String = "g(Wide) got " x.big
g(x: String): String = "g(String) got " x

run(): () = do
  n = NarrowOf(3)
  println("control, a Wide:       " g(WideOf(widen(3))))
  println("a Narrow where only g(Wide) and g(String) are declared:")
  println(g(n))
end
end

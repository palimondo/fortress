component SkSatOps
export Executable

run(): () = do
  zero: ZZ32 = 0
  one: ZZ32 = 1
  zMax: ZZ32 = 7FFFFFFF_16
  zMin: ZZ32 = -zMax - 1
  lZero: ZZ64 = widen(zero)
  lOne: ZZ64 = widen(one)
  lTwo: ZZ64 = lOne + lOne
  lMOne: ZZ64 = -lOne
  lMTwo: ZZ64 = -lTwo
  lMax: ZZ64 = 7FFFFFFFFFFFFFFF_16
  lMin: ZZ64 = -lMax - 1
  println("ZZ32 DOTMINUS MIN = " (DOTMINUS zMin).asString)
  println("ZZ32 DOTMINUS 1 = " (DOTMINUS one).asString)
  println("ZZ64 DOTMINUS 1 = " (DOTMINUS lOne).asString)
  println("ZZ64 MAX DOTCROSS 2 = " (lMax DOTCROSS lTwo).asString)
  println("ZZ64 MIN DOTCROSS MIN = " (lMin DOTCROSS lMin).asString)
  println("ZZ64 MAX DOTCROSS -2 = " (lMax DOTCROSS lMTwo).asString)
  println("ZZ64 -1 DOTCROSS MIN = " (lMOne DOTCROSS lMin).asString)
  println("ZZ64 0 DOTCROSS MIN = " (lZero DOTCROSS lMin).asString)
  println("ZZ64 MIN DOTCROSS 0 = " (lMin DOTCROSS lZero).asString)
  println("ZZ64 MIN DOTCROSS 1 = " (lMin DOTCROSS lOne).asString)
  println("ZZ64 MIN BOXDOT 2 = " (lMin BOXDOT lTwo).asString)
end

end

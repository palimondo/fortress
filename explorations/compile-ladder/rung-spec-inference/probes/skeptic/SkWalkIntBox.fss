component SkWalkIntBox
export Executable

object BoxT[\T\](v: T) end

k1[\T\](x: T): BoxT[\T\] = BoxT[\T\](x)

run(): () = do
  z: ZZ32 = 5
  println("W1 a: BoxT[ZZ32] = BoxT(z), the constructor (row 364's shape)")
  a: BoxT[\ZZ32\] = BoxT(z)
  println("  bound")
  println("W2 b: BoxT[ZZ32] = k1(z), a generic function")
  b: BoxT[\ZZ32\] = k1(z)
  println("  bound")
  println("end")
end

end

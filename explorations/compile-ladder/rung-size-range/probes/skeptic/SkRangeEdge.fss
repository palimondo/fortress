component SkRangeEdge
export Executable
show(f: () -> Any): String =
  try
    "" || f()
  catch e
    IntegerOverflow => "OVF"
  end
cnt(g: Generator[\ZZ32\]): String =
  try
    var n: ZZ32 = 0
    var first: String := "-"
    var last: String := "-"
    for i <- seq(g) do
      if n = 0 then first := "" || i end
      last := "" || i
      n += 1
    end
    n || " [" || first || ".." || last || "]"
  catch e
    IntegerOverflow => "OVF"
  end
parSum(g: Generator[\ZZ32\]): String =
  try
    "" || (SUM[i <- g] widen(i))
  catch e
    IntegerOverflow => "OVF"
  end
run(): () = do
  zMax: ZZ32 = 2147483647
  zMin: ZZ32 = -zMax - 1
  zero: ZZ32 = 0
  one: ZZ32 = 1
  two: ZZ32 = 2
  mfive: ZZ32 = -5
  println("h01 MAX#1 " || show(fn () => (zMax # one).asDebugString) || " size " || show(fn () => |zMax # one|))
  println("h02 MAX#2 " || show(fn () => (zMax # two).asDebugString))
  println("h03 MIN#0 " || show(fn () => (zMin # zero).asDebugString) || " size " || show(fn () => (zMin # zero).size) || " MIN in it " || show(fn () => zMin IN (zMin # zero)))
  println("h04 MIN#-1 " || show(fn () => (zMin # (-one)).asDebugString) || " size " || show(fn () => (zMin # (-one)).size))
  println("h05 MIN#MIN " || show(fn () => (zMin # zMin).asDebugString) || " size " || show(fn () => (zMin # zMin).size))
  println("h06 MAX#0 " || show(fn () => (zMax # zero).asDebugString) || " size " || show(fn () => (zMax # zero).size))
  println("h07 MAX#MIN " || show(fn () => (zMax # zMin).asDebugString) || " size " || show(fn () => (zMax # zMin).size))
  println("h08 (MIN+1)#-1 " || show(fn () => ((zMin + one) # (-one)).asDebugString))
  println("h09 (MIN+1)#-2 " || show(fn () => ((zMin + one) # (-two)).asDebugString))
  println("h10 -1#MIN " || show(fn () => ((-one) # zMin).asDebugString))
  println("h11 0#MAX size " || show(fn () => (zero # zMax).size))
  println("h12 MIN#MAX last " || show(fn () => (zMin # zMax).asDebugString) || " size " || show(fn () => (zMin # zMax).size))
  println("s01 (1:MIN).size " || show(fn () => (one:zMin).size) || " card " || show(fn () => |one:zMin|))
  println("s02 (MIN:(-2)).size " || show(fn () => (zMin:(-two)).size) || " card " || show(fn () => |zMin:(-two)|))
  println("s03 (MIN:(-1)).size " || show(fn () => (zMin:(-one)).size))
  println("s04 (0:(MAX-1)).size " || show(fn () => (zero:(zMax - one)).size) || " card " || show(fn () => |zero:(zMax - one)|))
  println("s05 (-1:(MAX-1)).size " || show(fn () => ((-one):(zMax - one)).size))
  println("s06 (MAX:MAX).size " || show(fn () => (zMax:zMax).size) || " card " || show(fn () => |zMax:zMax|))
  println("s07 (MIN:MIN).size " || show(fn () => (zMin:zMin).size) || " card " || show(fn () => |zMin:zMin|))
  println("s08 (MAX:MIN).size " || show(fn () => (zMax:zMin).size) || " card " || show(fn () => |zMax:zMin|))
  println("s09 (0:MAX:MAX).size " || show(fn () => (zero:zMax:zMax).size) || " card " || show(fn () => |zero:zMax:zMax|))
  println("s10 (MAX:0:-MAX).size " || show(fn () => (zMax:zero:(-zMax)).size))
  println("s11 (0:MIN:MIN).size " || show(fn () => (zero:zMin:zMin).size))
  println("s12 (-1:MIN:MIN).size " || show(fn () => ((-one):zMin:zMin).size))
  println("s13 (1:10:3).size " || show(fn () => (one:10:3).size) || " card " || show(fn () => |one:10:3|))
  println("s14 (10:1:-3).size " || show(fn () => (10:one:(-3)).size))
  println("s15 (10:1:3).size " || show(fn () => (10:one:3).size) || " card " || show(fn () => |10:one:3|))
  println("s16 (5:5:7).size " || show(fn () => (5:5:7).size))
  println("t01 |(0,MIN):(-1,MAX)| " || show(fn () => |(zero,zMin):(-one,zMax)|))
  println("t02 |(MIN,0):(-2,0)| " || show(fn () => |(zMin,zero):(-two,zero)|))
  println("t03 |(MIN,0):(-1,0)| " || show(fn () => |(zMin,zero):(-one,zero)|))
  println("t04 |(0,0,MIN):(1,1,-3)| " || show(fn () => |(zero,zero,zMin):(one,one,(-3))|))
  println("t05 |(1,1):(3,4)| " || show(fn () => |(one,one):(3,4)|))
  println("t06 (MAX,1)#(1,2) " || show(fn () => ((zMax,one) # (one,two)).asDebugString))
  println("t07 (MIN,5)#(0,0) " || show(fn () => ((zMin,5) # (zero,zero)).asDebugString) || " card " || show(fn () => |(zMin,5) # (zero,zero)|))
  println("t08 (1,2,3)#(2,2,2) " || show(fn () => ((one,two,3) # (two,two,two)).asDebugString))
  println("q01 seq((MAX-2):MAX) " || cnt((zMax - two):zMax))
  println("q02 seq(MIN:(MIN+2)) " || cnt(zMin:(zMin + two)))
  println("q03 seq(MAX:MAX) " || cnt(zMax:zMax))
  println("q04 seq((MAX-4):MAX:2) " || cnt((zMax - 4):zMax:2))
  println("q05 seq((MAX-5):MAX:2) " || cnt((zMax - 5):zMax:2))
  println("q06 seq(0:MAX:MAX) " || cnt(zero:zMax:zMax))
  println("q07 seq(MAX:0:-MAX) " || cnt(zMax:zero:(-zMax)))
  println("q08 seq(0:MIN:MIN) " || cnt(zero:zMin:zMin))
  println("q09 seq(-1:MIN:MIN) " || cnt((-one):zMin:zMin))
  println("q10 seq((MIN+4):MIN:-2) " || cnt((zMin + 4):zMin:(-2)))
  println("q11 seq((MIN+5):MIN:-2) " || cnt((zMin + 5):zMin:(-2)))
  println("q12 seq(-3:3:2) " || cnt((-3):3:2))
  println("q13 seq(3:-3:-2) " || cnt(3:(-3):(-2)))
  println("q14 seq(-7:-1:3) " || cnt((-7):(-1):3))
  println("q15 seq(1:0) " || cnt(one:zero))
  println("q16 seq(5:1:1) " || cnt(5:one:1))
  println("q17 seq(1:5:-1) " || cnt(one:5:(-1)))
  println("q18 seq(MIN#0) " || cnt(zMin # zero))
  println("q19 seq((MAX-1)#2) " || cnt((zMax - one) # two))
  println("q20 seq(-2:1:1) " || cnt((-two):one:1))
  println("q21 seq(2:-1:-1) " || cnt(two:(-one):(-1)))
  println("p01 SUM (MAX-2):MAX " || parSum((zMax - two):zMax))
  println("p02 SUM MIN:(MIN+2) " || parSum(zMin:(zMin + two)))
  println("p03 SUM (MAX-4):MAX:2 " || parSum((zMax - 4):zMax:2))
  println("p04 SUM (MAX-1)#2 " || parSum((zMax - one) # two))
  println("END")
end
end

component R2ArithIn
export Executable
object Box[\nat k\](v: ZZ32) end
object IBox[\int k\](v: ZZ32) end
sz[\nat k\](b: Box[\k\]): ZZ64 = k
isz[\int k\](b: IBox[\k\]): ZZ64 = k
run(): () = do
  println("a1 3 4 + 5 = " || sz(Box[\3 4 + 5\](0)))
  println("a2 2147483647 + 2147483648 = " || sz(Box[\2147483647 + 2147483648\](0)))
  println("a3 0 - 2147483647 - 1 = " || isz(IBox[\0 - 2147483647 - 1\](0)))
  println("a4 65536 65536 - 1 = " || sz(Box[\65536 65536 - 1\](0)))
  println("a5 9223372036854775807 - 9223372036854775807 + 7 = " || sz(Box[\9223372036854775807 - 9223372036854775807 + 7\](0)))
  println("END")
end
end

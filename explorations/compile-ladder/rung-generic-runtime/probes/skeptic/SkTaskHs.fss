component SkTaskHs
export Executable

object BoxT[\T\](v: ZZ32) end
object Box[\nat k\](v: ZZ32) end
which(x: Any): String = typecase x of
    BoxT[\String\] => "string"
    BoxT[\ZZ32\] => "zz32"
    BoxT[\Boolean\] => "bool"
    Box[\3\] => "three"
    Box[\4\] => "four"
    else => "other"
  end
lbl(x: Any): String = which(x)
idz(n: ZZ32): ZZ32 = n

object Hs[\nat k\](v: ZZ32)
  m[\nat j\](): ZZ32 = idz(k) + idz(j)
end

run(): () = do
  println("Hs.m: " Hs[\3\](0).m[\4\]())
end

end

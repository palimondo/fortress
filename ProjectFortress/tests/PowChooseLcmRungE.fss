(*) explorations/compile-ladder/rung-size-range/REPORT.md

component PowChooseLcmRungE
export Executable

overflows(f: () -> Any): Boolean =
  try
    ignore(f())
    false
  catch e
    IntegerOverflow => true
  end

run() = do
    two: ZZ32 = 2
    three: ZZ32 = 3
    mtwo: ZZ32 = -2
    zero: ZZ32 = 0
    mone: ZZ32 = -1
    five: ZZ32 = 5
    mfive: ZZ32 = -5
    n33: ZZ32 = 33
    n34: ZZ32 = 34
    maxI: ZZ32 = 2147483647
    twoL: ZZ64 = widen(two)
    threeL: ZZ64 = widen(three)
    mtwoL: ZZ64 = widen(mtwo)
    n62L: ZZ64 = widen(62)
    n66L: ZZ64 = widen(66)
    n67L: ZZ64 = widen(67)
    n68L: ZZ64 = widen(68)
    oneN: NN32 = unsigned(1)
    twoN: NN32 = unsigned(2)
    threeN: NN32 = unsigned(3)
    fourN: NN32 = unsigned(4)
    fiveN: NN32 = unsigned(5)
    sixN: NN32 = unsigned(6)
    sevenN: NN32 = unsigned(7)
    b16N: NN32 = unsigned(65536)
    b16pN: NN32 = unsigned(65537)
    m65535N: NN32 = unsigned(65535)
    n92682N: NN32 = unsigned(92682)
    n92683N: NN32 = unsigned(92683)
    maxN: NN32 = BITNOT unsigned(0)
    twoTo31N: NN32 = unsigned(1073741824) + unsigned(1073741824)
    maxL: ZZ64 = 9223372036854775807
    oneU: NN64 = unsigned(widen(1))
    twoU: NN64 = unsigned(widen(2))
    threeU: NN64 = unsigned(widen(3))
    fiveU: NN64 = unsigned(widen(5))
    n33U: NN64 = unsigned(widen(33))
    n34U: NN64 = unsigned(widen(34))
    n67U: NN64 = unsigned(widen(67))
    n68U: NN64 = unsigned(widen(68))
    twoTo32U: NN64 = unsigned(widen(65536)) DOT unsigned(widen(65536))
    twoTo63U: NN64 = unsigned(maxL) + oneU

    assert(overflows(fn () => two^31), "ZZ32 2^31 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"")
    assert(overflows(fn () => two^64), "ZZ32 2^64 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"")
    assert(overflows(fn () => three^40), "ZZ32 3^40 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"")
    assert((two^30).asString, "1073741824", "ZZ32 2^30 is 1073741824; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"")
    assert((mtwo^31).asString, "-2147483648", "ZZ32 (-2)^31 is -2147483648; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"")
    assert((zero^0).asString, "1", "ZZ32 0^0 is 1; basic-integers.tex, section \"Integers\", opr ^")
    assert((mone^2147483647).asString, "-1", "ZZ32 (-1)^2147483647 is -1; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"")
    assert(overflows(fn () => n34 CHOOSE 17), "ZZ32 34 CHOOSE 17 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsections \"Multiplication, Division, Modulo, and Remainder Operators\" and \"GCD, LCM, and CHOOSE Operators\"")
    assert(overflows(fn () => maxI CHOOSE 2), "ZZ32 MAX CHOOSE 2 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsections \"Multiplication, Division, Modulo, and Remainder Operators\" and \"GCD, LCM, and CHOOSE Operators\"")
    assert((n33 CHOOSE 16).asString, "1166803110", "ZZ32 33 CHOOSE 16 is 1166803110; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsections \"Multiplication, Division, Modulo, and Remainder Operators\" and \"GCD, LCM, and CHOOSE Operators\"")
    assert((maxI CHOOSE 1).asString, "2147483647", "ZZ32 MAX CHOOSE 1 is 2147483647; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsections \"Multiplication, Division, Modulo, and Remainder Operators\" and \"GCD, LCM, and CHOOSE Operators\"")
    assert((maxI CHOOSE 2147483646).asString, "2147483647", "ZZ32 MAX CHOOSE (MAX-1) is 2147483647; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsections \"Multiplication, Division, Modulo, and Remainder Operators\" and \"GCD, LCM, and CHOOSE Operators\"")
    assert((three CHOOSE 5).asString, "0", "ZZ32 3 CHOOSE 5 is 0; basic-integers.tex, section \"Integers\", opr CHOOSE")
    assert((five CHOOSE (-1)).asString, "0", "ZZ32 5 CHOOSE -1 is 0; basic-integers.tex, section \"Integers\", opr CHOOSE")
    assert((mfive CHOOSE 2).asString, "0", "ZZ32 -5 CHOOSE 2 is 0; basic-integers.tex, section \"Integers\", opr CHOOSE")
    assert(overflows(fn () => twoL^63), "ZZ64 2^63 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"")
    assert(overflows(fn () => twoL^64), "ZZ64 2^64 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"")
    assert(overflows(fn () => threeL^40), "ZZ64 3^40 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"")
    assert((twoL^62).asString, "4611686018427387904", "ZZ64 2^62 is 4611686018427387904; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"")
    assert((mtwoL^63).asString, "-9223372036854775808", "ZZ64 (-2)^63 is -9223372036854775808; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"")
    assert(overflows(fn () => n67L CHOOSE 33), "ZZ64 67 CHOOSE 33 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsections \"Multiplication, Division, Modulo, and Remainder Operators\" and \"GCD, LCM, and CHOOSE Operators\"")
    assert(overflows(fn () => n68L CHOOSE 34), "ZZ64 68 CHOOSE 34 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsections \"Multiplication, Division, Modulo, and Remainder Operators\" and \"GCD, LCM, and CHOOSE Operators\"")
    assert((n62L CHOOSE 31).asString, "465428353255261088", "ZZ64 62 CHOOSE 31 is 465428353255261088; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsections \"Multiplication, Division, Modulo, and Remainder Operators\" and \"GCD, LCM, and CHOOSE Operators\"")
    assert((n66L CHOOSE 33).asString, "7219428434016265740", "ZZ64 66 CHOOSE 33 is 7219428434016265740; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsections \"Multiplication, Division, Modulo, and Remainder Operators\" and \"GCD, LCM, and CHOOSE Operators\"")
    assert((threeL CHOOSE 5).asString, "0", "ZZ64 3 CHOOSE 5 is 0; basic-integers.tex, section \"Integers\", opr CHOOSE")
    assert(overflows(fn () => twoTo31N LCM sevenN), "NN32 2^31 LCM 7 throws IntegerOverflow; opr-overview.tex, subsection \"GCD, LCM, and CHOOSE Operators\"; POSITIONS 2026-09-22, ledger row 334; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert(overflows(fn () => b16N LCM b16pN), "NN32 65536 LCM 65537 throws IntegerOverflow; opr-overview.tex, subsection \"GCD, LCM, and CHOOSE Operators\"; POSITIONS 2026-09-22, ledger row 334; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((twoTo31N LCM twoN).asString, "2147483648", "NN32 2^31 LCM 2 is 2147483648; opr-overview.tex, subsection \"GCD, LCM, and CHOOSE Operators\"; POSITIONS 2026-09-22, ledger row 334; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((maxN LCM oneN).asString, "4294967295", "NN32 MAX LCM 1 is 4294967295; opr-overview.tex, subsection \"GCD, LCM, and CHOOSE Operators\"; POSITIONS 2026-09-22, ledger row 334; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((sixN LCM fourN).asString, "12", "NN32 6 LCM 4 is 12; opr-overview.tex, subsection \"GCD, LCM, and CHOOSE Operators\"; POSITIONS 2026-09-22, ledger row 334; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert(overflows(fn () => n92683N CHOOSE twoN), "NN32 92683 CHOOSE 2 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsections \"Multiplication, Division, Modulo, and Remainder Operators\" and \"GCD, LCM, and CHOOSE Operators\"; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((n92682N CHOOSE twoN).asString, "4294930221", "NN32 92682 CHOOSE 2 is 4294930221; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsections \"Multiplication, Division, Modulo, and Remainder Operators\" and \"GCD, LCM, and CHOOSE Operators\"; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((b16N CHOOSE twoN).asString, "2147450880", "NN32 65536 CHOOSE 2 is 2147450880; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsections \"Multiplication, Division, Modulo, and Remainder Operators\" and \"GCD, LCM, and CHOOSE Operators\"; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((twoTo31N CHOOSE oneN).asString, "2147483648", "NN32 2^31 CHOOSE 1 is 2147483648; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsections \"Multiplication, Division, Modulo, and Remainder Operators\" and \"GCD, LCM, and CHOOSE Operators\"; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((threeN CHOOSE fiveN).asString, "0", "NN32 3 CHOOSE 5 is 0; basic-integers.tex, section \"Integers\", opr CHOOSE; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert(overflows(fn () => twoN^32), "NN32 2^32 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert(overflows(fn () => b16N^2), "NN32 65536^2 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((twoN^31).asString, "2147483648", "NN32 2^31 is 2147483648; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((m65535N^2).asString, "4294836225", "NN32 65535^2 is 4294836225; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((twoTo31N^1).asString, "2147483648", "NN32 (2^31)^1 is 2147483648; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert(overflows(fn () => twoTo63U LCM threeU), "NN64 2^63 LCM 3 throws IntegerOverflow; opr-overview.tex, subsection \"GCD, LCM, and CHOOSE Operators\"; POSITIONS 2026-09-22, ledger row 334; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((twoTo63U LCM twoU).asString, "9223372036854775808", "NN64 2^63 LCM 2 is 9223372036854775808; opr-overview.tex, subsection \"GCD, LCM, and CHOOSE Operators\"; POSITIONS 2026-09-22, ledger row 334; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((twoTo32U LCM (twoTo32U - oneU)).asString, "18446744069414584320", "NN64 2^32 LCM (2^32-1) is 18446744069414584320; opr-overview.tex, subsection \"GCD, LCM, and CHOOSE Operators\"; POSITIONS 2026-09-22, ledger row 334; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert(overflows(fn () => n68U CHOOSE n34U), "NN64 68 CHOOSE 34 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsections \"Multiplication, Division, Modulo, and Remainder Operators\" and \"GCD, LCM, and CHOOSE Operators\"; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((n67U CHOOSE n33U).asString, "14226520737620288370", "NN64 67 CHOOSE 33 is 14226520737620288370; basic-integers.tex, section \"Integers\", opr CHOOSE, opr-overview.tex, subsections \"Multiplication, Division, Modulo, and Remainder Operators\" and \"GCD, LCM, and CHOOSE Operators\"; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((threeU CHOOSE fiveU).asString, "0", "NN64 3 CHOOSE 5 is 0; basic-integers.tex, section \"Integers\", opr CHOOSE; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert(overflows(fn () => twoU^64), "NN64 2^64 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert(overflows(fn () => threeU^41), "NN64 3^41 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((twoU^63).asString, "9223372036854775808", "NN64 2^63 is 9223372036854775808; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"; POSITIONS 2026-09-26, the fifth batch-5 answer")
    assert((threeU^40).asString, "12157665459056928801", "NN64 3^40 is 12157665459056928801; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"; POSITIONS 2026-09-26, the fifth batch-5 answer")
    println("PASS")
  end

end

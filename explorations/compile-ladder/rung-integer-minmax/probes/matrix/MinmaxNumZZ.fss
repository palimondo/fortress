component MinmaxNumZZ
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    NN32 => "NN32"
    NN64 => "NN64"
    ZZ => "ZZ"
    QQ => "QQ"
    RR64 => "RR64"
    else => "other"
  end

run() = do
    b: ZZ = big(3)
    (p, q) = b MINMAX 1
    println("b MINMAX 1 = (" p ", " q ") : (" typeOf(p) ", " typeOf(q) ")")
end

end

(* Probe S: (a) what happens when Value omits opr - but the program uses
   the Vector's - ;  (b) in-place mutation v[i] := Value(...) . *)
component p28_minus_and_mutation
export Executable

object Value(data: RR64) extends Number
    getter asString(): String = "V(" data ")"
    opr +(self, other: Value): Value = Value(data + other.data)
    opr TIMES(self, other: Value): Value = Value(data other.data)
    opr juxtaposition(self, other: Value): Value = self TIMES other
end

run(): () = do
    u: Value[3] = [Value(1.0) Value(2.0) Value(3.0)]
    println("-- (b) mutation --")
    u[0] := Value(99.0)
    println("after u[0] := V(99.0): " u)
    println("-- (a) subtraction with no opr - on Value --")
    v: Value[3] = [Value(1.0) Value(1.0) Value(1.0)]
    println("u - v = " (u - v))
  end
end

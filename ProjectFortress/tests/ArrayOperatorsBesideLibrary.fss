component ArrayOperatorsBesideLibrary
import ArrayOperatorVocabulary.{...}
export Executable

check(name: String, got: RR64, want: RR64): () =
    if got = want then
        println(name " = " got)
    else
        println("fail " name ": got " got ", want " want)
    end

run(): () = do
    v = array[\RR64\](3).fill(fn (i: ZZ32): RR64 => 1.0 i - 1.0)
    check("(v MINMAX 0.0)[0]", (v MINMAX 0.0)[0], 0.0)
    check("(0.0 MINMAX v)[2]", (0.0 MINMAX v)[2], 1.0)

    m: Matrix[\RR64,2,2\] = matrix[\RR64,2,2\](0.0)
    m[0,0] := 1.0
    m[0,1] := 2.0
    m[1,0] := 3.0
    m[1,1] := 4.0
    t = array3[\RR64,2,2,2\]().fill(fn (ix: (ZZ32,ZZ32,ZZ32)): RR64 => do (p, i, j) = ix; 10.0 p end)
    check("(m + t)[1,0,1]", (m + t)[1,0,1], 12.0)
    check("(t + m)[1,1,0]", (t + m)[1,1,0], 13.0)
    check("(t t)[1,1,1]", (t t)[1,1,1], 100.0)
    check("(t m)[1,0,1]", (t m)[1,0,1], 20.0)

    check("(m + 1.0)[1,1]", (m + 1.0)[1,1], 5.0)
    check("(1.0 + m)[0,1]", (1.0 + m)[0,1], 3.0)
    check("(0.0 MAX v)[0]", (0.0 MAX v)[0], 0.0)
end

end

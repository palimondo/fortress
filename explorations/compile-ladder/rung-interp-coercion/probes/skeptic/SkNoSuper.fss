component SkNoSuper
export Executable

trait WideSuper end
trait Wide extends WideSuper excludes { Narrow }
  coerce(x: Narrow) = WideOf(x.small)
  getter big(): ZZ32
end
trait Narrow excludes { Wide }
  getter small(): ZZ32
end
object WideOf(b: ZZ32) extends Wide
  getter big(): ZZ32 = b
end
object NarrowOf(s: ZZ32) extends Narrow
  getter small(): ZZ32 = s
end

fsup(x: WideSuper): String = "fsup got a WideSuper"

run(): () = do
  println("fsup(NarrowOf(1)) = " fsup(NarrowOf(1)))
end
end

component FlatCall
export Executable

(* A flat two-level tower in the compiler prelude's shape (CompilerBuiltin.fss:506, :574, :659):
   siblings under a trait that carries no algebra, each self-typed trait at the leaf's own type,
   the siblings excluding each other, widening declared by a coerce clause on the wider type.
   The caller passes a Narrow where a Wide is declared. *)
trait Num excludes { String } end
trait Wide extends { Num, Equality[\Wide\] } excludes { Narrow }
  coerce(x: Narrow) = WideOf(x.small)
  getter big(): ZZ64
  opr =(self, other: Wide): Boolean = self.big = other.big
end
trait Narrow extends { Num, Equality[\Narrow\] } excludes { Wide }
  getter small(): ZZ32
  opr =(self, other: Narrow): Boolean = self.small = other.small
end
object WideOf(b: ZZ64) extends Wide
  getter big(): ZZ64 = b
end
object NarrowOf(s: ZZ32) extends Narrow
  getter small(): ZZ32 = s
end

f(x: Wide): String = "f(Wide) got " x.big

run(): () = do
  n = NarrowOf(3)
  println("control, a Wide:       " f(WideOf(widen(3))))
  println("a Narrow where a Wide is declared:")
  println(f(n))
end
end

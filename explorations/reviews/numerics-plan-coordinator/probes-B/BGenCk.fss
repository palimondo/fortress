component BGenCk
export Executable
(* evidence-B probe; the compiled checker over the one library.  vN = call binds
   untyped (no expected type); cN: String = vN then reveals the type inferred.
   aN: T = call gives the call an expected type. *)
object BoxT[\T\](v: ZZ32) end
inc[\T extends Integral[\T\]\](x: T): T = x + 1
twice[\T extends Integral[\T\]\](x: T, y: T): T = x + y
pick[\T\](x: T, y: T): T = x
idt[\T\](x: T): T = x
takes64(x: ZZ64): ZZ64 = x
scale64[\T\](b: BoxT[\T\], m: ZZ64): ZZ64 = m
scaleR[\T\](b: BoxT[\T\], m: RR64): RR64 = m
scaleT[\T\](b: BoxT[\T\], m: ZZ32): ZZ32 = m
retIdt(): ZZ64 = idt(3)
run(): () = do
    z: ZZ32 = 5
    l: ZZ64 = widen(z)
    u: NN32 = unsigned(z)
    v1 = inc(l)
    c1: String = v1
    v2 = inc(z)
    c2: String = v2
    v3 = inc(5)
    c3: String = v3
    v4 = inc(u)
    c4: String = v4
    v5 = inc(big(5))
    c5: String = v5
    v6 = twice(l, 3)
    c6: String = v6
    v7 = twice(l, z)
    c7: String = v7
    v8 = twice(3, 4)
    c8: String = v8
    v9 = pick(l, 3)
    c9: String = v9
    v10 = pick(3, 4)
    c10: String = v10
    v11 = idt(3)
    c11: String = v11
    a1: ZZ64 = idt(3)
    a2: RR64 = idt(3)
    a3: ZZ64 = takes64(idt(3))
    a4: ZZ64 = scale64(BoxT[\String\](2), 3)
    a5: RR64 = scaleR(BoxT[\String\](2), 3)
    a6: ZZ32 = scaleT(BoxT[\String\](2), 3)
    a7: ZZ64 = scale64(BoxT[\String\](2), z)
    a8: ZZ64 = scale64[\String\](BoxT[\String\](2), 3)
    a9: ZZ64 = idt(z)
    a10: ZZ64 = pick(l, 3)
    ()
  end
end

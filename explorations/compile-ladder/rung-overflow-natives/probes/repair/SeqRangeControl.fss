component SeqRangeControl
export Executable

run(): () = do
    println("REACHED")
    zLo: ZZ32 = 1
    narrowTop = seq(zLo:3)
    var narrowCount: ZZ32 = 0
    for i <- narrowTop do
        assert(i >= zLo, "ranges.tex:47")
        narrowCount += 1
    end
    assert(narrowCount = 3, "ranges.tex:47")
    lLo = widen(zLo)
    wideTop = seq(lLo:widen(3))
    var wideCount: ZZ32 = 0
    for i <- wideTop do
        assert(i >= lLo, "ranges.tex:47")
        wideCount += 1
    end
    assert(wideCount = 3, "ranges.tex:47")
    sLo: ZZ32 = 1
    stridedTop = seq(sLo:5:2)
    var stridedCount: ZZ32 = 0
    for i <- stridedTop do
        assert(i >= sLo, "ranges.tex:47, :54-56")
        stridedCount += 1
    end
    assert(stridedCount = 3, "ranges.tex:47, :54-56")
    println("PASS")
  end

end

(*******************************************************************************
    A top-level array literal whose size is not its declared type's is refused.
    variables.tex, section "Top-Level Variable Declarations": the static type
    of the initializer must be a subtype of the declared type.
 ******************************************************************************)
component TopLevelArrayLiteralSize
export Executable

shp: ZZ32[4] = [27 16 27]

run(): () = println(shp[1])

end

(* The compiled checker gives the body of a label expression no expected type, so a call that ends the body instantiates a type parameter only its result mentions at its bound Any, and the body is refused. *)
component XXXInferResultOnlyLabelBody
export Executable

stop[\T extends Any\](s: String): T = throw InvalidRange
giveUp(s: String): ZZ32 = label here
    stop(s)
  end here

run(): () = do
    println("PASS")
  end

end

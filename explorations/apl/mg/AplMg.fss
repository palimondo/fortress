(* AplMg -- the glue of the focused base.  Ten typed declarations in C4's own
   style over the library's own arrays; every one of them is checked against
   C4's Corpus object in ../probes-4b/y06_fold.out, part (B). *)
component AplMg
export AplMg
import FlatArrays.{...}

tally[\nat s\](v: Vector[\ZZ32,s\]): ZZ32 = |v|

iota(n: ZZ32): Array[\ZZ32,ZZ32\] = keys(n, fn (i: ZZ32): ZZ32 => i)

ravel[\nat r, nat c\](m: Matrix[\ZZ32,r,c\]): Array[\ZZ32,ZZ32\] = do
    (nr, nc) = m.sizes
    keys(nr nc, fn (i: ZZ32): ZZ32 => m[i DIV nc, i MOD nc])
  end
ravel[\nat r, nat c\](m: Matrix[\RR64,r,c\]): Array[\RR64,ZZ32\] = do
    (nr, nc) = m.sizes
    vec(nr nc, fn (i: ZZ32): RR64 => m[i DIV nc, i MOD nc])
  end

cols[\nat r, nat c, nat k\](m: Matrix[\ZZ32,r,c\], ks: Vector[\ZZ32,k\]): Array[\ZZ32,(ZZ32,ZZ32)\] = do
    (nr, nc) = m.sizes
    array[\ZZ32\](nr, |ks|).fill(fn (i: ZZ32, j: ZZ32): ZZ32 => m[i, ks[j]])
  end

gatherV[\nat s, nat k\](v: Vector[\ZZ32,s\], ks: Vector[\ZZ32,k\]): Array[\ZZ32,ZZ32\] =
    keys(|ks|, fn (i: ZZ32): ZZ32 => v[ks[i]])

outerGt[\nat s, nat k\](l: Vector[\ZZ32,s\], r: Vector[\ZZ32,k\]): Array[\RR64,(ZZ32,ZZ32)\] =
    mat(|l|, |r|, fn (i: ZZ32, j: ZZ32): RR64 => if l[i] > r[j] then 1.0 else 0.0 end)
outerGe[\nat s, nat k\](l: Vector[\ZZ32,s\], r: Vector[\ZZ32,k\]): Array[\RR64,(ZZ32,ZZ32)\] =
    mat(|l|, |r|, fn (i: ZZ32, j: ZZ32): RR64 => if l[i] >= r[j] then 1.0 else 0.0 end)
outerLt[\nat s, nat k\](l: Vector[\ZZ32,s\], r: Vector[\ZZ32,k\]): Array[\RR64,(ZZ32,ZZ32)\] =
    mat(|l|, |r|, fn (i: ZZ32, j: ZZ32): RR64 => if l[i] < r[j] then 1.0 else 0.0 end)

cycle[\nat s\](n: ZZ32, v: Vector[\ZZ32,s\]): Array[\ZZ32,ZZ32\] =
    keys(n, fn (i: ZZ32): ZZ32 => v[i MOD |v|])

opr +[\I\](s: ZZ32, a: Array[\ZZ32,I\]): Array[\ZZ32,I\] = a.map[\ZZ32\](fn (e: ZZ32): ZZ32 => s + e)

end

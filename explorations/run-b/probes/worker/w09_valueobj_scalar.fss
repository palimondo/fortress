component w09_valueobj_scalar
export Executable

value object VBox(d: Array[\RR64,ZZ32\], f: RR64 -> RR64)
end

value object P(x: RR64)
end

inc(x: RR64): RR64 = x + 1.0
dec(x: RR64): RR64 = x - 1.0

run(): () = do
    println("P(1.0) === P(1.0) : " (P(1.0) === P(1.0)))
    println("P(1.0) === P(2.0) : " (P(1.0) === P(2.0)))
    d: Array[\RR64,ZZ32\] = array[\RR64\](2)
    d[0] := 1.0
    d[1] := 2.0
    g: Array[\RR64,ZZ32\] = array[\RR64\](2)
    g[0] := 5.0
    g[1] := 6.0
    println("VBox(d,inc) === VBox(g,dec) : " (VBox(d,inc) === VBox(g,dec)))
    println("1.0 === 2.0 : " (1.0 === 2.0))
  end

end

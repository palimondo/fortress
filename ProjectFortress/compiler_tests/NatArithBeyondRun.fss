(* A size computed at instantiation beyond its kind, below 0 for a nat, is made today on the compiled path, where walk refuses it. *)
component NatArithBeyondRun
export Executable

object Box[\nat k\](v: ZZ32) end

sz64[\nat k\](b: Box[\k\]): ZZ64 = k

prev[\nat k\](): ZZ64 = sz64[\k - 1\](Box[\k - 1\](0))

run(): () = do
    println(prev[\0\]())
    println("PASS")
  end

end

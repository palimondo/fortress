(* An object that extends a generic trait at the static argument Any runs the trait's methods at Any. *)
component ExtendsGenericAtAnyWalk
export Executable

trait Holder[\T extends Any\]
  keep(x: T): T = x
  describe(): String
end

object AnyHolder extends Holder[\Any\]
  describe(): String = "any"
end

isZZ32(x: Any): Boolean = typecase x of
    ZZ32 => true
    else => false
  end

isString(x: Any): Boolean = typecase x of
    String => true
    else => false
  end

run(): () = do
  h = AnyHolder
  n: ZZ32 = 5
  assert(h.describe(), "any", "an object's own method; traits.tex, section \"Trait Declarations\"")
  assert(isZZ32(h.keep(n)), "the trait's method at T = Any keeps a ZZ32; traits.tex, section \"Trait Declarations\"")
  assert(isString(h.keep("s")), "the trait's method at T = Any keeps a String; traits.tex, section \"Trait Declarations\"")
  assert(NOT isZZ32(h.keep("s")), "a String kept at Any is no ZZ32; traits.tex, section \"Trait Declarations\"")
  println("PASS")
end

end

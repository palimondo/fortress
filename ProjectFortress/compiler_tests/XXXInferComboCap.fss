(* The coercion attempt refuses a call whose lone type parameters give more than 64 combinations of the types it chooses. *)
component XXXInferComboCap
export Executable

g4[\A, B, C, D\](a: A, b: B, c: C, d: D, m: ZZ64): ZZ64 = m + m

run(): () = do
    z: ZZ32 = 1
    println("g4(z, z, z, z, z): " || g4(z, z, z, z, z))
end

end

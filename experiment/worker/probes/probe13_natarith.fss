component probe13_natarith
import List.{...}
export Executable

(* nat arithmetic in types, generic objects with nat params, growing caches. *)
object V(x: RR64) end

object Layer[\nat d, nat f\](W_q: Array2[\V,0,d,0,d\], W_1: Array2[\V,0,f,0,d\])
  size(): ZZ32 = |W_1|
end

object Cache
  var keys: List[\Array1[\V,0,2\]\] := <|[\Array1[\V,0,2\]\] |>
  push(k: Array1[\V,0,2\]): () = do keys := keys.addRight(k) end
end

up[\nat d, nat f\](x: Array1[\V,0,d\], _: Array1[\V,0,f\]): Array1[\V,0,f\] = array1[\V,f\](fn (i: ZZ32) => x[i MOD d])

run(): () = do
  wq = array2[\V,3,3\]().fill(V(1.0))
  w1 = array2[\V,12,3\]().fill(V(2.0))
  layer = Layer[\3,12\](wq, w1)
  println("layer size " layer.size() " (expect 36)")
  x = array1[\V,3\](fn (i: ZZ32) => V(i))
  y = up(x, array1[\V,12\]())
  println("|up(x)| = " |y| " (expect 12) y[11] = " y[11].x " (expect 2)")
  c = Cache
  c.push(array1[\V,2\](fn (i: ZZ32) => V(i)))
  c.push(array1[\V,2\](fn (i: ZZ32) => V(10 + i)))
  println("cache size " |c.keys| " (expect 2) last " (c.keys[1])[1].x " (expect 11)")
  caches = array1[\Cache,2\](fn (i: ZZ32) => Cache)
  caches[1].push(array1[\V,2\](fn (i: ZZ32) => V(i)))
  println("caches[0] " |caches[0].keys| " caches[1] " |caches[1].keys| " (expect 0 1)")
end
end

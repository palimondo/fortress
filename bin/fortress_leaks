# Runs the Fortress shell with -Dfortress.test.leaks=t: after evaluation the
# interpreter resets its interned static type caches and then sleeps forever
# so you can attach jmap and take a heap snapshot to hunt leaks (see
# interpreter/evaluator/Init.allowForLeakChecks). Classpath comes from
# bin/fortress_classpath (the single place that knows toolchain versions).

export FORTRESS_HOME="`${0%fortress_leaks}fortress_home`"

CP="`"${FORTRESS_HOME}"/bin/fortress_classpath`"

if [ -z "$JAVA_HOME" ] ; then
  JAVACMD=java
else
  JAVACMD="$JAVA_HOME/bin/java"
fi

if [ -z "$JAVA_FLAGS" ] ; then
  JAVA_FLAGS="-Xmx256m  -Xss32m"
fi
JAVA_FLAGS="$JAVA_FLAGS -Dfile.encoding=UTF-8"

# -agentlib:hprof=doe=y,format=b,heap=dump

"$JAVACMD" $JAVA_FLAGS -cp "$CP" \
 -Dfortress.test.leaks=t \
com.sun.fortress.Shell "$@"

component CompCheck
import List.{...}
export Executable

(*) explorations/compile-ladder/rung-result-bounds/REPORT.md, section 6

object Pt(v: ZZ32) extends StandardMinMax[\Pt\]
    opr MINMAX(self, other: Pt): (Pt, Pt) =
        if other.v < v then (other, self) else (self, other) end
end

minOfPt(a: Pt, b: Pt): Pt = a MIN b
maxOfPt(a: Pt, b: Pt): Pt = a MAX b

pairsWritten(): List[\(ZZ32, ZZ32)\] = <|[\(ZZ32, ZZ32)\] (k, k) | k <- <|1, 2|> |>
pairsUnwritten(): List[\(ZZ32, ZZ32)\] = <| (k, k) | k <- <|1, 2|> |>
arrowsWritten(): List[\ZZ32 -> ZZ32\] = <|[\ZZ32 -> ZZ32\] (fn (y: ZZ32): ZZ32 => y + k) | k <- <|1, 2|> |>
numbersWritten(): List[\ZZ32\] = <|[\ZZ32\] k | k <- <|1, 2|> |>
numbersUnwritten(): List[\ZZ32\] = <| k | k <- <|1, 2|> |>

failAtZZ32(): ZZ32 = fail("a")
failAtTuple(): (ZZ32, ZZ32) = fail("b")
failAtArrow(): ZZ32 -> ZZ32 = fail("c")
failWrittenTuple(): (ZZ32, ZZ32) = fail[\(ZZ32, ZZ32)\]("d")
failInStatement(): () = do fail("e"); () end

run(): () = println "done"

end

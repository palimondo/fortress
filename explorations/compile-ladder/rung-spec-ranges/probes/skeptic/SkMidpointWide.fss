component SkMidpointWide
export Executable

mid(lo: ZZ32, hi: ZZ32): ZZ32 = lo + (hi - lo) DIV 2

run(): () = do
  top: ZZ32 = 2147483647
  bot: ZZ32 = -top - 1
  println("X1 halfway, bounds -1 and MAX: " (mid(-1, top)).asString)
  println("X2 bounds MIN and MAX, where hi - lo is beyond ZZ32: " (mid(bot, top)).asString)
end

end

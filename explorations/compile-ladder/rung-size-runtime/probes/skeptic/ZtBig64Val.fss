component ZtBig64Val
export Executable
object Box[\nat k\](v: ZZ32) end
vz[\nat k\](b: Box[\k\]): ZZ = (fn (): ZZ => (fn (): ZZ => k)())()
last64: ZZ64 := 0
set64(x: ZZ64): () = atomic do last64 := x end
v64[\nat k\](b: Box[\k\]): ZZ64 = do
  for i <- 0#1 do set64(k) end
  last64
end
run() = do
  println(v64(Box[\4294967296\](0)))
  println(v64(Box[\4611686018427387904\](0)))
  println(vz(Box[\18446744073709551616\](0)))
  println(vz(Box[\340282366920938463463374607431768211456\](0)))
end
end

component R2ChooseC
export Executable
cl(a: ZZ64, b: ZZ64): String = try "" || (a CHOOSE b) catch e IntegerOverflow => "OVF" end
cn(a: NN32, b: NN32): String = try "" || (a CHOOSE b) catch e IntegerOverflow => "OVF" end
cz(a: ZZ32, b: ZZ32): String = try "" || (a CHOOSE b) catch e IntegerOverflow => "OVF" end
run(): () = do
  println("l5 66 CHOOSE 33 = " || cl(widen(66), widen(33)))
  println("l6 67 CHOOSE 33 = " || cl(widen(67), widen(33)))
  r3: NN32 = unsigned(92682) CHOOSE unsigned(2)
  e3: NN32 = unsigned(2147465110) + unsigned(2147465111)
  println("n3 92682 CHOOSE 2 = 4294930221: " || (r3 = e3))
  println("n4 92683 CHOOSE 2 = " || cn(unsigned(92683), unsigned(2)))
  println("e7 34 CHOOSE 17 = " || cz(34, 17))
  println("e8 2147483647 CHOOSE 2147483646 = " || cz(2147483647, 2147483646))
  println("e9 2147483647 CHOOSE 2 = " || cz(2147483647, 2))
  println("e10 65536 CHOOSE 2 = " || cz(65536, 2))
  println("e11 65537 CHOOSE 2 = " || cz(65537, 2))
  println("END")
end
end

component PZ3
export Executable
run(): () = do
  a: ZZ64 = 3000000000
  println(a + a)
  u: NN32 = 7
  println(u + u)
  r: RR64 = 1.5
  println(r r + 0.25)
  println(r < 2.0)
  f: RR32 = 2.5
  println(f + f)
  z: ZZ = 123456789012345678901234567890
  println(z + z)
  n: NN64 = 5
  println(n + n)
  k: ZZ32 = 3
  println(k.asRR64() + r)
end
end

--- /dev/null
+++ b/ProjectFortress/src-one/com/sun/fortress/compiler/runtimeValues/LibraryNames.java
@@ -0,0 +1,15 @@
+// PROBE Y: the names that the run time takes from the library that the run selected.
+// This is the one library's copy; ProjectFortress/src holds the prelude's.
+package com.sun.fortress.compiler.runtimeValues;
+
+public final class LibraryNames {
+    public static final String LIBRARY = "one";
+    /** The class of a Fortress exception that a helper raises, written by its prelude name. */
+    // PROBE Y HACK: the helpers' 99 raise strings stay the prelude's and are mapped here; all of them are
+    // FortressLibrary's in the one library (switch-rehearsal.md, W2).
+    public static String exceptionClass(String preludeName) {
+        for (String p : new String[] { "fortress.CompilerBuiltin$", "fortress.CompilerLibrary$" })
+            if (preludeName.startsWith(p)) return "fortress.FortressLibrary$" + preludeName.substring(p.length());
+        return preludeName;
+    }
+}

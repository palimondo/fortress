component WalkIdentityValues
export Executable

(* The two identity functions' values under walk, reached through an empty SUM or PROD
   (they have no api declaration), printed with their run-time types, for every leaf. *)
shown(v: Any): String = v.asString || " : " || v.ilkName

run(): () = do
  none: Array[\RR64,ZZ32\] = array[\RR64\](0)
  println("SUM[ZZ32]  empty " || shown(SUM[\ZZ32\][j <- 0#0] j))
  println("SUM[ZZ64]  empty " || shown(SUM[\ZZ64\][j <- 0#0] widen(j)))
  println("SUM[NN32]  empty " || shown(SUM[\NN32\][j <- 0#0] unsigned(j)))
  println("SUM[NN64]  empty " || shown(SUM[\NN64\][j <- 0#0] widen(unsigned(j))))
  println("SUM[ZZ]    empty " || shown(SUM[\ZZ\][j <- 0#0] big(j)))
  println("SUM[QQ]    empty " || shown(SUM[\QQ\][j <- 0#0] big(j)/big(1)))
  println("SUM[RR32]  empty " || shown(SUM[\RR32\][j <- 0#0] narrow(asFloat(j))))
  println("SUM[RR64]  empty " || shown(SUM[\RR64\][j <- 0#0] asFloat(j)))
  println("SUM a      empty " || shown(SUM none))
  println("PROD[ZZ32] empty " || shown(PROD[\ZZ32\][j <- 1#0] j))
  println("PROD[ZZ64] empty " || shown(PROD[\ZZ64\][j <- 1#0] widen(j)))
  println("PROD[NN32] empty " || shown(PROD[\NN32\][j <- 1#0] unsigned(j)))
  println("PROD[NN64] empty " || shown(PROD[\NN64\][j <- 1#0] widen(unsigned(j))))
  println("PROD[ZZ]   empty " || shown(PROD[\ZZ\][j <- 1#0] big(j)))
  println("PROD[QQ]   empty " || shown(PROD[\QQ\][j <- 1#0] big(j)/big(1)))
  println("PROD[RR32] empty " || shown(PROD[\RR32\][j <- 1#0] narrow(asFloat(j))))
  println("PROD[RR64] empty " || shown(PROD[\RR64\][j <- 1#0] asFloat(j)))
  println("PROD a     empty " || shown(PROD[\RR64\][t <- none] t))
  println("SUM[ZZ32]  1#3   " || shown(SUM[\ZZ32\][j <- 1#3] j))
  println("SUM[RR64]  1#3   " || shown(SUM[\RR64\][j <- 1#3] asFloat(j)))
end
end

component TcNested
export Executable

trait Wide excludes { Narrow }
  coerce(x: Narrow) = WideOf(x.small)
  getter big(): ZZ32
end
trait Narrow excludes { Wide }
  getter small(): ZZ32
end
object WideOf(b: ZZ32) extends Wide
  getter big(): ZZ32 = b
end
object NarrowOf(s: ZZ32) extends Narrow
  getter small(): ZZ32 = s
end



run() = do
    nested: ((Wide, ZZ32), ZZ32) = ((WideOf(1), 2), 3)
    (n1, nc) = nested
    (na, nb) = n1
    println("nested: na.big = " na.big " nb = " nb " nc = " nc)
  end

end

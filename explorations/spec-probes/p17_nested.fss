component p17_nested
import List.{...}
export Executable
run() = do
  m0 = <|[\ZZ32\] 1, 2|>; m1 = <|[\ZZ32\] 3, 4|>
  a = <|[\List[\ZZ32\]\] m0, m1|>
  b = <|[\List[\ZZ32\]\] <|[\ZZ32\] 5, 6|>|>
  mats = <|[\List[\List[\ZZ32\]\]\] a, b|>
  (* the file's run() flattens this with three nested for-loops and
     psL := psL.addRight(q); the file's own concat() at line 175 already
     uses a nested generator clause list. *)
  flat = <|[\ZZ32\] q | mm <- seq(mats), row <- seq(mm), q <- seq(row)|>
  println("flat = " flat)
end
end

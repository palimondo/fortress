component SkSzIn
export Executable
object Box[\nat k\](v: ZZ32) end
object IBox[\int i\](v: ZZ32) end
natv[\nat k\](b: Box[\k\]): ZZ64 = k
intv[\int i\](b: IBox[\i\]): ZZ64 = i
natw[\nat k\](): ZZ64 = k
intw[\int i\](): ZZ64 = i
d(b: Box[\2147483648\]): String = "d2^31"
d(b: Box[\4294967295\]): String = "dMax"
d(x: Any): String = "dOther"
e(b: IBox[\2147483647\]): String = "eMax"
e(b: IBox[\0\]): String = "eZero"
e(x: Any): String = "eOther"
run(): () = do
  println("v1 " || natv(Box[\2147483647\](0)))
  println("v2 " || natv(Box[\2147483648\](0)))
  println("v3 " || natv(Box[\4294967295\](0)))
  println("w1 " || natw[\2147483648\]())
  println("w2 " || natw[\4294967295\]())
  println("w3 " || natw[\0\]())
  println("i1 " || intv(IBox[\2147483647\](0)))
  println("i2 " || intw[\2147483647\]())
  a: Any = Box[\2147483648\](0)
  println("d1 " || d(a))
  b: Any = Box[\4294967295\](0)
  println("d2 " || d(b))
  c: Any = Box[\4294967294\](0)
  println("d3 " || d(c))
  ib: Any = IBox[\2147483647\](0)
  println("e1 " || e(ib))
  ic: Any = IBox[\0\](0)
  println("e2 " || e(ic))
  t1 = typecase a of
         Box[\2147483648\] => "match"
         else => "no"
       end
  println("t1 " || t1)
  t2 = typecase b of
         Box[\2147483648\] => "match"
         else => "no"
       end
  println("t2 " || t2)
  t3 = typecase b of
         Box[\4294967295\] => "match"
         else => "no"
       end
  println("t3 " || t3)
  println("END")
end
end

(* Probe, point 2: a typecase whose arms are pairs that hold self, returned at a pair of the self-type parameter. *)
component ProbeTupleArmsTypecaseSelfType
export Executable

trait Tord[\T extends Tord[\T\]\]
    lt(self, other: T): Boolean
    tc(self, x: Any, other: T): (T, T) = typecase x of
        s: String => (other, self)
        else => (self, other)
      end
end

object Num(v: ZZ32) extends Tord[\Num\]
    lt(self, other: Num): Boolean = v < other.v
end

run(): () = do
    println("REACHED")
    (a, b) = tc(Num(7), "s", Num(5))
    assert(a.v, 5, "String arm, first element")
    assert(b.v, 7, "String arm, second element: self")
    (c, d) = tc(Num(7), 3, Num(5))
    assert(c.v, 7, "else arm, first element: self")
    assert(d.v, 5, "else arm, second element")
    println("PASS")
  end

end

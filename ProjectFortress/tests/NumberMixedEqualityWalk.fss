    assert(r0 = 0, "numbers.tex, section \"Rational Numbers\", and conversions-coercions.tex, section \"Coercion Resolution\": RR64 coerces from NaturalNumeral, so the two compare at RR64; an RR64 and a numeral of one value are equal, the RR64 first")
    assert(0 = r0, "numbers.tex, section \"Rational Numbers\", and conversions-coercions.tex, section \"Coercion Resolution\": RR64 coerces from NaturalNumeral, so the two compare at RR64; a numeral and an RR64 of one value are equal, the numeral first")

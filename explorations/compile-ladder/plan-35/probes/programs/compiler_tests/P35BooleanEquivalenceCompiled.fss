(* The logical equivalence of two booleans, written a EQV b or with the operator IDENTICAL TO, is true where they are equal. *)
component P35BooleanEquivalenceCompiled
export Executable

run(): () = do
  t: Boolean = true
  f: Boolean = false
  assert(t ≡ t, "booleans.tex, opr EQV: true EQV true")
  assert(NOT (t EQV f), "booleans.tex, opr EQV: true EQV false")
  println("PASS")
end

end

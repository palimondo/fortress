component SolverResultOnly
export Executable
(* The solver's two behaviours for a type parameter that only the result mentions, compiled against
   the compiler library: bounded by Any and by Object, with an expected type and without one. A
   declaration whose result is written as the type Seen reports the type the call inferred. *)
object Seen end
object BoxT[\T\](v: ZZ32) end
object BoxA[\T extends Any\](v: ZZ32) end
fAny[\T extends Any\](): T = throw InvalidRange
fObj[\T extends Object\](): T = throw InvalidRange
bAny[\T extends Any\](): BoxA[\T\] = BoxA[\T\](0)
bObj[\T extends Object\](): BoxT[\T\] = BoxT[\T\](0)
s1(): () = do x = fAny(); () end
s2(): () = do x = fObj(); () end
s3(): () = do x = bAny(); () end
s4(): () = do x = bObj(); () end
c1(): ZZ32 = fAny()
c2(): ZZ32 = fObj()
c3(): Seen = bAny()
c4(): Seen = bObj()
run(): () = ()
end

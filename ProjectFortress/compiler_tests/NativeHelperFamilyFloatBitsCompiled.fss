(* On the compiled path, the simpleDoubleArith helpers that Float's bit, neighbour, narrowing, inequality, MIN, MAX and directed-rounding bindings and fromRawBits name give their values at zeros, large values, the smallest subnormal, the infinities and NaN. *)
component NativeHelperFamilyFloatBitsCompiled
export Executable

dToString(a:RR64):JavaString = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleToString")
dNeg(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleNeg")
dSub(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSub")
dMul(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleMul")
dDiv(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleDiv")
dPow(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doublePow")
fToD(a:RR32):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.floatToDouble")

dIsNaN(a:RR64):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleIsNaN")
dIsInfinite(a:RR64):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleIsInfinite")
dRawBits(a:RR64):ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleRawBits")
dNextUp(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleNextUp")
dNextDown(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleNextDown")
dToFloat(a:RR64):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleToFloat")
dNE(a:RR64, b:RR64):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleNE")
dMin(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleMin")
dMax(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleMax")
dAddUpNoNaN(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleAddUpNoNaN")
dSubUpNoNaN(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSubUpNoNaN")
dMulUpNoNaN(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleMulUpNoNaN")
dDivUpNoNaN(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleDivUpNoNaN")
dSqrtUp(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSqrtUp")
dAddDownNoNaN(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleAddDownNoNaN")
dSubDownNoNaN(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSubDownNoNaN")
dMulDownNoNaN(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleMulDownNoNaN")
dDivDownNoNaN(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleDivDownNoNaN")
dSqrtDown(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSqrtDown")
dAddUp(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleAddUp")
dSubUp(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSubUp")
dMulUp(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleMulUp")
dDivUp(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleDivUp")
dAddDown(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleAddDown")
dSubDown(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSubDown")
dMulDown(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleMulDown")
dDivDown(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleDivDown")
dFromRawBits(a:ZZ64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleFromRawBits")

run():() = do
  z: RR64 = 0.0
  nz: RR64 = dNeg(z)
  one: RR64 = 1.0
  two: RR64 = 2.0
  three: RR64 = 3.0
  a: RR64 = 2.5
  b: RR64 = dNeg(0.75)
  p1: RR64 = 0.1
  p2: RR64 = 0.2
  large: RR64 = 1000000000000000000000.0
  huge: RR64 = dMul(dMul(large, large), dMul(large, large))
  huge2: RR64 = dMul(huge, huge)
  inf: RR64 = dMul(dMul(huge, huge), dMul(huge, huge))
  ninf: RR64 = dNeg(inf)
  nan: RR64 = dDiv(z, z)
  tiny: RR64 = dPow(two, dNeg(1074.0))
  ntiny: RR64 = dNeg(tiny)
  maxNeg: ZZ64 = -9223372036854775807
  minZZ64: ZZ64 = maxNeg - 1

  assert(dToString(tiny) = "4.9E-324", "the smallest subnormal")
  assert(dToString(huge2) = "1.0000000000000001E168", "1.0E84 times 1.0E84")

  assert(NOT dIsNaN(z), "dIsNaN of 0.0")
  assert(NOT dIsNaN(nz), "dIsNaN of -0.0")
  assert(NOT dIsNaN(one), "dIsNaN of 1.0")
  assert(NOT dIsNaN(large), "dIsNaN of a large value")
  assert(NOT dIsNaN(tiny), "dIsNaN of the smallest subnormal")
  assert(NOT dIsNaN(inf), "dIsNaN of infinity")
  assert(NOT dIsNaN(ninf), "dIsNaN of -infinity")
  assert(dIsNaN(nan), "dIsNaN of 0.0 / 0.0")
  assert(dIsNaN(dSub(inf, inf)), "dIsNaN of infinity - infinity")
  assert(NOT dIsInfinite(z), "dIsInfinite of 0.0")
  assert(NOT dIsInfinite(nz), "dIsInfinite of -0.0")
  assert(NOT dIsInfinite(b), "dIsInfinite of -0.75")
  assert(NOT dIsInfinite(large), "dIsInfinite of a large value")
  assert(NOT dIsInfinite(tiny), "dIsInfinite of the smallest subnormal")
  assert(dIsInfinite(inf), "dIsInfinite of infinity")
  assert(dIsInfinite(ninf), "dIsInfinite of -infinity")
  assert(dIsInfinite(dMul(huge2, huge2)), "dIsInfinite of an overflow")
  assert(NOT dIsInfinite(nan), "dIsInfinite of NaN")

  assert(dRawBits(z) = 0, "dRawBits of 0.0")
  assert(dRawBits(nz) = minZZ64, "dRawBits of -0.0")
  assert(dRawBits(one) = 4607182418800017408, "dRawBits of 1.0")
  assert(dRawBits(a) = 4612811918334230528, "dRawBits of 2.5")
  assert(dRawBits(b) = -4618441417868443648, "dRawBits of -0.75")
  assert(dRawBits(p1) = 4591870180066957722, "dRawBits of 0.1")
  assert(dRawBits(large) = 4921056587992461136, "dRawBits of a large value")
  assert(dRawBits(tiny) = 1, "dRawBits of the smallest subnormal")
  assert(dRawBits(inf) = 9218868437227405312, "dRawBits of infinity")
  assert(dRawBits(ninf) = -4503599627370496, "dRawBits of -infinity")
  assert(dIsNaN(dFromRawBits(dRawBits(nan))), "dRawBits of NaN, read back")

  assert(dToString(dNextUp(z)) = "4.9E-324", "dNextUp of 0.0")
  assert(dToString(dNextUp(one)) = "1.0000000000000002", "dNextUp of 1.0")
  assert(dToString(dNextUp(a)) = "2.5000000000000004", "dNextUp of 2.5")
  assert(dToString(dNextUp(b)) = "-0.7499999999999999", "dNextUp of -0.75")
  assert(dToString(dNextUp(large)) = "1.0000000000000001E21", "dNextUp of a large value")
  assert(dToString(dNextUp(tiny)) = "9.9E-324", "dNextUp of the smallest subnormal")
  assert(dToString(dNextUp(ntiny)) = "-0.0", "dNextUp of minus the smallest subnormal")
  assert(dToString(dNextUp(inf)) = "Infinity", "dNextUp of infinity")
  assert(dToString(dNextUp(ninf)) = "-1.7976931348623157E308", "dNextUp of -infinity")
  assert(dToString(dNextUp(nan)) = "NaN", "dNextUp of NaN")
  assert(dToString(dNextDown(one)) = "0.9999999999999999", "dNextDown of 1.0")
  assert(dToString(dNextDown(a)) = "2.4999999999999996", "dNextDown of 2.5")
  assert(dToString(dNextDown(b)) = "-0.7500000000000001", "dNextDown of -0.75")
  assert(dToString(dNextDown(large)) = "9.999999999999999E20", "dNextDown of a large value")
  assert(dToString(dNextDown(tiny)) = "0.0", "dNextDown of the smallest subnormal")
  assert(dToString(dNextDown(nz)) = "-4.9E-324", "dNextDown of -0.0")
  assert(dToString(dNextDown(inf)) = "1.7976931348623157E308", "dNextDown of infinity")
  assert(dToString(dNextDown(ninf)) = "-Infinity", "dNextDown of -infinity")
  assert(dToString(dNextDown(nan)) = "NaN", "dNextDown of NaN")

  assert(dToString(fToD(dToFloat(a))) = "2.5", "dToFloat of 2.5")
  assert(dToString(fToD(dToFloat(b))) = "-0.75", "dToFloat of -0.75")
  assert(dToString(fToD(dToFloat(p1))) = "0.10000000149011612", "dToFloat of 0.1")
  assert(dToString(fToD(dToFloat(z))) = "0.0", "dToFloat of 0.0")
  assert(dToString(fToD(dToFloat(nz))) = "-0.0", "dToFloat of -0.0")
  assert(dToString(fToD(dToFloat(large))) = "1.0000000200408773E21", "dToFloat of a large value")
  assert(dToString(fToD(dToFloat(huge))) = "Infinity", "dToFloat of 1.0E84 overflows")
  assert(dToString(fToD(dToFloat(tiny))) = "0.0", "dToFloat of the smallest subnormal underflows")
  assert(dToString(fToD(dToFloat(inf))) = "Infinity", "dToFloat of infinity")
  assert(dToString(fToD(dToFloat(ninf))) = "-Infinity", "dToFloat of -infinity")
  assert(dToString(fToD(dToFloat(nan))) = "NaN", "dToFloat of NaN")

  assert(dNE(a, b), "dNE")
  assert(NOT dNE(a, a), "dNE of equal values")
  assert(NOT dNE(z, nz), "dNE of 0.0 and -0.0")
  assert(NOT dNE(inf, inf), "dNE of infinities")
  assert(dNE(inf, ninf), "dNE of infinity and -infinity")
  assert(dNE(large, inf), "dNE of a large value and infinity")
  assert(dNE(tiny, z), "dNE of the smallest subnormal and 0.0")
  assert(NOT dNE(tiny, tiny), "dNE of the smallest subnormal and itself")

  assert(dToString(dMin(a, b)) = "-0.75", "dMin")
  assert(dToString(dMin(b, a)) = "-0.75", "dMin, swapped")
  assert(dToString(dMin(z, nz)) = "-0.0", "dMin of 0.0 and -0.0")
  assert(dToString(dMin(nz, z)) = "-0.0", "dMin of -0.0 and 0.0")
  assert(dToString(dMin(large, inf)) = "1.0E21", "dMin of a large value and infinity")
  assert(dToString(dMin(ninf, b)) = "-Infinity", "dMin of -infinity and b")
  assert(dToString(dMin(tiny, z)) = "0.0", "dMin of the smallest subnormal and 0.0")
  assert(dToString(dMax(a, b)) = "2.5", "dMax")
  assert(dToString(dMax(b, a)) = "2.5", "dMax, swapped")
  assert(dToString(dMax(z, nz)) = "0.0", "dMax of 0.0 and -0.0")
  assert(dToString(dMax(nz, z)) = "0.0", "dMax of -0.0 and 0.0")
  assert(dToString(dMax(nz, nz)) = "-0.0", "dMax of -0.0 and -0.0")
  assert(dToString(dMax(large, inf)) = "Infinity", "dMax of a large value and infinity")
  assert(dToString(dMax(ninf, b)) = "-0.75", "dMax of -infinity and b")
  assert(dToString(dMax(tiny, z)) = "4.9E-324", "dMax of the smallest subnormal and 0.0")

  assert(dToString(dAddUpNoNaN(p1, p2)) = "0.30000000000000004", "dAddUpNoNaN, inexact")
  assert(dToString(dAddUpNoNaN(one, two)) = "3.0", "dAddUpNoNaN, exact")
  assert(dToString(dAddUpNoNaN(large, one)) = "1.0000000000000001E21", "dAddUpNoNaN of a large value and 1")
  assert(dToString(dAddUpNoNaN(tiny, one)) = "1.0000000000000002", "dAddUpNoNaN of the smallest subnormal and 1")
  assert(dToString(dAddUpNoNaN(tiny, tiny)) = "9.9E-324", "dAddUpNoNaN of two smallest subnormals")
  assert(dToString(dAddUpNoNaN(z, nz)) = "0.0", "dAddUpNoNaN of 0.0 and -0.0")
  assert(dToString(dAddUpNoNaN(nz, nz)) = "-0.0", "dAddUpNoNaN of -0.0 and -0.0")
  assert(dToString(dAddUpNoNaN(inf, one)) = "Infinity", "dAddUpNoNaN of infinity and 1")
  assert(dToString(dAddUpNoNaN(inf, ninf)) = "Infinity", "dAddUpNoNaN of infinity and -infinity")
  assert(dToString(dAddUpNoNaN(nan, one)) = "NaN", "dAddUpNoNaN of NaN and 1")
  assert(dToString(dAddDownNoNaN(p1, p2)) = "0.3", "dAddDownNoNaN, inexact")
  assert(dToString(dAddDownNoNaN(one, two)) = "3.0", "dAddDownNoNaN, exact")
  assert(dToString(dAddDownNoNaN(large, one)) = "1.0E21", "dAddDownNoNaN of a large value and 1")
  assert(dToString(dAddDownNoNaN(tiny, one)) = "1.0", "dAddDownNoNaN of the smallest subnormal and 1")
  assert(dToString(dAddDownNoNaN(z, nz)) = "-0.0", "dAddDownNoNaN of 0.0 and -0.0")
  assert(dToString(dAddDownNoNaN(ninf, one)) = "-Infinity", "dAddDownNoNaN of -infinity and 1")
  assert(dToString(dAddDownNoNaN(inf, ninf)) = "-Infinity", "dAddDownNoNaN of infinity and -infinity")
  assert(dToString(dAddDownNoNaN(nan, one)) = "NaN", "dAddDownNoNaN of NaN and 1")
  assert(dToString(dSubUpNoNaN(one, p1)) = "0.9", "dSubUpNoNaN, inexact")
  assert(dToString(dSubUpNoNaN(one, two)) = "-1.0", "dSubUpNoNaN, exact")
  assert(dToString(dSubUpNoNaN(large, one)) = "1.0E21", "dSubUpNoNaN of a large value and 1")
  assert(dToString(dSubUpNoNaN(one, tiny)) = "1.0", "dSubUpNoNaN of 1 and the smallest subnormal")
  assert(dToString(dSubUpNoNaN(z, z)) = "0.0", "dSubUpNoNaN of 0.0 and 0.0")
  assert(dToString(dSubUpNoNaN(nz, nz)) = "0.0", "dSubUpNoNaN of -0.0 and -0.0")
  assert(dToString(dSubUpNoNaN(ninf, one)) = "-Infinity", "dSubUpNoNaN of -infinity and 1")
  assert(dToString(dSubUpNoNaN(inf, inf)) = "Infinity", "dSubUpNoNaN of infinities")
  assert(dToString(dSubUpNoNaN(nan, one)) = "NaN", "dSubUpNoNaN of NaN and 1")
  assert(dToString(dSubDownNoNaN(one, p1)) = "0.8999999999999999", "dSubDownNoNaN, inexact")
  assert(dToString(dSubDownNoNaN(one, two)) = "-1.0", "dSubDownNoNaN, exact")
  assert(dToString(dSubDownNoNaN(large, one)) = "9.999999999999999E20", "dSubDownNoNaN of a large value and 1")
  assert(dToString(dSubDownNoNaN(one, tiny)) = "0.9999999999999999", "dSubDownNoNaN of 1 and the smallest subnormal")
  assert(dToString(dSubDownNoNaN(z, z)) = "-0.0", "dSubDownNoNaN of 0.0 and 0.0")
  assert(dToString(dSubDownNoNaN(tiny, tiny)) = "-0.0", "dSubDownNoNaN of two smallest subnormals")
  assert(dToString(dSubDownNoNaN(inf, inf)) = "-Infinity", "dSubDownNoNaN of infinities")
  assert(dToString(dSubDownNoNaN(nan, one)) = "NaN", "dSubDownNoNaN of NaN and 1")

  assert(dToString(dMulUpNoNaN(p1, p2)) = "0.020000000000000004", "dMulUpNoNaN, inexact")
  assert(dToString(dMulUpNoNaN(two, three)) = "6.0", "dMulUpNoNaN, exact")
  assert(dToString(dMulUpNoNaN(a, b)) = "-1.875", "dMulUpNoNaN of a and b")
  assert(dToString(dMulUpNoNaN(tiny, tiny)) = "4.9E-324", "dMulUpNoNaN of two smallest subnormals")
  assert(dToString(dMulUpNoNaN(large, tiny)) = "4.9406564584124654E-303", "dMulUpNoNaN of a large value and the smallest subnormal")
  assert(dToString(dMulUpNoNaN(huge2, huge2)) = "Infinity", "dMulUpNoNaN overflows")
  assert(dToString(dMulUpNoNaN(z, nz)) = "-0.0", "dMulUpNoNaN of 0.0 and -0.0")
  assert(dToString(dMulUpNoNaN(nz, nz)) = "0.0", "dMulUpNoNaN of -0.0 and -0.0")
  assert(dToString(dMulUpNoNaN(inf, b)) = "-Infinity", "dMulUpNoNaN of infinity and b")
  assert(dToString(dMulUpNoNaN(inf, z)) = "Infinity", "dMulUpNoNaN of infinity and 0.0")
  assert(dToString(dMulUpNoNaN(nan, one)) = "NaN", "dMulUpNoNaN of NaN and 1")
  assert(dToString(dMulDownNoNaN(p1, p2)) = "0.02", "dMulDownNoNaN, inexact")
  assert(dToString(dMulDownNoNaN(two, three)) = "6.0", "dMulDownNoNaN, exact")
  assert(dToString(dMulDownNoNaN(tiny, tiny)) = "0.0", "dMulDownNoNaN of two smallest subnormals")
  assert(dToString(dMulDownNoNaN(huge2, huge2)) = "1.7976931348623157E308", "dMulDownNoNaN overflows to the largest finite value")
  assert(dToString(dMulDownNoNaN(z, nz)) = "-0.0", "dMulDownNoNaN of 0.0 and -0.0")
  assert(dToString(dMulDownNoNaN(inf, z)) = "0.0", "dMulDownNoNaN of infinity and 0.0")
  assert(dToString(dMulDownNoNaN(ninf, one)) = "-Infinity", "dMulDownNoNaN of -infinity and 1")
  assert(dToString(dMulDownNoNaN(nan, one)) = "NaN", "dMulDownNoNaN of NaN and 1")
  assert(dToString(dDivUpNoNaN(one, three)) = "0.33333333333333337", "dDivUpNoNaN, inexact")
  assert(dToString(dDivUpNoNaN(one, two)) = "0.5", "dDivUpNoNaN, exact")
  assert(dToString(dDivUpNoNaN(a, b)) = "-3.333333333333333", "dDivUpNoNaN of a and b")
  assert(dToString(dDivUpNoNaN(tiny, two)) = "4.9E-324", "dDivUpNoNaN of the smallest subnormal by 2")
  assert(dToString(dDivUpNoNaN(large, tiny)) = "Infinity", "dDivUpNoNaN overflows")
  assert(dToString(dDivUpNoNaN(z, two)) = "0.0", "dDivUpNoNaN of 0.0 by 2")
  assert(dToString(dDivUpNoNaN(nz, two)) = "-0.0", "dDivUpNoNaN of -0.0 by 2")
  assert(dToString(dDivUpNoNaN(inf, inf)) = "Infinity", "dDivUpNoNaN of infinities")
  assert(dToString(dDivUpNoNaN(inf, ninf)) = "-0.0", "dDivUpNoNaN of infinity and -infinity")
  assert(dToString(dDivUpNoNaN(nan, one)) = "NaN", "dDivUpNoNaN of NaN by 1")
  assert(dToString(dDivDownNoNaN(one, three)) = "0.3333333333333333", "dDivDownNoNaN, inexact")
  assert(dToString(dDivDownNoNaN(one, two)) = "0.5", "dDivDownNoNaN, exact")
  assert(dToString(dDivDownNoNaN(a, b)) = "-3.3333333333333335", "dDivDownNoNaN of a and b")
  assert(dToString(dDivDownNoNaN(tiny, two)) = "0.0", "dDivDownNoNaN of the smallest subnormal by 2")
  assert(dToString(dDivDownNoNaN(large, tiny)) = "1.7976931348623157E308", "dDivDownNoNaN overflows to the largest finite value")
  assert(dToString(dDivDownNoNaN(inf, inf)) = "0.0", "dDivDownNoNaN of infinities")
  assert(dToString(dDivDownNoNaN(inf, ninf)) = "-Infinity", "dDivDownNoNaN of infinity and -infinity")
  assert(dToString(dDivDownNoNaN(nan, one)) = "NaN", "dDivDownNoNaN of NaN by 1")

  assert(dToString(dSqrtUp(a)) = "1.5811388300841898", "dSqrtUp, inexact")
  assert(dToString(dSqrtUp(6.25)) = "2.5", "dSqrtUp, exact")
  assert(dToString(dSqrtUp(two)) = "1.4142135623730951", "dSqrtUp of 2")
  assert(dToString(dSqrtUp(z)) = "0.0", "dSqrtUp of 0.0")
  assert(dToString(dSqrtUp(nz)) = "-0.0", "dSqrtUp of -0.0")
  assert(dToString(dSqrtUp(tiny)) = "2.2227587494850775E-162", "dSqrtUp of the smallest subnormal")
  assert(dToString(dSqrtUp(large)) = "3.1622776601683796E10", "dSqrtUp of a large value")
  assert(dToString(dSqrtUp(inf)) = "Infinity", "dSqrtUp of infinity")
  assert(dToString(dSqrtUp(b)) = "NaN", "dSqrtUp of a negative")
  assert(dToString(dSqrtUp(ninf)) = "NaN", "dSqrtUp of -infinity")
  assert(dToString(dSqrtUp(nan)) = "NaN", "dSqrtUp of NaN")
  assert(dToString(dSqrtDown(a)) = "1.5811388300841895", "dSqrtDown, inexact")
  assert(dToString(dSqrtDown(6.25)) = "2.5", "dSqrtDown, exact")
  assert(dToString(dSqrtDown(two)) = "1.414213562373095", "dSqrtDown of 2")
  assert(dToString(dSqrtDown(z)) = "0.0", "dSqrtDown of 0.0")
  assert(dToString(dSqrtDown(nz)) = "-0.0", "dSqrtDown of -0.0")
  assert(dToString(dSqrtDown(tiny)) = "2.2227587494850775E-162", "dSqrtDown of the smallest subnormal")
  assert(dToString(dSqrtDown(large)) = "3.1622776601683792E10", "dSqrtDown of a large value")
  assert(dToString(dSqrtDown(inf)) = "Infinity", "dSqrtDown of infinity")
  assert(dToString(dSqrtDown(b)) = "NaN", "dSqrtDown of a negative")
  assert(dToString(dSqrtDown(nan)) = "NaN", "dSqrtDown of NaN")

  assert(dToString(dAddUp(p1, p2)) = "0.30000000000000004", "dAddUp, inexact")
  assert(dToString(dAddUp(one, two)) = "3.0", "dAddUp, exact")
  assert(dToString(dAddUp(large, one)) = "1.0000000000000001E21", "dAddUp of a large value and 1")
  assert(dToString(dAddUp(tiny, tiny)) = "9.9E-324", "dAddUp of two smallest subnormals")
  assert(dToString(dAddUp(z, nz)) = "0.0", "dAddUp of 0.0 and -0.0")
  assert(dToString(dAddUp(nz, nz)) = "-0.0", "dAddUp of -0.0 and -0.0")
  assert(dToString(dAddUp(inf, one)) = "Infinity", "dAddUp of infinity and 1")
  assert(dToString(dAddUp(inf, ninf)) = "NaN", "dAddUp of infinity and -infinity")
  assert(dToString(dAddUp(nan, one)) = "NaN", "dAddUp of NaN and 1")
  assert(dToString(dAddDown(p1, p2)) = "0.3", "dAddDown, inexact")
  assert(dToString(dAddDown(one, two)) = "3.0", "dAddDown, exact")
  assert(dToString(dAddDown(large, one)) = "1.0E21", "dAddDown of a large value and 1")
  assert(dToString(dAddDown(z, nz)) = "-0.0", "dAddDown of 0.0 and -0.0")
  assert(dToString(dAddDown(ninf, one)) = "-Infinity", "dAddDown of -infinity and 1")
  assert(dToString(dAddDown(inf, ninf)) = "NaN", "dAddDown of infinity and -infinity")
  assert(dToString(dAddDown(nan, one)) = "NaN", "dAddDown of NaN and 1")
  assert(dToString(dSubUp(one, p1)) = "0.9", "dSubUp, inexact")
  assert(dToString(dSubUp(one, two)) = "-1.0", "dSubUp, exact")
  assert(dToString(dSubUp(one, tiny)) = "1.0", "dSubUp of 1 and the smallest subnormal")
  assert(dToString(dSubUp(z, z)) = "0.0", "dSubUp of 0.0 and 0.0")
  assert(dToString(dSubUp(inf, ninf)) = "Infinity", "dSubUp of infinity and -infinity")
  assert(dToString(dSubUp(inf, inf)) = "NaN", "dSubUp of infinities")
  assert(dToString(dSubUp(nan, one)) = "NaN", "dSubUp of NaN and 1")
  assert(dToString(dSubDown(one, p1)) = "0.8999999999999999", "dSubDown, inexact")
  assert(dToString(dSubDown(one, two)) = "-1.0", "dSubDown, exact")
  assert(dToString(dSubDown(large, one)) = "9.999999999999999E20", "dSubDown of a large value and 1")
  assert(dToString(dSubDown(z, z)) = "-0.0", "dSubDown of 0.0 and 0.0")
  assert(dToString(dSubDown(tiny, tiny)) = "-0.0", "dSubDown of two smallest subnormals")
  assert(dToString(dSubDown(inf, inf)) = "NaN", "dSubDown of infinities")
  assert(dToString(dSubDown(nan, one)) = "NaN", "dSubDown of NaN and 1")
  assert(dToString(dMulUp(p1, p2)) = "0.020000000000000004", "dMulUp, inexact")
  assert(dToString(dMulUp(two, three)) = "6.0", "dMulUp, exact")
  assert(dToString(dMulUp(tiny, tiny)) = "4.9E-324", "dMulUp of two smallest subnormals")
  assert(dToString(dMulUp(huge2, huge2)) = "Infinity", "dMulUp overflows")
  assert(dToString(dMulUp(z, nz)) = "-0.0", "dMulUp of 0.0 and -0.0")
  assert(dToString(dMulUp(inf, b)) = "-Infinity", "dMulUp of infinity and b")
  assert(dToString(dMulUp(inf, z)) = "NaN", "dMulUp of infinity and 0.0")
  assert(dToString(dMulUp(nan, one)) = "NaN", "dMulUp of NaN and 1")
  assert(dToString(dMulDown(p1, p2)) = "0.02", "dMulDown, inexact")
  assert(dToString(dMulDown(two, three)) = "6.0", "dMulDown, exact")
  assert(dToString(dMulDown(tiny, tiny)) = "0.0", "dMulDown of two smallest subnormals")
  assert(dToString(dMulDown(huge2, huge2)) = "1.7976931348623157E308", "dMulDown overflows to the largest finite value")
  assert(dToString(dMulDown(nz, nz)) = "0.0", "dMulDown of -0.0 and -0.0")
  assert(dToString(dMulDown(inf, z)) = "NaN", "dMulDown of infinity and 0.0")
  assert(dToString(dMulDown(nan, one)) = "NaN", "dMulDown of NaN and 1")
  assert(dToString(dDivUp(one, three)) = "0.33333333333333337", "dDivUp, inexact")
  assert(dToString(dDivUp(one, two)) = "0.5", "dDivUp, exact")
  assert(dToString(dDivUp(tiny, two)) = "4.9E-324", "dDivUp of the smallest subnormal by 2")
  assert(dToString(dDivUp(large, tiny)) = "Infinity", "dDivUp overflows")
  assert(dToString(dDivUp(nz, two)) = "-0.0", "dDivUp of -0.0 by 2")
  assert(dToString(dDivUp(inf, inf)) = "NaN", "dDivUp of infinities")
  assert(dToString(dDivUp(nan, one)) = "NaN", "dDivUp of NaN by 1")
  assert(dToString(dDivDown(one, three)) = "0.3333333333333333", "dDivDown, inexact")
  assert(dToString(dDivDown(one, two)) = "0.5", "dDivDown, exact")
  assert(dToString(dDivDown(tiny, two)) = "0.0", "dDivDown of the smallest subnormal by 2")
  assert(dToString(dDivDown(large, tiny)) = "1.7976931348623157E308", "dDivDown overflows to the largest finite value")
  assert(dToString(dDivDown(z, two)) = "0.0", "dDivDown of 0.0 by 2")
  assert(dToString(dDivDown(inf, inf)) = "NaN", "dDivDown of infinities")
  assert(dToString(dDivDown(nan, one)) = "NaN", "dDivDown of NaN by 1")

  assert(dToString(dSubDownNoNaN(ninf, one)) = "-Infinity", "-infinity dSubDownNoNaN 1")
  assert(dToString(dMulUpNoNaN(ninf, z)) = "-0.0", "-infinity dMulUpNoNaN 0.0")
  assert(dToString(dMulUpNoNaN(ntiny, tiny)) = "-0.0", "dMulUpNoNaN underflows to -0.0")
  assert(dToString(dMulDownNoNaN(large, tiny)) = "4.9406564584124654E-303", "dMulDownNoNaN of a large value and the smallest subnormal")
  assert(dToString(dMulDownNoNaN(ntiny, tiny)) = "-4.9E-324", "dMulDownNoNaN underflows to minus the smallest subnormal")
  assert(dToString(dMulDownNoNaN(ninf, z)) = "-Infinity", "-infinity dMulDownNoNaN 0.0")
  assert(dToString(dDivDownNoNaN(z, two)) = "0.0", "0.0 dDivDownNoNaN 2")
  assert(dToString(dDivDownNoNaN(nz, two)) = "-0.0", "-0.0 dDivDownNoNaN 2")
  assert(dToString(dDivDownNoNaN(ntiny, large)) = "-4.9E-324", "dDivDownNoNaN underflows to minus the smallest subnormal")
  assert(dToString(dDivUpNoNaN(ntiny, large)) = "-0.0", "dDivUpNoNaN underflows to -0.0")
  assert(dToString(dSqrtDown(ninf)) = "NaN", "dSqrtDown of -infinity")
  assert(dToString(dAddDown(tiny, one)) = "1.0", "dAddDown of the smallest subnormal and 1")
  assert(dToString(dSubUp(nz, nz)) = "0.0", "-0.0 dSubUp -0.0")
  assert(dToString(dSubUp(large, one)) = "1.0E21", "dSubUp of a large value and 1")
  assert(dToString(dSubDown(nz, nz)) = "-0.0", "-0.0 dSubDown -0.0")
  assert(dToString(dSubDown(ninf, one)) = "-Infinity", "-infinity dSubDown 1")
  assert(dToString(dMulUp(large, tiny)) = "4.9406564584124654E-303", "dMulUp of a large value and the smallest subnormal")
  assert(dToString(dMulUp(ntiny, tiny)) = "-0.0", "dMulUp underflows to -0.0")
  assert(dToString(dMulUp(ninf, b)) = "Infinity", "-infinity dMulUp b")
  assert(dToString(dMulDown(large, tiny)) = "4.9406564584124654E-303", "dMulDown of a large value and the smallest subnormal")
  assert(dToString(dMulDown(ntiny, tiny)) = "-4.9E-324", "dMulDown underflows to minus the smallest subnormal")
  assert(dToString(dMulDown(ninf, one)) = "-Infinity", "-infinity dMulDown 1")
  assert(dToString(dDivUp(z, two)) = "0.0", "0.0 dDivUp 2")
  assert(dToString(dDivUp(ntiny, large)) = "-0.0", "dDivUp underflows to -0.0")
  assert(dToString(dDivUp(ninf, two)) = "-Infinity", "-infinity dDivUp 2")
  assert(dToString(dDivDown(nz, two)) = "-0.0", "-0.0 dDivDown 2")
  assert(dToString(dDivDown(ntiny, large)) = "-4.9E-324", "dDivDown underflows to minus the smallest subnormal")
  assert(dToString(dDivDown(ninf, two)) = "-Infinity", "-infinity dDivDown 2")

  assert(dToString(dFromRawBits(0)) = "0.0", "dFromRawBits of 0")
  assert(dToString(dFromRawBits(1)) = "4.9E-324", "dFromRawBits of 1")
  assert(dToString(dFromRawBits(4607182418800017408)) = "1.0", "dFromRawBits of the bits of 1.0")
  assert(dToString(dFromRawBits(-4616189618054758400)) = "-1.0", "dFromRawBits of the bits of -1.0")
  assert(dToString(dFromRawBits(minZZ64)) = "-0.0", "dFromRawBits of the bits of -0.0")
  assert(dToString(dFromRawBits(9218868437227405311)) = "1.7976931348623157E308", "dFromRawBits of the bits of the largest finite value")
  assert(dToString(dFromRawBits(9218868437227405312)) = "Infinity", "dFromRawBits of the bits of infinity")
  assert(dToString(dFromRawBits(-4503599627370496)) = "-Infinity", "dFromRawBits of the bits of -infinity")
  assert(dToString(dFromRawBits(9221120237041090560)) = "NaN", "dFromRawBits of the bits of a NaN")
  assert(dRawBits(dFromRawBits(9221120237041090560)) = 9221120237041090560, "dFromRawBits of the bits of a NaN keeps them")
  println("PASS")
end

end

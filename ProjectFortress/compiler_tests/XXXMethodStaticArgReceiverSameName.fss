(* An explicit static argument of a method invocation does not capture the method's own static parameter by the receiver's type argument of the same name, so the call type-checks and runs. *)
component XXXMethodStaticArgReceiverSameName
export Executable
trait Gen[\E\]
  mp[\G\](f: E->G): Gen[\G\]
  count(): ZZ32
end
object Box[\E\](x: E) extends Gen[\E\]
  mp[\G\](f: E->G): Gen[\G\] = Box[\G\](f(x))
  count(): ZZ32 = 1
end
object P[\A,B\](a: A, b: B) end
object Cell[\T\](x: T)
  pair[\G\](g: Gen[\G\]): Gen[\P[\T,G\]\] = g.mp[\P[\T,G\]\](fn (e:G):P[\T,G\] => P[\T,G\](x,e))
end
run() = println(if Cell[\ZZ32\](1).pair[\String\](Box[\String\]("a")).count() = 1 then "PASS" else "FAIL" end)
end

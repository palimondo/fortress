-trait AnyIntegral extends { Number } comprises { ZZ, ZZ64, ZZ32, NN64, NN32 } end
+trait AnyIntegral extends { Number } comprises { ZZ, ZZ64, ZZ32, NN64, NN32 }
+    (* Probe Q, device A: a numeral at an AnyIntegral parameter reads as Q1 reads it. *)
+    coerce(x: IntLiteral) =
+        if (x >= -2147483648) AND (x <= 2147483647) then x.asZZ32
+        elif (x >= -9223372036854775808) AND (x <= 9223372036854775807) then x.asZZ64
+        else x.asZZ end
+end

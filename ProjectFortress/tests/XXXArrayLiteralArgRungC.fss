component XXXArrayLiteralArgRungC
export Executable

run(): () = do
    println("REACHED")
    d = 3 - [1 2]
    assert(d[0], 2, "row 49: 3 - [1 2] is [2 1]; Specification/basic/expressions/aggregate.tex:129-137")
    assert(d[1], 1, "row 49: 3 - [1 2] is [2 1]; Specification/basic/expressions/aggregate.tex:129-137")
    println("PASS")
  end

end

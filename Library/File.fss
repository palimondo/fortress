component File
import FlatString.FlatString
import FileSupport.{...}
import Stream.{ WriteStream }
export File

FileReadStream(filename: String): FileReadStream = typecase filename.asFlatString of
    f:FlatString ⇒ FileReadStream(filename, makeJavaBufferedReader(f))
    f:String ⇒ fail[\FileReadStream\]("FileReadStream: asFlatString answered a string that is not flat")
  end

object FileReadStream(fileName: String, under: JavaBufferedReader)
        extends { ReadStream, FileStream }
    getter asString():String = "<Read handle to \"" || fileName || "\">"

    getter eof():Boolean = under.eof()

    getter ready():Boolean = under.ready()

    whenUnconsumed():() = under.whenUnconsumed()
    consume():() = under.consume()

    uncheckedReadLine():String = under.readLine()

    (* The reader answers char(0) at the end and sets eof; the stream answers -1 there. *)
    uncheckedReadChar():ZZ32 = do
        c = under.read()
        if under.eof() then -1 else c.codePoint end
      end

    uncheckedRead(k:ZZ32):String = under.readk(k)

    close():() = under.close()
end

FileWriteStream(fileName:String):FileWriteStream = typecase fileName.asFlatString of
    f:FlatString ⇒ FileWriteStream(fileName, makeJavaBufferedWriter(f))
    f:String ⇒ fail[\FileWriteStream\]("FileWriteStream: asFlatString answered a string that is not flat")
  end

object FileWriteStream(fileName: String, under: JavaBufferedWriter) extends { FileStream, WriteStream }
    getter asString(): String = "<Write handle to \"" || fileName || "\">"
    write(s:FlatString):() = under.write(s)
    write(c:Char):() = under.write(c)
    (* A string that is not flat reaches the Java writer in one write, so lines from parallel tasks stay whole. *)
    write(x:String):() = under.write(x)
    write(x:Any): () = write("" x)
    writes(x:Generator[\Any\], r:String):() =
        write((BIG ||[e <- x]
                   typecase e of
                        e':FlatString => e'
                        e':String => e'.asFlatString
                        else   => ("" e).asFlatString
                   end) r)
    writes(x:Generator[\Any\]):() = writes(x,"")
    print(x:Any...):() = writes(x)
    println(x:Any...):() = writes(x,"\n")
    flush():() = under.flush()
    close():() = under.close()
end

end

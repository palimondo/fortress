(* lift_b2: spelling 3 -- a List comprehension <| f(r) | r <- rowsOf(m) |>
   over a generator of row views, then stacked into a matrix. *)
component lift_b2
export Executable
import List.{...}

object Row[\nat r, nat c\](base: Matrix[\RR64,r,c\], i: ZZ32) extends Vector[\RR64,c\]
    get(j: ZZ32): RR64 = base.get(i, j)
    put(j: ZZ32, v: RR64): () = base.put((i, j), v)
    init0(j: ZZ32, v: RR64): () = base.init0((i, j), v)
    replica[\U\](): Array1[\U,0,c\] = array1[\U,c\]()
end
mat(r: ZZ32, c: ZZ32, f: (ZZ32,ZZ32) -> RR64): Array[\RR64,(ZZ32,ZZ32)\] = array[\RR64\](r,c).fill(f)

rowsOf[\nat r, nat c\](m: Matrix[\RR64,r,c\]): Generator[\Array[\RR64,ZZ32\]\] = do
    (nr, nc) = m.sizes
    (0#nr).map[\Array[\RR64,ZZ32\]\](fn (i: ZZ32): Array[\RR64,ZZ32\] => Row[\r,c\](m, i))
  end

nth[\nat s\](v: Vector[\RR64,s\], j: ZZ32): RR64 = v[j]
lenOf[\nat s\](v: Vector[\RR64,s\]): ZZ32 = |v|

dbl(v: Array[\RR64,ZZ32\]): Array[\RR64,ZZ32\] = array[\RR64\](|v|).fill(fn (j: ZZ32): RR64 => 2.0 v[j])

run(): () = do
    m = mat(4, 3, fn (i: ZZ32, j: ZZ32): RR64 => 1.0 i + 0.1 j)
    ls = <| dbl(r) | r <- rowsOf(m) |>
    println "(b2) list length = " |ls| "  ls[0] = " ls[0]
    println "(b2) chained subscript ls[i][j]: see lift_b2a.out"
    out = mat(|ls|, lenOf(ls[0]), fn (i: ZZ32, j: ZZ32): RR64 => nth(ls[i], j))
    println "(b2) stacked = " out
  end
end

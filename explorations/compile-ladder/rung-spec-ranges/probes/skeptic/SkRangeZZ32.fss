component SkRangeZZ32
export Executable

count(g: Generator[\ZZ32\]): ZZ32 = do
  var c: ZZ32 = 0
  for x <- seq(g) do c := c + 1 end
  c
end

run(): () = do
  a: ZZ32 = 3
  b: ZZ32 = 7
  n: ZZ32 = -2
  println("R1 3:7 elements " (count(3:7)).asString)
  println("R2 a:b elements " (count(a:b)).asString)
  println("R3 0#a elements " (count(0#a)).asString)
  println("R4 a#n, n negative, elements " (count(a#n)).asString)
  println("R5 b:a elements " (count(b:a)).asString)
  var s: ZZ32 = 0
  for x <- seq(a#4) do s := s + x end
  println("R6 sum over a#4 " s.asString)
end

end

\newbox\lowered@leftharpoonup  \setbox\lowered@leftharpoonup\hbox{\lower0.25ex\hbox{$\leftharpoonup$}}\dp\lowered@leftharpoonup=0pt
\newbox\lowered@rightharpoonup  \setbox\lowered@rightharpoonup\hbox{\lower0.25ex\hbox{$\rightharpoonup$}}\dp\lowered@rightharpoonup=0pt

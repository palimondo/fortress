(* Decision D's way D3: the specification's spelling of a sized vector, T^n for Vector[\T,n\]
   (Specification/preliminaries/overview.tex:1075-1079), in a signature beside the library's name for the
   same type, checked against the one library and run under walk.  Ledger row 24: walk parses T^n. *)
component TPow
export Executable

norm2[\nat n\](x: RR64^n): RR64 = x DOT x
norm2w[\nat n\](x: Vector[\RR64,n\]): RR64 = x DOT x
three(): RR64^3 = vector[\RR64,3\](2.0)

run(): () = do
  v: Vector[\RR64,3\] = vector[\RR64,3\](2.0)
  println("TPow spelled " norm2(v) " written " norm2w(v) " made " norm2(three()))
end

end

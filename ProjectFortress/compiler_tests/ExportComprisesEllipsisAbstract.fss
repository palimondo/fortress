(* The api's abstract functional method of a trait that comprises { ... } declares the component's of a trait that comprises { R } (apis.tex, section "Component and API Identity"), so the component matches its api and num(R) is 1. *)
component ExportComprisesEllipsisAbstract
export { ExportComprisesEllipsisAbstract, Executable }

trait Q comprises { R }
    abstract num(self): ZZ32
end

object R extends Q
    num(self): ZZ32 = 1
end

run(): () = do
    assert(num(R), 1, "num(R)")
    println("PASS")
  end

end

(* A local function that leaves the types of its parameter and its result out is refused with the name of the parameter, as a top-level function is, since the compiled checker infers no parameter type (type-inference.tex, section "Type Inference for Components", and its revision). *)
component XXXLocalFunctionUntypedParamAndReturn
export Executable

run(): () = do
    sq(n) = n n
    z: ZZ32 = 7
    println(sq(z))
  end

end

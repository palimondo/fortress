component PbgPairEq
export Executable

(* The one library's own instance of the question. Its top-level opr =(a:Any, b:Any), whose
   body is a SEQV b (Library/FortressLibrary.fsi:69, .fss:96), sits beside the generic
   opr =[\A,B\](t1:(A,B), t2:(A,B)), which compares element by element (.fsi:2530, .fss:4345).
   A pair reached through a variable of type Any, or through a type parameter, is a call whose
   static choice is the plain declaration while the value fits the generic one. Three kinds of
   element: two equal strings built separately; an object with its own = (two instances);
   0.0 against -0.0. For each, the element's = and SEQV are printed first, then the pair's =
   reached four ways, then the pair's SEQV, which is what the plain declaration answers.
   Walk only: the compiler library declares neither of the two. *)
object Pt(x: ZZ32)
  opr =(self, o: Pt): Boolean = (x = o.x)
end

b(x: Boolean): String = if x then "true" else "false" end

same[\T\](x: T, y: T): Boolean = x = y

show[\A,B\](title: String, e1: A, e2: A, p1: (A,B), p2: (A,B)): () = do
  a1: Any = p1
  a2: Any = p2
  println(title)
  println("  element: e1 = e2 -> " b(e1 = e2) ", e1 SEQV e2 -> " b(e1 SEQV e2))
  println("  pair, static (A,B):   p1 = p2 -> " b(p1 = p2))
  println("  pair, static Any:     a1 = a2 -> " b(a1 = a2))
  println("  pair, static T:  same(p1, p2) -> " b(same(p1, p2)))
  println("  pair, nested: (p1,0) = (p2,0) -> " b((p1, 0) = (p2, 0)))
  println("  pair SEQV (the Any arm's body): p1 SEQV p2 -> " b(p1 SEQV p2))
end

run(): () = do
  s1: String = "a" "b"
  s2: String = "ab"
  show[\String,ZZ32\]("strings built separately", s1, s2, (s1, 1), (s2, 1))
  q1: Pt = Pt(1)
  q2: Pt = Pt(1)
  show[\Pt,ZZ32\]("an object with its own =, two instances", q1, q2, (q1, 1), (q2, 1))
  z1: RR64 = 0.0
  z2: RR64 = -0.0
  show[\RR64,ZZ32\]("0.0 and -0.0", z1, z2, (z1, 1), (z2, 1))
end
end

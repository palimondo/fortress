  assert(fToString(fCeiling(nz)) = "-0.0", "ceiling of nz")
  assert(fToString(fCeiling(tiny)) = "1.0", "ceiling of tiny")
  assert(fToString(fCeiling(ntiny)) = "-0.0", "ceiling of ntiny")
  assert(fToString(fCeiling(large)) = "3.0E38", "ceiling of large")
  assert(fToString(fCeiling(nmaxf)) = "-3.4028235E38", "ceiling of nmaxf")
  assert(fToString(fCeiling(wide)) = "8.589935E9", "ceiling of wide")
  assert(fIFloor(a) = 2, "floor bracket of a")
  assert(fIFloor(b) = -1, "floor bracket of b")
  assert(fIFloor(h35) = 3, "floor bracket of h35")
  assert(fIFloor(nh25) = -3, "floor bracket of nh25")
  assert(fIFloor(p27) = 2, "floor bracket of p27")
  assert(fIFloor(np27) = -3, "floor bracket of np27")
  assert(fIFloor(z) = 0, "floor bracket of z")
  assert(fIFloor(nz) = 0, "floor bracket of nz")
  assert(fIFloor(tiny) = 0, "floor bracket of tiny")
  assert(fIFloor(ntiny) = -1, "floor bracket of ntiny")
  assert(fIFloor(wide) = 8589934592, "floor bracket of wide")
  assert(fIFloor(nwide) = -6442450944, "floor bracket of nwide")
  assert(fICeiling(a) = 3, "ceiling bracket of a")
  assert(fICeiling(b) = 0, "ceiling bracket of b")
  assert(fICeiling(h35) = 4, "ceiling bracket of h35")
  assert(fICeiling(nh25) = -2, "ceiling bracket of nh25")
  assert(fICeiling(p27) = 3, "ceiling bracket of p27")
  assert(fICeiling(np27) = -2, "ceiling bracket of np27")
  assert(fICeiling(z) = 0, "ceiling bracket of z")
  assert(fICeiling(nz) = 0, "ceiling bracket of nz")
  assert(fICeiling(tiny) = 1, "ceiling bracket of tiny")
  assert(fICeiling(ntiny) = 0, "ceiling bracket of ntiny")
  assert(fICeiling(wide) = 8589934592, "ceiling bracket of wide")
  assert(fICeiling(nwide) = -6442450944, "ceiling bracket of nwide")
  assert(fTruncate(a) = 2, "truncate of a")
  assert(fTruncate(b) = 0, "truncate of b")
  assert(fTruncate(h35) = 3, "truncate of h35")
  assert(fTruncate(nh25) = -2, "truncate of nh25")
  assert(fTruncate(p27) = 2, "truncate of p27")
  assert(fTruncate(np27) = -2, "truncate of np27")
  assert(fTruncate(z) = 0, "truncate of z")
  assert(fTruncate(nz) = 0, "truncate of nz")
  assert(fTruncate(tiny) = 0, "truncate of tiny")
  assert(fTruncate(ntiny) = 0, "truncate of ntiny")
  assert(fTruncate(wide) = 8589934592, "truncate of wide")
  assert(fTruncate(nwide) = -6442450944, "truncate of nwide")
  assert(fRound(a) = 2, "round of a")
  assert(fRound(b) = -1, "round of b")
  assert(fRound(h35) = 4, "round of h35")
  assert(fRound(nh25) = -2, "round of nh25")
  assert(fRound(p27) = 3, "round of p27")
  assert(fRound(np27) = -3, "round of np27")
  assert(fRound(z) = 0, "round of z")
  assert(fRound(nz) = 0, "round of nz")
  assert(fRound(tiny) = 0, "round of tiny")
  assert(fRound(ntiny) = 0, "round of ntiny")
  assert(fRound(wide) = 8589934592, "round of wide")
  assert(fRound(nwide) = -6442450944, "round of nwide")
  println("PASS")
end

end

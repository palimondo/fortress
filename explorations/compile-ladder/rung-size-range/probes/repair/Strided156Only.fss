component Strided156Only
export Executable

run(): () = do
    println("REACHED")
    zMax: ZZ32 = 2147483647
    zMin: ZZ32 = -zMax - 1
    twoFit = 0:zMin:zMin
    assert(|twoFit|, 2, "a strided range whose two elements, 0 and the minimum, fit; ranges.tex:68-70, :140-143")
    println("PASS")
  end

end

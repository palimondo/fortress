(* A tight juxtaposition whose items are not functions is an application of the juxtaposition operator and has the expected type of its value, which fixes a static argument that only the result mentions. *)
component XXXInferTightJuxtContext
export Executable

object BoxV[\T\]() end
object K() end
tag(b: BoxV[\ZZ64\]): String = "ZZ64"
tag(b: BoxV[\String\]): String = "String"
opr juxtaposition[\T\](a: Any, b: K): BoxV[\T\] = BoxV[\T\]()

run(): () = do
    a: K = K()
    y: BoxV[\ZZ64\] = a(a)
    assert(tag(y), "ZZ64", "a(a), a not a function, is the juxtaposition operator applied, which the expected type BoxV[ZZ64] instantiates at ZZ64; Specification/basic/operators/juxtameaning.tex, section \"Juxtaposition\"; Specification/basic/inference.tex, section \"The Static Arguments of a Call\"")
    println("PASS")
  end

end

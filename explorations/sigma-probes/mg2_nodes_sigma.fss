component mg2_nodes_sigma
import FortressLibrary.{...} except { opr BIG + }
import List.{...}
import File.{...}
export Executable

(* microgpt2.fss -- iteration 2 of the microgpt notation exploration: the
   complete model in the merged "carriers (+) tower" design approved in
   explorations/microgpt-iteration2-plan.md (Judgment section; decision
   brief in the session record).  Karpathy's microgpt -- scalar reverse-mode
   autodiff, char-level tokenizer, 1-layer/2-head transformer (rmsnorm,
   multi-head attention with KV history, relu MLP), Adam with bias
   correction and linear LR decay, temperature sampling -- with the model
   level stated in the notation the ML literature itself uses:

     h0      = _We[t] + _Wp[i]
     RMSNorm  x / SQRT((x DOT x) / d + epsilon)
     dot      u DOT w = SUM[m <- u.indices] u[m] w[m]
     attend   softmax(q K^T / SQRT d_k) V
     FFN      _W2 relu(_W1 x)
     loss     - log(p[y])

   -- and with the SPACES the literature names them over stated in the
   signatures: softmax : Vec -> ProbDist (the paper's p in Delta^(n-1)),
   forward : ... -> (Vec, KVCache, KVCache) (the paper's own noun for the
   thing the same List[\Mat\] spelling otherwise shares with the per-head
   weight bundles).

   The design, per the judgment: the autodiff node is named Value
   (Karpathy's own class name -- freeing the letter V for the value
   matrix); Value joins the 2012 library's numeric tower twice
   (MultiplicativeRing gives juxtaposition, binary minus, zero as trait
   defaults; StandardMax opens the genuine library BIG MAX to the tape,
   so softmax's stabilizing shift is a real big operator with no .data
   leak); vectors and matrices are carrier objects on the library's own
   Potemkin rank traits (Rank1 excludes Rank2 -- the exclusion that makes
   BOTH juxtaposition directions legal under the spec's Meet Rule,
   advanced/overloading.tex; library precedent FortressLibrary.fss:2634,
   2641); Vec extends AdditiveGroup, so the residual stream rides on
   carrier-level inherited algebra; ^T is a real superscripted postfix
   operator (spec basic/operators/intro.tex special-cases ^T "to signify
   matrix transposition"), making the attention line the literature's own;
   carrier = is defined (HasRank's default makes even x = x false --
   FortressLibrary.fss:1588); weights are _W-prefixed, the spec's
   leading-underscore boldface convention (basic/lexical-structure.tex,
   render-identifiers), so they typeset as the bold matrices of the
   papers; summation is the genuine library big operator SUM, reached over
   the tape by hiding the library's own SUM with the spec's `except` import
   and redeclaring it once over Any (explorations/sum-experiment-report.md),
   so every place the ML literature writes Sigma this file writes SUM --
   the dot product, the left-multiplication, softmax's denominator, the
   mean loss -- and no place it does not; per-head plumbing is three per-head
   comprehensions, the literature's "head_1 ... head_h" ellipsis made
   precise.  Everything else about the architecture matches the Python
   reference: 1 layer, heads structural, rmsnorm without gain, no biases,
   plain relu, causality by history, Adam beta1 .85 beta2 .99 lr .01
   linear decay, BOS = 26, vocab 27.

   The named spaces (ProbDist, KVCache) and their price: Fortress
   SPECIFIES transparent type aliases -- `type ProbDist = Vec`, expanded
   before type checking, defining no new type and no nominal equivalence
   (basic/types-vals-vars.tex:597-623) -- and the 2012 implementation
   stops one line short of them (IndexBuilder.scala:187 is `bug("Not yet
   implemented")`; the expansion at TypeAnalyzer.scala:552-557 is written
   and unreachable).  So here a signature can name a space only by
   minting a NEW NOMINAL TYPE, and minting is not free.  The bill, in
   full: KVCache costs +7 counted lines (an 8-line carrier and
   emptyCache, against a one-line forward signature and the vanished
   emptyHist), and ProbDist costs +2 -- because the shared supertype
   RowLike lets the left-multiplication  p M  be written once for both
   rank-1 carriers.  Without RowLike, ProbDist costs +8, six of them a
   VERBATIM DUPLICATE of the Vec-times-Mat operator body.  Both variants
   were built and both pass the golden check; the 6-line difference is
   the measured price of the missing alias.

   The harness (data, tokenizer, optimizer, sampling) is held to the same
   notational discipline as the model: each stage is a named definition
   stated by its own formula, and the Adam sweep is an unordered for --
   the per-parameter updates are independent, so only the step loop is
   seq (a genuine recurrence).

   Verified: v1's goldenCheck numbers (15 logits, mean loss, 5 gradients)
   at 1e-9, then a nano training run.  Run FORTRESS_THREADS=1. *)

(* ---------- scalar reverse-mode autodiff: the tape engine ---------- *)

(* Value is a multiplicative ring and a StandardMax; saying so buys
   juxtaposition (= TIMES), binary minus (= self + (-o)), zero, and the
   library's genuine BIG MAX, all as trait defaults (precedents:
   explorations/complex_ring.fss for the ring; the tower nucleus for MAX). *)
object Value(var data: RR64, children: List[\Value\], grads: List[\RR64\])
       extends { MultiplicativeRing[\Value\], StandardMax[\Value\] }
  getter one(): Value = konst(1.0)
  var grad: RR64 := 0.0
  var visited: Boolean := false
  opr +(self, o: Value): Value = Value(data + o.data, <| self, o |>, <|[\RR64\] 1.0, 1.0|>)
  opr +(self, c: RR64): Value = Value(data + c, <| self |>, <|[\RR64\] 1.0|>)
  opr TIMES(self, o: Value): Value =
    Value(data o.data, <| self, o |>, <|[\RR64\] o.data, data|>)
  opr -(self): Value = Value(-data, <| self |>, <|[\RR64\] -1.0|>)
  opr /(self, o: Value): Value =
    Value(data / o.data, <| self, o |>,
          <|[\RR64\] 1.0 / o.data, (-data) / (o.data o.data)|>)
  opr /(self, c: RR64): Value = Value(data / c, <| self |>, <|[\RR64\] 1.0 / c|>)
  opr /(self, n: ZZ32): Value = self / (n 1.0)
  opr ^ (self, n: RR64): Value = Value(data^n, <| self |>, <|[\RR64\] n data^(n-1.0)|>)
  opr MAX(self, o: Value): Value = if data >= o.data then self else o end
end

konst(d: RR64): Value = Value(d, emptyList[\Value\](), emptyList[\RR64\]())

exp(v: Value): Value = Value(exp v.data, <| v |>, <|[\RR64\] exp v.data|>)
log(v: Value): Value = Value(log v.data, <| v |>, <|[\RR64\] 1.0/v.data|>)
relu(v: Value): Value = if v.data > 0.0
                        then Value(v.data, <| v |>, <|[\RR64\] 1.0|>)
                        else Value(0.0, <| v |>, <|[\RR64\] 0.0|>) end
opr SQRT(u: Value): Value = u^0.5

object Topo()
  var items: List[\Value\] := emptyList[\Value\]()
  build(v: Value): () = do
    if NOT v.visited then
      v.visited := true
      for ch <- seq(v.children) do self.build(ch) end
      items := items.addRight(v)
    end
  end
end

(* backpropagation over the reverse topological order; the visited marks
   are the engine's own scratch, so the engine clears them -- nothing
   outside this function ever needs to know they exist *)
backward(root: Value): () = do
  t = Topo()
  t.build(root)
  println("tape nodes: " |t.items|)
  root.grad := 1.0
  for v <- seq(t.items.reverse) do
    for (ch, lg) <- seq(v.children.zip[\RR64\](v.grads)) do
      ch.grad := ch.grad + lg v.grad
    end
  end
  for v <- t.items do v.visited := false end
end

(* ---------- the carriers: library citizens ----------
   The carriers wrap List; extending the library's own Rank1/Rank2 makes
   rows and matrices mutually excluding, so BOTH juxtaposition directions
   are legal overloads; ZeroIndexed/DelegatedIndexed buy |x|, x[i], zip,
   and full generator integration (u <- x, BIG ops over x) from three
   one-line members; AdditiveGroup gives Vec inherited binary minus and
   zero from + and unary -.  Carrier = is defined because HasRank's
   default equality is constant false -- even x = x.

   RowLike is the shared supertype of every rank-1 carrier.  `xs` is the
   spec's ABSTRACT FIELD DECLARATION -- "an implicit declaration of an
   abstract getter method" (basic/traits.tex:573-583) -- and indices, |.|
   and [.] are defined once in terms of it, the same move by which
   MultiplicativeRing hands Value its inherited operators.  An object's
   non-transient value parameter is a field (basic/objects.tex:271) with
   that implicit getter, so `object Vec(xs: ...)` satisfies it with no
   extra line.  Its purpose is dedup: the left-multiplication  p M  is
   written ONE time, on RowLike, and both Vec and ProbDist get it.

   ProbDist is the simplex: softmax's codomain, the paper's own
   p in Delta^(n-1).  Because Fortress 1.0 has no working type alias
   (spec basic/types-vals-vars.tex:597-623 specifies
   `type ProbDist = Vec`, expanded before type checking and defining no
   new type; IndexBuilder.scala:187 stops one line short of it), naming
   the space costs a NEW NOMINAL TYPE.  With RowLike that cost is one
   declaration line and one lift at softmax's exit -- not a duplicated
   operator body. *)

trait RowLike extends { Rank1, ZeroIndexed[\Value\], DelegatedIndexed[\Value,ZZ32\] }
  xs: List[\Value\]
  getter indices(): Generator[\ZZ32\] = 0 # |self.xs|
  opr |self| : ZZ32 = |self.xs|
  opr [i: ZZ32]: Value = (self.xs)[i]
end

object Vec(xs: List[\Value\]) extends { RowLike, AdditiveGroup[\Vec\] }
  opr +(self, y: Vec): Vec = Vec(<| u + w | (u, w) <- self.zip[\Value\](y) |>)
  opr -(self): Vec = Vec(<| -u | u <- xs |>)
  opr =(self, y: Vec): Boolean =
    (|xs| = |y|) AND (BIG AND[m <- self.indices] ((xs[m]).data = y[m].data))
end

object ProbDist(xs: List[\Value\]) extends { RowLike } end

object Mat(rows: List[\Vec\])
    extends { Rank2, ZeroIndexed[\Vec\], DelegatedIndexed[\Vec,ZZ32\] }
  getter indices(): Generator[\ZZ32\] = 0 # |rows|
  opr |self| : ZZ32 = |rows|
  opr [i: ZZ32]: Vec = rows[i]
  addRight(k: Vec): Mat = Mat(rows.addRight(k))
  opr =(self, y: Mat): Boolean =
    (|rows| = |y|) AND (BIG AND[i <- self.indices] (rows[i] = y[i]))
end

(* the KV cache: one Mat of history per head, indexed by head and
   extended at the right -- the paper's own noun, with the paper's own
   two operations.  It replaces the spelling List[\Mat\], which this file
   otherwise uses for the per-head WEIGHT bundles _Wq/_Wk/_Wv: the same
   type name meant two unrelated things, and needed a comment to say
   which. *)
object KVCache(heads: List[\Mat\])
    extends { ZeroIndexed[\Mat\], DelegatedIndexed[\Mat,ZZ32\] }
  getter indices(): Generator[\ZZ32\] = 0 # |heads|
  opr |self| : ZZ32 = |heads|
  opr [h: ZZ32]: Mat = heads[h]
  extend(ks: List[\Vec\]): KVCache =
    KVCache(<| (heads[h]).addRight(ks[h]) | h <- self.indices |>)
end

emptyCache(nh: ZZ32): KVCache = KVCache(<| Mat(emptyList[\Vec\]()) | h <- 0#nh |>)

(* ---------- the notation layer: each operator defined once,
              by its index formula ---------- *)

(* Sigma over the tape.  A big operator's name admits exactly ONE
   declaration: a reduction expression desugars to a NULLARY operator call
   (PreTypeCheckDesugaringVisitor.java:358-373) and Fortress overloading is
   decided on value parameter lists alone -- static parameters do not enter
   in (basic/overloading.tex:99-105) -- so two nullary SUMs always collide.
   SUM is therefore not extensible by ADDITION, but it is by REPLACEMENT:
   the spec's `except` import (basic/components/source-code.tex:64-93,
   spelled with SUM's internal name `BIG +`) frees the name in this
   component, and the monoid below is then the one the library's own
   reduction machinery runs -- over Values and over the built-in numbers
   alike, so `sample` below keeps a numeric Sigma in the same file.
   PlusReduction's identity is the numeric 0 (a polymorphic reduction
   cannot know Value's own zero), which is why Value accepts an integer on
   either side of +; that identity element is only ever joined in when a
   generator is FILTERED or EMPTY.  No Sigma here is either: every one runs
   over the index range of a non-empty carrier, or over the loss list of a
   step with at least one token.  An empty Sigma over Values would return
   the numeric 0 rather than Value(0.0) -- the one honest hole in a single
   shared SUM, recorded in explorations/sum-experiment-report.md. *)
opr +(z: ZZ32, v: Value): Value = v + (z 1.0)
opr +(v: Value, z: ZZ32): Value = v + (z 1.0)

object PlusReduction extends CommutativeMonoidReduction[\Any\]
  empty(): Any = 0
  join(a: Any, b: Any): Any = a + b
end

opr SUM[\T\](): BigReduction[\Any,Any\] = BigReduction[\Any,Any\](PlusReduction)

(* u DOT w = SUM_m u_m w_m *)
opr DOT(u: Vec, w: Vec): Value = SUM[m <- u.indices] u[m] w[m]

(* (W x)_r = W_r DOT x *)
opr juxtaposition(w: Mat, x: Vec): Vec = Vec(<| r DOT x | r <- w |>)

(* (p M)_c = SUM_j p_j M_j_c -- the OTHER direction, legal because
   Rank1 excludes Rank2.  Stated on RowLike, so q K^T (a Vec on the left)
   and softmax(...) V (a ProbDist on the left) are the SAME definition. *)
opr juxtaposition(p: RowLike, m: Mat): Vec =
  Vec(<| SUM[j <- p.indices] p[j] (m[j])[c] | c <- (m[0]).indices |>)

(* (M^T)_c_j = M_j_c : the spec's superscripted postfix operator,
   "typically used to signify matrix transposition" (basic/operators/intro.tex) *)
opr (m: Mat)^T : Mat =
  Mat(<| Vec(<| (m[j])[c] | j <- m.indices |>) | c <- (m[0]).indices |>)

(* scalar broadcasts and pointwise lifts *)
opr -(x: Vec, s: Value): Vec = Vec(<| u - s | u <- x |>)
opr /(x: Vec, s: Value): Vec = Vec(<| u / s | u <- x |>)
opr /(x: Vec, c: RR64): Vec = Vec(<| u / c | u <- x |>)
relu(x: Vec): Vec = Vec(<| relu u | u <- x |>)
exp(x: Vec): Vec = Vec(<| exp u | u <- x |>)
concat(heads: List[\Vec\]): Vec = Vec(<| u | h <- heads, u <- h |>)

(* ---------- the model, block by block ---------- *)

epsilon: RR64 = 0.00001

(* RMSNorm(x) = x / SQRT(x.x/d + eps) -- no learnable gain; d is the
   dimension of x (|x| is length here, not a norm) *)
rmsnorm(x: Vec): Vec = do
  d = |x|
  x / SQRT((x DOT x) / d + epsilon)
end

(* softmax(a)_j = e^(a_j - m) / SUM_k e^(a_k - m): the stabilizing shift
   m = max a is the library's own BIG MAX (Value extends StandardMax), the
   pointwise e^(a - m) uses Value's inherited minus, and
   softmax(a) = softmax(a - m) is an identity, so the shift changes no
   number the mathematics defines.  The signature states the paper's own
   membership, softmax : RR^n -> Delta^(n-1); the ProbDist(... .xs) lift
   on the last line is the whole price of saying it without a type
   alias. *)
softmax(a: Vec): ProbDist = do
  m = BIG MAX[u <- a] u
  e = exp(a - m)
  ProbDist((e / (SUM[u <- e] u)).xs)
end

(* L = -log softmax(logits)_y *)
nll(logits: Vec, y: ZZ32): Value = do
  p = softmax(logits)
  - log(p[y])
end

(* one layer, nHead heads; n_layer = 1 as in Karpathy's default.  kh/vh
   are the KV caches for positions 0..i-1; forward returns the logits
   together with the caches extended by position i -- the KV cache is
   visible as data, and causality is the data too: K and V never contain
   a future position, so no mask. *)
object Model(nHead: ZZ32, d_k: ZZ32, _We: Mat, _Wp: Mat, _Wlm: Mat,
             _Wq: List[\Mat\], _Wk: List[\Mat\], _Wv: List[\Mat\],
             _Wo: Mat, _W1: Mat, _W2: Mat)

  (* one head at one step, over its whole history: score, weights, blend
     in the literature's own line.  K stacks the head's key vectors as
     rows, so (q K^T)_j = q DOT k_j. *)
  attend(q: Vec, K: Mat, V: Mat): Vec = softmax(q K^T / SQRT d_k) V

  (* FFN(x) = W_2 relu(W_1 x) *)
  ffn(x: Vec): Vec = _W2 relu(_W1 x)

  forward(t: ZZ32, i: ZZ32, kh: KVCache, vh: KVCache): (Vec, KVCache, KVCache) = do
    h0 = _We[t] + _Wp[i]
    x1 = rmsnorm(h0)
    x2 = rmsnorm(x1)
    K = kh.extend(<| _Wk[h] x2 | h <- 0#nHead |>)
    V = vh.extend(<| _Wv[h] x2 | h <- 0#nHead |>)
    heads = <| attend(_Wq[h] x2, K[h], V[h]) | h <- 0#nHead |>
    x3 = _Wo concat(heads) + x1
    x4 = rmsnorm(x3)
    x5 = ffn(x4) + x3
    (_Wlm x5, K, V)
  end

  (* every weight leaf in one flat list, the optimizer's view of the
     model (Karpathy's [p for mat in state_dict.values() for row in mat
     for p in row]); Mats and Vecs are generators, so the nested clauses
     walk them with no unwrapping *)
  params(): List[\Value\] =
    (<| p | m <- <| _We, _Wp, _Wlm, _Wo, _W1, _W2 |>, row <- m, p <- row |>
     || <| p | hm <- <|[\List[\Mat\]\] _Wq, _Wk, _Wv |>, m <- hm, row <- m, p <- row |>)
end

(* ---------- weights ---------- *)

wStd: RR64 = 0.08

(* Box-Muller; random() is the library native.  wStd is a constant rather
   than Karpathy's default argument (matrix(nout, nin, std=0.08)) because
   keyword parameters with default expressions -- sanctioned by the spec,
   basic/functions.tex:155 -- parse but are unimplemented in the walk
   interpreter: InterpreterBug "the number of parameters (2) does not match
   with the number of arguments (1)".  Implementation gap, recorded. *)
gauss(): RR64 = do
  var u1: RR64 := random(1.0)
  if u1 < 0.000000000001 then u1 := 0.000000000001 end
  u2 = random(1.0)
  wStd (SQRT (-2.0 (log u1))) (cos (2.0 3.141592653589793 u2))
end

gaussMat(rows: ZZ32, cols: ZZ32): Mat =
  Mat(<| Vec(<| konst(gauss()) | j <- 0#cols |>) | i <- 0#rows |>)
gaussHeads(nh: ZZ32, hs: ZZ32, cols: ZZ32): List[\Mat\] =
  <| gaussMat(hs, cols) | h <- 0#nh |>

(* ---------- the harness: data, tokenizer, sampling ---------- *)

(* the first k lines of the file.  File.fsi's lines() is a whole-file
   generator and lines(n) bounds only the read-ahead chunk, not the
   count, so a bounded read is a loop, not a comprehension: the
   comprehension form works but overflows the launcher's default 32 MB
   stack on names.txt's 32033 lines (recorded in the diet report). *)
readDocs(path: String, k: ZZ32): List[\String\] = do
  fr = FileReadStream(path)
  var docs: List[\String\] := emptyList[\String\]()
  while (NOT fr.eof) AND (|docs| < k) do docs := docs.addRight(fr.readLine()) end
  fr.close(); docs
end

(* tokens = BOS doc BOS, a..z mapped to 0..25 -- Karpathy's
   [BOS] + [ids] + [BOS], and String is a Char generator so the middle
   is one comprehension *)
tokenize(doc: String, bos: ZZ32): List[\ZZ32\] =
  <|[\ZZ32\] bos|> || <| c.codePoint() - 97 | c <- doc |> || <|[\ZZ32\] bos|>

(* sample j with probability p_j: the inverse-CDF rule stated as a count
   -- j is the number of prefix sums that fall short of a uniform draw
   (the MIN is the floating-point guard, exactly v1's fallback) *)
sample(p: ProbDist): ZZ32 = do
  r = random(1.0)
  short = <| j | j <- p.indices, (SUM[i <- seq(0#(j + 1))] (p[i]).data) < r |>
  |short| MIN (|p| - 1)
end

(* ---------- golden check: exact model math vs. the Python reference ---------- *)

(* deterministic weights for the golden check (no RNG; the same formula
   lives in the Python reference generator).  goldRows(mi, r0, rows, cols)
   is the row block r0 .. r0+rows-1 of v1's flat matrix mi, so a head's
   slice carries exactly v1's values (the flat-row-index mapping). *)
initW(i: ZZ32, j: ZZ32): RR64 = (((31 i + 17 j) REM 97) - 48) / 100.0

goldRows(mi: ZZ32, r0: ZZ32, rows: ZZ32, cols: ZZ32): Mat =
  Mat(<| Vec(<| konst(initW(100 mi + r0 + i, j)) | j <- 0#cols |>) | i <- 0#rows |>)

goldMat(mi: ZZ32, rows: ZZ32, cols: ZZ32): Mat = goldRows(mi, 0, rows, cols)

goldHeads(mi: ZZ32, nh: ZZ32, hs: ZZ32, cols: ZZ32): List[\Mat\] =
  <| goldRows(mi, h hs, hs, cols) | h <- 0#nh |>

goldenCheck(): () = do
  nH: ZZ32 = 2
  hs: ZZ32 = 2
  g = Model(nH, hs,
            goldMat(0, 5, 4), goldMat(1, 4, 4), goldMat(2, 5, 4),
            goldHeads(3, nH, hs, 4), goldHeads(4, nH, hs, 4), goldHeads(5, nH, hs, 4),
            goldMat(6, 4, 4), goldMat(7, 16, 4), goldMat(8, 4, 16))
  tol = 10.0^(-9)
  tokens = <|[\ZZ32\] 4, 0, 1, 4|>
  gold0 = <|[\RR64\] 1.1786640480869652, 0.08369680205708685, -1.2116330341802932, 1.161464590811486, 0.06649734478160751|>
  gold1 = <|[\RR64\] -0.5153754312822434, 0.7583368418857922, -0.6709093810270941, -0.44385589510170814, 0.8298563780663275|>
  gold2 = <|[\RR64\] -0.7803193651360372, 0.2648497272535788, 0.9794442126538028, -0.861494046699949, 0.18367504568966714|>
  golds = <|[\List[\RR64\]\] gold0, gold1, gold2|>
  var (kh, vh): (KVCache, KVCache) := (emptyCache(nH), emptyCache(nH))
  var losses: List[\Value\] := emptyList[\Value\]()
  for pos <- seq(0#3) do
    (logits, kh2, vh2) = g.forward(tokens[pos], pos, kh, vh)
    kh := kh2
    vh := vh2
    gold = golds[pos]
    for i <- seq(0#5) do
      assert(|(logits[i]).data - gold[i]| < tol, "golden logits pos " pos " idx " i)
    end
    losses := losses.addRight(nll(logits, tokens[pos + 1]))
  end
  loss = (SUM[l <- losses] l) / 3.0
  assert(|loss.data - 1.228662661701597| < tol, "golden loss")
  backward(loss)
  gwte = g._We; gwpe = g._Wp; glm = g._Wlm; gwq = g._Wq; gfc2 = g._W2
  assert(|((gwte[4])[0]).grad - (-0.21705452841851058)| < tol, "grad wte[4][0]")
  assert(|((gwpe[0])[1]).grad - 0.06350371373725669| < tol, "grad wpe[0][1]")
  assert(|((glm[2])[3]).grad - 0.028373522248445866| < tol, "grad lm_head[2][3]")
  assert(|(((gwq[0])[0])[0]).grad - (-0.001587106636149662)| < tol, "grad attn_wq[0][0]")
  assert(|((gfc2[1])[2]).grad - 0.0101351876799767| < tol, "grad mlp_fc2[1][2]")
  println("golden transformer forward/backward vs Python reference: PASS")
end

(* ---------- training ---------- *)

run() = do
  goldenCheck()
end
end

component SkIntBoth
export Executable

(*) Skeptic's differential of rung P's integer text on ZZ32 and ZZ64, runnable on both paths.
r32(f: () -> ZZ32): String =
  try
    "" f()
  catch e
    IntegerOverflow => "IntegerOverflow"
    Exception => "other exception"
  end

r64(f: () -> ZZ64): String =
  try
    "" f()
  catch e
    IntegerOverflow => "IntegerOverflow"
    Exception => "other exception"
  end

run(): () = do
  zero: ZZ32 = 0
  one: ZZ32 = 1
  two: ZZ32 = 2
  three: ZZ32 = 3
  five: ZZ32 = 5
  mOne: ZZ32 = -1
  mFour: ZZ32 = -4
  mFive: ZZ32 = -5
  mSix: ZZ32 = -6
  mSeven: ZZ32 = -7
  hundred: ZZ32 = 100
  thirtyOne: ZZ32 = 31
  maxI: ZZ32 = 2147483647
  minI: ZZ32 = -maxI - 1
  a46340: ZZ32 = 46340
  a46341: ZZ32 = 46341
  a46342: ZZ32 = 46342
  println("A1 ZZ32 3 LSHIFT 31 [text: congruent to 3 2^31 mod 2^32, -2147483648]: " r32(fn () => three LSHIFT thirtyOne))
  println("A2 ZZ32 MAX LSHIFT 1 [text: -2, no IntegerOverflow]: " r32(fn () => maxI LSHIFT one))
  println("A3 ZZ32 -7 RSHIFT 1 [text: floor(-7/2) = -4]: " r32(fn () => mSeven RSHIFT one))
  println("A4 ZZ32 -1 RSHIFT 100 [text: -1]: " r32(fn () => mOne RSHIFT hundred))
  println("A5 ZZ32 5 LSHIFT -1 [text: 5 RSHIFT 1 = 2]: " r32(fn () => five LSHIFT mOne))
  println("A6 ZZ32 -5 LSHIFT -1 [text: floor(-5/2) = -3]: " r32(fn () => mFive LSHIFT mOne))
  println("A7 ZZ32 -5 RSHIFT MIN [text: -5 LSHIFT 2^31 = 0]: " r32(fn () => mFive RSHIFT minI))
  println("A8 ZZ32 -5 LSHIFT MIN [text: -5 RSHIFT 2^31 = -1]: " r32(fn () => mFive LSHIFT minI))
  println("D1 ZZ32 MIN GCD MIN [text: 2^31, IntegerOverflow]: " r32(fn () => minI GCD minI))
  println("D2 ZZ32 MIN GCD 2 [text: 2]: " r32(fn () => minI GCD two))
  println("D3 ZZ32 MIN LCM 1 [text: |MIN| = 2^31, IntegerOverflow]: " r32(fn () => minI LCM one))
  println("D4 ZZ32 1 LCM MIN [text: IntegerOverflow]: " r32(fn () => one LCM minI))
  println("D5 ZZ32 -4 GCD -6 [text: 2]: " r32(fn () => mFour GCD mSix))
  println("D6 ZZ32 -4 LCM -6 [text: 12]: " r32(fn () => mFour LCM mSix))
  println("D7 ZZ32 0 GCD 0 [text: |0| = 0]: " r32(fn () => zero GCD zero))
  println("D8 ZZ32 MIN LCM 0 [text: 0]: " r32(fn () => minI LCM zero))
  println("D9 ZZ32 46341 LCM 46340 [text: 2147441940, fits]: " r32(fn () => a46341 LCM a46340))
  println("D10 ZZ32 46341 LCM 46342 [text: 2147534622, IntegerOverflow]: " r32(fn () => a46341 LCM a46342))
  println("D11 ZZ32 MIN LCM -1 [text: IntegerOverflow]: " r32(fn () => minI LCM mOne))
  oneL: ZZ64 = 1
  threeL: ZZ64 = 3
  fiveL: ZZ64 = 5
  mFiveL: ZZ64 = -5
  mSevenL: ZZ64 = -7
  mOneL: ZZ64 = -1
  zeroL: ZZ64 = 0
  sixtyThree: ZZ64 = 63
  sixtyFour: ZZ64 = 64
  maxL: ZZ64 = 9223372036854775807
  minL: ZZ64 = -maxL - 1
  b499: ZZ64 = 3037000499
  b500: ZZ64 = 3037000500
  b501: ZZ64 = 3037000501
  twoTo32: ZZ64 = 4294967296
  twoTo31: ZZ64 = 2147483648
  println("B1 ZZ64 3 LSHIFT 63 [text: -9223372036854775808]: " r64(fn () => threeL LSHIFT sixtyThree))
  println("B2 ZZ64 -7 RSHIFT 1 [text: -4]: " r64(fn () => mSevenL RSHIFT oneL))
  println("B3 ZZ64 1 LSHIFT 64 [text: 0]: " r64(fn () => oneL LSHIFT sixtyFour))
  println("B4 ZZ64 -1 RSHIFT 64 [text: -1]: " r64(fn () => mOneL RSHIFT sixtyFour))
  println("B5 ZZ64 -5 LSHIFT MIN [text: -1]: " r64(fn () => mFiveL LSHIFT minL))
  println("B6 ZZ64 5 RSHIFT MIN [text: 0]: " r64(fn () => fiveL RSHIFT minL))
  println("C1 ZZ64 narrow(2^32 + 5) [text: 5]: " r32(fn () => narrow(twoTo32 + fiveL)))
  println("C2 ZZ64 narrow(2^31) [text: -2147483648]: " r32(fn () => narrow(twoTo31)))
  println("C3 ZZ64 narrow(-2^31 - 1) [text: 2147483647]: " r32(fn () => narrow(-twoTo31 - oneL)))
  println("C4 ZZ64 narrow(MAX) [text: -1]: " r32(fn () => narrow(maxL)))
  println("C5 ZZ64 narrow(MIN) [text: 0]: " r32(fn () => narrow(minL)))
  println("E1 ZZ64 MIN GCD 0 [text: IntegerOverflow]: " r64(fn () => minL GCD zeroL))
  println("E2 ZZ64 MIN LCM 1 [text: IntegerOverflow]: " r64(fn () => minL LCM oneL))
  println("E3 ZZ64 3037000499 LCM 3037000500 [text: 9223372033963249500, fits]: " r64(fn () => b499 LCM b500))
  println("E4 ZZ64 3037000500 LCM 3037000501 [text: IntegerOverflow]: " r64(fn () => b500 LCM b501))
  println("E5 ZZ64 0 GCD -5 [text: 5]: " r64(fn () => zeroL GCD mFiveL))
  println("E6 ZZ64 1 LCM -5 [text: 5]: " r64(fn () => oneL LCM mFiveL))
end

end

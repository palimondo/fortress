component XXXComprisesWhereFunctionalMethodBounds
export Executable

(* A generic functional method of a trait whose comprises clause lists a type at a type where-clause variable, beside a generic top-level function of the same name whose domain meets its own, satisfies none of the rules of valid overloading, read with the static parameters' bounds (overloading.tex, section "Declarations with Static Parameters"). *)

trait AnyC comprises { C[\E\] } where [\E\]
  cat[\T extends Object\](self, t: T): AnyC = self
end
trait C[\E\] extends AnyC end
object Ci[\E\](item: E) extends C[\E\] end

cat[\T extends Object\](x: T, t: ZZ32): AnyC = Ci[\ZZ32\](1)

run(): () = do
  println("PASS")
end

end

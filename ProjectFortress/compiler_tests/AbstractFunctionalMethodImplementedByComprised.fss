(* An abstract functional method of a trait that comprises one object, beside that object's declaration of it with the same parameter type, is one method the object defines, not two declarations with the same parameter type (traits.tex, section "Method Declarations"; overloading.tex, section "Principles of Overloading"). *)
component AbstractFunctionalMethodImplementedByComprised
export Executable

trait Q comprises { R }
  num(self): ZZ32
end
object R extends Q
  num(self): ZZ32 = 1
end

run(): () = do
    q: Q = R
    assert(num(q), 1, "num(q) runs R's declaration")
    println("PASS")
  end

end

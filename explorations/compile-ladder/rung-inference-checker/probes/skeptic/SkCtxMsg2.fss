component SkCtxMsg2
export Executable

object Seen end
object BoxA[\T extends Any\](v: ZZ32) end
object BoxT[\T\](v: ZZ32) end
bAny[\T extends Any\](): BoxA[\T\] = BoxA[\T\](0)
bArg[\T extends Any\](x: ZZ32): BoxA[\T\] = BoxA[\T\](x)
bObj[\T extends Object\](): BoxT[\T\] = BoxT[\T\](0)

c3(): Seen = bAny()
c5(): Seen = bArg(1)
c6(): () = do x: Seen = bAny(); () end
c7(): () = do x: Seen = bArg(1); () end
c8(): Seen = bObj()

run(): () = ()

end

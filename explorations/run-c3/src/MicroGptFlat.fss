(* MicroGptFlat -- microGPT in native Fortress arrays, data designed after Hsu
   (Run C3). The model only: hyperparameters, the layout table, the step,
   Adam, the training loop. The array vocabulary is FlatArrays, the loaders
   and the corpus are FlatData. Follows
   explorations/apl/reference/hsu-flat/microgpt_concise.dyalog line for line;
   each line is judged against its formula first (explorations/run-c3/tour.md).
   Run from explorations/run-c3/src (the corpus and weight paths are relative). *)
component MicroGptFlat
export MicroGptFlat
export Executable
import FlatArrays.{...}
import FlatData.{...}
import System.{...}

(* --------------------------------------------------- hyperparameters ---- *)
nEmbd: ZZ32 = 16
blockSize: ZZ32 = 16
nHead: ZZ32 = 4
headDim: ZZ32 = 4
vocabSize: ZZ32 = 27
bosId: ZZ32 = 26
epsRms: RR64 = 10.0^(-5)
lr0: RR64 = 0.01
beta1: RR64 = 0.85
beta2: RR64 = 0.99
epsAdam: RR64 = 10.0^(-8)
scheduleLength: ZZ32 = 1000
corpusPath: String = "../../apl/reference/dzaima/docs.txt"
weightsDir: String = "../../apl/reference/dzaima/w"

(* ------------------------- the layout: nine matrices in one flat vector -- *)
matName(i: ZZ32): String =
    if i = 0 then "wte" elif i = 1 then "wpe" elif i = 2 then "lm_head"
    elif i = 3 then "attn_wq" elif i = 4 then "attn_wk" elif i = 5 then "attn_wv"
    elif i = 6 then "attn_wo" elif i = 7 then "mlp_fc1" else "mlp_fc2" end
matRows(i: ZZ32): ZZ32 = if (i = 0) OR (i = 2) then vocabSize elif i = 7 then 4 nEmbd else nEmbd end
matCols(i: ZZ32): ZZ32 = if i = 8 then 4 nEmbd else nEmbd end
matOffset(i: ZZ32): ZZ32 = SUM[j <- 0#i] matRows(j) matCols(j)
nParams(): ZZ32 = matOffset(9)
(* matrix i as a zero-copy view of p, and all nine: v¨⍳9 *)
view(p: Array[\RR64,ZZ32\], i: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] = view(p, matOffset(i), matRows(i), matCols(i))
views(p: Array[\RR64,ZZ32\]) = (view(p,0), view(p,1), view(p,2), view(p,3), view(p,4), view(p,5), view(p,6), view(p,7), view(p,8))
(* the nine gradient matrices back into one flat vector: ⊃,/,¨ *)
flat(g0: Array[\RR64,(ZZ32,ZZ32)\], g1: Array[\RR64,(ZZ32,ZZ32)\], g2: Array[\RR64,(ZZ32,ZZ32)\], g3: Array[\RR64,(ZZ32,ZZ32)\], g4: Array[\RR64,(ZZ32,ZZ32)\],
     g5: Array[\RR64,(ZZ32,ZZ32)\], g6: Array[\RR64,(ZZ32,ZZ32)\], g7: Array[\RR64,(ZZ32,ZZ32)\], g8: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,ZZ32\] = do
    g = zeros(nParams())
    view(g,0).assign(g0); view(g,1).assign(g1); view(g,2).assign(g2); view(g,3).assign(g3); view(g,4).assign(g4)
    view(g,5).assign(g5); view(g,6).assign(g6); view(g,7).assign(g7); view(g,8).assign(g8)
    g
  end
(* the transpose operator lives here and not in the vocabulary: an api file
   cannot declare a postfix ^T (Run C3 gap row) *)
opr (m: Matrix[\RR64,r,c\])^T[\nat r, nat c\]: Matrix[\RR64,c,r\] = m.t()

(* ------------------------------------- the row-level functions, once ---- *)
rmsn(x: Array[\RR64,ZZ32\]): Array[\RR64,ZZ32\] = x / SQRT (epsRms + (x DOT x) / |x|)
sm(z: Array[\RR64,ZZ32\]): Array[\RR64,ZZ32\] = do e = exp(z - (BIG MAX[t <- z] t)); e / (SUM e) end
rmsnB(dy: Array[\RR64,ZZ32\], x: Array[\RR64,ZZ32\]): Array[\RR64,ZZ32\] = do
    r = SQRT (epsRms + (x DOT x) / |x|); y = x / r
    (dy - y ((y DOT dy) / |y|)) / r
  end
smB(p: Array[\RR64,ZZ32\], dy: Array[\RR64,ZZ32\]): Array[\RR64,ZZ32\] = p × (dy - (p DOT dy))
(* the causal mask, additive: ¯1E10 above the diagonal *)
causalMask: Array[\RR64,(ZZ32,ZZ32)\] = mat(blockSize, blockSize, fn (i, j) => if j > i then -(10.0^10) else 0.0 end)
(* f⍤2 over the per-head cells: rows 16d.., the columns of head h *)
heads(f: (Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\]) -> Array[\RR64,(ZZ32,ZZ32)\],
      a: Array[\RR64,(ZZ32,ZZ32)\], b: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] = cells(f, a, b, blockSize, nHead)
heads(f: (Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\]) -> Array[\RR64,(ZZ32,ZZ32)\],
      a: Array[\RR64,(ZZ32,ZZ32)\], b: Array[\RR64,(ZZ32,ZZ32)\], c: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] = cells(f, a, b, c, blockSize, nHead)

corpus: Corpus = loadCorpus(corpusPath, blockSize, bosId)

(* ------------------- the step: keys -> (loss, flat gradient). Pure. ----- *)
step(p: Array[\RR64,ZZ32\], b: Array[\ZZ32,ZZ32\]): (RR64, Array[\RR64,ZZ32\]) = do
    ids = corpus.tokens(b, 0); tg = corpus.tokens(b, 1); vm = corpus.valid(b); nv = SUM vm; pos = corpus.positions(b)
    (wte, wpe, lm, wq, wk, wv, wo, f1, f2) = views(p)
    (* -- forward, all (doc,pos) rows at once -- *)
    x = gather(wte, ids) + gather(wpe, pos)
    xp = rows(rmsn, x); x1 = rows(rmsn, xp)
    q = x1 (wq^T); k = x1 (wk^T); v = x1 (wv^T)
    att = heads(fn (qc, kc) => rows(sm, (qc (kc^T)) / SQRT (1.0 headDim) + causalMask), q, k)
    hc = heads(fn (ac, vc) => ac vc, att, v)
    x2 = xp + hc (wo^T); x3 = rows(rmsn, x2); m0 = x3 (f1^T); mr = 0.0 MAX m0; x4 = x2 + mr (f2^T)
    pr = rows(sm, x4 (lm^T)); loss = -(vm DOT log(pick(pr, tg))) / nv
    (* -- backward, one line under each forward line, bottom-up -- *)
    dL = rows(fn (w, r) => w r, vm / nv, pr - onehot(tg, vocabSize)); gLM = (dL^T) x4; dX4 = dL lm
    gF2 = (dX4^T) mr; dM0 = (dX4 f2) × (m0 > 0.0); gF1 = (dM0^T) x3; dX3 = dM0 f1
    dX2 = dX4 + rows(rmsnB, dX3, x2); gWO = (dX2^T) hc; dH = dX2 wo
    dV = heads(fn (ac, dc) => (ac^T) dc, att, dH)
    dS = heads(fn (ac, dc, vc) => rows(smB, ac, dc (vc^T)), att, dH, v) / SQRT (1.0 headDim)
    dQ = heads(fn (sc, kc) => sc kc, dS, k); dK = heads(fn (sc, qc) => (sc^T) qc, dS, q)
    gWQ = (dQ^T) x1; gWK = (dK^T) x1; gWV = (dV^T) x1; dX1 = dQ wq + dK wk + dV wv
    dXp = dX2 + rows(rmsnB, dX1, xp); dX = rows(rmsnB, dXp, x)
    yi = onehot(ids, vocabSize); yp = onehot(pos, blockSize); gWTE = (yi^T) dX; gWPE = (yp^T) dX
    (loss, flat(gWTE, gWPE, gLM, gWQ, gWK, gWV, gWO, gF1, gF2))
  end

(* --------------------- Adam: three whole-vector expressions over P, M, V -- *)
adam(p: Array[\RR64,ZZ32\], m: Array[\RR64,ZZ32\], v: Array[\RR64,ZZ32\],
     g: Array[\RR64,ZZ32\], t: ZZ32, lr: RR64): (Array[\RR64,ZZ32\], Array[\RR64,ZZ32\], Array[\RR64,ZZ32\]) = do
    m' = beta1 m + (1 - beta1) g; v' = beta2 v + (1 - beta2) (g × g)
    (p - lr (m' / (1 - beta1^t)) / (SQRT (v' / (1 - beta2^t)) + epsAdam), m', v')
  end
learningRate(s: ZZ32): RR64 = lr0 (1 - (1.0 s) / scheduleLength)

(* --------------------------------------------------- training ----------- *)
run(): () = do
    println "microgpt flat | params " nParams() " | corpus " corpus.size() " x " (blockSize + 1) " | batch 1, 5 steps"
    p: Array[\RR64,ZZ32\] := loadParams(weightsDir, matName, 9, nParams())
    m: Array[\RR64,ZZ32\] := zeros(nParams())
    v: Array[\RR64,ZZ32\] := zeros(nParams())
    for s <- seq(0#5) do
        t0 = nanoTime()
        (l, g) = step(p, keys(1, fn (i: ZZ32): ZZ32 => s MOD corpus.size()))
        (p, m, v) := adam(p, m, v, g, s + 1, learningRate(s))
        println "step " (s + 1) " loss " l "  (" ((nanoTime() - t0) DIV 1000000) " ms)"
    end
  end
end

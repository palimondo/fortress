component CMaxNN32RR64
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    NN32 => "NN32"
    NN64 => "NN64"
    ZZ => "ZZ"
    IntLiteral => "IntLiteral"
    RR64 => "RR64"
    else => "other"
  end

run(): () = do
    k: ZZ32 = 3
    u: NN32 = unsigned(k)
    f: RR64 = 2.5
    r = u MAX f
    println("u MAX f = " r " : " typeOf(r))
  end

end

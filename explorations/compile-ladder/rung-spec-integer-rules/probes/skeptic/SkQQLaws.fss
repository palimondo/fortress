component SkQQLaws
export Executable

(*) Skeptic's probe of rung P's sentence on QQ's four traits: which laws fail where 0/0 or an infinity takes part.
run(): () = do
  a: QQ = 1/3
  b: QQ = 1/6
  z: QQ = 0/0
  pinf: QQ = 1/0
  ninf: QQ = -1/0
  zero: QQ = 0
  println("finite: a + (-a) = 0: " ((a + (-a)) = zero))
  println("finite: a <= a: " (a <= a) ", a MIN b = b: " ((a MIN b) = b))
  println("finite: SUM of a, b, a: " (SUM[\QQ\] [i <- 0#3] (if i = 1 then b else a end)))
  println("infinity: 1/0 <= 1/0 (reflexive): " (pinf <= pinf))
  println("infinity: -1/0 <= a <= 1/0: " ((ninf <= a) AND (a <= pinf)))
  println("infinity: (1/0) CMP (-1/0): " (pinf CMP ninf))
  println("infinity: (1/0) MAX a = 1/0: " ((pinf MAX a) = pinf))
  println("infinity: (1/0) + (-(1/0)) = 0 (group inverse): " ((pinf + (-pinf)) = zero) " (the sum is " (pinf + (-pinf)) ")")
  println("infinity: 0 (1/0) = 0 (ring zero): " ((zero pinf) = zero) " (the product is " (zero pinf) ")")
  println("0/0: 0/0 <= 0/0 (reflexive): " (z <= z))
  println("0/0: 0/0 + (-(0/0)) = 0: " ((z + (-z)) = zero))
end

end

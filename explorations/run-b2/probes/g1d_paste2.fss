(* D2: nested array literal -- [[ h1 h2 h3 h4 ]] makes the paste rank 2, so
   every axis of the elements is covered by an `extents` row rather than by
   `extentSums`, which D1 showed is initialised to 0 instead of -1. *)
component g1d_paste2
export Executable

mk(base: RR64): Matrix[\RR64,3,4\] =
    matrix[\RR64,3,4\]().fill(fn (i:ZZ32,j:ZZ32):RR64 => base + 1.0 (4 i + j))

run(): () = do
    h1: Matrix[\RR64,3,4\] = mk(100.0)
    h2: Matrix[\RR64,3,4\] = mk(200.0)
    h3: Matrix[\RR64,3,4\] = mk(300.0)
    h4: Matrix[\RR64,3,4\] = mk(400.0)
    cat: Matrix[\RR64,3,16\] = [ [ h1 h2 h3 h4 ] ]
    println("cat = " cat)
  end
end

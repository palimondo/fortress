(* See explorations/compile-ladder/rung-size-range/REPORT.md. *)
component XXXTryCompareCoerceRungE
export Executable

f(): ZZ32 = throw InvalidRange

run(): () = do
  println("REACHED")
  r = try f() catch e InvalidRange => -1 end
  assert(r = -1, "a try expression whose catch clause answers a numeral, its value compared with a numeral, row 340; Specification/basic/expressions/try.tex:56-64")
  println("PASS")
end

end

(* An array literal assigned to a variable of an array type is that array; aggregate.tex, subsection "Array Expressions"; bindings.tex, section "Assignments". *)
component XXXArrayLiteralAssigned
export Executable

run(): () = do
    u: ZZ32[2] = [5 6]
    var t: ZZ32[2] = u
    t := [7 8]
    assert(t[1], 8, "a literal assigned to a var")
end

end

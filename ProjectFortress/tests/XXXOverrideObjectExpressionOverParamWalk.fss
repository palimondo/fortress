component XXXOverrideObjectExpressionOverParamWalk
export Executable

(* An object expression in a generic function whose override over String inherits its declaration over the function's unbounded static parameter overrides nothing, a static error, so the program is refused at load, under walk (traits.tex, section "Method Declarations"). *)

trait A[\T\]
  f(x: T): String = "A"
end

mk[\T\](y: T): A[\T\] = object extends A[\T\]
    override f(x: String): String = "E"
  end

run(): () = do
    println(mk[\ZZ32\](1).f("s"))
  end

end

component FailWordProbe
export Executable

check(name: String, got: RR64, want: RR64): () =
    if got = want then
        println(name " = " got)
    else
        println("fail " name ": got " got ", want " want)
    end

check(name: String, got: ZZ32, want: ZZ32): () =
    if got = want then
        println(name " = " got)
    else
        println("fail " name ": got " got ", want " want)
    end

run(): () = do
    v = array[\RR64\](3).fill(fn (i: ZZ32): RR64 => 1.0 i - 1.0)
    check("(v + 1.0)[0]", (v + 1.0)[0], 99.0)
    check("(1.0 + v)[2]", (1.0 + v)[2], 2.0)
    check("(v - 1.0)[0]", (v - 1.0)[0], -2.0)
    check("(1.0 - v)[0]", (1.0 - v)[0], 2.0)
    check("(0.0 MAX v)[0]", (0.0 MAX v)[0], 0.0)
    check("(v MAX 0.0)[2]", (v MAX 0.0)[2], 1.0)
    check("(0.0 MIN v)[2]", (0.0 MIN v)[2], 0.0)
    check("(v MIN 0.0)[0]", (v MIN 0.0)[0], -1.0)

    m: Matrix[\RR64,2,2\] = matrix[\RR64,2,2\](2.0)
    m[0,1] := -3.0
    m[1,0] := 0.0
    check("(m + 1.0)[0,1]", (m + 1.0)[0,1], -2.0)
    check("(1.0 + m)[1,0]", (1.0 + m)[1,0], 1.0)
    check("(m - 1.0)[0,0]", (m - 1.0)[0,0], 1.0)
    check("(1.0 - m)[0,1]", (1.0 - m)[0,1], 4.0)
    check("(0.0 MAX m)[0,1]", (0.0 MAX m)[0,1], 0.0)
    check("(m MAX 0.0)[0,0]", (m MAX 0.0)[0,0], 2.0)
    check("(0.0 MIN m)[0,0]", (0.0 MIN m)[0,0], 0.0)
    check("(m MIN 0.0)[0,1]", (m MIN 0.0)[0,1], -3.0)

    iv = array[\ZZ32\](3).fill(fn (i: ZZ32): ZZ32 => i - 1)
    check("(iv + 1)[0]", (iv + 1)[0], 0)
    check("(1 + iv)[2]", (1 + iv)[2], 2)
    check("(iv - 1)[0]", (iv - 1)[0], -2)
    check("(1 - iv)[0]", (1 - iv)[0], 2)
    check("(0 MAX iv)[0]", (0 MAX iv)[0], 0)
    check("(iv MAX 0)[2]", (iv MAX 0)[2], 1)
    check("(0 MIN iv)[2]", (0 MIN iv)[2], 0)
    check("(iv MIN 0)[0]", (iv MIN 0)[0], -1)
end

end

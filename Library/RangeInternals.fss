component RangeInternals
import TypeProxy.{...}
export RangeInternals

private printLimit = 5

(************************************************************
* Bounds juggling and modular arithmetic
************************************************************)

(** Much of the complexity in ranges is getting the corner cases right
    for unbounded ranges, backwards ranges, and intersection thereof.
    There's hairy modular arithmetic involved in intersecting strided
    ranges, but that mostly involves working around the round-to-0
    behavior of machine arithmetic (which is exceedingly
    irritating). **)

(* Round to nearest multiple of stride towards 0. *)
roundToStride(amt:ZZ32, stride:ZZ32): ZZ32 =
    stride (amt DIV stride)

(* Perform necessary arithmetic on strides to find starting points of
   ranges.  The following start at the given starting point and go either
   up or down by stride, until the bound is reached as described.

   A positive stride is assumed! *)
atOrAboveGoingUp(start:ZZ32,bound:ZZ32,stride:ZZ32): ZZ32 =
    start + roundToStride(bound-start+stride-1, stride)
atOrBelowGoingUp(start:ZZ32,bound:ZZ32,stride:ZZ32): ZZ32 =
    start + roundToStride(bound-start, stride)
atOrBelowGoingDown(start:ZZ32,bound:ZZ32,stride:ZZ32): ZZ32 =
    start - roundToStride(start-bound+stride-1, stride)
atOrAboveGoingDown(start:ZZ32,bound:ZZ32,stride:ZZ32): ZZ32 =
    start - roundToStride(start-bound, stride)

(* These work as above, but do not assume a particular relationship0
   between starting point and bound---so they either count up or count
   down as appropriate.  This requires a test when rounding division
   to 0. *)
atOrBelow(start:ZZ32, bound:ZZ32, stride:ZZ32): ZZ32 =
    if start <= bound then atOrBelowGoingUp(start,bound,stride)
    else atOrBelowGoingDown(start,bound,stride) end

atOrAbove(start:ZZ32, bound:ZZ32, stride:ZZ32): ZZ32 =
    if start >= bound then atOrAboveGoingDown(start,bound,stride)
    else atOrAboveGoingUp(start,bound,stride) end

(* Find meeting point given the two bounds; tries to avoid overflow. *)
meetingPoint(init0:ZZ32, stride0:ZZ32, init1:ZZ32, stride1:ZZ32, stride:ZZ32): Maybe[\ZZ32\] =
    if init0 = init1 then Just[\ZZ32\](init0)
    else
        (i_min,s_min,i_max,s_max) : (ZZ32,ZZ32,ZZ32,ZZ32) :=
            if init0 < init1 then
                (init0,stride0,init1,stride1)
            else
                (init1,stride1,init0,stride0)
            end
        i_max := atOrAboveGoingDown(i_max,i_min,s_max)
        endPoint = i_min + stride
        while i_max =/= i_min AND i_max < endPoint do
            i_next = atOrAboveGoingUp(i_min,i_max,s_min)
            (i_min,s_min,i_max,s_max) := (i_max,s_max,i_next,s_min)
        end
        if i_max = i_min then
            Just[\ZZ32\](i_max)
        else
            Nothing[\ZZ32\]
        end
    end

(************************************************************
* Help for comparisons
************************************************************)

(** Stride comparison *)
opr SCMP(a:ZZ32, b:ZZ32): Comparison =
    if a = b then EqualTo
    elif (a < 0 AND b > 0) OR (a > 0 AND b < 0) then
        Unordered
    elif a DIVIDES b then
        GreaterThan
    elif b DIVIDES a then
        LessThan
    else
        Unordered
    end

opr SCMP(a:(ZZ32,ZZ32), b:(ZZ32,ZZ32)): Comparison = do
    (ai,aj) = a; (bi,bj) = b
    (ai SCMP bi) SYMMETRIC_PARTIAL (aj SCMP bj)
  end

opr SCMP(a:(ZZ32,ZZ32,ZZ32), b:(ZZ32,ZZ32,ZZ32)): Comparison = do
    (ai,aj,ak) = a; (bi,bj,bk) = b
    (ai SCMP bi) SYMMETRIC_PARTIAL ((aj SCMP bj) SYMMETRIC_PARTIAL (ak SCMP bk))
  end


(** Point comparison *)
opr PCMP(a:ZZ32, b:ZZ32): Comparison = a CMP b

opr PCMP(a:(ZZ32,ZZ32), b:(ZZ32,ZZ32)): Comparison = do
    (ai,aj) = a; (bi,bj) = b
    (ai PCMP bi) SYMMETRIC_PARTIAL (aj PCMP bj)
  end

opr PCMP(a:(ZZ32,ZZ32,ZZ32), b:(ZZ32,ZZ32,ZZ32)): Comparison = do
    (ai,aj,ak) = a; (bi,bj,bk) = b
    (ai PCMP bi) SYMMETRIC_PARTIAL ((aj PCMP bj) SYMMETRIC_PARTIAL (ak PCMP bk))
  end


(** Bounds checks for narrowToRange *)
checkSelection[\R extends Range[\I\], I\]
              (this:Range[\I\], other: Range[\I\], r:R): R = do
    tf = this.forward()
    otf = other.forward()
    for tfl <- tf.left, ofl <- otf.left, tfl > ofl, NOT tf.isEmpty, NOT otf.isEmpty do
        errorPrintln(other " left outside bounds " this)
        throw IndexOutOfBounds[\I\](this,ofl)
    end
    for tfr <- tf.right, ofr <- otf.right, tfr < ofr, NOT tf.isEmpty, NOT otf.isEmpty do
        errorPrintln(other " right outside bounds " this)
        throw IndexOutOfBounds[\I\](this,ofr)
    end
    r
  end

(************************************************************
* Concrete Range Traits
************************************************************)

trait ScalarRange extends { Range[\ZZ32\] }
    truncL(l:ZZ32): BoundedScalarRange
    truncR(r:ZZ32): BoundedScalarRange = self.flip().truncL(r).flip()
    flip(): ScalarRange
    every(s:ZZ32): ScalarRange
    imposeStride(s:ZZ32): ScalarRange
    atMost(n:ZZ32): ScalarRange
    opr INTERSECTION(self, other: Range[\ZZ32\]): ScalarRange =
        fail("ScalarRange INTERSECTION Range!  Shouldn't happen.")
    intersectWithExtent(e:ExtentScalarRange): ScalarRangeWithExtent
    indexOf(n:ZZ32): Maybe[\ZZ32\] = fail("indexOf of a scalar range with no left or right end")
    opr CMP(self, other:Range[\ZZ32\]): Comparison =
        ((self.stride SCMP other.stride) SYMMETRIC_PARTIAL:
         (self.forward() FORWARD_CMP other.forward()))
    check(): ScalarRange = do
        str = self.stride
        if str = 0 then fail(self.asDebugString ": Zero stride") end
        for l <- self.left, r <- self.right do
            if (l-r) MOD str =/= 0 AND NOT self.isEmpty then
                fail(self.asDebugString ": Bounds don't match stride.")
            end
        end
        self
      end
end

combine2D(i:ScalarRange, j:ScalarRange): Range2D =
    fail("shouldn't happen: combine2D of non-uniform ranges " i " and " j)

trait Range2D extends Range[\(ZZ32,ZZ32)\]
    getter range1(): ScalarRange
    getter range2(): ScalarRange
    getter stride(): (ZZ32,ZZ32) = (self.range1.stride, self.range2.stride)
    getter isEmpty(): Boolean = self.range1.isEmpty OR self.range2.isEmpty
    getter asString(): String = "(" self.range1 " BY " self.range2 ")"
    every(s_i:ZZ32, s_j:ZZ32): Range2D
    atMost(n_i:ZZ32, n_j:ZZ32): Range2D =
        combine2D(self.range1.atMost(n_i), self.range2.atMost(n_j))
    truncL(l_i:ZZ32, l_j:ZZ32): BoundedRange2D =
        combine2D(self.range1.truncL(l_i),self.range2.truncL(l_j))
    truncR(r_i:ZZ32, r_j:ZZ32): BoundedRange2D =
        combine2D(self.range1.truncR(r_i),self.range2.truncR(r_j))
    opr INTERSECTION(self, other: Range[\(ZZ32,ZZ32)\]): Range[\(ZZ32,ZZ32)\] =
        fail("other is Range[\\(ZZ32,ZZ32)\\] but not Range2D")
    opr INTERSECTION(self, other: Range2D): Range[\(ZZ32,ZZ32)\] =
        combine2D(self.range1 INTERSECTION other.range1,
                  self.range2 INTERSECTION other.range2)
    opr IN(n:(ZZ32,ZZ32), self): Boolean = do
        (n_i,n_j) = n
        n_i IN self.range1 AND: n_j IN self.range2
      end
    indexOf(n:(ZZ32,ZZ32)):Maybe[\(ZZ32,ZZ32)\] = do
        (n_i,n_j) = n
        if x_i <- self.range1.indexOf(n_i) then
            if x_j <- self.range2.indexOf(n_j) then
                Just[\(ZZ32,ZZ32)\](x_i,x_j)
            else
                Nothing[\(ZZ32,ZZ32)\]
            end
        else
            Nothing[\(ZZ32,ZZ32)\]
        end
      end
    opr =(self, other:Range2D): Boolean =
        self.range1 = other.range1 AND: self.range2 = other.range2
    opr CMP(self, other:Range[\(ZZ32,ZZ32)\]): Comparison =
        ((self.stride SCMP other.stride) SYMMETRIC_PARTIAL:
         (self.forward() FORWARD_CMP other.forward()))
    check():Range2D = do
        _ = self.range1.check()
        _ = self.range2.check()
        self
      end
end

trait ActualRange2D[\T extends ActualRange2D[\T, Scalar1, Scalar2\], Scalar1 extends ScalarRange, Scalar2 extends ScalarRange\] extends Range2D
    getter range1(): Scalar1
    getter range2(): Scalar2
    every(s_i:ZZ32, s_j:ZZ32): Range2D =
        combine2D(self.range1.every(s_i), self.range2.every(s_j))
    imposeStride(s_i:ZZ32, s_j:ZZ32): Range2D =
        combine2D(self.range1.imposeStride(s_i), self.range2.imposeStride(s_j))
    recombine(a:Scalar1, b:Scalar2): T
end

combine3D(i:ScalarRange, j:ScalarRange, k:ScalarRange): Range3D =
    fail("shouldn't happen: combine3D of non-uniform ranges " i " and " j)

trait Range3D extends Range[\(ZZ32,ZZ32,ZZ32)\]
    getter range1(): ScalarRange
    getter range2(): ScalarRange
    getter range3(): ScalarRange
    getter stride(): (ZZ32,ZZ32,ZZ32) =
        (self.range1.stride, self.range2.stride, self.range3.stride)
    getter isEmpty(): Boolean =
        self.range1.isEmpty OR self.range2.isEmpty OR self.range3.isEmpty
    getter asString(): String = "(" self.range1 " BY " self.range2 " BY " self.range3 ")"
    every(s_i:ZZ32, s_j:ZZ32, s_k:ZZ32): Range3D
    atMost(n_i:ZZ32, n_j:ZZ32, n_k:ZZ32): Range3D =
        combine3D(self.range1.atMost(n_i), self.range2.atMost(n_j), self.range3.atMost(n_k))
    truncL(l_i:ZZ32, l_j:ZZ32, l_k:ZZ32): BoundedRange3D =
        combine3D(self.range1.truncL(l_i), self.range2.truncL(l_j),self.range3.truncL(l_k))
    truncR(r_i:ZZ32, r_j:ZZ32, r_k:ZZ32): BoundedRange3D =
        combine3D(self.range1.truncR(r_i), self.range2.truncR(r_j),self.range3.truncR(r_k))
    opr INTERSECTION(self, other: Range[\(ZZ32,ZZ32,ZZ32)\]): Range[\(ZZ32,ZZ32,ZZ32)\] =
        fail("other is Range[\\(ZZ32,ZZ32,ZZ32)\\] but not Range3D")
    opr INTERSECTION(self, other: Range3D): Range[\(ZZ32,ZZ32,ZZ32)\] =
        combine3D(self.range1 INTERSECTION other.range1,
                  self.range2 INTERSECTION other.range2,
                  self.range3 INTERSECTION other.range3)
    opr IN(n:(ZZ32,ZZ32,ZZ32), self): Boolean = do
        (n_i,n_j,n_k) = n
        n_i IN self.range1 AND: n_j IN self.range2 AND: n_k IN self.range3
      end
    indexOf(n:(ZZ32,ZZ32,ZZ32)):Maybe[\(ZZ32,ZZ32,ZZ32)\] = do
        (n_i,n_j,n_k) = n
        if x_i <- self.range1.indexOf(n_i) then
            if x_j <- self.range2.indexOf(n_j) then
                if x_k <- self.range3.indexOf(n_k) then
                    Just[\(ZZ32,ZZ32,ZZ32)\](x_i,x_j,x_k)
                else
                    Nothing[\(ZZ32,ZZ32,ZZ32)\]
                end
            else
                Nothing[\(ZZ32,ZZ32,ZZ32)\]
            end
        else
            Nothing[\(ZZ32,ZZ32,ZZ32)\]
        end
      end
    opr =(self, other:Range3D): Boolean =
        self.range1 = other.range1 AND: self.range2 = other.range2 AND: self.range3 = other.range3
    opr CMP(self, other:Range[\(ZZ32,ZZ32,ZZ32)\]): Comparison =
        ((self.stride SCMP other.stride) SYMMETRIC_PARTIAL:
         (self.forward() FORWARD_CMP other.forward()))
    check():Range3D = do
        _ = self.range1.check()
        _ = self.range2.check()
        _ = self.range3.check()
        self
      end
end

trait ActualRange3D[\T extends ActualRange3D[\T, Scalar1, Scalar2, Scalar3\], Scalar1 extends ScalarRange, Scalar2 extends ScalarRange, Scalar3 extends ScalarRange\] extends Range3D
    getter range1(): Scalar1
    getter range2(): Scalar2
    getter range3(): Scalar3
    every(s_i:ZZ32, s_j:ZZ32, s_k:ZZ32): Range3D =
        combine3D(self.range1.every(s_i),
                  self.range2.every(s_j),
                  self.range3.every(s_k))
    imposeStride(s_i:ZZ32, s_j:ZZ32, s_k:ZZ32): Range3D =
        combine3D(self.range1.imposeStride(s_i),
                  self.range2.imposeStride(s_j),
                  self.range3.imposeStride(s_k))
    recombine(a:Scalar1, b:Scalar2, c:Scalar3): T
end

trait PartialScalarRange
    extends { ScalarRange, PartialRange[\ZZ32\] }
end

object OpenScalarRange(str: ZZ32)
        extends { PartialScalarRange, OpenRange[\ZZ32\] }
    getter stride(): ZZ32 = str
    getter asString(): String =
        if str > 0 then
            "...o,o+" str "..."
        else
            "...o,o" str "..."
        end
    getter asDebugString(): String = "OpenScalarRange(" str ")"
    truncL(l:ZZ32): LeftScalarRange = leftScalarRange(l,str)
    flip(): OpenScalarRange = OpenScalarRange(-str)
    forward(): OpenScalarRange = OpenScalarRange(|str|)
    every(s:ZZ32): OpenScalarRange =
        if s<0 AND str<0 then OpenScalarRange(-s str) else OpenScalarRange(s str) end
    imposeStride(s:ZZ32): OpenScalarRange = self.every(s)
    atMost(n:ZZ32): ScalarRangeWithExtent = extentScalarRange(n,str)
    opr =(self, b:OpenRange[\ZZ32\]): Boolean = self.stride = b.stride
    opr INTERSECTION(self, other: ScalarRange): ScalarRange = other.every(openEveryParam(other))
    intersectWithExtent(e:ExtentScalarRange): ScalarRangeWithExtent =
        e.every(openEveryParam(e))
    openEveryParam(r:ScalarRange): ZZ32 = do
        gcd = str GCD r.stride
        str DIV gcd
      end
end

combine2D(i:OpenScalarRange, j:OpenScalarRange): OpenRange2D =
    OpenRange2D(i.stride, j.stride)

object OpenRange2D(str_i:ZZ32, str_j:ZZ32)
        extends { OpenRange[\(ZZ32,ZZ32)\],
                  ActualRange2D[\OpenRange2D, OpenScalarRange, OpenScalarRange\] }
    getter stride(): (ZZ32,ZZ32) = (str_i,str_j)
    getter range1(): OpenScalarRange = OpenScalarRange(str_i)
    getter range2(): OpenScalarRange = OpenScalarRange(str_j)
    getter asDebugString(): String = "OpenRange2D(" str_i "," str_j ")"
    flip(): OpenRange2D = OpenRange2D(-str_i,-str_j)
    forward(): OpenRange2D = OpenRange2D(|str_i|,|str_j|)
    recombine(i:OpenScalarRange, j:OpenScalarRange): OpenRange2D =
        combine2D(i, j)
    opr IN(n:(ZZ32,ZZ32), self): Boolean = true
end

combine3D(i:OpenScalarRange, j:OpenScalarRange, k:OpenScalarRange): OpenRange3D =
    OpenRange3D(i.stride, j.stride, k.stride)

object OpenRange3D(str_i:ZZ32, str_j:ZZ32, str_k:ZZ32)
        extends { OpenRange[\(ZZ32,ZZ32,ZZ32)\],
                  ActualRange3D[\OpenRange3D, OpenScalarRange, OpenScalarRange, OpenScalarRange\] }
    getter stride(): (ZZ32,ZZ32,ZZ32) = (str_i,str_j,str_k)
    getter range1(): OpenScalarRange = OpenScalarRange(str_i)
    getter range2(): OpenScalarRange = OpenScalarRange(str_j)
    getter range3(): OpenScalarRange = OpenScalarRange(str_k)
    getter asDebugString(): String = "OpenRange3D(" str_i "," str_j "," str_k ")"
    flip(): OpenRange3D = OpenRange3D(-str_i,-str_j,-str_k)
    forward(): OpenRange3D = OpenRange3D(|str_i|,|str_j|,|str_k|)
    recombine(i:OpenScalarRange, j:OpenScalarRange, k:OpenScalarRange): OpenRange3D =
        combine3D(i, j, k)
    opr IN(n:(ZZ32,ZZ32,ZZ32), self): Boolean = true
end

open(): OpenScalarRange = OpenScalarRange(1)

trait ScalarRangeWithExtent
        extends { ScalarRange, RangeWithExtent[\ZZ32\] }
end

(* Invariant: ex > 0.  Means take every every |str|^th element, up to
   |ex| elements.  Work from left if ex is positive, from right if ex is
   negative.  Reverse afterwards if str is negative. *)
object ExtentScalarRange(ex:ZZ32, str:ZZ32)
        extends { ScalarRangeWithExtent, PartialScalarRange, ExtentRange[\ZZ32\] }
    getter stride(): ZZ32 = str
    getter extent(): Just[\ZZ32\] = Just[\ZZ32\]( |ex| )
    getter fromLeft(): Boolean = ex > 0
    getter asString(): String =
        case ex of
            1 => "l"
            -1 => "r"
            2 => if str > 0 then "l,l+" str else "l,l-" str end
            -2 => if str > 0 then "r-" str ",r" else "r+" (-str) ",r" end
            else =>
                if ex > 0 then
                    f = (ex-1) str
                    if str > 0
                    then "l,l+" str ",...l+" f
                    else "l,l" str ",...l" f end
                else
                    f = (-ex-1) str
                    if str > 0
                    then "r-" f "...,r-" str ",r"
                    else "r+" (-f) "...,r+" (-str) ",r" end
                end
        end
    getter asDebugString(): String = "ExtentScalarRange(" ex "," str ")"
    getter asExprString(): String = "(#" ex "):" str
    truncL(s:ZZ32): FullScalarRange =
        if ex > 0 then
            fullScalarRange(s, s + (ex-1) str, str)
        else
            fullScalarRange(s, s - (ex+1) str, str)
        end
    flip(): ExtentScalarRange = ExtentScalarRange(-ex, -str)
    forward(): ExtentScalarRange =
        if str < 0 then flip() else self end
    every(s:ZZ32): ExtentScalarRange =
        if s < 0 then
            every(-s).flip()
        else
            self.imposeStride(s)
        end
    imposeStride(s:ZZ32): ExtentScalarRange = do
          exr =
              if s > 0 then
                  if ex > 0 then ex+s-1 else ex-s+1 end
              else
                  if ex < 0 then ex+s+1 else ex-s-1 end
              end
          ExtentScalarRange(exr DIV s, s str)
        end
    atMost(n:ZZ32): ScalarRange =
        (* If either n or ex is negative, yield negative ex in result (for idempotence) *)
        if n = 0 then
            emptyScalarRange()
        elif n < 0 then
            ExtentScalarRange(-|ex| MAX n, str)
        elif ex < 0 then
            ExtentScalarRange(ex MAX -n, str)
        else
            ExtentScalarRange(ex MIN n, str)
        end
    opr INTERSECTION(self, other: ScalarRange): ScalarRangeWithExtent =
        other.intersectWithExtent(self)
    intersectWithExtent(e:ExtentScalarRange): ScalarRangeWithExtent = do
        x = self.extent.get MIN e.extent.get
        resultStride = str LCM e.stride
        s = if (str < 0 OR e.stride < 0) AND resultStride > 0
            then -resultStride
            else resultStride end
        if self.fromLeft AND e.fromLeft then
            extentScalarRange(x,s)
        else
            extentScalarRange(-x,s)
        end
      end
    opr =(self, b:ExtentScalarRange): Boolean =
        ex = b.ex AND (str = b.str OR ex=1 OR ex=-1)
    opr FORWARD_CMP(self, other: Range[\ZZ32\]): Comparison =
        if ext <- other.extent then
            ((self.extent.get PCMP ext) SYMMETRIC_PARTIAL:
             (if other.left.holds then GreaterThan else EqualTo end))
        elif other.left.holds OR other.right.holds then
            Unordered
        else
            LessThan
        end
    shiftLeft(amount: ZZ32): ExtentScalarRange = self
    shiftRight(amount: ZZ32): ExtentScalarRange = self
end

extentScalarRange(ex:ZZ32, str:ZZ32): ScalarRangeWithExtent =
    if ex = 0 then emptyScalarRange()
    else
        e = ExtentScalarRange(ex,str)
        _ = e.check()
        e
    end

combine2D(i:ExtentScalarRange, j:ExtentScalarRange): ExtentRange2D =
    ExtentRange2D(i.ex, j.ex, i.stride, j.stride)

object ExtentRange2D(ex_i:ZZ32, ex_j:ZZ32, str_i:ZZ32, str_j:ZZ32)
        extends { ExtentRange[\(ZZ32,ZZ32)\],
                  ActualRange2D[\ExtentRange2D, ExtentScalarRange, ExtentScalarRange\] }
    getter stride(): (ZZ32,ZZ32) = (str_i,str_j)
    getter extent(): Just[\(ZZ32,ZZ32)\] = Just[\(ZZ32,ZZ32)\]( |ex_i|, |ex_j| )
    getter range1(): ExtentScalarRange = ExtentScalarRange(ex_i,str_i)
    getter range2(): ExtentScalarRange = ExtentScalarRange(ex_j,str_j)
    getter asDebugString(): String = "ExtentRange2D(" ex_i "," ex_j ", " str_i "," str_j ")"
    getter asExprString(): String = "(#" self.extent "):" self.stride
    flip(): ExtentRange2D = ExtentRange2D(-ex_i,-ex_j,-str_i,-str_j)
    forward(): ExtentRange2D =
        self.recombine(self.range1.forward(), self.range2.forward())
    recombine(i:ExtentScalarRange, j:ExtentScalarRange): ExtentRange2D =
        combine2D(i, j)
    shiftLeft(amount: (ZZ32, ZZ32)): ExtentRange2D = self
    shiftRight(amount: (ZZ32, ZZ32)): ExtentRange2D = self
    opr IN(n:(ZZ32,ZZ32), self): Boolean = true
    opr FORWARD_CMP(self, other: Range[\(ZZ32,ZZ32)\]): Comparison =
        if ext <- other.extent then
            ((self.extent.get PCMP ext) SYMMETRIC_PARTIAL:
             (if other.left.holds then GreaterThan else EqualTo end))
        elif other.left.holds OR other.right.holds then
            Unordered
        else
            LessThan
        end
end

combine3D(i:ExtentScalarRange, j:ExtentScalarRange, k:ExtentScalarRange): ExtentRange3D =
    ExtentRange3D(i.ex, j.ex, k.ex, i.stride, j.stride, k.stride)

object ExtentRange3D(ex_i:ZZ32, ex_j:ZZ32, ex_k:ZZ32, str_i:ZZ32, str_j:ZZ32, str_k:ZZ32)
        extends { ExtentRange[\(ZZ32,ZZ32,ZZ32)\],
                  ActualRange3D[\ExtentRange3D, ExtentScalarRange, ExtentScalarRange, ExtentScalarRange\] }
    getter stride(): (ZZ32,ZZ32,ZZ32) = (str_i,str_j,str_k)
    getter extent(): Just[\(ZZ32,ZZ32,ZZ32)\] = Just[\(ZZ32,ZZ32,ZZ32)\]( |ex_i|, |ex_j| , |ex_k| )
    getter range1(): ExtentScalarRange = ExtentScalarRange(ex_i,str_i)
    getter range2(): ExtentScalarRange = ExtentScalarRange(ex_j,str_j)
    getter range3(): ExtentScalarRange = ExtentScalarRange(ex_k,str_k)
    getter asDebugString(): String = "ExtentRange3D(" ex_i "," ex_j "," ex_k ", " str_i "," str_j "," str_k ")"
    flip(): ExtentRange3D = ExtentRange3D(-ex_i,-ex_j,-ex_k,-str_i,-str_j,-str_k)
    forward(): ExtentRange3D =
        self.recombine(self.range1.forward(), self.range2.forward(), self.range3.forward())
    recombine(i:ExtentScalarRange, j:ExtentScalarRange, k:ExtentScalarRange): ExtentRange3D =
        combine3D(i, j, k)
    shiftLeft(amount: (ZZ32, ZZ32, ZZ32)):ExtentRange3D = self
    shiftRight(amount: (ZZ32, ZZ32, ZZ32)):ExtentRange3D = self
    opr IN(n:(ZZ32,ZZ32,ZZ32), self): Boolean = true
    opr FORWARD_CMP(self, other: Range[\(ZZ32,ZZ32,ZZ32)\]): Comparison =
        if ext <- other.extent then
            ((self.extent.get PCMP ext) SYMMETRIC_PARTIAL:
             (if other.left.holds then GreaterThan else EqualTo end))
        elif other.left.holds OR other.right.holds then
            Unordered
        else
            LessThan
        end
end

trait BoundedScalarRange
        extends { ScalarRange, BoundedRange[\ZZ32\] }
    truncL(l:ZZ32): BoundedScalarRange = do
        dir = if self.stride > 0 then 1 else -1 end
        self INTERSECTION leftScalarRange(l,dir)
      end
    flip(): BoundedScalarRange
    every(s:ZZ32): BoundedScalarRange
    atMost(n:ZZ32): FullScalarRange
    opr INTERSECTION(self, other: Range[\ZZ32\]): BoundedScalarRange =
        fail("BoundedScalarRange INTERSECTION Range!  Shouldn't happen.")
    opr INTERSECTION(self, other: ScalarRange): BoundedScalarRange =
        typecase other of
            other':BoundedScalarRange =>
                if self.stride < 0 OR other'.stride < 0 then
                    s = if self.stride < 0 then self.flip() else self end
                    o = if other'.stride < 0 then other'.flip() else other' end
                    s.forwardIntersection(o).flip()
                else
                    self.forwardIntersection(other')
                end
            other':ExtentScalarRange => self.intersectWithExtent(other')
            other':OpenScalarRange => self.every(other'.openEveryParam(self))
        end
    intersectWithExtent(e:ExtentScalarRange): FullScalarRange =
        if e.fromLeft then
            resultGCD = self.stride GCD e.stride
            str' = e.stride DIV resultGCD
            init = self
            adj = if str' < 0 then init.flip() else init end
            res = adj.every(str').atMost(e.extent.get) (*'*)
            if e.stride < 0 then res.flip() else res end
        else
            self.flip().intersectWithExtent(e.flip())
        end
    forwardIntersection(other: BoundedScalarRange): BoundedScalarRange =
        typecase other of
            other':FullScalarRange => other'.forwardIntersection(self)
            else =>
                resultStride = self.stride LCM other.stride
                self.nonemptyUpwardIntersection(other, resultStride)
        end
    (* nonemptyUpwardIntersection does the bulk of the work of opr INTERSECTION. *)
    nonemptyUpwardIntersection(other:BoundedScalarRange, resultStride:ZZ32):BoundedScalarRange =
        if p <- meetingPoint(self.leftOrRight,  self.stride,
                             other.leftOrRight, other.stride, resultStride) then
            other.nonemptyUpwardIntersectionWithPoint(self, resultStride, p)
        else
            emptyScalarRange()
        end
    nonemptyUpwardIntersectionWithPoint(other: BoundedScalarRange, resultStride:ZZ32, p:ZZ32): BoundedScalarRange
end

combine2D(i:BoundedScalarRange, j:BoundedScalarRange): BoundedRange2D =
    fail("shouldn't happen: combine2D of non-uniform ranges " i " and " j)

trait BoundedRange2D extends { Range2D, BoundedRange[\(ZZ32,ZZ32)\] }
    opr INTERSECTION(self, other: Range[\(ZZ32,ZZ32)\]): BoundedRange2D
    opr INTERSECTION(self, other: Range2D): BoundedRange2D
end

combine3D(i:BoundedScalarRange, j:BoundedScalarRange, k:BoundedScalarRange): BoundedRange3D =
    fail("shouldn't happen: combine3D of non-uniform ranges " i " and " j)

trait BoundedRange3D extends { Range3D, BoundedRange[\(ZZ32,ZZ32,ZZ32)\] }
    opr INTERSECTION(self, other: Range[\(ZZ32,ZZ32,ZZ32)\]): BoundedRange3D
    opr INTERSECTION(self, other: Range3D): BoundedRange3D
end

trait ScalarRangeWithLeft
        extends { BoundedScalarRange, RangeWithLeft[\ZZ32\] }
    maxLeft(other:ScalarRange): ZZ32 =
        if ol <- other.left then
            ol MAX self.left.get
        else
            self.left.get
        end
end

object LeftScalarRange(l:ZZ32, str:ZZ32)
        extends { ScalarRangeWithLeft, PartialScalarRange, LeftRange[\ZZ32\] }
    getter stride(): ZZ32 = str
    getter left(): Just[\ZZ32\] = Just[\ZZ32\](l)
    getter asString(): String = do
        t : ZZ32 := l
        v : String := "["
        n : ZZ32 := 1
        s = self.stride
        while n < printLimit do
            v ||= t ","
            t += s
            n += 1
        end
        v || t "..."
      end
    getter asDebugString(): String = "LeftScalarRange(" l "," str ")"
    flip(): RightScalarRange = rightScalarRange(l, -str)
    forward(): BoundedScalarRange =
        if str < 0 then self.flip() else self end
    every(s:ZZ32): BoundedScalarRange =
        if s < 0 then
            flip().every(-s)
        else
            self.imposeStride(s)
        end
    imposeStride(s:ZZ32): LeftScalarRange =
        leftScalarRange(l, s str)
    atMost(n:ZZ32): FullScalarRange =
        fullScalarRange(l, l + ( |n| - 1 ) str, str)
    opr =(self, b:LeftScalarRange): Boolean = l = b.l AND str = b.str
    opr IN(n:ZZ32, self): Boolean =
        (if self.stride > 0 then l <= n else n <= l) AND: (self.stride DIVIDES (n-l))
    indexOf(n:ZZ32):Maybe[\ZZ32\] = if (n IN self) then Just[\ZZ32\]((n-l) DIV self.stride) else Nothing[\ZZ32\] end
    opr FORWARD_CMP(self, other: Range[\ZZ32\]): Comparison =
        if otherLeft <- other.left then
            sl = self.left.get
            typecase sl PCMP otherLeft of
                Unordered => Unordered
                LessThan => GreaterThan
                EqualTo => if other.right.holds then GreaterThan else EqualTo end
                GreaterThan => if other.right.holds then Unordered else LessThan end
            end
        elif other.right.holds OR other.extent.holds then
            Unordered
        else
            LessThan
        end
    nonemptyUpwardIntersectionWithPoint(other: BoundedScalarRange, resultStride:ZZ32, p:ZZ32): ScalarRangeWithLeft =
        if r <- other.right then
            fullScalarRangeInter(l,r,resultStride,p)
        else
            leftScalarRangeInter(self.maxLeft(other),resultStride,p)
        end
    shiftLeft(amount: ZZ32): LeftScalarRange = leftScalarRange(l - amount, str)
    shiftRight(amount: ZZ32): LeftScalarRange = leftScalarRange(l + amount, str)
end

leftScalarRange(l:ZZ32, str:ZZ32): LeftScalarRange = do
    r = LeftScalarRange(l,str)
    _ = r.check()
    r
  end

leftScalarRangeInter(l:ZZ32, str:ZZ32, p:ZZ32): LeftScalarRange =
    leftScalarRange(atOrAbove(p,l,str),str)

combine2D(i:LeftScalarRange, j:LeftScalarRange): LeftRange2D =
    LeftRange2D(i.left.get, j.left.get, i.stride, j.stride)

object LeftRange2D(l_i:ZZ32, l_j:ZZ32, str_i:ZZ32, str_j:ZZ32)
        extends { LeftRange[\(ZZ32,ZZ32)\], BoundedRange2D,
                  ActualRange2D[\LeftRange2D, LeftScalarRange, LeftScalarRange\] }
    getter stride(): (ZZ32,ZZ32) = (str_i,str_j)
    getter left(): Just[\(ZZ32,ZZ32)\] = Just[\(ZZ32,ZZ32)\]( l_i, l_j )
    getter range1(): LeftScalarRange = LeftScalarRange(l_i,str_i)
    getter range2(): LeftScalarRange = LeftScalarRange(l_j,str_j)
    getter asDebugString(): String = "LeftRange2D(" l_i "," l_j ", " str_i "," str_j ")"
    flip(): RightRange2D = RightRange2D(l_i,l_j,-str_i,-str_j)
    forward(): BoundedRange2D =
        combine2D(self.range1.forward(), self.range2.forward())
    recombine(i:LeftScalarRange, j:LeftScalarRange): LeftRange2D =
        combine2D(i, j)
    opr INTERSECTION(self, other: Range[\(ZZ32,ZZ32)\]): BoundedRange2D =
        fail("other is Range[\\(ZZ32,ZZ32)\\] but not Range2D")
    opr INTERSECTION(self, other: Range2D): BoundedRange2D =
        combine2D(self.range1 INTERSECTION other.range1,
                  self.range2 INTERSECTION other.range2)
    opr FORWARD_CMP(self, other: Range[\(ZZ32,ZZ32)\]): Comparison =
        if otherLeft <- other.left then
            sl = self.left.get
            typecase sl PCMP otherLeft of
                Unordered => Unordered
                LessThan => GreaterThan
                EqualTo => if other.right.holds then GreaterThan else EqualTo end
                GreaterThan => if other.right.holds then Unordered else LessThan end
            end
        elif other.right.holds OR other.extent.holds then
            Unordered
        else
            LessThan
        end
    shiftLeft(amount: (ZZ32,ZZ32)):LeftRange2D = do
        (shift_i, shift_j) = amount
        LeftRange2D(l_i-shift_i, l_j-shift_j, str_i, str_j)
      end
    shiftRight(amount: (ZZ32,ZZ32)):LeftRange2D = do
        (shift_i, shift_j) = amount
        LeftRange2D(l_i+shift_i, l_j+shift_j, str_i, str_j)
      end
end

combine3D(i:LeftScalarRange, j:LeftScalarRange, k:LeftScalarRange): LeftRange3D =
    LeftRange3D(i.left.get, j.left.get, k.left.get, i.stride, j.stride, k.stride)

object LeftRange3D(l_i:ZZ32, l_j:ZZ32, l_k:ZZ32, str_i:ZZ32, str_j:ZZ32, str_k:ZZ32)
        extends { LeftRange[\(ZZ32,ZZ32,ZZ32)\], BoundedRange3D,
                  ActualRange3D[\LeftRange3D, LeftScalarRange, LeftScalarRange, LeftScalarRange\] }
    getter stride(): (ZZ32,ZZ32,ZZ32) = (str_i, str_j, str_k)
    getter left(): Just[\(ZZ32,ZZ32,ZZ32)\] = Just[\(ZZ32,ZZ32,ZZ32)\]( l_i, l_j , l_k )
    getter range1(): LeftScalarRange = LeftScalarRange(l_i,str_i)
    getter range2(): LeftScalarRange = LeftScalarRange(l_j,str_j)
    getter range3(): LeftScalarRange = LeftScalarRange(l_k,str_k)
    getter asDebugString(): String = "LeftRange3D(" l_i "," l_j "," l_k ", " str_i "," str_j "," str_k ")"
    flip(): RightRange3D = RightRange3D(l_i,l_j,l_k,-str_i,-str_j,-str_k)
    forward(): BoundedRange3D =
        combine3D(self.range1.forward(), self.range2.forward(), self.range3.forward())
    recombine(i:LeftScalarRange, j:LeftScalarRange, k:LeftScalarRange): LeftRange3D =
        combine3D(i, j, k)
    opr INTERSECTION(self, other: Range[\(ZZ32,ZZ32,ZZ32)\]): BoundedRange3D =
        fail("other is Range[\\(ZZ32,ZZ32,ZZ32)\\] but not Range3D")
    opr INTERSECTION(self, other: Range3D): BoundedRange3D =
        combine3D(self.range1 INTERSECTION other.range1,
                  self.range2 INTERSECTION other.range2,
                  self.range3 INTERSECTION other.range3)
    opr FORWARD_CMP(self, other: Range[\(ZZ32,ZZ32,ZZ32)\]): Comparison =
        if otherLeft <- other.left then
            sl = self.left.get
            typecase sl PCMP otherLeft of
                Unordered => Unordered
                LessThan => GreaterThan
                EqualTo => if other.right.holds then GreaterThan else EqualTo end
                GreaterThan => if other.right.holds then Unordered else LessThan end
            end
        elif other.right.holds OR other.extent.holds then
            Unordered
        else
            LessThan
        end
    shiftLeft(amount: (ZZ32, ZZ32, ZZ32)):LeftRange3D = do
        (shift_i, shift_j, shift_k) = amount
        LeftRange3D(l_i-shift_i, l_j-shift_j, l_k-shift_k, str_i, str_j, str_k)
      end
    shiftRight(amount: (ZZ32, ZZ32, ZZ32)):LeftRange3D = do
        (shift_i, shift_j, shift_k) = amount
        LeftRange3D(l_i+shift_i, l_j+shift_j, l_k+shift_k, str_i, str_j, str_k)
      end
end

trait ScalarRangeWithRight
        extends { BoundedScalarRange, RangeWithRight[\ZZ32\] }
    minRight(other:ScalarRange): ZZ32 =
        if ol <- other.right then
            ol MIN self.right.get
        else
            self.right.get
        end
end

object RightScalarRange(r:ZZ32, str:ZZ32)
        extends { ScalarRangeWithRight, PartialScalarRange, RightRange[\ZZ32\] }
    getter stride(): ZZ32 = str
    getter right(): Just[\ZZ32\] = Just[\ZZ32\](r)
    getter asString(): String = do
        t : ZZ32 := r
        v : String := "]"
        n : ZZ32 := 1
        s = self.stride
        while n < printLimit do
            v := "," t || v
            t -= s
            n += 1
        end
        "..." t || v
      end
    getter asDebugString(): String = "RightScalarRange(" r "," str ")"
    flip(): LeftScalarRange = leftScalarRange(r, -str)
    forward(): BoundedScalarRange =
        if str < 0 then self.flip() else self end
    every(s:ZZ32): BoundedScalarRange =
        if s < 0 then
            flip().every(-s)
        else
            self.imposeStride(s)
        end
    imposeStride(s:ZZ32): RightScalarRange =
        rightScalarRange(r, s str)
    atMost(n:ZZ32): FullScalarRange =
        fullScalarRange(r - ( |n| - 1 ) str, r, str)
    opr =(self, b:RightScalarRange): Boolean = r = b.r AND str = b.str
    opr IN(n:ZZ32, self): Boolean =
        (if self.stride > 0 then n <= r else r <= n) AND: (self.stride DIVIDES (r-n))
    indexOf(n:ZZ32):Maybe[\ZZ32\] = if (n IN self) then Just[\ZZ32\]((r-n) DIV self.stride) else Nothing[\ZZ32\] end
    opr FORWARD_CMP(self, other: Range[\ZZ32\]): Comparison =
        if otherRight <- other.right then
            sr = self.right.get
            typecase sr PCMP otherRight of
                Unordered => Unordered
                LessThan => if other.left.holds then Unordered else LessThan end
                EqualTo => if other.left.holds then GreaterThan else EqualTo end
                GreaterThan => GreaterThan
            end
        elif other.left.holds OR other.extent.holds then
            Unordered
        else
            LessThan
        end
    nonemptyUpwardIntersectionWithPoint(other: BoundedScalarRange, resultStride:ZZ32, p:ZZ32):
            ScalarRangeWithRight =
        if l <- other.left then
            fullScalarRangeInter(l,r,resultStride,p)
        else
            rightScalarRangeInter(self.minRight(other),resultStride,p)
        end
    shiftLeft(amount: ZZ32): RightScalarRange = rightScalarRange(r - amount, str)
    shiftRight(amount: ZZ32): RightScalarRange = rightScalarRange(r + amount, str)
end

rightScalarRange(r:ZZ32, str:ZZ32): RightScalarRange = do
    rr = RightScalarRange(r,str)
    _ = rr.check()
    rr
  end

rightScalarRangeInter(r:ZZ32, str:ZZ32, p:ZZ32): RightScalarRange =
    rightScalarRange(atOrBelow(p,r,str),str)

combine2D(i:RightScalarRange, j:RightScalarRange): RightRange2D =
    RightRange2D(i.right.get, j.right.get, i.stride, j.stride)

object RightRange2D(r_i:ZZ32, r_j:ZZ32, str_i:ZZ32, str_j:ZZ32)
        extends { RightRange[\(ZZ32,ZZ32)\], BoundedRange2D,
                  ActualRange2D[\RightRange2D, RightScalarRange, RightScalarRange\] }
    getter stride(): (ZZ32,ZZ32) = (str_i,str_j)
    getter right(): Just[\(ZZ32,ZZ32)\] = Just[\(ZZ32,ZZ32)\]( r_i, r_j )
    getter range1(): RightScalarRange = RightScalarRange(r_i,str_i)
    getter range2(): RightScalarRange = RightScalarRange(r_j,str_j)
    getter asDebugString(): String = "RightRange2D(" r_i "," r_j ", " str_i "," str_j ")"
    flip(): LeftRange2D = LeftRange2D(r_i,r_j,-str_i,-str_j)
    forward(): BoundedRange2D =
        combine2D(self.range1.forward(), self.range2.forward())
    recombine(i:RightScalarRange, j:RightScalarRange): RightRange2D =
        combine2D(i, j)
    opr INTERSECTION(self, other: Range[\(ZZ32,ZZ32)\]): BoundedRange2D =
        fail("other is Range[\\(ZZ32,ZZ32)\\] but not Range2D")
    opr INTERSECTION(self, other: Range2D): BoundedRange2D =
        combine2D(self.range1 INTERSECTION other.range1,
                  self.range2 INTERSECTION other.range2)
    opr FORWARD_CMP(self, other: Range[\(ZZ32,ZZ32)\]): Comparison =
        if otherRight <- other.right then
            sr = self.right.get
            typecase sr PCMP otherRight of
                Unordered => Unordered
                LessThan => if other.left.holds then Unordered else LessThan end
                EqualTo => if other.left.holds then GreaterThan else EqualTo end
                GreaterThan => GreaterThan
            end
        elif other.left.holds OR other.extent.holds then
            Unordered
        else
            LessThan
        end
    shiftLeft(amount: (ZZ32,ZZ32)):RightRange2D = do
        (shift_i, shift_j) = amount
        RightRange2D(r_i-shift_i, r_j-shift_j, str_i, str_j)
      end
    shiftRight(amount: (ZZ32,ZZ32)):RightRange2D = do
        (shift_i, shift_j) = amount
        RightRange2D(r_i+shift_i, r_j+shift_j, str_i, str_j)
      end
end

combine3D(i:RightScalarRange, j:RightScalarRange, k:RightScalarRange): RightRange3D =
    RightRange3D(i.right.get, j.right.get, k.right.get, i.stride, j.stride, k.stride)

object RightRange3D(r_i:ZZ32, r_j:ZZ32, r_k:ZZ32, str_i:ZZ32, str_j:ZZ32, str_k:ZZ32)
        extends { RightRange[\(ZZ32,ZZ32,ZZ32)\], BoundedRange3D,
                  ActualRange3D[\RightRange3D, RightScalarRange, RightScalarRange, RightScalarRange\] }
    getter stride(): (ZZ32,ZZ32,ZZ32) = (str_i,str_j,str_k)
    getter right(): Just[\(ZZ32,ZZ32,ZZ32)\] = Just[\(ZZ32,ZZ32,ZZ32)\]( r_i, r_j , r_k )
    getter range1(): RightScalarRange = RightScalarRange(r_i,str_i)
    getter range2(): RightScalarRange = RightScalarRange(r_j,str_j)
    getter range3(): RightScalarRange = RightScalarRange(r_k,str_k)
    getter asDebugString(): String = "RightRange3D(" r_i "," r_j "," r_k ", " str_i "," str_j "," str_k ")"
    flip(): LeftRange3D = LeftRange3D(r_i,r_j,r_k,-str_i,-str_j,-str_k)
    forward(): BoundedRange3D =
        combine3D(self.range1.forward(), self.range2.forward(), self.range3.forward())
    recombine(i:RightScalarRange, j:RightScalarRange, k:RightScalarRange): RightRange3D =
        combine3D(i, j, k)
    opr INTERSECTION(self, other: Range[\(ZZ32,ZZ32,ZZ32)\]): BoundedRange3D =
        fail("other is Range[\\(ZZ32,ZZ32,ZZ32)\\] but not Range3D")
    opr INTERSECTION(self, other: Range3D): BoundedRange3D =
        combine3D(self.range1 INTERSECTION other.range1,
                  self.range2 INTERSECTION other.range2,
                  self.range3 INTERSECTION other.range3)
    opr FORWARD_CMP(self, other: Range[\(ZZ32,ZZ32,ZZ32)\]): Comparison =
        if otherRight <- other.right then
            sr = self.right.get
            typecase sr PCMP otherRight of
                Unordered => Unordered
                LessThan => if other.left.holds then Unordered else LessThan end
                EqualTo => if other.left.holds then GreaterThan else EqualTo end
                GreaterThan => GreaterThan
            end
        elif other.left.holds OR other.extent.holds then
            Unordered
        else
            LessThan
        end
    shiftLeft(amount: (ZZ32, ZZ32, ZZ32)):RightRange3D = do
        (shift_i, shift_j, shift_k) = amount
        RightRange3D(r_i-shift_i, r_j-shift_j, r_k-shift_k, str_i, str_j, str_k)
      end
    shiftRight(amount: (ZZ32, ZZ32, ZZ32)):RightRange3D = do
        (shift_i, shift_j, shift_k) = amount
        RightRange3D(r_i+shift_i, r_j+shift_j, r_k+shift_k, str_i, str_j, str_k)
      end
end

trait FullScalarRange
        extends { ScalarRangeWithLeft, ScalarRangeWithRight,
                  ScalarRangeWithExtent, FullRange[\ZZ32\] }
    getter extent(): Just[\ZZ32\] = Just[\ZZ32\](self.size)
    getter bounds(): CompactFullScalarRange = CompactFullParScalarRange(0,self.size-1)
    getter asString(): String =
        if self.isEmpty then
            "[]"
        else
            r = self.right.get
            t : ZZ32 := self.left.get
            v : String := "["
            n : ZZ32 := 1
            s = self.stride
            if s > 0 then
                while t < r AND n < printLimit do
                    v ||= t ","
                    t += s
                    n += 1
                end
            else
                while t > r AND n < printLimit do
                    v ||= t ","
                    t += s
                    n += 1
                end
            end
            if t=r then
                v || t "]"
            else
                v || "... " r "]"
            end
        end
    flip(): FullScalarRange = fullScalarRange(self.right.get,self.left.get,-self.stride)
    forward(): FullScalarRange
    every(s:ZZ32): FullScalarRange =
        if s < 0 then
            flip().every(-s)
        else
            self.imposeStride(s)
        end
    imposeStride(s:ZZ32): FullScalarRange = do
        r = self.right.get
        l = self.left.get
        dist = r-l
        str = s self.stride
        if (str > 0) = (dist > 0) then
            steps = dist DIV str (* Doesn't work for empty b/c DIV rounds to 0! *)
            fullScalarRange(l, l + steps str, str)
        else
            fullScalarRange(l, r, str)
        end
      end
    atMost(n:ZZ32): FullScalarRange =
        if n >= 0 then
            l = self.left.get
            str = self.stride
            r' = l + (n-1) str (* ' *)
            r = self.right.get
            if (str > 0 AND r' > r) OR (str < 0 AND r' < r) then
                self
            else
                fullScalarRange(l, r', str)
            end
        else (* n < 0 *)
            r = self.right.get
            str = self.stride
            l' = r + (n+1) str (* ' *)
            l = self.left.get
            if (str > 0 AND l' < l) OR (str < 0 AND l' > l) then (* ' *)
                self
            else
                fullScalarRange(l', r, str) (* ' *)
            end
        end
    opr =(self, b:FullScalarRange): Boolean =
        (self.isEmpty AND b.isEmpty) OR
        (self.left = b.left AND self.right = b.right AND
            (self.stride = b.stride OR self.left=self.right))
    opr FORWARD_CMP(self, other: FullRange[\ZZ32\]): Comparison =
        ((other.left.get PCMP self.left.get) SYMMETRIC_PARTIAL:
         (self.right.get PCMP other.right.get))
    forwardIntersection(other: BoundedScalarRange): BoundedScalarRange =
        if self.isEmpty then self
        elif other.isEmpty then other
        else
            resultStride = self.stride LCM other.stride
            self.nonemptyUpwardIntersection(other, resultStride)
        end
    (* nonemptyUpwardIntersection does the bulk of the work of opr INTERSECTION. *)
    nonemptyUpwardIntersection(other: BoundedScalarRange, resultStride:ZZ32): FullScalarRange =
        if p <- meetingPoint(self.leftOrRight, self.stride,
                             other.leftOrRight, other.stride, resultStride) then
            nonemptyUpwardIntersectionWithPoint(other, resultStride, p)
        else
            emptyScalarRange()
        end
    nonemptyUpwardIntersectionWithPoint(other: BoundedScalarRange, resultStride:ZZ32, p:ZZ32): FullScalarRange =
        fullScalarRangeInter(self.maxLeft(other),self.minRight(other),resultStride,p)
    opr[r:Range[\ZZ32\]]: FullScalarRange = do
        f = self.bounds.narrowToRange(r)
        l = self.left.get
        s = self.stride
        fullScalarRange(l + f.left.get s, l + f.right.get s, f.stride s)
      end
    opr[i:ZZ32]:ZZ32 = self.left.get + i self.stride
    indexOf(i:ZZ32):Maybe[\ZZ32\] = if (i IN self) then Just[\ZZ32\]((i - self.left.get) DIV self.stride) else Nothing[\ZZ32\] end
end

trait FullRange2D
        extends { FullRange[\(ZZ32,ZZ32)\], BoundedRange2D, DelegatedIndexed[\(ZZ32,ZZ32),(ZZ32,ZZ32)\],
                  ActualRange2D[\FullRange2D, FullScalarRange, FullScalarRange\] }
    getter extent(): Just[\(ZZ32,ZZ32)\] = Just[\(ZZ32,ZZ32)\]( |self.range1|, |self.range2| )
    getter generator(): Generator[\(ZZ32,ZZ32)\] = self.range1.cross[\ZZ32\](self.range2)
    getter indices(): Generator[\(ZZ32,ZZ32)\] = self.range1.indices.cross[\ZZ32\](self.range2.indices)
    opr |self|: ZZ32 = |self.range1| |self.range2|
    flip(): FullRange2D = do
        (l_i,l_j) = self.left.get
        (r_i,r_j) = self.right.get
        (str_i,str_j) = self.stride
        fullRange2D(r_i,r_j,l_i,l_j,-str_i,-str_j)
      end
    opr[ij:(ZZ32,ZZ32)]: (ZZ32,ZZ32) = do (i,j) = ij; (self.range1[i],self.range2[j]) end
    opr[r:Range[\(ZZ32,ZZ32)\]]: FullRange2D = do
        f = self.bounds.narrowToRange(r)
        (l1,l2) = self.left.get
        (s1,s2) = self.stride
        (fl1,fl2) = f.left.get
        (fr1,fr2) = f.right.get
        (fs1,fs2) = f.stride
        fullRange2D(l1 + fl1 s1, l2 + fl2 s2, l1 + fr1 s1, l2 + fr2 s2, fs1 s1, fs2 s2)
      end
    indexOf(n:(ZZ32,ZZ32)):Maybe[\(ZZ32,ZZ32)\] = do
        (n_i,n_j) = n
        if x_i <- self.range1.indexOf(n_i) then
            if x_j <- self.range2.indexOf(n_j) then
                Just[\(ZZ32,ZZ32)\](x_i,x_j)
            else
                Nothing[\(ZZ32,ZZ32)\]
            end
        else
            Nothing[\(ZZ32,ZZ32)\]
        end
      end
    opr INTERSECTION(self, other: Range[\(ZZ32,ZZ32)\]): BoundedRange2D =
        fail("other is Range[\\(ZZ32,ZZ32)\\] but not Range2D")
    opr INTERSECTION(self, other: Range2D): BoundedRange2D =
        combine2D(self.range1 INTERSECTION other.range1,
                  self.range2 INTERSECTION other.range2)
    opr IN(n:(ZZ32,ZZ32), self): Boolean = do
        (n_i,n_j) = n
        n_i IN self.range1 AND: n_j IN self.range2
      end
    opr FORWARD_CMP(self, other: FullRange[\(ZZ32,ZZ32)\]): Comparison =
        ((other.left.get PCMP self.left.get) SYMMETRIC_PARTIAL:
         (self.right.get PCMP other.right.get))
end

tupleFlatten[\I,J,K\](t:(I,J),k:K):(I,J,K) = do (i,j)=t; (i,j,k) end


trait FullRange3D
        extends { FullRange[\(ZZ32,ZZ32,ZZ32)\], BoundedRange3D, DelegatedIndexed[\(ZZ32,ZZ32,ZZ32),(ZZ32,ZZ32,ZZ32)\],
                  ActualRange3D[\FullRange3D, FullScalarRange, FullScalarRange, FullScalarRange\] }
    getter extent(): Just[\(ZZ32,ZZ32,ZZ32)\] =
        Just[\(ZZ32,ZZ32,ZZ32)\]( |self.range1|, |self.range2| , |self.range3| )
    getter generator(): Generator[\(ZZ32,ZZ32,ZZ32)\] =
        self.range1.cross[\ZZ32\](self.range2).cross[\ZZ32\](self.range3).map[\(ZZ32,ZZ32,ZZ32)\](
            tupleFlatten[\ZZ32,ZZ32,ZZ32\])
    getter indices(): Generator[\(ZZ32,ZZ32,ZZ32)\] =
        self.range1.indices.cross[\ZZ32\](self.range2.indices).cross[\ZZ32\](self.range3.indices).map[\(ZZ32,ZZ32,ZZ32)\](
            tupleFlatten[\ZZ32,ZZ32,ZZ32\])
    opr |self|: ZZ32 = |self.range1| |self.range2| |self.range3|
    flip(): FullRange3D = do
        (l_i,l_j,l_k) = self.left.get
        (r_i,r_j,r_k) = self.right.get
        (str_i,str_j,str_k) = self.stride
        fullRange3D(r_i,r_j,r_k,l_i,l_j,l_k,-str_i,-str_j,-str_k)
      end
    opr[ij:(ZZ32,ZZ32,ZZ32)]: (ZZ32,ZZ32,ZZ32) =
        do (i,j,k) = ij; (self.range1[i],self.range2[j],self.range3[k]) end
    opr[r:Range[\(ZZ32,ZZ32,ZZ32)\]]: FullRange3D = do
        f = self.bounds.narrowToRange(r)
        (l1,l2,l3) = self.left.get
        (s1,s2,s3) = self.stride
        (fl1,fl2,fl3) = f.left.get
        (fr1,fr2,fr3) = f.right.get
        (fs1,fs2,fs3) = f.stride
        fullRange3D(l1 + fl1 s1, l2 + fl2 s2, l3 + fl3 s3, l1 + fr1 s1, l2 + fr2 s2, l3 + fr3 s3,
                    fs1 s1, fs2 s2, fs3 s3)
      end
    indexOf(n:(ZZ32,ZZ32,ZZ32)):Maybe[\(ZZ32,ZZ32,ZZ32)\] = do
        (n_i,n_j,n_k) = n
        if x_i <- self.range1.indexOf(n_i) then
            if x_j <- self.range2.indexOf(n_j) then
                if x_k <- self.range3.indexOf(n_k) then
                    Just[\(ZZ32,ZZ32,ZZ32)\](x_i,x_j,x_k)
                else
                    Nothing[\(ZZ32,ZZ32,ZZ32)\]
                end
            else
                Nothing[\(ZZ32,ZZ32,ZZ32)\]
            end
        else
            Nothing[\(ZZ32,ZZ32,ZZ32)\]
        end
      end
    opr INTERSECTION(self, other: Range[\(ZZ32,ZZ32,ZZ32)\]): BoundedRange3D =
        fail("other is Range[\\(ZZ32,ZZ32,ZZ32)\\] but not Range3D")
    opr INTERSECTION(self, other: Range3D): BoundedRange3D =
        combine3D(self.range1 INTERSECTION other.range1,
                  self.range2 INTERSECTION other.range2,
                  self.range3 INTERSECTION other.range3)
    opr IN(n:(ZZ32,ZZ32,ZZ32), self): Boolean = do
        (n_i,n_j,n_k) = n
        n_i IN self.range1 AND: n_j IN self.range2 AND: n_k IN self.range3
      end
    opr FORWARD_CMP(self, other: FullRange[\(ZZ32,ZZ32,ZZ32)\]): Comparison =
        ((other.left.get PCMP self.left.get) SYMMETRIC_PARTIAL:
         (self.right.get PCMP other.right.get))
end

trait CompactFullScalarRange extends { FullScalarRange, CompactFullRange[\ZZ32\] }
    getter stride(): ZZ32 = 1
    getter size(): ZZ32 = do
        l = self.lower
        r = self.upper
        if l > r then 0 else narrow(r-l+1) end
      end
    getter isEmpty(): Boolean = self.lower > self.upper
    getter indexValuePairs(): Indexed[\(ZZ32,ZZ32),ZZ32\] = do
        l = self.lower
        self.map[\(ZZ32,ZZ32)\](fn (i:ZZ32):(ZZ32,ZZ32) => (i-l,i))
      end
    getter indices(): Indexed[\ZZ32,ZZ32\] = do
        l = self.lower
        self.map[\ZZ32\](fn (i:ZZ32):ZZ32 => (i-l))
      end
    getter asExprString():String = self.lower ":" self.upper

    opr |self| : ZZ32 = do
        (l, u) = (self.lower, self.upper)
        if u < l then 0 else (u - l) + 1 end
      end
    opr[i:ZZ32]: ZZ32 =
        if i NOTIN self.bounds then throw IndexOutOfBounds(self.bounds,i)
        else i+self.lower end
    opr IN(n:ZZ32, self): Boolean = self.lower <= n <= self.upper
    indexOf(n:ZZ32):Maybe[\ZZ32\] = if (n IN self) then Just[\ZZ32\](n - self.lower) else Nothing[\ZZ32\] end
    forward(): CompactFullScalarRange = self
    shiftLeft(amount: ZZ32): CompactFullScalarRange = bounded1Range(self.lower - amount, self.upper - amount)
    shiftRight(amount: ZZ32): CompactFullScalarRange (* ensures { |outcome| = |self| } *)
        =  bounded1Range(self.lower + amount, self.upper + amount)
end

object CompactFullParScalarRange(l:ZZ32, r:ZZ32)
        extends { CompactFullScalarRange }
    getter lower(): ZZ32 = l
    getter upper(): ZZ32 = r
    getter left(): Just[\ZZ32\] = Just[\ZZ32\](l)
    getter right(): Just[\ZZ32\] = Just[\ZZ32\](r)
    getter asDebugString(): String = "CompactFullParScalarRange(" l "," r ")"
    seq(self): CompactFullSeqScalarRange = CompactFullSeqScalarRange(l,r)
    generate[\T\](red:Reduction[\T\], body: ZZ32->T): T =
        if r < l then
            red.empty()
        else
            loop'(lo:ZZ32,hi:ZZ32): T =
                if lo=hi then
                    body(lo)
                else
                    (* Identify power-of-2 boundary in region, split there *)
                    split = partitionL((lo BITXOR hi) DOTPLUS 1)
                    mid   = hi BITAND (BITNOT (split DOTMINUS 1))
                    red.join(loop'(lo,mid-1),loop'(mid,hi))
                end
            loop'(l,r)
        end
    loop(body: ZZ32->()): () =
        if r < l then
            ()
        else
            lop(lo:ZZ32,hi:ZZ32): () =
                if lo=hi then
                    body(lo)
                else
                    (* Identify power-of-2 boundary in region, split there *)
                    split = partitionL((lo BITXOR hi) DOTPLUS 1)
                    mid   = hi BITAND (BITNOT (split DOTMINUS 1))
                    do
                        lop(lo,mid-1)
                    also do
                        lop(mid,hi)
                    end
                end
            lop(l,r)
        end


end

object CompactFullSeqScalarRange(l:ZZ32, r:ZZ32)
        extends { CompactFullScalarRange, SequentialGenerator[\ZZ32\] }
    getter lower(): ZZ32 = l
    getter upper(): ZZ32 = r
    getter left(): Just[\ZZ32\] = Just[\ZZ32\](l)
    getter right(): Just[\ZZ32\] = Just[\ZZ32\](r)
    getter asDebugString(): String = "CompactFullSeqScalarRange(" l "," r ")"
    getter asExprString(): String = "seq(" (self asif CompactFullScalarRange).asExprString ")"
    map[\G\](f: ZZ32->G): SimpleMappedSeqIndexed[\ZZ32,G,ZZ32\] =
        SimpleMappedSeqIndexed[\ZZ32,G,ZZ32\](self, f)
    generate[\T\](red:Reduction[\T\], body: ZZ32->T): T = do
        result : T := red.empty()
        i : ZZ32 := l
        if l <= r then
            result := red.join(result, body(i))
            while i < r do
                i += 1
                result := red.join(result, body(i))
            end
        end
        result
      end
    loop(body: ZZ32->()): () = do
        i : ZZ32 := l
        if l <= r then
            body(i)
            while i < r do
                i += 1
                body(i)
            end
        end
      end
end

combine2D(i:CompactFullScalarRange, j:CompactFullScalarRange): CompactFullRange2D =
    CompactFullRange2D(i.left.get, j.left.get, i.right.get, j.right.get)

object CompactFullRange2D(l_i:ZZ32, l_j:ZZ32, r_i:ZZ32, r_j:ZZ32)
        extends { CompactFullRange[\(ZZ32,ZZ32)\], FullRange2D }
    getter lower(): (ZZ32,ZZ32) = (l_i,l_j)
    getter upper(): (ZZ32,ZZ32) = (r_i,r_j)
    getter bounds(): CompactFullRange2D =
        CompactFullRange2D(0,0,r_i-l_i,r_j-l_j)
    getter indices(): Generator[\(ZZ32,ZZ32)\] =
        self.generator.map[\(ZZ32,ZZ32)\](fn (i,j) => (i-l_i, j-l_j))
    getter indexValuePairs(): Generator[\((ZZ32,ZZ32),(ZZ32,ZZ32))\] =
        self.generator.map[\((ZZ32,ZZ32),(ZZ32,ZZ32))\](fn (i,j) => ((i-l_i, j-l_j),(i,j)))
    getter stride(): (ZZ32,ZZ32) = (1,1)
    getter left(): Just[\(ZZ32,ZZ32)\] = Just[\(ZZ32,ZZ32)\]( l_i, l_j )
    getter right(): Just[\(ZZ32,ZZ32)\] = Just[\(ZZ32,ZZ32)\]( r_i, r_j )
    getter range1(): CompactFullScalarRange = CompactFullParScalarRange(l_i,r_i)
    getter range2(): CompactFullScalarRange = CompactFullParScalarRange(l_j,r_j)
    getter asDebugString(): String = "CompactFullRange2D(" l_i "," l_j ", " r_i "," r_j ")"
    opr |self| : ZZ32 = do
        (l1, l2) = self.lower
        (u1, u2) = self.upper
        if (u1 < l1) OR (u2 < l2) then 0 else ((u1 - l1) + 1) ((u2 - l2) + 1) end
      end
    recombine(i:FullScalarRange, j:FullScalarRange): FullRange2D =
        combine2D(i, j)
    shiftLeft(amount: (ZZ32,ZZ32)):CompactFullRange2D = do
        (shift_i, shift_j) = amount
        CompactFullRange2D(l_i-shift_i, l_j-shift_j, r_i-shift_i, r_j-shift_j)
      end
    shiftRight(amount: (ZZ32,ZZ32)):CompactFullRange2D = do
        (shift_i, shift_j) = amount
        CompactFullRange2D(l_i+shift_i, l_j+shift_j, r_i+shift_i, r_j+shift_j)
      end
end

combine3D(i:CompactFullScalarRange, j:CompactFullScalarRange, k:CompactFullScalarRange): CompactFullRange3D =
    CompactFullRange3D(i.left.get, j.left.get, k.left.get, i.right.get, j.right.get, k.right.get)

object CompactFullRange3D(l_i:ZZ32, l_j:ZZ32, l_k:ZZ32, r_i:ZZ32, r_j:ZZ32, r_k:ZZ32)
        extends { CompactFullRange[\(ZZ32,ZZ32,ZZ32)\], FullRange3D }
    getter lower(): (ZZ32,ZZ32,ZZ32) = (l_i,l_j,l_k)
    getter upper(): (ZZ32,ZZ32,ZZ32) = (r_i,r_j,r_k)
    getter bounds(): CompactFullRange3D =
        CompactFullRange3D(0,0,0,r_i-l_i,r_j-l_j,r_k-l_k)
    getter indices(): Generator[\(ZZ32,ZZ32,ZZ32)\] =
        self.generator.map[\(ZZ32,ZZ32,ZZ32)\](fn (i,j,k) => (i-l_i, j-l_j, k-l_k))
    getter indexValuePairs(): Generator[\((ZZ32,ZZ32,ZZ32),(ZZ32,ZZ32,ZZ32))\] =
        self.generator.map[\((ZZ32,ZZ32,ZZ32),(ZZ32,ZZ32,ZZ32))\](fn (i,j,k) => ((i-l_i, j-l_j, k-l_k),(i,j,k)))
    getter stride(): (ZZ32,ZZ32,ZZ32) = (1,1,1)
    getter left(): Just[\(ZZ32,ZZ32,ZZ32)\] = Just[\(ZZ32,ZZ32,ZZ32)\]( l_i, l_j , l_k )
    getter right(): Just[\(ZZ32,ZZ32,ZZ32)\] = Just[\(ZZ32,ZZ32,ZZ32)\]( r_i, r_j , r_k )
    getter range1(): CompactFullScalarRange = CompactFullParScalarRange(l_i,r_i)
    getter range2(): CompactFullScalarRange = CompactFullParScalarRange(l_j,r_j)
    getter range3(): CompactFullScalarRange = CompactFullParScalarRange(l_k,r_k)
    getter asDebugString(): String = "CompactFullRange3D(" l_i "," l_j "," l_k ", " r_i "," r_j "," r_k ")"
    opr |self| : ZZ32 = do
        (l1, l2, l3) = self.lower
        (u1, u2, u3) = self.upper
        if (u1 < l1) OR (u2 < l2) OR (u3 < l3) then 0 else ((u1 - l1) + 1) ((u2 - l2) + 1) ((u3 - l3) + 1) end
      end
    recombine(i:FullScalarRange, j:FullScalarRange, k:FullScalarRange):
             FullRange3D = combine3D(i, j, k)
    shiftLeft(amount: (ZZ32, ZZ32, ZZ32)):CompactFullRange3D = do
        (shift_i, shift_j, shift_k) = amount
        CompactFullRange3D(l_i-shift_i, l_j-shift_j, l_k-shift_k,
                                                        r_i-shift_i, r_j-shift_j, r_k-shift_k)
      end
    shiftRight(amount: (ZZ32, ZZ32, ZZ32)):CompactFullRange3D = do
        (shift_i, shift_j, shift_k) = amount
        CompactFullRange3D(l_i+shift_i, l_j+shift_j, l_k+shift_k,
                                                        r_i+shift_i, r_j+shift_j, r_k+shift_k)
      end
end

trait StridedFullScalarRange
        extends { FullScalarRange, StridedFullRange[\ZZ32\] }
    getter size(): ZZ32 =
        if self.isEmpty then 0
        else narrow((self.right.get-self.left.get) DIV self.stride + 1) end
    getter isEmpty(): Boolean =
        if self.stride > 0 then (self.left.get>self.right.get)
                           else (self.left.get<self.right.get) end
    getter indexValuePairs(): Indexed[\(ZZ32,ZZ32),ZZ32\] =
        self.map[\(ZZ32,ZZ32)\](fn (i:ZZ32):(ZZ32,ZZ32) => ((i-self.left.get) DIV self.stride,i))
    getter indices(): Indexed[\ZZ32,ZZ32\] =
        self.map[\ZZ32\](fn (i:ZZ32):ZZ32 => (i-self.left.get) DIV self.stride)
    getter asDebugString(): String = "StridedFullScalarRange(" self.left.get "," self.right.get "," self.stride ")"
    opr |self| : ZZ32 = self.size
    opr[i:ZZ32]: ZZ32 =
        if i NOTIN self.bounds then throw IndexOutOfBounds[\ZZ32\](self.bounds,i)
        else i self.stride + self.left.get end
    opr IN(n:ZZ32, self): Boolean = do
        l = self.left.get
        r = self.right.get
        (if self.stride > 0 then l <= n <= r else r <= n <= l) AND: (self.stride DIVIDES (n-l))
      end
    indexOf(n:ZZ32):Maybe[\ZZ32\] = if (n IN self) then Just[\ZZ32\]((n - self.left.get) DIV self.stride) else Nothing[\ZZ32\] end
    forward(): FullScalarRange =
        if self.stride < 0 then self.flip() else self end
end

object StridedFullParScalarRange(l:ZZ32, r:ZZ32, str:ZZ32) extends StridedFullScalarRange
    getter stride(): ZZ32 = str
    getter left(): Just[\ZZ32\] = Just[\ZZ32\](l)
    getter right(): Just[\ZZ32\] = Just[\ZZ32\](r)
    getter asExprString(): String = l || ":" || r || ":" || str
    getter asDebugString(): String = "StridedFullParScalarRange(" l "," r "," str ")"
    seq(self): StridedFullSeqScalarRange = StridedFullSeqScalarRange(l,r,str)
    generate[\T\](red:Reduction[\T\], body: ZZ32->T): T =
        if str > 0 then
            if r < l then
                red.empty()
            else
                lop(lo:ZZ32,hi:ZZ32): T =
                    if lo=hi then
                        body(lo)
                    else
                        (* Identify power-of-2 boundary *)
                        split = partitionL((lo BITXOR hi) DOTPLUS 1)
                        midAmt = ((hi BITAND (BITNOT (split DOTMINUS 1))) - 1) - lo
                        (* Round power-of-2 boundary down to stride size
                           WARNING?  Problem with negative lo here?  *)
                        midL = lo + str (midAmt DIV str)
                        midR = midL + str
                        red.join(lop(lo,midL),lop(midR,hi))
                    end
                lop(l,r)
            end
        else (* str > 0 *)
            if l < r then
                red.empty()
            else
                str' = -str (*'*)
                lop(lo:ZZ32,hi:ZZ32): T =
                    if lo=hi then
                        body(lo)
                    else
                        (* Identify power-of-2 boundary *)
                        split = partitionL((lo BITXOR hi) DOTPLUS 1)
                        midAmt = ((hi BITAND (BITNOT (split DOTMINUS 1))) - 1) - lo
                        (* Round power-of-2 boundary down to stride size
                           WARNING?  Problem with negative lo here?  *)
                        midL = lo + str' (midAmt DIV str')
                        midR = midL + str' (*'*)
                        red.join(lop(midR,hi),lop(lo,midL))
                    end
                lop(r,l)
            end
        end
    loop(body: ZZ32->()): () =
        if str > 0 then
            if r < l then
                ()
            else
                lop(lo:ZZ32,hi:ZZ32): () =
                    if lo=hi then
                        body(lo)
                    else
                        (* Identify power-of-2 boundary *)
                        split = partitionL((lo BITXOR hi) DOTPLUS 1)
                        midAmt = ((hi BITAND (BITNOT (split DOTMINUS 1))) - 1) - lo
                        (* Round power-of-2 boundary down to stride size
                           WARNING?  Problem with negative lo here?  *)
                        midL = lo + str (midAmt DIV str)
                        midR = midL + str
                        do
                            lop(lo,midL)
                        also do
                            lop(midR,hi)
                        end
                    end
                lop(l,r)
            end
        else (* str > 0 *)
            if l < r then
                ()
            else
                str' = -str
                lop(lo:ZZ32,hi:ZZ32): () =
                    if lo=hi then
                        body(lo)
                    else
                        (* Identify power-of-2 boundary *)
                        split = partitionL((lo BITXOR hi) DOTPLUS 1)
                        midAmt = ((hi BITAND (BITNOT (split DOTMINUS 1))) - 1) - lo
                        (* Round power-of-2 boundary down to stride size
                           WARNING?  Problem with negative lo here?  *)
                        midL = lo + str' (midAmt DIV str')
                        midR = midL + str'
                        do
                            lop(midR,hi)
                        also do
                            lop(lo,midL)
                        end
                    end
                lop(r,l)
            end
        end
    shiftLeft(amount: ZZ32):StridedFullParScalarRange = StridedFullParScalarRange(l-amount, r-amount, str)
    shiftRight(amount: ZZ32):StridedFullParScalarRange = StridedFullParScalarRange(l+amount, r+amount, str)
end

object StridedFullSeqScalarRange(l:ZZ32, r:ZZ32, str:ZZ32)
        extends { StridedFullScalarRange, SequentialGenerator[\ZZ32\] }
    getter stride(): ZZ32 = str
    getter left(): Just[\ZZ32\] = Just[\ZZ32\](l)
    getter right(): Just[\ZZ32\] = Just[\ZZ32\](r)
    getter asDebugString(): String = "StridedFullSeqScalarRange(" l "," r "," str ")"
    seq(self): StridedFullSeqScalarRange = StridedFullSeqScalarRange(l,r,str)
    map[\G\](f: ZZ32->G): SimpleMappedSeqIndexed[\ZZ32,G,ZZ32\] =
        SimpleMappedSeqIndexed[\ZZ32,G,ZZ32\](self, f)
    generate[\T\](red:Reduction[\T\], body: ZZ32->T): T = do
        result : T := red.empty()
        i : ZZ32 := l
        if str > 0 then
            if l <= r then
                result := red.join(result,body(i))
                while (r >= 0 AND: (i <= r - str)) OR: (r < 0 AND: (i + str <= r)) do
                    i += str
                    result := red.join(result,body(i))
                end
            end
        else (* str < 0 *)
            if l >= r then
                result := red.join(result,body(i))
                while (r < 0 AND: (i >= r - str)) OR: (r >= 0 AND: (i + str >= r)) do
                    i += str
                    result := red.join(result,body(i))
                end
            end
        end
        result
      end
    loop(body: ZZ32->()): () =
        if str > 0 then
            i : ZZ32 := l
            if l <= r then
                body(i)
                while (r >= 0 AND: (i <= r - str)) OR: (r < 0 AND: (i + str <= r)) do
                    i += str
                    body(i)
                end
            end
        else (* str < 0 *)
            i : ZZ32 := l
            if l >= r then
                body(i)
                while (r < 0 AND: (i >= r - str)) OR: (r >= 0 AND: (i + str >= r)) do
                    i += str
                    body(i)
                end
            end
        end
    shiftLeft(amount: ZZ32):StridedFullSeqScalarRange = StridedFullSeqScalarRange(l-amount, r-amount, str)
    shiftRight(amount: ZZ32):StridedFullSeqScalarRange = StridedFullSeqScalarRange(l+amount, r+amount, str)
end


combine2D(i:FullScalarRange, j:FullScalarRange): FullRange2D =
    StridedFullRange2D(i.left.get, j.left.get, i.right.get, j.right.get,
                            i.stride, j.stride)

object StridedFullRange2D(l_i:ZZ32, l_j:ZZ32, r_i:ZZ32, r_j:ZZ32, str_i:ZZ32, str_j:ZZ32)
        extends { StridedFullRange[\(ZZ32,ZZ32)\], FullRange2D }
    getter bounds(): CompactFullRange2D =
        CompactFullRange2D(0,0,(r_i-l_i) DIV str_i,(r_j-l_j) DIV str_j)
    getter indices(): Generator[\(ZZ32,ZZ32)\] =
        self.generator.map[\(ZZ32,ZZ32)\](fn (i,j) => ((i-l_i) DIV str_i, (j-l_j) DIV str_j))
    getter indexValuePairs(): Generator[\((ZZ32,ZZ32),(ZZ32,ZZ32))\] =
        self.generator.map[\((ZZ32,ZZ32),(ZZ32,ZZ32))\](fn (i,j) => (((i-l_i) DIV str_i, (j-l_j) DIV str_j),(i,j)))
    getter stride(): (ZZ32,ZZ32) = (str_i,str_j)
    getter left(): Just[\(ZZ32,ZZ32)\] = Just[\(ZZ32,ZZ32)\]( l_i, l_j )
    getter right(): Just[\(ZZ32,ZZ32)\] = Just[\(ZZ32,ZZ32)\]( r_i, r_j )
    getter range1(): FullScalarRange = StridedFullParScalarRange(l_i,r_i,str_i)
    getter range2(): FullScalarRange = StridedFullParScalarRange(l_j,r_j,str_j)
    getter asDebugString(): String = ("StridedFullRange2D(" l_i "," l_j ", " r_i "," r_j ", "
                                          str_i "," str_j ")" )
    forward(): FullRange2D =
        self.recombine(self.range1.forward(), self.range2.forward())
    recombine(i:FullScalarRange, j:FullScalarRange): FullRange2D =
        combine2D(i, j)
    shiftLeft(amount: (ZZ32, ZZ32)): StridedFullRange2D = do
        (shift_i, shift_j) = amount
        StridedFullRange2D(l_i-shift_i, l_j-shift_j, r_i-shift_i, r_j-shift_j, str_i, str_j)
      end
    shiftRight(amount: (ZZ32, ZZ32)): StridedFullRange2D = do
        (shift_i, shift_j) = amount
        StridedFullRange2D(l_i+shift_i, l_j+shift_j, r_i+shift_i, r_j+shift_j, str_i, str_j)
      end
end

combine3D(i:FullScalarRange, j:FullScalarRange, k:FullScalarRange): FullRange3D =
    StridedFullRange3D(i.left.get, j.left.get, k.left.get, i.right.get, j.right.get, k.right.get,
                            i.stride, j.stride, k.stride)

object StridedFullRange3D(l_i:ZZ32, l_j:ZZ32, l_k:ZZ32, r_i:ZZ32, r_j:ZZ32, r_k:ZZ32, str_i:ZZ32, str_j:ZZ32, str_k:ZZ32)
        extends { StridedFullRange[\(ZZ32,ZZ32,ZZ32)\], FullRange3D }
    getter bounds(): CompactFullRange3D =
        CompactFullRange3D(0,0,0,
            (r_i-l_i) DIV str_i,(r_j-l_j) DIV str_j, (r_k-l_k) DIV str_k)
    getter indices(): Generator[\(ZZ32,ZZ32,ZZ32)\] =
        self.generator.map[\(ZZ32,ZZ32,ZZ32)\](
            fn (i,j,k) => ((i-l_i) DIV str_i, (j-l_j) DIV str_j, (k-l_k) DIV str_k))
    getter indexValuePairs(): Generator[\((ZZ32,ZZ32,ZZ32),(ZZ32,ZZ32,ZZ32))\] =
        self.generator.map[\((ZZ32,ZZ32,ZZ32),(ZZ32,ZZ32,ZZ32))\](
            fn (i,j,k) => (((i-l_i) DIV str_i, (j-l_j) DIV str_j, (k-l_k) DIV str_k),(i,j,k)))
    getter stride(): (ZZ32,ZZ32,ZZ32) = (str_i,str_j,str_k)
    getter left(): Just[\(ZZ32,ZZ32,ZZ32)\] = Just[\(ZZ32,ZZ32,ZZ32)\]( l_i, l_j , l_k )
    getter right(): Just[\(ZZ32,ZZ32,ZZ32)\] = Just[\(ZZ32,ZZ32,ZZ32)\]( r_i, r_j , r_k )
    getter range1(): FullScalarRange = StridedFullParScalarRange(l_i,r_i,str_i)
    getter range2(): FullScalarRange = StridedFullParScalarRange(l_j,r_j,str_j)
    getter range3(): FullScalarRange = StridedFullParScalarRange(l_k,r_k,str_k)
    getter asDebugString(): String = ("StridedFullRange3D(" l_i "," l_j "," l_k ", " r_i "," r_j "," r_k ", "
                                              str_i "," str_j "," str_k ")" )
    forward(): FullRange3D =
        self.recombine(self.range1.forward(), self.range2.forward(), self.range3.forward())
    recombine(i:FullScalarRange, j:FullScalarRange, k:FullScalarRange):
            FullRange3D = combine3D(i, j, k)
    shiftLeft(amount: (ZZ32, ZZ32, ZZ32)): StridedFullRange3D = do
        (shift_i, shift_j, shift_k) = amount
        StridedFullRange3D(l_i-shift_i, l_j-shift_j, l_k-shift_k, r_i-shift_i, r_j-shift_j, r_k-shift_k,
                           str_i, str_j, str_k)
      end
    shiftRight(amount: (ZZ32, ZZ32, ZZ32)): StridedFullRange3D = do
        (shift_i, shift_j, shift_k) = amount
        StridedFullRange3D(l_i+shift_i, l_j+shift_j, l_k+shift_k, r_i+shift_i, r_j+shift_j, r_k+shift_k,
                           str_i, str_j, str_k)
      end
  end


fullScalarRange(l:ZZ32, r:ZZ32, str:ZZ32): FullScalarRange = do
    f: FullScalarRange =
        if str=1 then CompactFullParScalarRange(l,r)
        else StridedFullParScalarRange(l,r,str) end
    _ = f.check()
    f
  end

fullScalarRangeInter(l:ZZ32, r:ZZ32, str:ZZ32, p:ZZ32): FullScalarRange =
    fullScalarRange(atOrAbove(p,l,str), atOrBelow(p,r,str), str)

fullRange2D(l_i:ZZ32, l_j:ZZ32, r_i:ZZ32, r_j:ZZ32, str_i:ZZ32, str_j:ZZ32): FullRange2D = do
    f: FullRange2D =
        if str_i=1 AND str_j=1 then
            CompactFullRange2D(l_i,l_j,r_i,r_j)
        else
            StridedFullRange2D(l_i,l_j,r_i,r_j,str_i,str_j)
        end
    _ = f.check()
    f
  end

fullRange3D(l_i:ZZ32, l_j:ZZ32, l_k:ZZ32, r_i:ZZ32, r_j:ZZ32, r_k:ZZ32, str_i:ZZ32, str_j:ZZ32, str_k:ZZ32): FullRange3D = do
    f: FullRange3D =
        if str_i=1 AND str_j=1 AND str_k=1 then
            CompactFullRange3D(l_i,l_j,l_k,r_i,r_j,r_k)
        else
            StridedFullRange3D(l_i,l_j,l_k,r_i,r_j,r_k,str_i,str_j,str_k)
        end
    _ = f.check()
    f
  end

emptyScalarRange() : FullScalarRange = CompactFullParScalarRange(0,-1)

(** Helpers for #. **)
sized1Range(lo:ZZ32,ex:ZZ32): CompactFullParScalarRange =
    if ex > 0 then CompactFullParScalarRange(lo,lo+(ex-1))
    elif lo > lo.minimum - ex then CompactFullParScalarRange(lo,lo+ex-1)
    else CompactFullParScalarRange(0,-1) end
sized2Range(l1:ZZ32,l2:ZZ32,ex1:ZZ32,ex2:ZZ32): CompactFullRange2D = do
    (r1, r2) = (sized1Range(l1,ex1), sized1Range(l2,ex2))
    CompactFullRange2D(r1.lower,r2.lower,r1.upper,r2.upper)
  end
sized3Range(l1:ZZ32,l2:ZZ32,l3:ZZ32,ex1:ZZ32,ex2:ZZ32,ex3:ZZ32): CompactFullRange3D = do
    (r1, r2, r3) = (sized1Range(l1,ex1), sized1Range(l2,ex2), sized1Range(l3,ex3))
    CompactFullRange3D(r1.lower,r2.lower,r3.lower,r1.upper,r2.upper,r3.upper)
  end

(** Helpers for :. **)
bounded1Range(lo:ZZ32,hi:ZZ32): CompactFullParScalarRange = CompactFullParScalarRange(lo,hi)
bounded2Range(l1:ZZ32,l2:ZZ32,hi1:ZZ32,hi2:ZZ32): CompactFullRange2D =
    CompactFullRange2D(l1,l2,hi1,hi2)
bounded3Range(l1:ZZ32,l2:ZZ32,l3:ZZ32,hi1:ZZ32,hi2:ZZ32,hi3:ZZ32): CompactFullRange3D =
    CompactFullRange3D(l1,l2,l3,hi1,hi2,hi3)

left1Range(x:ZZ32):LeftRange[\ZZ32\] = LeftScalarRange(x,1)
left2Range(x:ZZ32,y:ZZ32):
    LeftRange[\(ZZ32,ZZ32)\] = LeftRange2D(x,y,1,1)
left3Range(x:ZZ32,y:ZZ32,z:ZZ32): LeftRange[\(ZZ32,ZZ32,ZZ32)\] =
    LeftRange3D(x,y,z,1,1,1)

extent1Range(x:ZZ32):RangeWithExtent[\ZZ32\] =
    if x=0 then
        xx = x-x
        CompactFullParScalarRange(xx,xx-1)
    else
        ExtentScalarRange(x,1)
    end
extent2Range(x:ZZ32,y:ZZ32):
        RangeWithExtent[\(ZZ32,ZZ32)\] =
    if x=0 OR y=0 then
        xx = x-x
        yy = y-y
        CompactFullRange2D(xx,yy,xx-1,yy-1)
    else
        ExtentRange2D(x,y,1,1)
    end
extent3Range(x:ZZ32,y:ZZ32,z:ZZ32): RangeWithExtent[\(ZZ32,ZZ32,ZZ32)\] =
    if x=0 OR y=0 OR z=0 then
        xx = x-x
        yy = y-y
        zz = z-z
        CompactFullRange3D(xx,yy,zz,xx-1,yy-1,zz-1)
    else
        ExtentRange3D(x,y,z,1,1,1)
    end

right1Range(x:ZZ32):RightRange[\ZZ32\] = RightScalarRange(x,1)
right2Range(x:ZZ32,y:ZZ32):
    RightRange[\(ZZ32,ZZ32)\] = RightRange2D(x,y,1,1)
right3Range(x:ZZ32,y:ZZ32,z:ZZ32): RightRange[\(ZZ32,ZZ32,ZZ32)\] =
    RightRange3D(x,y,z,1,1,1)

open1Range(x:ZZ32):OpenRange[\ZZ32\] = OpenScalarRange(x)
open2Range(x:ZZ32,y:ZZ32):
    OpenRange[\(ZZ32,ZZ32)\] = OpenRange2D(x,y)
open3Range(x:ZZ32,y:ZZ32,z:ZZ32): OpenRange[\(ZZ32,ZZ32,ZZ32)\] =
    OpenRange3D(x,y,z)

end

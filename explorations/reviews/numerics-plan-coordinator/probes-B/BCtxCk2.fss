component BCtxCk2
export Executable
(* evidence-B probe; the compiled checker over the one library: the expected type
   reaches a method invocation's and an operator's inference, not a call f(x)? *)
object BoxT[\T\](v: ZZ32) end
object Fac
  mk[\T\](): BoxT[\T\] = BoxT[\T\](1)
  wrap[\T\](x: T): BoxT[\T\] = BoxT[\T\](1)
end
opr BOXOF[\T\](x: T): BoxT[\T\] = BoxT[\T\](1)
opr OPLUS[\T\](x: T, y: ZZ32): BoxT[\T\] = BoxT[\T\](1)
mk[\T\](): BoxT[\T\] = BoxT[\T\](1)
m01(): () = do a: BoxT[\ZZ64\] = Fac.mk(); () end
m02(): () = do v = Fac.mk(); c: String = v; () end
m03(): () = do a: BoxT[\ZZ64\] = Fac.wrap(3); () end
m04(): () = do a: BoxT[\ZZ64\] = BOXOF 3; () end
m05(): () = do a: BoxT[\ZZ64\] = 3 OPLUS 4; () end
m06(): () = do a: BoxT[\ZZ64\] = (mk()); () end
m07(): () = do a: BoxT[\ZZ64\] = mk[\ZZ64\](); () end
run(): () = ()
end

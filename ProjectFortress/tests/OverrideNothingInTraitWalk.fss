component OverrideNothingInTraitWalk
export Executable

(* A trait's method declaration with the modifier override that overrides no inherited declaration is a static error, so the program is refused at load, under walk (traits.tex, section "Method Declarations"). *)

trait S
  tag(self, x: ZZ32): ZZ32 = 1
end
trait W extends S
  override tag(self, x: String): ZZ32 = 2
end
object Wo extends W end

run(): () = do
    println(tag(Wo, 3))
  end

end

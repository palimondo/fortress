component CPairNN32NN64
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    NN32 => "NN32"
    NN64 => "NN64"
    ZZ => "ZZ"
    IntLiteral => "IntLiteral"
    else => "other"
  end

run(): () = do
    x: NN32 = 4
    y: NN64 = 3
    r = x MAX y
    println("x MAX y = " r " : " typeOf(r))
  end

end

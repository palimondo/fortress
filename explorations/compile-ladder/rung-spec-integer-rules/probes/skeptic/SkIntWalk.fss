component SkIntWalk
export Executable

(*) Skeptic's differential of rung P's integer text on NN32, NN64 and ZZ, which only walk declares.
res(f: () -> Any): String =
  try
    "" f()
  catch e
    IntegerOverflow => "IntegerOverflow"
  end

run(): () = do
  mOne: ZZ32 = -1
  minI: ZZ32 = -2147483647 - 1
  one: ZZ32 = 1
  x: NN32 = unsigned(mOne)
  n31: NN32 = unsigned(minI)
  oneL: ZZ64 = 1
  big63: NN64 = unsigned(oneL) LSHIFT 63
  y: NN64 = unsigned(-oneL)
  bigOne: ZZ = big(oneL)
  bigMinus5: ZZ = big(widen(-5))
  bigFive: ZZ = big(widen(5))
  zzMinusOne: ZZ = big(widen(-1))
  println("N1 NN32 (2^32-1) RSHIFT 31 [text: 1]: " res(fn () => x RSHIFT 31))
  println("N2 NN32 (2^32-1) RSHIFT 32 [text: 0]: " res(fn () => x RSHIFT 32))
  println("N3 NN32 (2^32-1) LSHIFT 1 [text: 4294967294]: " res(fn () => x LSHIFT 1))
  println("N4 NN32 (2^32-1) LSHIFT -1 [text: 2147483647]: " res(fn () => x LSHIFT (-1)))
  println("N5 NN32 (2^32-1) LSHIFT an NN64 count of 2^63 [text: beyond the width, 0]: " res(fn () => x LSHIFT big63))
  println("N6 NN32 (2^32-1) RSHIFT an NN32 count of 2^31 [text: beyond the width, 0]: " res(fn () => x RSHIFT n31))
  println("N7 NN32 (2^32-1) LSHIFT a ZZ count of -1 [text: 2147483647]: " res(fn () => x LSHIFT zzMinusOne))
  println("N8 NN64 (2^64-1) RSHIFT 63 [text: 1]: " res(fn () => y RSHIFT 63))
  println("N9 NN64 (2^64-1) LSHIFT 1 [text: 18446744073709551614]: " res(fn () => y LSHIFT 1))
  println("N10 NN64 (2^64-1) RSHIFT a ZZ count of -1 [text: 18446744073709551614]: " res(fn () => y RSHIFT zzMinusOne))
  println("N11 NN64 (2^64-1) LSHIFT an NN64 count of 2^63 [text: 0]: " res(fn () => y LSHIFT big63))
  println("W1 NN64 narrow(2^64-1) [text: 4294967295]: " res(fn () => narrow(y)))
  println("W2 ZZ narrow(2^64 + 2^31) [text: -2147483648]: " res(fn () => narrow((bigOne LSHIFT 64) + (bigOne LSHIFT 31))))
  println("W3 ZZ narrow(-2^31 - 1) [text: 2147483647]: " res(fn () => narrow(-(bigOne LSHIFT 31) - bigOne)))
  println("W4 ZZ narrow(-2^100 + 7) [text: 7]: " res(fn () => narrow(-(bigOne LSHIFT 100) + big(widen(7)))))
  println("Z1 ZZ -5 RSHIFT an NN64 count of 2^63 [text: shift(-5, -2^63) = -1]: " res(fn () => bigMinus5 RSHIFT big63))
  println("Z2 ZZ 5 RSHIFT an NN64 count of 2^63 [text: 0]: " res(fn () => bigFive RSHIFT big63))
  println("Z3 ZZ 5 LSHIFT an NN64 count of 2^63 [text: IntegerOverflow]: " res(fn () => bigFive LSHIFT big63))
  println("Z4 ZZ -5 LSHIFT a ZZ count of -2^70 [text: -1]: " res(fn () => bigMinus5 LSHIFT (-(bigOne LSHIFT 70))))
  println("Z5 ZZ -5 RSHIFT 1 [text: shift(-5, -1) = floor(-5/2) = -3]: " res(fn () => bigMinus5 RSHIFT 1))
  println("Z6 ZZ shift(-5, 3) [text: -40]: " res(fn () => shift(bigMinus5, 3)))
  println("Z7 ZZ 0 LSHIFT 2^40 [text: 0, exact]: " res(fn () => big(widen(0)) LSHIFT (bigOne LSHIFT 40)))
  a: NN32 = unsigned(65536)
  b: NN32 = unsigned(65537)
  c: NN64 = unsigned(oneL LSHIFT 32)
  d: NN64 = unsigned((oneL LSHIFT 32) + oneL)
  println("G1 NN32 65536 LCM 65537 [overview: 4295032832, IntegerOverflow]: " res(fn () => a LCM b))
  println("G2 NN64 2^32 LCM (2^32+1) [overview: 2^64 + 2^32, IntegerOverflow]: " res(fn () => c LCM d))
  println("G3 NN32 0 GCD (2^32-1) [text: 4294967295]: " res(fn () => unsigned(0) GCD x))
  println("G4 ZZ -4 LCM 6 [text: 12]: " res(fn () => big(widen(-4)) LCM big(widen(6))))
  println("G5 ZZ 0 GCD -7 [text: 7]: " res(fn () => big(widen(0)) GCD big(widen(-7))))
end

end

(* Does the checker report every failing statement of a block, or stop at the first?
   Three calls, each refused on its own (a String where a ZZ32 is declared), in one
   do-block, then the same three each in its own block. *)
component BlockStop
export Executable
takesZ(x: ZZ32): ZZ32 = x
run(): () = do
    s: String = "s"
    do
        a = takesZ(s)
        b = takesZ(s)
        c = takesZ(s)
        println("never")
    end
    do a2 = takesZ(s); println("never") end
    do b2 = takesZ(s); println("never") end
    do c2 = takesZ(s); println("never") end
  end
end

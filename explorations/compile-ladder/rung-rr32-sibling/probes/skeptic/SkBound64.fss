component SkBound64
export Executable

sh(v: Any): String =
  typecase v of
    RR32 => v.asString || " : RR32"
    RR64 => v.asString || " : RR64"
    else => v.asString || " : other"
  end
bound64[\T extends RR64\](x: T): T = x

run() = do
  a: RR32 = narrow(1.5)
  println("REACHED")
  println("bound64(a) " sh(bound64(a)))
  println("DONE")
end

end

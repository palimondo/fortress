component XXXNumeralBeyondZZ32Range
export Executable

run(): () = do
  println("REACHED")
  for x <- seq(3000000000#2) do println("  element " x) end
  assert(true, "ledger row 325: a numeral beyond ZZ32 as a range component is a static error; Specification/basic/expressions/ranges.tex, section \"Ranges\", basic/expressions/literals.tex, section \"Literals\"")
  println("PASS")
end

end

component SkSigmaMore
export Executable

trait N
  getter n(): ZZ32
end
object NOf(k: ZZ32) extends N
  getter n(): ZZ32 = k
end
trait W2 excludes { N }
  coerce(x: N) = W2Of(x.n)
end
trait W1 extends W2
  coerce(x: N) = W1Of(x.n)
end
object W2Of(k: ZZ32) extends W2 end
object W1Of(k: ZZ32) extends W1 end

g[\T\](x: W1, y: T): String = "g(W1, T)"
g(x: W2, y: Any): String = "g(W2, Any)"
p(x: W1, y: Any): String = "p(W1, Any)"
p(x: W2, y: Any): String = "p(W2, Any)"

run(): () = do
    println("g: " || g(NOf(1), 5))
    println("p: " || p(NOf(1), 5))
end

end

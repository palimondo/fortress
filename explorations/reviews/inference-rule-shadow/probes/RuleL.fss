component RuleL
export Executable
(* The inference rule's shapes against the one library, one declaration per case, each binding or
   returning its call at a written type or at an untyped local, so that the trace shows the static
   arguments inferred. Checked against today's library (L0) and the numeral switch's copy (A0). *)
object BoxT[\T\](v: ZZ32) end
object Box[\T\](v: T)
    accept(x: T): T = x
end
object Fac
    wrap[\T\](x: T): BoxT[\T\] = BoxT[\T\](1)
    idm[\T\](x: T): T = x
end
opr BOXOF[\T\](x: T): BoxT[\T\] = BoxT[\T\](1)
opr OPLUS[\T\](x: T, y: T): T = x
idt[\T\](x: T): T = x
wrapT[\T\](x: T): BoxT[\T\] = BoxT[\T\](1)
pick[\T\](x: T, y: T): T = x
pickN[\T extends Number\](x: T, y: T): T = x
lohi[\I extends AnyIntegral\](lo: I, hi: I): I = lo
lohi32[\I extends ZZ32\](lo: I, hi: I): I = lo
twice[\T extends Integral[\T\]\](x: T, y: T): T = x
scale[\T\](b: Box[\T\], x: T): T = b.accept(x)
scale64[\T\](b: BoxT[\T\], x: ZZ64): ZZ64 = x
scaleT[\T\](b: BoxT[\T\], m: ZZ32): ZZ32 = m
(* row 401's shape, microGPT's heads, unheads and onehot: a size fixed by a structured argument,
   a numeral-typed binding or a numeral for a declared ZZ32 parameter *)
object M[\nat r, nat c\]() end
hd[\nat r, nat c\](base: M[\r, c\], p: ZZ32, nh: ZZ32, k: ZZ32): ZZ32 = p
uh[\nat r, nat c\](t: M[\r, c\], nh: ZZ32): ZZ32 = nh
oh[\nat k\](ks: M[\k, 1\], width: ZZ32): ZZ32 = width
(* a user-declared coercion, the rule's general case *)
trait Wide excludes Narrow
    coerce(x: Narrow) = WideOf(x.small)
    getter big(): ZZ32
end
object WideOf(big: ZZ32) extends Wide end
trait Narrow excludes Wide
    getter small(): ZZ32
end
object NarrowOf(small: ZZ32) extends Narrow end
(blockSize, nHead, headDim, vocabSize) = (16, 4, 4, 27)
bs = 16
nhd = 4
hdim = 4
vs = 27
z: ZZ32 = 3
l: ZZ64 = widen(4)
rr: RR64 = 2.5
u: NN32 = unsigned(5)
s: String = "s"
bR: Box[\RR64\] = Box[\RR64\](1.0)
bS: BoxT[\String\] = BoxT[\String\](2)
bW: Box[\Wide\] = Box[\Wide\](WideOf(1))
mat: M[\16, 16\] = M[\16, 16\]()
wd: Wide = WideOf(1)
nw: Narrow = NarrowOf(2)
r401a(): ZZ32 = hd(mat, blockSize, nHead, headDim)
r401b(): ZZ32 = uh(mat, nHead)
r401c(): ZZ32 = oh(M[\16, 1\](), vocabSize)
r401d(): ZZ32 = hd(mat, 16, 4, 4)
r401e(): ZZ32 = scaleT(bS, 3)
r401f(): ZZ32 = hd(mat, bs, nhd, hdim)
r401g(): ZZ32 = uh(mat, nhd)
r401h(): ZZ32 = oh(M[\16, 1\](), vs)
s64a(): ZZ64 = scale64(bS, 3)
s64b(): ZZ64 = scale64(bS, z)
sc3(): RR64 = scale(bR, 3)
scz(): RR64 = scale(bR, z)
scu(): () = do v = scale(bR, z); () end
scn(): Wide = scale(bW, nw)
pk1(): () = do v = pick(z, l); () end
pk2(): () = do v = pick(3, l); () end
pk3(): () = do v = pick(z, rr); () end
pk4(): () = do v = pick(l, rr); () end
pk5(): () = do v = pick(z, s); () end
pk6(): () = do v = pick(u, z); () end
pk7(): () = do v = pick(wd, nw); () end
pk8(): () = do v = pick(3, 4); () end
pk9(): ZZ64 = pick(z, l)
pn1(): () = do v = pickN(3, l); () end
pn2(): () = do v = pickN(z, rr); () end
lh1(): () = do v = lohi(2, 46); () end
lh2(): () = do v = lohi(2, z); () end
lh3(): () = do v = lohi(z, l); () end
lh4(): () = do v = lohi(z, u); () end
lh5(): () = do v = lohi32(2, 46); () end
lh6(): () = do v = lohi(l, 3); () end
tw1(): ZZ64 = twice(l, 3)
tw2(): () = do v = twice(l, z); () end
tw3(): () = do v = twice(3, 4); () end
rg1(): () = do v = 0#z; () end
rg2(): () = do v = 2:46; () end
rg3(): () = do v = z#3; () end
rg4(): () = do v = l#3; () end
rg5(): () = do v = 0#l; () end
rg6(): () = do v = z:l; () end
rg7(): () = do v = 0#vocabSize; () end
rg7b(): () = do v = 0#vs; () end
rg8(): () = do v = 0#3; () end
bx1(): () = do a: BoxT[\ZZ64\] = wrapT(3); () end
bx2(): () = do a: BoxT[\ZZ64\] = Fac.wrap(3); () end
bx3(): () = do a: BoxT[\ZZ64\] = BOXOF 3; () end
bx4(): () = do a: ZZ64 = 3 OPLUS 4; () end
bx5(): () = do a: ZZ64 = Fac.idm(3); () end
bx6(): () = do a: ZZ64 = idt(3); () end
bx7(): () = do a: BoxT[\ZZ64\] = wrapT(z); () end
bx8(): () = do a: BoxT[\ZZ32\] = wrapT(l); () end
run(): () = ()
end

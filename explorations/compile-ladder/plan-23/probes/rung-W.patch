diff --git a/ProjectFortress/tests/NativeHelperRaiseWalk.fss b/ProjectFortress/tests/NativeHelperRaiseWalk.fss
new file mode 100644
index 000000000..a77153e60
--- /dev/null
+++ b/ProjectFortress/tests/NativeHelperRaiseWalk.fss
@@ -0,0 +1,26 @@
+(* Under walk, a helper's raise of IntegerOverflow or DivisionByZero is the library's exception, which a catch sees. *)
+component NativeHelperRaiseWalk
+export Executable
+
+add(a:ZZ32, b:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleIntArith.intOverflowingAdd")
+quot(a:ZZ32, b:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleIntArith.intOverflowingDiv")
+
+run():() = do
+  assert(add(2, 3), 5, "add(2, 3)")
+  r: String := "none"
+  try
+    add(2147483647, 1)
+  catch e
+    IntegerOverflow => r := "IntegerOverflow"
+  end
+  assert(r, "IntegerOverflow", "add(2147483647, 1)")
+  r := "none"
+  try
+    quot(1, 0)
+  catch e
+    DivisionByZero => r := "DivisionByZero"
+  end
+  assert(r, "DivisionByZero", "quot(1, 0)")
+end
+
+end
diff --git a/ProjectFortress/tests/ZZ32DivisionByZeroWalk.fss b/ProjectFortress/tests/ZZ32DivisionByZeroWalk.fss
new file mode 100644
index 000000000..7bd3a102c
--- /dev/null
+++ b/ProjectFortress/tests/ZZ32DivisionByZeroWalk.fss
@@ -0,0 +1,20 @@
+(* ZZ32's DIV by zero throws DivisionByZero, which a catch sees; opr-overview.tex, section "Multiplication, Division, Modulo, and Remainder Operators". *)
+component ZZ32DivisionByZeroWalk
+export Executable
+
+dividesByZero(f: () -> ZZ32): Boolean =
+  try
+    f()
+    false
+  catch e
+    DivisionByZero => true
+  end
+
+run():() = do
+  zero: ZZ32 = 0
+  seven: ZZ32 = 7
+  assert(dividesByZero(fn () => seven DIV zero), "ZZ32 7 DIV 0 throws DivisionByZero; opr-overview.tex, section \"Multiplication, Division, Modulo, and Remainder Operators\"")
+  assert(seven DIV 2, 3, "ZZ32 7 DIV 2 is 3")
+end
+
+end

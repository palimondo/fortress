component R2ArithIntEdge
export Executable
object Box[\nat k\](v: ZZ32) end
object IBox[\int k\](v: ZZ32) end
sz[\nat k\](b: Box[\k\]): ZZ64 = k
isz[\int k\](b: IBox[\k\]): ZZ64 = k
run(): () = do
  println("REACHED")
  println("i1 2147483647 + 1 = " || isz(IBox[\2147483647 + 1\](0)))
  println("END")
end
end

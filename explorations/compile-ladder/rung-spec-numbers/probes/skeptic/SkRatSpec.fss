component SkRatSpec
export Executable

show(tag: String, v: Any): () = println(tag || ": " || v.asString)

run() = do
  pinf: QQ = 1/0
  ninf: QQ = (-1)/0
  nan: QQ = 0/0
  one: QQ = 1
  zero: QQ = 0
  half: QQ = 1/2
  show("1/0 + 1", (pinf + one))
  show("1/0 + 1/0", (pinf + pinf))
  show("1/0 + -1/0", (pinf + ninf))
  show("0/0 + 1", (nan + one))
  show("-(1/0)", (-pinf))
  show("-(0/0)", (-nan))
  show("0 DOT 1/0", (zero pinf))
  show("-2 DOT 1/0", ((-2) pinf))
  show("0/0 DOT 1", (nan one))
  show("1 / 0 as QQ", (one / zero))
  show("1 / (1/0)", (one / pinf))
  show("1 / (0/0)", (one / nan))
  show("(1/2)^(-2)", (half^(-2)))
  show("(0/0)^0", (nan^0))
  show("0/0 = 0/0", (nan = nan))
  show("0/0 < 1", (nan < one))
  show("0/0 > 1", (nan > one))
  show("0/0 = 1", (nan = one))
  show("0/0 CMP 1", (nan CMP one))
  show("0/0 CMP 0/0", (nan CMP nan))
  show("1 CMP 1/0", (one CMP pinf))
  show("-1/0 < 1", (ninf < one))
  show("1/0 MAX 0/0", (pinf MAX nan))
  show("0/0 MIN 1", (nan MIN one))
  show("0/0 MAXNUM 1", (nan MAXNUM one))
  show("1 MINNUM 0/0", (one MINNUM nan))
  show("|-1/0|", (|ninf|))
  show("|0/0|", (|nan|))
  show("numerator(1/0)", (numerator(pinf)))
  show("numerator(-1/0)", (numerator(ninf)))
  show("numerator(0/0)", (numerator(nan)))
  show("denominator(1/0)", (denominator(pinf)))
  show("denominator(0/0)", (denominator(nan)))
  show("floor(7/2)", (floor(7/2)))
  show("7/2 + 1/2", (7/2) + half)
end
end

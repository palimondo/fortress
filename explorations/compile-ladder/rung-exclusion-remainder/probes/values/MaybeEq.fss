component MaybeEq
export Executable
run(): () = do
  a: AnyMaybe = Nothing[\ZZ32\]
  b: AnyMaybe = Nothing[\String\]
  c: AnyMaybe = Just[\ZZ32\](3)
  d: AnyMaybe = Just[\RR64\](3.0)
  e: AnyMaybe = Nothing[\ZZ32\]
  println("Nothing[ZZ32] = Nothing[String]: " (a = b))
  println("Just[ZZ32](3) = Just[RR64](3.0): " (c = d))
  println("Nothing[ZZ32] = Nothing[ZZ32]: " (a = e))
  println("Just[ZZ32](3) = Nothing[ZZ32]: " (c = a))
end
end

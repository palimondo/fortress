(* A generic call whose two arguments share two unrelated supertypes, run under walk. *)
component XXXInferTwoCommonParentsWalk
export Executable

trait Red end
trait Round end
object Apple extends { Red, Round } end
object Cherry extends { Red, Round } end

same[\T\](a: T, b: T): String = "joined"

run() = do
    println("REACHED")
    assert(same(Apple, Cherry), "joined", "a generic call whose two arguments share the two unrelated supertypes Red and Round instantiates its type parameter and runs")
    println("PASS")
end

end

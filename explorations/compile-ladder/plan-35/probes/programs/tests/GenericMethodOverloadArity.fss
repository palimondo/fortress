(* Two generic dotted methods of one name and one static parameter, of two and three parameters, each run where the call's arguments fit it (overloading.tex, section "Applicability to Dotted Method Calls"). *)
component GenericMethodOverloadArity
export Executable

object Two
    tk[\U\](y: U, z: U): U = z
    tk[\U\](y: U, z: U, w: U): U = w
end

run(): () = do
    assert(Two.tk[\ZZ32\](1, 2), 2, "the overload of two parameters")
    assert(Two.tk[\ZZ32\](1, 2, 3), 3, "the overload of three parameters")
    assert(Two.tk(4, 5), 5, "the overload of two parameters, its static argument inferred")
end

end

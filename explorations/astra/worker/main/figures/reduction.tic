object VSumReduction extends CommutativeMonoidReduction[\V\]
  empty():V = constant(0.0)
  join(x:V,y:V):V = x + y
end
opr SUM():Comprehension[\V,V,V,V\] =
  Comprehension[\V,V,V,V\](fn (x:V) => x,VSumReduction,fn (x:V) => x)

component OptField
export Executable
(*) B2d: static argument to be inferred from a FIELD's declared type.
trait Opt[\T\] comprises { Full[\T\], Empty[\T\] } end
value object Full[\T\](x: T) extends Opt[\T\] end
value object Empty[\T\] extends Opt[\T\] end

object Holder(v: Opt[\String\] = Empty)
    getter tag(): ZZ32 = 1
end

run():() = do
    h = Holder()
    print("OptField=")
    println(h.tag)
end
end

component RR32Comp2
export Executable

kind(v: Any): String = typecase v of
    RR32 => "RR32"
    RR64 => "RR64"
    else => "other"
  end

gen[\T extends Number\](x: T, y: T): T = x

r64(x: RR64): String = kind(x)

run(): () = do
    a: RR32 = 1.5
    b: RR32 = 2.5
    f: RR64 = 3.0
    println("a < f " (a < f))
    println("a < 2.5 " (a < 2.5))
    println("a = 1.5 " (a = 1.5))
    println("a = f " (a = f))
    println("r64(a) is " r64(a))
    println("a MAX f is " kind(a MAX f))
    println(a MAX f)
    println("gen(a, f) is " kind(gen(a, f)))
    println("gen(a, b) is " kind(gen(a, b)))
  end
end

(* NN32Lcm -- the batch-3.5-4 review's hand arithmetic, run: NN32's LCM hands its operands to
   UnsignedLong.gcd sign-extended (NN32.java:147), where GCD widens them first (:141).
   2147483648 is 2^31; 2^31 LCM 7 is 15032385536, which NN32 cannot hold, so the
   specification's answer is a catchable IntegerOverflow (POSITIONS 2026-09-22, row 334). *)
component NN32Lcm
export Executable

run(): () = do
  a: NN32 = unsigned(-2147483647 - 1)
  b: NN32 = unsigned(7)
  c: NN32 = unsigned(6)
  d: NN32 = unsigned(4)
  println("a = " a ", b = " b)
  println("a GCD b = " (a GCD b))
  println("c LCM d = " (c LCM d))
  println("a LCM b = " (try (a LCM b).asString catch e IntegerOverflow => "IntegerOverflow" end))
  println("end reached")
end
end

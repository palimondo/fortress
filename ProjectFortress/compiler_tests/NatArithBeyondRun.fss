(* A size computed at instantiation beyond NN32 is made today on the compiled path, where walk refuses it. *)
component NatArithBeyondRun
export Executable

object Box[\nat k\](v: ZZ32) end
sz64[\nat k\](b: Box[\k\]): ZZ64 = k
next[\nat k\](): ZZ64 = sz64[\k + 1\](Box[\k + 1\](0))

run(): () = do
    println(next[\4294967295\]())
    println("PASS")
  end

end

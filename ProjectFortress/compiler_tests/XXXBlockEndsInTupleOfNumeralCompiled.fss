(* A block that ends in a tuple with a numeral element gives that tuple at the function's declared tuple type (conversions-coercions.tex, section "Coercions for Tuple and Arrow Types"). *)
component XXXBlockEndsInTupleOfNumeralCompiled
export Executable

pair(k: ZZ32): (ZZ32, ZZ32) = do (1, k) end

run(): () = do
    println("REACHED")
    (a, b) = pair(5)
    assert(a + b, 6, "the numeral and the value")
    println("PASS")
end

end

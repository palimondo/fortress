component SkPowZZ32
export Executable
run(): () = do
  zero: ZZ32 = 0
  one: ZZ32 = 1
  two: ZZ32 = 2
  three: ZZ32 = 3
  mone: ZZ32 = -1
  mtwo: ZZ32 = -2
  mthree: ZZ32 = -3
  n46340: ZZ32 = 46340
  n46341: ZZ32 = 46341
  n65536: ZZ32 = 65536
  n65537: ZZ32 = 65537
  n33: ZZ32 = 33
  n34: ZZ32 = 34
  maxI: ZZ32 = 2147483647
  println("z1 2^31 " || (try "" || (two^31) catch e IntegerOverflow => "OVF" end))
  println("z2 (-2)^31 " || (try "" || (mtwo^31) catch e IntegerOverflow => "OVF" end))
  println("z3 46341^2 " || (try "" || (n46341^2) catch e IntegerOverflow => "OVF" end))
  println("z4 46340^2 " || (try "" || (n46340^2) catch e IntegerOverflow => "OVF" end))
  println("z5 3^20 " || (try "" || (three^20) catch e IntegerOverflow => "OVF" end))
  println("z6 3^19 " || (try "" || (three^19) catch e IntegerOverflow => "OVF" end))
  println("z7 (-3)^19 " || (try "" || (mthree^19) catch e IntegerOverflow => "OVF" end))
  println("z8 0^0 " || (try "" || (zero^0) catch e IntegerOverflow => "OVF" end))
  println("z9 1^MAX " || (try "" || (one^maxI) catch e IntegerOverflow => "OVF" end))
  println("z10 (-1)^MAX " || (try "" || (mone^maxI) catch e IntegerOverflow => "OVF" end))
  println("z11 (-2)^32 " || (try "" || (mtwo^32) catch e IntegerOverflow => "OVF" end))
  println("c1 65536 CHOOSE 2 " || (try "" || (n65536 CHOOSE two) catch e IntegerOverflow => "OVF" end))
  println("c2 65537 CHOOSE 2 " || (try "" || (n65537 CHOOSE two) catch e IntegerOverflow => "OVF" end))
  println("c3 0 CHOOSE 0 " || (try "" || (zero CHOOSE zero) catch e IntegerOverflow => "OVF" end))
  println("c4 MAX CHOOSE MAX " || (try "" || (maxI CHOOSE maxI) catch e IntegerOverflow => "OVF" end))
  println("c5 MAX CHOOSE 0 " || (try "" || (maxI CHOOSE zero) catch e IntegerOverflow => "OVF" end))
  println("c6 34 CHOOSE 16 " || (try "" || (n34 CHOOSE 16) catch e IntegerOverflow => "OVF" end))
  println("c7 33 CHOOSE 17 " || (try "" || (n33 CHOOSE 17) catch e IntegerOverflow => "OVF" end))
  println("c8 1 CHOOSE 2 " || (try "" || (one CHOOSE two) catch e IntegerOverflow => "OVF" end))
  println("c9 -1 CHOOSE -1 " || (try "" || (mone CHOOSE mone) catch e IntegerOverflow => "OVF" end))
  println("c10 -1 CHOOSE 0 " || (try "" || (mone CHOOSE zero) catch e IntegerOverflow => "OVF" end))
  println("c11 MAX CHOOSE 2 " || (try "" || (maxI CHOOSE two) catch e IntegerOverflow => "OVF" end))
  println("c12 MAX CHOOSE (MAX-1) " || (try "" || (maxI CHOOSE (maxI - one)) catch e IntegerOverflow => "OVF" end))
  println("END")
end
end

component SkSizeLocal32
export Executable
object Box[\nat k\](v: ZZ32) end
kind(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    else => "other"
  end
lit32(): ZZ32 = 2147483648
loc[\nat k\](b: Box[\k\]): String = do
  z: ZZ32 = k
  "" || z || " of kind " || kind(z)
end
run(): () = do
  println("REACHED")
  println("a numeral 2147483648 from a ZZ32 function: " || lit32() || " of kind " || kind(lit32()))
  println("a size 2147483647 bound to a ZZ32 local: " || loc(Box[\2147483647\](0)))
  println("a size 2147483648 bound to a ZZ32 local: " || loc(Box[\2147483648\](0)))
  println("END")
end
end

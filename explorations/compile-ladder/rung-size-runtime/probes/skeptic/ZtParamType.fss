component ZtParamType
export Executable
object Box[\nat k\](v: ZZ32) end
f[\nat k\](b: Box[\k\]): ZZ32 = (fn (x: Box[\k\]): ZZ32 => x.v + 1)(b)
trait Sz[\nat k\]
  m[\nat j\](b: Box[\j\]): ZZ32 = (fn (): ZZ32 => 10 k + j)()
end
object O[\nat k\]() extends Sz[\k\] end
run() = do
  println(f(Box[\5\](40)))
  println(O[\3\]().m[\4\](Box[\4\](0)))
end
end

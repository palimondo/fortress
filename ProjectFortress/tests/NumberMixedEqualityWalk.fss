    assert(i3 = g3, "numbers.tex, section \"Rational Numbers\", and conversions-coercions.tex, section \"Coercion Resolution\": ZZ coerces from ZZ32, so the two compare at ZZ; a ZZ32 and a ZZ of one value are equal, the ZZ32 first")

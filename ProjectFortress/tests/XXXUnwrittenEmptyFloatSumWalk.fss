component XXXUnwrittenEmptyFloatSumWalk
export Executable

(* An empty sum of RR64 elements with no static argument is the RR64 identity 0.0, as the sum directed by the expression's type RR64 is. *)

emptyRSum(n: ZZ32): RR64 = SUM[j <- 0#n] (j / 2.0)

run(): () = do
    e = emptyRSum(0)
    assert(e, 0.0, "an empty sum whose expression has type RR64 is SUM[RR64] over no element, the RR64 zero (reductions.tex, section \"Summations and Other Reduction Expressions\"; defining-generators.tex, subsection \"Simple Desugaring of Expressions with Generators\")")
    println("PASS")
  end

end

component SpecZZOnly64
export Executable

(*) The example with one exclusion only, S64 excludes S128: the definition's "rejects" still fails, since S32, which coerces to S64, does not exclude S128.
trait S32 end
trait S64 excludes { S128 }
  coerce(z: S32) = S64Of
end
trait S128
  coerce(z: S32) = S128Of
  coerce(z: S64) = S128Of
end
object S32Of extends S32 end
object S64Of extends S64 end
object S128Of extends S128 end

f(z: S64): ZZ32 = 1
f(z: S128): ZZ32 = 2

run(): () = do
  println("f(S32Of) = " f(S32Of))
end
end

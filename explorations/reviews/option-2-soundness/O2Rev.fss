component O2Rev
export Executable
(* Check 2: the pair of OpAnyZW declared in the other order, the plain arm first. *)
op(a: Any, b: Any): String = "op plain[" (typeOf a) "," (typeOf b) "]"
op[\T extends Number\](a: T, b: T): String = "op generic[" (typeOf a) "," (typeOf b) "]"
typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    IntLiteral => "IntLiteral"
    else => "other"
  end
run(): () = do
    z: ZZ32 = 3
    w: ZZ64 = 4
    n: Number = z
    println("op(z, w): " op(z, w))
    println("op(z, z): " op(z, z))
    println("op(n, w): " op(n, w))
  end
end

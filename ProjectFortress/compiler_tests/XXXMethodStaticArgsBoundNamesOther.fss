(* A dotted method one of whose type parameters is bounded by a type at another of them may be invoked with its static arguments written (method-invocation.tex, section "Dotted Method Invocations"; trait-parameters.tex, section "Type Parameters"), so the program runs it; the compiled checker stops on the invocation, "R is not in the kind env". *)
component XXXMethodStaticArgsBoundNamesOther
export Executable

object Box[\T\]() end

object O
  gen[\R, Q extends Box[\R\]\](q: Q): ZZ32 = 1
end

run(): () = do
    assert(O.gen[\String, Box[\String\]\](Box[\String\]()), 1, "O.gen with its static arguments written")
    println("PASS")
  end

end

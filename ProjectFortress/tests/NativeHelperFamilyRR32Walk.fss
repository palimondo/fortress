(* RR32's operators and functions bound to nativeHelpers keep their values under walk, at signed zeros, the largest and smallest magnitudes, the infinities and NaN. *)
component NativeHelperFamilyRR32Walk
export Executable

run():() = do
  z: RR32 = narrow(0.0)
  nz: RR32 = narrow(-0.0)
  one: RR32 = narrow(1.0)
  two: RR32 = narrow(2.0)
  three: RR32 = narrow(3.0)
  half: RR32 = narrow(0.5)
  a: RR32 = narrow(2.5)
  b: RR32 = narrow(-0.75)
  tenth: RR32 = narrow(0.1)
  sq: RR32 = narrow(6.25)
  large: RR32 = narrow(300000000000000000000000000000000000000.0)
  maxf: RR32 = narrow(340282346638528859811704183484516925440.0)
  tiny: RR32 = narrow(0.0000000000000000000000000000000000000000000014)
  inf: RR32 = large DOT large
  ninf: RR32 = -inf
  nan: RR32 = z / z
  nmaxf: RR32 = -maxf
  ntiny: RR32 = -tiny
  wide: RR32 = narrow(8589934592.0)
  nwide: RR32 = narrow(-6442450944.0)
  seven: RR32 = narrow(10000000.0)
  milli: RR32 = narrow(0.001)
  small: RR32 = narrow(0.0001)
  mill: RR32 = narrow(1234567.0)
  h35: RR32 = narrow(3.5)
  nh25: RR32 = narrow(-2.5)
  p27: RR32 = narrow(2.7)
  np27: RR32 = narrow(-2.7)

  assert(a.asString, "2.5", "asString of a")
  assert(b.asString, "-0.75", "asString of b")
  assert(tenth.asString, "0.1", "asString of tenth")
  assert(z.asString, "0.0", "asString of z")
  assert(nz.asString, "-0.0", "asString of nz")
  assert(large.asString, "3.0E38", "asString of large")
  assert(maxf.asString, "3.4028235E38", "asString of maxf")
  assert(tiny.asString, "1.4E-45", "asString of tiny")
  assert(ntiny.asString, "-1.4E-45", "asString of ntiny")
  assert(inf.asString, "Infinity", "asString of inf")
  assert(ninf.asString, "-Infinity", "asString of ninf")
  assert(nan.asString, "NaN", "asString of nan")
  assert(seven.asString, "1.0E7", "asString of seven")
  assert(milli.asString, "0.001", "asString of milli")
  assert(small.asString, "1.0E-4", "asString of small")
  assert(mill.asString, "1234567.0", "asString of mill")
  assert(a.asExprString, "2.5", "asExprString of a")
  assert(b.asExprString, "-0.75", "asExprString of b")
  assert(z.asExprString, "0.0", "asExprString of z")
  assert(nz.asExprString, "-0.0", "asExprString of nz")
  assert(maxf.asExprString, "3.4028235E38", "asExprString of maxf")
  assert(tiny.asExprString, "1.4E-45", "asExprString of tiny")
  assert(inf.asExprString, "Infinity", "asExprString of inf")
  assert(ninf.asExprString, "-Infinity", "asExprString of ninf")
  assert(nan.asExprString, "NaN", "asExprString of nan")
  assert(seven.asExprString, "1.0E7", "asExprString of seven")
  assert(small.asExprString, "1.0E-4", "asExprString of small")

  assert(nan.isNaN, true, "isNaN of nan")
  assert(a.isNaN, false, "isNaN of a")
  assert(z.isNaN, false, "isNaN of z")
  assert(nz.isNaN, false, "isNaN of nz")
  assert(inf.isNaN, false, "isNaN of inf")
  assert(ninf.isNaN, false, "isNaN of ninf")
  assert(maxf.isNaN, false, "isNaN of maxf")
  assert(tiny.isNaN, false, "isNaN of tiny")
  assert(inf.isInfinite, true, "isInfinite of inf")
  assert(ninf.isInfinite, true, "isInfinite of ninf")
  assert(a.isInfinite, false, "isInfinite of a")
  assert(z.isInfinite, false, "isInfinite of z")
  assert(nz.isInfinite, false, "isInfinite of nz")
  assert(maxf.isInfinite, false, "isInfinite of maxf")
  assert(tiny.isInfinite, false, "isInfinite of tiny")
  assert(nan.isInfinite, false, "isInfinite of nan")
  assert((a.rawBits).asString, "1075838976", "rawBits of a")
  assert((one.rawBits).asString, "1065353216", "rawBits of one")
  assert((b.rawBits).asString, "-1086324736", "rawBits of b")
  assert((z.rawBits).asString, "0", "rawBits of z")
  assert((nz.rawBits).asString, "-2147483648", "rawBits of nz")
  assert((maxf.rawBits).asString, "2139095039", "rawBits of maxf")
  assert((tiny.rawBits).asString, "1", "rawBits of tiny")
  assert((ntiny.rawBits).asString, "-2147483647", "rawBits of ntiny")
  assert((inf.rawBits).asString, "2139095040", "rawBits of inf")
  assert((ninf.rawBits).asString, "-8388608", "rawBits of ninf")

  assert((one.nextUp).asString, "1.0000001", "nextUp of one")
  assert((a.nextUp).asString, "2.5000002", "nextUp of a")
  assert((b.nextUp).asString, "-0.74999994", "nextUp of b")
  assert((z.nextUp).asString, "1.4E-45", "nextUp of z")
  assert((tiny.nextUp).asString, "2.8E-45", "nextUp of tiny")
  assert((ntiny.nextUp).asString, "-0.0", "nextUp of ntiny")
  assert((maxf.nextUp).asString, "Infinity", "nextUp of maxf")
  assert((nmaxf.nextUp).asString, "-3.4028233E38", "nextUp of nmaxf")
  assert((inf.nextUp).asString, "Infinity", "nextUp of inf")
  assert((ninf.nextUp).asString, "-3.4028235E38", "nextUp of ninf")
  assert((nan.nextUp).asString, "NaN", "nextUp of nan")
  assert((one.nextDown).asString, "0.99999994", "nextDown of one")
  assert((a.nextDown).asString, "2.4999998", "nextDown of a")
  assert((b.nextDown).asString, "-0.75000006", "nextDown of b")
  assert((nz.nextDown).asString, "-1.4E-45", "nextDown of nz")
  assert((tiny.nextDown).asString, "0.0", "nextDown of tiny")
  assert((ntiny.nextDown).asString, "-2.8E-45", "nextDown of ntiny")
  assert((maxf.nextDown).asString, "3.4028233E38", "nextDown of maxf")
  assert((nmaxf.nextDown).asString, "-Infinity", "nextDown of nmaxf")
  assert((inf.nextDown).asString, "3.4028235E38", "nextDown of inf")
  assert((ninf.nextDown).asString, "-Infinity", "nextDown of ninf")
  assert((nan.nextDown).asString, "NaN", "nextDown of nan")
  assert((|a|).asString, "2.5", "|x| of a")
  assert((|b|).asString, "0.75", "|x| of b")
  assert((|z|).asString, "0.0", "|x| of z")
  assert((|nz|).asString, "0.0", "|x| of nz")
  assert((|large|).asString, "3.0E38", "|x| of large")
  assert((|nmaxf|).asString, "3.4028235E38", "|x| of nmaxf")
  assert((|tiny|).asString, "1.4E-45", "|x| of tiny")
  assert((|ntiny|).asString, "1.4E-45", "|x| of ntiny")
  assert((|inf|).asString, "Infinity", "|x| of inf")
  assert((|ninf|).asString, "Infinity", "|x| of ninf")
  assert((|nan|).asString, "NaN", "|x| of nan")

  assert(a = a, true, "= of a and a")
  assert(a = b, false, "= of a and b")
  assert(b = a, false, "= of b and a")
  assert(z = nz, true, "= of z and nz")
  assert(nz = z, true, "= of nz and z")
  assert(tiny = z, false, "= of tiny and z")
  assert(z = tiny, false, "= of z and tiny")
  assert(ntiny = nz, false, "= of ntiny and nz")
  assert(large = inf, false, "= of large and inf")
  assert(inf = large, false, "= of inf and large")
  assert(maxf = inf, false, "= of maxf and inf")
  assert(inf = inf, true, "= of inf and inf")
  assert(ninf = b, false, "= of ninf and b")
  assert(ninf = ninf, true, "= of ninf and ninf")
  assert(ninf = inf, false, "= of ninf and inf")
  assert(nmaxf = ninf, false, "= of nmaxf and ninf")
  assert(a =/= a, false, "=/= of a and a")
  assert(a =/= b, true, "=/= of a and b")
  assert(b =/= a, true, "=/= of b and a")
  assert(z =/= nz, false, "=/= of z and nz")
  assert(nz =/= z, false, "=/= of nz and z")
  assert(tiny =/= z, true, "=/= of tiny and z")
  assert(z =/= tiny, true, "=/= of z and tiny")
  assert(ntiny =/= nz, true, "=/= of ntiny and nz")
  assert(large =/= inf, true, "=/= of large and inf")
  assert(inf =/= large, true, "=/= of inf and large")
  assert(maxf =/= inf, true, "=/= of maxf and inf")
  assert(inf =/= inf, false, "=/= of inf and inf")
  assert(ninf =/= b, true, "=/= of ninf and b")
  assert(ninf =/= ninf, false, "=/= of ninf and ninf")
  assert(ninf =/= inf, true, "=/= of ninf and inf")
  assert(nmaxf =/= ninf, true, "=/= of nmaxf and ninf")
  assert(a < a, false, "< of a and a")
  assert(a < b, false, "< of a and b")
  assert(b < a, true, "< of b and a")
  assert(z < nz, false, "< of z and nz")
  assert(nz < z, false, "< of nz and z")
  assert(tiny < z, false, "< of tiny and z")
  assert(z < tiny, true, "< of z and tiny")
  assert(ntiny < nz, true, "< of ntiny and nz")
  assert(large < inf, true, "< of large and inf")
  assert(inf < large, false, "< of inf and large")
  assert(maxf < inf, true, "< of maxf and inf")
  assert(inf < inf, false, "< of inf and inf")
  assert(ninf < b, true, "< of ninf and b")
  assert(ninf < ninf, false, "< of ninf and ninf")
  assert(ninf < inf, true, "< of ninf and inf")
  assert(nmaxf < ninf, false, "< of nmaxf and ninf")
  assert(a <= a, true, "<= of a and a")
  assert(a <= b, false, "<= of a and b")
  assert(b <= a, true, "<= of b and a")
  assert(z <= nz, true, "<= of z and nz")
  assert(nz <= z, true, "<= of nz and z")
  assert(tiny <= z, false, "<= of tiny and z")
  assert(z <= tiny, true, "<= of z and tiny")
  assert(ntiny <= nz, true, "<= of ntiny and nz")
  assert(large <= inf, true, "<= of large and inf")
  assert(inf <= large, false, "<= of inf and large")
  assert(maxf <= inf, true, "<= of maxf and inf")
  assert(inf <= inf, true, "<= of inf and inf")
  assert(ninf <= b, true, "<= of ninf and b")
  assert(ninf <= ninf, true, "<= of ninf and ninf")
  assert(ninf <= inf, true, "<= of ninf and inf")
  assert(nmaxf <= ninf, false, "<= of nmaxf and ninf")
  assert(a > a, false, "> of a and a")
  assert(a > b, true, "> of a and b")
  assert(b > a, false, "> of b and a")
  assert(z > nz, false, "> of z and nz")
  assert(nz > z, false, "> of nz and z")
  assert(tiny > z, true, "> of tiny and z")
  assert(z > tiny, false, "> of z and tiny")
  assert(ntiny > nz, false, "> of ntiny and nz")
  assert(large > inf, false, "> of large and inf")
  assert(inf > large, true, "> of inf and large")
  assert(maxf > inf, false, "> of maxf and inf")
  assert(inf > inf, false, "> of inf and inf")
  assert(ninf > b, false, "> of ninf and b")
  assert(ninf > ninf, false, "> of ninf and ninf")
  assert(ninf > inf, false, "> of ninf and inf")
  assert(nmaxf > ninf, true, "> of nmaxf and ninf")
  assert(a >= a, true, ">= of a and a")
  assert(a >= b, true, ">= of a and b")
  assert(b >= a, false, ">= of b and a")
  assert(z >= nz, true, ">= of z and nz")
  assert(nz >= z, true, ">= of nz and z")
  assert(tiny >= z, true, ">= of tiny and z")
  assert(z >= tiny, false, ">= of z and tiny")
  assert(ntiny >= nz, false, ">= of ntiny and nz")
  assert(large >= inf, false, ">= of large and inf")
  assert(inf >= large, true, ">= of inf and large")
  assert(maxf >= inf, false, ">= of maxf and inf")
  assert(inf >= inf, true, ">= of inf and inf")
  assert(ninf >= b, false, ">= of ninf and b")
  assert(ninf >= ninf, true, ">= of ninf and ninf")
  assert(ninf >= inf, false, ">= of ninf and inf")
  assert(nmaxf >= ninf, true, ">= of nmaxf and ninf")

  assert((a MIN b).asString, "-0.75", "MIN of a and b")
  assert((b MIN a).asString, "-0.75", "MIN of b and a")
  assert((z MIN nz).asString, "-0.0", "MIN of z and nz")
  assert((nz MIN z).asString, "-0.0", "MIN of nz and z")
  assert((tiny MIN z).asString, "0.0", "MIN of tiny and z")
  assert((large MIN inf).asString, "3.0E38", "MIN of large and inf")
  assert((ninf MIN tiny).asString, "-Infinity", "MIN of ninf and tiny")
  assert((maxf MIN nmaxf).asString, "-3.4028235E38", "MIN of maxf and nmaxf")
  assert((a MIN nan).asString, "NaN", "MIN of a and nan")
  assert((nan MIN a).asString, "NaN", "MIN of nan and a")
  assert((a MAX b).asString, "2.5", "MAX of a and b")
  assert((b MAX a).asString, "2.5", "MAX of b and a")
  assert((z MAX nz).asString, "0.0", "MAX of z and nz")
  assert((nz MAX z).asString, "0.0", "MAX of nz and z")
  assert((tiny MAX z).asString, "1.4E-45", "MAX of tiny and z")
  assert((large MAX inf).asString, "Infinity", "MAX of large and inf")
  assert((ninf MAX tiny).asString, "1.4E-45", "MAX of ninf and tiny")
  assert((maxf MAX nmaxf).asString, "3.4028235E38", "MAX of maxf and nmaxf")
  assert((a MAX nan).asString, "NaN", "MAX of a and nan")
  assert((nan MAX a).asString, "NaN", "MAX of nan and a")

  assert((-a).asString, "-2.5", "unary - of a")
  assert((-b).asString, "0.75", "unary - of b")
  assert((-z).asString, "-0.0", "unary - of z")
  assert((-nz).asString, "0.0", "unary - of nz")
  assert((-large).asString, "-3.0E38", "unary - of large")
  assert((-maxf).asString, "-3.4028235E38", "unary - of maxf")
  assert((-tiny).asString, "-1.4E-45", "unary - of tiny")
  assert((-inf).asString, "-Infinity", "unary - of inf")
  assert((-ninf).asString, "Infinity", "unary - of ninf")
  assert((-nan).asString, "NaN", "unary - of nan")
  assert((a + b).asString, "1.75", "+ of a and b")
  assert((one + tenth).asString, "1.1", "+ of one and tenth")
  assert((z + nz).asString, "0.0", "+ of z and nz")
  assert((nz + nz).asString, "-0.0", "+ of nz and nz")
  assert((maxf + maxf).asString, "Infinity", "+ of maxf and maxf")
  assert((nmaxf + nmaxf).asString, "-Infinity", "+ of nmaxf and nmaxf")
  assert((tiny + tiny).asString, "2.8E-45", "+ of tiny and tiny")
  assert((tiny + ntiny).asString, "0.0", "+ of tiny and ntiny")
  assert((inf + one).asString, "Infinity", "+ of inf and one")
  assert((inf + ninf).asString, "NaN", "+ of inf and ninf")
  assert((nan + one).asString, "NaN", "+ of nan and one")
  assert((a - b).asString, "3.25", "- of a and b")
  assert((one - tenth).asString, "0.9", "- of one and tenth")
  assert((z - z).asString, "0.0", "- of z and z")
  assert((nz - z).asString, "-0.0", "- of nz and z")
  assert((tiny - tiny).asString, "0.0", "- of tiny and tiny")
  assert((nmaxf - maxf).asString, "-Infinity", "- of nmaxf and maxf")
  assert((ninf - large).asString, "-Infinity", "- of ninf and large")
  assert((inf - inf).asString, "NaN", "- of inf and inf")
  assert((nan - one).asString, "NaN", "- of nan and one")
  assert((a DOT b).asString, "-1.875", "DOT of a and b")
  assert((tenth DOT tenth).asString, "0.010000001", "DOT of tenth and tenth")
  assert((nz DOT a).asString, "-0.0", "DOT of nz and a")
  assert((nz DOT nz).asString, "0.0", "DOT of nz and nz")
  assert((tiny DOT tiny).asString, "0.0", "DOT of tiny and tiny")
  assert((tiny DOT two).asString, "2.8E-45", "DOT of tiny and two")
  assert((large DOT large).asString, "Infinity", "DOT of large and large")
  assert((maxf DOT half).asString, "1.7014117E38", "DOT of maxf and half")
  assert((inf DOT z).asString, "NaN", "DOT of inf and z")
  assert((ninf DOT b).asString, "Infinity", "DOT of ninf and b")
  assert((nan DOT one).asString, "NaN", "DOT of nan and one")
  assert((a TIMES b).asString, "-1.875", "TIMES of a and b")
  assert((tenth TIMES tenth).asString, "0.010000001", "TIMES of tenth and tenth")
  assert((nz TIMES a).asString, "-0.0", "TIMES of nz and a")
  assert((nz TIMES nz).asString, "0.0", "TIMES of nz and nz")
  assert((tiny TIMES tiny).asString, "0.0", "TIMES of tiny and tiny")
  assert((tiny TIMES two).asString, "2.8E-45", "TIMES of tiny and two")
  assert((large TIMES large).asString, "Infinity", "TIMES of large and large")
  assert((maxf TIMES half).asString, "1.7014117E38", "TIMES of maxf and half")
  assert((inf TIMES z).asString, "NaN", "TIMES of inf and z")
  assert((ninf TIMES b).asString, "Infinity", "TIMES of ninf and b")
  assert((nan TIMES one).asString, "NaN", "TIMES of nan and one")
  assert((a b).asString, "-1.875", "juxtaposition of a and b")
  assert((tenth tenth).asString, "0.010000001", "juxtaposition of tenth and tenth")
  assert((nz a).asString, "-0.0", "juxtaposition of nz and a")
  assert((nz nz).asString, "0.0", "juxtaposition of nz and nz")
  assert((tiny tiny).asString, "0.0", "juxtaposition of tiny and tiny")
  assert((tiny two).asString, "2.8E-45", "juxtaposition of tiny and two")
  assert((large large).asString, "Infinity", "juxtaposition of large and large")
  assert((maxf half).asString, "1.7014117E38", "juxtaposition of maxf and half")
  assert((inf z).asString, "NaN", "juxtaposition of inf and z")
  assert((ninf b).asString, "Infinity", "juxtaposition of ninf and b")
  assert((nan one).asString, "NaN", "juxtaposition of nan and one")
  assert((a / b).asString, "-3.3333333", "/ of a and b")
  assert((one / three).asString, "0.33333334", "/ of one and three")
  assert((one / ninf).asString, "-0.0", "/ of one and ninf")
  assert((large / large).asString, "1.0", "/ of large and large")
  assert((nz / a).asString, "-0.0", "/ of nz and a")
  assert((tiny / two).asString, "0.0", "/ of tiny and two")
  assert((maxf / tiny).asString, "Infinity", "/ of maxf and tiny")
  assert((inf / inf).asString, "NaN", "/ of inf and inf")
  assert((z / z).asString, "NaN", "/ of z and z")
  assert((ninf / b).asString, "Infinity", "/ of ninf and b")
  assert((nan / one).asString, "NaN", "/ of nan and one")
  assert((SQRT sq).asString, "2.5", "SQRT of sq")
  assert((SQRT two).asString, "1.4142135", "SQRT of two")
  assert((SQRT z).asString, "0.0", "SQRT of z")
  assert((SQRT nz).asString, "-0.0", "SQRT of nz")
  assert((SQRT maxf).asString, "1.8446743E19", "SQRT of maxf")
  assert((SQRT tiny).asString, "3.743392E-23", "SQRT of tiny")
  assert((SQRT inf).asString, "Infinity", "SQRT of inf")
  assert((SQRT b).asString, "NaN", "SQRT of b")
  assert((SQRT ninf).asString, "NaN", "SQRT of ninf")
  assert((SQRT nan).asString, "NaN", "SQRT of nan")

  assert((a PLUS_UP b).asString, "1.75", "PLUS_UP of a and b")
  assert((one PLUS_UP tenth).asString, "1.1", "PLUS_UP of one and tenth")
  assert((tenth PLUS_UP b).asString, "-0.65", "PLUS_UP of tenth and b")
  assert((z PLUS_UP nz).asString, "0.0", "PLUS_UP of z and nz")
  assert((nz PLUS_UP nz).asString, "-0.0", "PLUS_UP of nz and nz")
  assert((tiny PLUS_UP tiny).asString, "2.8E-45", "PLUS_UP of tiny and tiny")
  assert((maxf PLUS_UP maxf).asString, "Infinity", "PLUS_UP of maxf and maxf")
  assert((nmaxf PLUS_UP nmaxf).asString, "-3.4028235E38", "PLUS_UP of nmaxf and nmaxf")
  assert((inf PLUS_UP ninf).asString, "Infinity", "PLUS_UP of inf and ninf")
  assert((nan PLUS_UP one).asString, "NaN", "PLUS_UP of nan and one")
  assert((a MINUS_UP b).asString, "3.25", "MINUS_UP of a and b")
  assert((one MINUS_UP tenth).asString, "0.90000004", "MINUS_UP of one and tenth")
  assert((b MINUS_UP tenth).asString, "-0.84999996", "MINUS_UP of b and tenth")
  assert((z MINUS_UP z).asString, "0.0", "MINUS_UP of z and z")
  assert((nz MINUS_UP z).asString, "-0.0", "MINUS_UP of nz and z")
  assert((tiny MINUS_UP ntiny).asString, "2.8E-45", "MINUS_UP of tiny and ntiny")
  assert((maxf MINUS_UP nmaxf).asString, "Infinity", "MINUS_UP of maxf and nmaxf")
  assert((nmaxf MINUS_UP maxf).asString, "-3.4028235E38", "MINUS_UP of nmaxf and maxf")
  assert((inf MINUS_UP inf).asString, "Infinity", "MINUS_UP of inf and inf")
  assert((nan MINUS_UP one).asString, "NaN", "MINUS_UP of nan and one")
  assert((a DOT_UP b).asString, "-1.875", "DOT_UP of a and b")
  assert((tenth DOT_UP tenth).asString, "0.010000001", "DOT_UP of tenth and tenth")
  assert((tenth DOT_UP b).asString, "-0.074999996", "DOT_UP of tenth and b")
  assert((tiny DOT_UP tiny).asString, "1.4E-45", "DOT_UP of tiny and tiny")
  assert((ntiny DOT_UP tiny).asString, "-0.0", "DOT_UP of ntiny and tiny")
  assert((large DOT_UP large).asString, "Infinity", "DOT_UP of large and large")
  assert((z DOT_UP inf).asString, "Infinity", "DOT_UP of z and inf")
  assert((nz DOT_UP inf).asString, "-0.0", "DOT_UP of nz and inf")
  assert((nan DOT_UP one).asString, "NaN", "DOT_UP of nan and one")
  assert((a SLASH_UP two).asString, "1.25", "SLASH_UP of a and two")
  assert((one SLASH_UP three).asString, "0.33333334", "SLASH_UP of one and three")
  assert((b SLASH_UP three).asString, "-0.25", "SLASH_UP of b and three")
  assert((tiny SLASH_UP two).asString, "1.4E-45", "SLASH_UP of tiny and two")
  assert((ntiny SLASH_UP two).asString, "-0.0", "SLASH_UP of ntiny and two")
  assert((maxf SLASH_UP tiny).asString, "Infinity", "SLASH_UP of maxf and tiny")
  assert((inf SLASH_UP inf).asString, "Infinity", "SLASH_UP of inf and inf")
  assert((ninf SLASH_UP inf).asString, "-0.0", "SLASH_UP of ninf and inf")

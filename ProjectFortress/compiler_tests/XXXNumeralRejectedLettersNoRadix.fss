(* The specification's section on numerals (Specification/basic/lexical-structure.tex) gives seven tokens that
   "would be classified as numerals but then rejected as static errors":

     0.a  0x6A35    FF_EIGHT       12.52.23     57_50   PI_FIFTEEN   dead.BEEF_16

   This test holds 0.a from that line. XXXNumeralRejectedLettersNoRadix.test names the rule that refuses it.
   The valid numerals of the same section are in tests/NumeralTest.fss. *)
component XXXNumeralRejectedLettersNoRadix
export Executable

run() = println(0.a)

end

component DivFail
export Executable

(*) The failure modes of DIV on the compiled path: the precedent for MOD and
(*) REM.  Both operands are computed at run time, so the folding phase
(*) (INTEGERLITERALFOLDING, PhaseOrder.java:57) cannot reach them.

opaque(x: ZZ32): ZZ32 = if x > 0 then x else (x + 1) - 1 end

run():() = do
    seven = opaque(7)
    zero = opaque(0)
    println("about to divide by zero")
    println((seven DIV zero).asString)
    println("NOT REACHED")
  end
end

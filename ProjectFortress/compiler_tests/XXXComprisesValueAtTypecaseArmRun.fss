(* A typecase with self in one arm and a value of the listed type in the other, returned at the type that the comprises clause of self's trait lists, runs compiled (traits.tex, section "Trait Declarations"). *)
component XXXComprisesValueAtTypecaseArmRun
export Executable

trait Q comprises { R }
    chosen(x: Any): R = typecase x of
        s: String => self
        else => R(0, 0)
      end
end

value object R(n: ZZ32, d: ZZ32) extends Q end

run(): () = do
    q: Q = R(1, 2)
    println("REACHED")
    assert(q.chosen("s").d, 2, "the arm that is self")
    assert(q.chosen(3).d, 0, "the arm at the listed type")
    println("PASS")
  end

end

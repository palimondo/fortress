component w02_paste_stack
export Executable

run(): () = do
    a: Array[\RR64,(ZZ32,ZZ32)\] = array[\RR64\](2, 2)
    a[(0,0)] := 1.0
    a[(0,1)] := 2.0
    a[(1,0)] := 3.0
    a[(1,1)] := 4.0
    b: Array[\RR64,(ZZ32,ZZ32)\] = array[\RR64\](2, 2)
    b[(0,0)] := 5.0
    b[(0,1)] := 6.0
    b[(1,0)] := 7.0
    b[(1,1)] := 8.0
    stack: Array[\RR64,(ZZ32,ZZ32)\] = [ a ; b ]
    println("stack = " stack)
  end

end

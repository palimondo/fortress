(* A generic trait with an excludes clause, an object below it that provides its functional method, and a top-level function of the same name are a valid program, which compiles. *)
component XXXGenericTraitExcludesKindEnv
export Executable

trait Numeric0 end
trait Str0 end
object Five extends Numeric0 end
object Word extends Str0 end
trait Rg[\I\] excludes { Numeric0, Str0 }
    opr IN(n: I, self): Boolean
end
object R1 extends Rg[\ZZ32\]
    opr IN(n: ZZ32, self): Boolean = n > 0
end
opr IN(n: Numeric0, s: Str0): Boolean = false

run(): () = do
    println("REACHED")
    println(3 IN R1)
    println(Five IN Word)
end
end

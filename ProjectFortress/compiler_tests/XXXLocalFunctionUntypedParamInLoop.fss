(* A loop body calls a local function whose parameter type is undeclared (functions.tex, sections "Local Function Declarations" and "Function Declarations"), so the program is valid; the compiled checker stops on the loop body's function, "TryChecker returned an untyped expr". *)
component XXXLocalFunctionUntypedParamInLoop
export Executable

run(): () = do
    r: ZZ32 := 0
    row(i) = do r := r + i end
    for i <- seq(1#3) do
        row(i)
    end
    println(r)
  end

end

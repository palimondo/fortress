component SkUnsignedNat
export Executable
run(): () = do
  oneN: NN32 = unsigned(1)
  twoN: NN32 = unsigned(2)
  zeroN: NN32 = unsigned(0)
  maxN: NN32 = BITNOT unsigned(0)
  m65535N: NN32 = unsigned(65535)
  b16N: NN32 = unsigned(65536)
  n92682N: NN32 = unsigned(92682)
  n92683N: NN32 = unsigned(92683)
  twoTo31N: NN32 = unsigned(1073741824) + unsigned(1073741824)
  e31N: NN32 = unsigned(31)
  e32N: NN32 = unsigned(32)
  println("n1 2^31 " || (try "" || (twoN^e31N) catch e IntegerOverflow => "OVF" end))
  println("n2 2^32 " || (try "" || (twoN^e32N) catch e IntegerOverflow => "OVF" end))
  println("n3 65535^2 " || (try "" || (m65535N^twoN) catch e IntegerOverflow => "OVF" end))
  println("n4 65536^2 " || (try "" || (b16N^twoN) catch e IntegerOverflow => "OVF" end))
  println("n5 MAX^1 " || (try "" || (maxN^oneN) catch e IntegerOverflow => "OVF" end))
  println("n6 MAX^0 " || (try "" || (maxN^zeroN) catch e IntegerOverflow => "OVF" end))
  println("n7 (2^31)^2 " || (try "" || (twoTo31N^twoN) catch e IntegerOverflow => "OVF" end))
  println("k1 MAX CHOOSE MAX " || (try "" || (maxN CHOOSE maxN) catch e IntegerOverflow => "OVF" end))
  println("k2 MAX CHOOSE (MAX-1) " || (try "" || (maxN CHOOSE (maxN - oneN)) catch e IntegerOverflow => "OVF" end))
  println("k3 92682 CHOOSE 2 " || (try "" || (n92682N CHOOSE twoN) catch e IntegerOverflow => "OVF" end))
  println("k4 92683 CHOOSE 2 " || (try "" || (n92683N CHOOSE twoN) catch e IntegerOverflow => "OVF" end))
  println("k5 2^31 CHOOSE 2 " || (try "" || (twoTo31N CHOOSE twoN) catch e IntegerOverflow => "OVF" end))
  println("k6 1 CHOOSE 2 " || (try "" || (oneN CHOOSE twoN) catch e IntegerOverflow => "OVF" end))
  println("k7 2^31 CHOOSE (2^31-1) " || (try "" || (twoTo31N CHOOSE (twoTo31N - oneN)) catch e IntegerOverflow => "OVF" end))
  println("END")
end
end

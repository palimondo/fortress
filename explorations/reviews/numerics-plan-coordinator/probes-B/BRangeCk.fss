component BRangeCk
export Executable
(* evidence-B probe; the compiled checker over the one library: ranges over the
   integer types, and a numeral meeting an NN32 in arithmetic.  One function per
   case; String = v reveals the static type. *)
l: ZZ64 = widen(5)
z: ZZ32 = 5
u: NN32 = unsigned(z)
r01(): () = do v = l#3; c: String = v; () end
r02(): () = do v = l#widen(3); c: String = v; () end
r03(): () = do v = 0#l; c: String = v; () end
r04(): () = do v = u#unsigned(3); c: String = v; () end
r05(): () = do v = big(1)#3; c: String = v; () end
r06(): () = do v = z#3; c: String = v; () end
r07(): () = do v = l:widen(7); c: String = v; () end
r08(): () = do v = big(1)#big(3); c: String = v; () end
r09(): () = do v = 0#3; c: String = v; () end
n01(): () = do v = u + 1; c: String = v; () end
n02(): () = do v = l + 1; c: String = v; () end
n03(): () = do v = u + u; c: String = v; () end
n04(): () = do v = 1 + u; c: String = v; () end
run(): () = ()
end

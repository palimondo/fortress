component O2MeetRev
export Executable
(* O2Meet with the three declarations in the reverse order. *)
op(a: ZZ32, b: Number): String = "op meet[" (typeOf a) "," (typeOf b) "]"
op(a: ZZ32, b: Any): String = "op z32any[" (typeOf a) "," (typeOf b) "]"
op[\T extends Number\](a: T, b: T): String = "op generic[" (typeOf a) "," (typeOf b) "]"
typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    IntLiteral => "IntLiteral"
    else => "other"
  end
run(): () = do
    z: ZZ32 = 3
    w: ZZ64 = 4
    println("op(z, w): " op(z, w))
    println("op(z, z): " op(z, z))
    println("op(w, w): " op(w, w))
    println("op(z, \"s\"): " op(z, "s"))
  end
end

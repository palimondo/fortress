(* Row 1078's shape, simplestRationalBetween's, copied with ZZ32 for QQ and an if for the typecase: against the prelude it compiles, verifies and prints 12 twice. *)
component LabelLocals3
export Executable
pick(a: ZZ32, b: ZZ32): ZZ32 = label done
    n0 : ZZ32 := a
    d0 : ZZ32 := 1
    n1 : ZZ32 := b
    d1 : ZZ32 := 1
    neg : Boolean := false
    if a = b then exit done with a end
    if a > b then (n0,d0,n1,d1) := (n1,d1,n0,d0) end
    if n1 < 0 then
        neg := true
        (n0,d0,n1,d1) := (-n1,d1,-n0,d0)
    end
    if n0 <= 0 then exit done with a - a end
    if d1 = 0 then
        r = n0 + d0
        q: ZZ32 = if neg then -r else r end
        exit done with q
    end
    (nr,dr) = (n0 + d1, n1 + d0)
    if neg then -nr else nr + dr end
  end done
run(): () = do
  println(pick(3, 7))
  println(pick(7, 3))
end
end

+      end
+    (** The subarray at (o0,o1,o2), given in this array's indices, striding by (m0,m1,m2). **)
+    subarray[\nat bo0, nat so0, nat bo1, nat so1, nat bo2, nat so2,
+              nat o0, nat o1, nat o2\]
+            (m0:ZZ32,m1:ZZ32,m2:ZZ32): ImmutableArray3[\T,bo0,so0,bo1,so1,bo2,so2\] = do
+        boundsCheck = self.bounds.narrowToRange( (o0,o1,o2)::(m0,m1,m2)#(so0,so1,so2) )
+        __ImmutableSubArray3[\T,bo0,so0,bo1,so1,bo2,so2,b0,s0,b1,s1,b2,s2\](self,m0,o0-b0,m1,o1-b1,m2,o2-b2)
+      end
+    zeroIndices():CompactFullRange3D =
+        sized3Range(0,0,0,s0,s1,s2)
+    replica[\U\]():ImmutableArray3[\U,b0,s0,b1,s1,b2,s2\] =
+        __immutableFactory3[\U,b0,s0,b1,s1,b2,s2\]()
+    copy():ImmutableArray3[\T,b0,s0,b1,s1,b2,s2\] =
+        self.replica[\T\]().tabulate(fn (i:ZZ32,j:ZZ32,k:ZZ32):T =>
+                                         get(i-b0,j-b1,k-b2))
+    fill(v:T):ImmutableArray3[\T,b0,s0,b1,s1,b2,s2\] = do
+        for i <- zeroIndices() do init0(i,v) end
+        self
+      end
+    tabulate(f:(ZZ32,ZZ32,ZZ32)->T):ImmutableArray3[\T,b0,s0,b1,s1,b2,s2\] = do
+        for i <- zeroIndices() do init0(i,f(toIndex(i))) end
+        self
+      end
+    thaw():Array3[\T,b0,s0,b1,s1,b2,s2\] =
+        __builtinFactory3[\T,b0,s0,b1,s1,b2,s2\]().tabulate(fn (i:ZZ32,j:ZZ32,k:ZZ32):T =>
+                                                               get(i-b0,j-b1,k-b2))
+    map[\R\](f:T->R): ImmutableArray3[\R,b0,s0,b1,s1,b2,s2\] =
+        replica[\R\]().tabulate(fn (i:ZZ32,j:ZZ32,k:ZZ32):R =>
+                                    f(get(i-b0,j-b1,k-b2)))
+    ivmap[\R\](f:((ZZ32,ZZ32,ZZ32),T)->R): ImmutableArray3[\R,b0,s0,b1,s1,b2,s2\] =
+        replica[\R\]().tabulate(fn (i:ZZ32,j:ZZ32,k:ZZ32):R =>
+                                    f((i,j,k),get(i-b0,j-b1,k-b2)))
+end
+
+__subarrayI[\T, nat b0, nat s0, nat b1, nat s1, nat b2, nat s2,
+             nat bo0, nat so0, nat bo1, nat so1, nat bo2, nat so2,
+             nat o0, nat o1, nat o2\]
+      (this:ImmutableArray3[\T,b0,s0,b1,s1,b2,s2\],
+       _:N[\bo0\],_:N[\so0\],_:N[\bo1\],_:N[\so1\],_:N[\bo2\],_:N[\so2\],
+       _:N[\o0\],_:N[\o1\],_:N[\o2\], m0:ZZ32,m1:ZZ32,m2:ZZ32): ImmutableArray3[\T,bo0,so0,bo1,so1,bo2,so2\] =
+    this.subarray[\bo0,so0,bo1,so1,bo2,so2,o0,o1,o2\](m0,m1,m2)
+
+object __DefaultImmutableArray3[\T, nat b0, nat s0, nat b1, nat s1, nat b2, nat s2\]() extends
+                                        ImmutableArray3[\T, b0, s0, b1, s1, b2, s2\]
+  mem:PrimImmutableArray[\T,(s0 (s1 s2))\] = PrimImmutableArray[\T,(s0 (s1 s2))\]()
+  ofs(i:ZZ32,j:ZZ32,k:ZZ32):ZZ32 = (i s1 + j) s2 + k
+  init0(t:(ZZ32,ZZ32,ZZ32), v:T) : () = mem.init0(ofs(t),v)
+  get(t:(ZZ32,ZZ32,ZZ32)) : T = mem.get(ofs(t))
+end
+
+(** A 3-D view of an ImmutableArray3, as SubArray3 is of an Array3. **)
+object __ImmutableSubArray3[\T, nat b0, nat s0, nat b1, nat s1, nat b2, nat s2,
+                                nat bu0, nat su0, nat bu1, nat su1, nat bu2, nat su2\]
+                (mem: ImmutableArray3[\T,bu0,su0,bu1,su1,bu2,su2\],
+                 m0:ZZ32,o0:ZZ32, m1:ZZ32,o1:ZZ32, m2:ZZ32, o2:ZZ32)
+        extends ImmutableArray3[\T,b0,s0,b1,s1,b2,s2\]
+    index(a0:ZZ32, a1:ZZ32, a2:ZZ32): (ZZ32,ZZ32,ZZ32) =
+        (m0 a0 + o0, m1 a1 + o1, m2 a2 + o2)
+    init0(t:(ZZ32,ZZ32,ZZ32), v:T): () = mem.init0(index(t),v)
+    get(t:(ZZ32,ZZ32,ZZ32)): T = mem.get(index(t))
+end
+
+__immutableFactory3[\T, nat b0, nat s0, nat b1, nat s1, nat b2, nat s2\]():
+        ImmutableArray3[\T,b0,s0,b1,s1,b2,s2\] =
+  __DefaultImmutableArray3[\T,b0,s0,b1,s1,b2,s2\]()
+
+immutableArray3[\T,nat s0, nat s1, nat s2\]():ImmutableArray3[\T,0,s0,0,s1,0,s2\] =
+  __DefaultImmutableArray3[\T,0,s0,0,s1,0,s2\]()
+

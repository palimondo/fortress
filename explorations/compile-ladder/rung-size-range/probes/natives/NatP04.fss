component NatP04
export Executable
run() = do
  two: ZZ32 = 2
  three: ZZ32 = 3
  mtwo: ZZ32 = -2
  zero: ZZ32 = 0
  one: ZZ32 = 1
  mone: ZZ32 = -1
  n34: ZZ32 = 34
  n33: ZZ32 = 33
  five: ZZ32 = 5
  mfive: ZZ32 = -5
  maxI: ZZ32 = 2147483647
  caseName = "ZZ32 three^40 = "
  r: String = try
      v = three^40
      v.asString
    catch e
      IntegerOverflow => "IntegerOverflow"
    end
  println(caseName || r)
end
end

(* p01b -- continue p01 after RR64.truncate() turned out not to exist at run
   time.  Next spellings: the floor bracket (declared : ZZ), its narrow, and
   RR64.floor(). *)
component p01b_numfmt
export Executable

run(): () = do
    v: RR64 = 7.0
    println("4. floor bracket in a string: " (|\ v /|))
end

end

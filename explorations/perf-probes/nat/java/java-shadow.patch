+/* NAT SHADOW, new file (explorations/perf-probes/nat/java/java-shadow.patch).
+ *
+ * The run-time representation of a size static argument, for the scoping
+ * experiment of explorations/perf-probes/nat/java.md  2: the missing third
+ * sibling of VoidRTTI (22 lines) and JavaRTTI (15 lines).
+ *
+ * Two things the rest of the run time asks of an RTTI object, and why a size
+ * needs its own class for them:
+ *   - className() (RTTI.java:52-58) is what RTHelpers.getRTTIclass builds the
+ *     instantiated RTTI class name out of (RTHelpers.java:31-45), so a size's
+ *     must be the size itself, the way VoidRTTI's is the snowman
+ *     (VoidRTTI.java:18-20).
+ *   - runtimeSupertypeOf (RTTI.java:22-27) is Class.isAssignableFrom on the
+ *     javaRep, and a size has no Java class; two sizes are related exactly when
+ *     they are equal (the team's "don't instantiate",
+ *     internal-document.tex:206).
+ * The name begins with "RTTI" so that InstantiatingClassloader's
+ * mustUseSystemLoader list (:2905-2907) sends it to the system loader, as it
+ * does RTTI, ArrowRTTI and JavaRTTI.
+ */
+package com.sun.fortress.compiler.runtimeValues;
+
+public class RTTIsize extends RTTI {
+
+    private final String size;
+
+    public RTTIsize(String size) {
+        // An inert placeholder: a size is not a type, and RTTI's javaRep is only
+        // used by the runtimeSupertypeOf and className overridden below.  FZZ32.class
+        // cannot be used -- its static initializer needs the generic Fortress class
+        // fortress/CompilerAlgebra$Equality[FZZ32], which only the instantiating
+        // loader can make, and it is not the one asking.
+        super(java.lang.Object.class);
+        this.size = size;
+    }
+
+    public boolean runtimeSupertypeOf(RTTI other) {
+        return (other instanceof RTTIsize) && ((RTTIsize) other).size.equals(size);
+    }
+
+    public String className() {
+        return size;
+    }
+
+    public String toString() {
+        return "size " + size;
+    }
+}

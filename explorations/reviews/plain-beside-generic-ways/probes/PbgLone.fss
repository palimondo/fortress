component PbgLone
export Executable

(* MieDispatchAny's generic peek alone, with no plain declaration beside it: can walk
   instantiate X from the argument when the declared return type does not mention X?
   Called with a variable of RedTag's own type, so that the compiled path accepts the call. *)
trait Tag[\X\] end
object Red end
object RedTag extends Tag[\Red\] end
object Marker[\X\] end

peek[\X\](t: Tag[\X\]): Any = Marker[\X\]

name(m: Any): String = typecase m of
    Marker[\Red\] => "Marker[Red]"
    else => "other"
  end

run(): () = do
  r: RedTag = RedTag
  println("peek(r), r: RedTag -> " name(peek(r)))
end
end

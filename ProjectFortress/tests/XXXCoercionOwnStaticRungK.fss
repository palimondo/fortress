trait TagO[\S\]
  getter s(): String
end
object TagOOf[\S\](s0: String) extends TagO[\S\]
  getter s(): String = s0
end
trait WideO[\T\]
  coerce[\S\](x: TagO[\S\]) = WideOOf[\T\](x.s)
  getter s(): String
end
object WideOOf[\T\](s0: String) extends WideO[\T\]
  getter s(): String = s0
end

fO(x: WideO[\ZZ32\]): String = x.s

run(): () = do
    println("REACHED")
    assert(fO(WideOOf[\ZZ32\]("direct")), "direct", "control: a WideO where a WideO is declared")
    assert(fO(TagOOf[\String\]("coerced")), "coerced", "a generic trait's coercion with its own static parameter converts; conversions-coercions.tex, sections \"Principles of Coercion\" and \"Coercion Declarations\"")
    println("PASS")
  end

end

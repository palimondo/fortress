component g4b_capture2
export Executable

trait Nd
  getter data(): ZZ32
  bump(): ZZ32
end

mk1(k: ZZ32): Nd = object extends Nd
    getter data(): ZZ32 = k
    bump(): ZZ32 = k + 1
  end

mk2(k: ZZ32): Nd = object extends Nd
    getter data(): ZZ32 = k + 10
    bump(): ZZ32 = k + 12
  end

run(): () = do
  println((mk1(5)).data " " (mk1(5)).bump())
  println((mk2(5)).data " " (mk2(5)).bump())
end
end

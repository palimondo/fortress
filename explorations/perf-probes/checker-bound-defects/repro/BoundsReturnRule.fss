(* Row 690: a generic declaration under two bounds beside a declaration on the closed trait, same return type. *)
component BoundsReturnRule
export Executable
trait R[\T extends R[\T\]\] end
trait K comprises { A, B, C } end
object A extends { K, R[\A\] } end
object B extends { K, R[\B\] } end
object C extends K end
f[\T extends { K, R[\T\] }\](x: T): String = "R"
f(x: K): String = "K"
run(): () = do
    assert(f(A), "R", "f(A) runs the generic declaration")
    assert(f(C), "K", "f(C) runs the declaration on K")
    println("PASS")
  end
end

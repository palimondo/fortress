(*) SpecCovariant.fss with the where clause in the binding-list grammar:
(*)     trait C[\S\] extends C[\T\] where [\T extends Object\] {S extends T}
component SpecCovariantBound
export Executable

trait Animal
  getter name(): String
end
object Dog extends Animal
  getter name(): String = "dog"
end

trait C[\S extends Any\] extends C[\T\] where [\T extends Object\] {S extends T}
  getter item(): S
end

object CImpl[\S extends Any\](item: S) extends C[\S\]
end

run():() = do
  d: C[\Dog\] = CImpl[\Dog\](Dog)
  a: C[\Animal\] = d
  println(a.item.name)
end

end

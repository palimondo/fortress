(* t05 -- the extended base grammar, every new rule once, with no APL names in
   it (values come in through rung 1's ⍎(…) escape), so that a failure here is a
   production and not the closed name set. *)
component t05_gram
import AplCore.{...}
import AplSyntax.{...}
export Executable

p(tag: String, s: String): () = println(("  " tag " = " s))

run(): () = do
    m = apl⦇ 3 4⍴3 0 5 1 7 9 8 6 2 10 11 4 ⦈
    println("--- take, drop, rotate ---")
    p("2↑1 2 3 4", aplShow(apl⦇ 2↑1 2 3 4 ⦈))
    p("¯2↑1 2 3 4", aplShow(apl⦇ ¯2↑1 2 3 4 ⦈))
    p("6↑1 2 3 4", aplShow(apl⦇ 6↑1 2 3 4 ⦈))
    p("1↓1 2 3 4", aplShow(apl⦇ 1↓1 2 3 4 ⦈))
    p("1↑⍎(m)", aplShow(apl⦇ 1↑⍎(m) ⦈))
    p("1↓⍎(m)", aplShow(apl⦇ 1↓⍎(m) ⦈))
    p("2 2↑⍎(m)", aplShow(apl⦇ 2 2↑⍎(m) ⦈))
    p("1 2↓⍎(m)", aplShow(apl⦇ 1 2↓⍎(m) ⦈))
    p("1⌽1 2 3 4", aplShow(apl⦇ 1⌽1 2 3 4 ⦈))
    p("1⌽⍎(m)", aplShow(apl⦇ 1⌽⍎(m) ⦈))
    p("1⊖⍎(m)", aplShow(apl⦇ 1⊖⍎(m) ⦈))
    p("1 2 ¯1 0⊖⍎(m)", aplShow(apl⦇ 1 2 ¯1 0⊖⍎(m) ⦈))
    println("--- ⍳ ⍸ | ---")
    p("1 2 3 4⍳3", aplShow(apl⦇ 1 2 3 4⍳3 ⦈))
    p("⍳4  (monadic, still)", aplShow(apl⦇ ⍳4 ⦈))
    p("1 3 5 7 9⍸8 9 0", aplShow(apl⦇ 1 3 5 7 9⍸8 9 0 ⦈))
    p("⍸0 1 0 2", aplShow(apl⦇ ⍸0 1 0 2 ⦈))
    p("5|13", aplShow(apl⦇ 5|13 ⦈))
    p("5|⍳6", aplShow(apl⦇ 5|⍳6 ⦈))
    p("|¯3", aplShow(apl⦇ |¯3 ⦈))
    println("--- set primitives ---")
    p("3∊1 2 3", aplShow(apl⦇ 3∊1 2 3 ⦈))
    p("∊⍎(m)", aplShow(apl⦇ ∊⍎(m) ⦈))
    p("1 1 2 3 4∪1 2 5 6", aplShow(apl⦇ 1 1 2 3 4∪1 2 5 6 ⦈))
    p("∪1 1 2 2 3", aplShow(apl⦇ ∪1 1 2 2 3 ⦈))
    p("1 1 2 3 4∩1 2 5 6", aplShow(apl⦇ 1 1 2 3 4∩1 2 5 6 ⦈))
    p("1 1 2 3 4 5~1 3 5", aplShow(apl⦇ 1 1 2 3 4 5~1 3 5 ⦈))
    p("~1 0 1", aplShow(apl⦇ ~1 0 1 ⦈))
    println("--- comparisons, connectives ---")
    p("1 2 3=1 5 3", aplShow(apl⦇ 1 2 3=1 5 3 ⦈))
    p("1 2 3≠1 5 3", aplShow(apl⦇ 1 2 3≠1 5 3 ⦈))
    p("1 2 3<1 5 3", aplShow(apl⦇ 1 2 3<1 5 3 ⦈))
    p("1 2 3>1 5 3", aplShow(apl⦇ 1 2 3>1 5 3 ⦈))
    p("1 2 3≥1 5 3", aplShow(apl⦇ 1 2 3≥1 5 3 ⦈))
    p("1 2 3≤1 5 3", aplShow(apl⦇ 1 2 3≤1 5 3 ⦈))
    p("0=5|⍳10", aplShow(apl⦇ 0=5|⍳10 ⦈))
    p("1 0 1∧1 1 0", aplShow(apl⦇ 1 0 1∧1 1 0 ⦈))
    p("1 0 1∨1 1 0", aplShow(apl⦇ 1 0 1∨1 1 0 ⦈))
    p("⍎(m)>5", aplShow(apl⦇ ⍎(m)>5 ⦈))
    println("--- , ⍪ ⍟ * and the new reductions ---")
    p("⍎(m),⍎(m)", aplShow(apl⦇ ⍎(m),⍎(m) ⦈))
    p("⍴⍎(m)⍪⍎(m)", aplShow(apl⦇ ⍴⍎(m)⍪⍎(m) ⦈))
    p("⍪1 2 3", aplShow(apl⦇ ⍪1 2 3 ⦈))
    p("2⍟8", aplShow(apl⦇ 2⍟8 ⦈))
    p("⍟1", aplShow(apl⦇ ⍟1 ⦈))
    p("*0 1", aplShow(apl⦇ *0 1 ⦈))
    p("⌊/3 1 2", aplShow(apl⦇ ⌊/3 1 2 ⦈))
    p("⌊⌿⍎(m)", aplShow(apl⦇ ⌊⌿⍎(m) ⦈))
    p("⌈⌿⍎(m)", aplShow(apl⦇ ⌈⌿⍎(m) ⦈))
    p("×⌿⍎(m)", aplShow(apl⦇ ×⌿⍎(m) ⦈))
    p("⌈/⍎(m)  (rung 1's, still)", aplShow(apl⦇ ⌈/⍎(m) ⦈))
    println("--- ⍋ ⍒ ---")
    p("⍋3 1 2", aplShow(apl⦇ ⍋3 1 2 ⦈))
    p("⍒3 1 2", aplShow(apl⦇ ⍒3 1 2 ⦈))
    println("--- commute ⍨ ---")
    p("1 2 3 4↑⍨2", aplShow(apl⦇ 1 2 3 4↑⍨2 ⦈))
    p("2 4 6÷⍨2", aplShow(apl⦇ 2 4 6÷⍨2 ⦈))
    p("=⍨1 2 3", aplShow(apl⦇ =⍨1 2 3 ⦈))
    p("+⍨1 2 3", aplShow(apl⦇ +⍨1 2 3 ⦈))
    p("1 2,⍨3 4", aplShow(apl⦇ 1 2,⍨3 4 ⦈))
    p("⍎(m)⊖⍨1", aplShow(apl⦇ ⍎(m)⊖⍨1 ⦈))
    println("--- (a,b)⍴x ---")
    p("(2,3)⍴5", aplShow(apl⦇ (2,3)⍴5 ⦈))
    p("(2,3)⍴⍳6", aplShow(apl⦇ (2,3)⍴⍳6 ⦈))
    println("--- rungs 1 and 2 read the same way ---")
    p("+/2 4⍴⍳8", aplShow(apl⦇ +/2 4⍴⍳8 ⦈))
    p("2 × 3 + 4", aplShow(apl⦇ 2 × 3 + 4 ⦈))
    p("⍎(m)[1;2]", aplShow(apl⦇ ⍎(m)[1;2] ⦈))
    p("0 1 0⌿⍎(m)", aplShow(apl⦇ 0 1 0⌿⍎(m) ⦈))
  end
end

component SkSizeBare
export Executable
object Box[\nat k\](v: ZZ32) end
bare[\nat k\](b: Box[\k\]): String = do
  x = k
  "" || x || " plus one " || (x + 1)
end
run(): () = do
  println("REACHED")
  println("7: " || bare(Box[\7\](0)))
  println("2147483647: " || bare(Box[\2147483647\](0)))
  println("3000000000: " || bare(Box[\3000000000\](0)))
  println("END")
end
end

(* GenNumeral -- how the compiled checker infers a generic's static parameter from numeral
   arguments when IntLiteral itself does not meet the bound: the one library's ranges are
   generic over I extends AnyIntegral, and a numeral is an IntLiteral on this path. *)
component GenNumeral
export Executable

g[\I extends ZZ32\](lo: I, hi: I): String = "g at ZZ32"
h[\I extends ZZ64\](lo: I, hi: I): String = "h at ZZ64"
k[\I extends ZZ32\](lo: I, hi: I): I = hi

run(): () = do
  n: ZZ32 = 46
  println(g(2, 46))
  println(g(2, n))
  println(h(2, 46))
  println(k(2, 46) + 1)
  println("end reached")
end
end

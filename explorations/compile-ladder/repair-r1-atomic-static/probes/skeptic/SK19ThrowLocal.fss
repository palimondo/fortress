component SK19ThrowLocal
export Executable

object Boom extends UncheckedException end

run(): () = do
    var g: ZZ32 = 100
    try
        atomic do
            g := 7
            throw Boom
        end
    catch e
        Boom => println("caught")
    end
    println("g after abrupt atomic = " g)
    g := 55
    println("g after plain write = " g)
  end

end

native component FortressBuiltin
export FortressBuiltin

private language="java"
private package="com.sun.fortress.interpreter.glue.prim"

(** The %builtinPrimitive% function is actually recognized as a special piece
    of built-in magic by the Fortress interpreter.  The %javaClass%
    argument names a Java Class which is a subclass of
    \texttt{com.sun.fortress.interpreter.glue.NativeApp}, which provides code
    for the closure which is used in place of the call to
    %builtinPrimitive%.  Meanwhile all the necessary type information,
    argument names, etc. must be declared here in Fortress-land.  For
    examples, see the end of this file.

    In practice, if you are extending the interpreter you will probably
    want to extend \texttt{com.sun.fortress.interpreter.glue.NativeFn0,1,2,3,4}
    or one of their subclasses defined in
    \texttt{com.sun.fortress.interpreter.glue.primitive}.  These types are
    generally easier to work with, and the boilerplate packing and
    unpacking of values is done for you.
**)
builtinPrimitive[\T\](javaClass:String):T =
  fail ("Implementation should not invoke builtinPrimitive " javaClass)

trait Object extends Any
    getter ilkName(): String =
        builtinPrimitive("com.sun.fortress.nativeHelpers.stringOps.typeName")
    getter asString(): String = self.ilkName
    getter asDebugString(): String  = do  (* for debugging; may contain more information *)
        ilk = self.ilkName
        firstChar = ilk[0]
        article = if firstChar = 'a' OR: firstChar = 'e' OR: firstChar = 'i' OR: firstChar = 'o' then "an " else "a " end
        article ilk ": " self.asString
      end
    getter asExprString(): String
        = "no expression for "  self.asString

    getter toString(): String = self.asString             (* deprecated *)
end

value object Float extends RR64
    getter asString(): String =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleToString")
    getter asExprString(): String =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleToString")
    (** returns true if the value is an IEEE NaN **)
    getter isNaN(): Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleIsNaN")
    (** returns true if the value is an IEEE infinity **)
    getter isInfinite(): Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleIsInfinite")
    (** obtain the raw bits of the IEEE floating-point representation of this value. **)
    getter rawBits():ZZ64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleRawBits")
    getter signBit():ZZ32 = if self.rawBits < 0 then 1 else 0 end
    (** next higher IEEE float **)
    getter nextUp():RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleNextUp")
    (** next lower IEEE float **)
    getter nextDown():RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleNextDown")
    asFloat(self): Float = self
    (** returns a value of type RR32 **)
    narrow(self): RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleToFloat")
    opr |self| : RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleAbs")
    opr =(self, b:Float):Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleEQ")
    opr =/=(self, b:Float):Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleNE")
    opr <(self, b:Float):Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleLT")
    opr <=(self, b:Float):Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleLE")
    opr >(self, b:Float):Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleGT")
    opr >=(self, b:Float):Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleGE")
    (** In case of NaN, %MIN% and %MAX% return a NaN, otherwise it respects the
        total order. **)
    opr MIN(self, b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleMin")
    opr MAX(self, b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleMax")
    opr MINMAX(self, b:Float): (RR64,RR64) = (self MIN b, self MAX b)

    opr -(self):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleNeg")
    opr +(self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleAdd")
    opr -(self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSub")
    opr DOT(self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleMul")
    opr TIMES(self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleMul")
    opr juxtaposition
         (self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleMul")
    opr /(self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleDiv")
    opr SQRT(self):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSQRT")
    opr PLUS_UP(self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleAddUpNoNaN")
    opr MINUS_UP(self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSubUpNoNaN")
    opr DOT_UP(self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleMulUpNoNaN")
    opr SLASH_UP(self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleDivUpNoNaN")
    opr SQRT_UP(self):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSqrtUp")
    opr PLUS_DOWN(self,b:Float):RR64 =

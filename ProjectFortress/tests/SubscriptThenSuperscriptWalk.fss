(* A subscript followed by a superscript or another subscript applies the subscript with all its indices: x[i]^2 is (x[i])^2, and g[i][j] is (g[i])[j]. *)
component SubscriptThenSuperscriptWalk
export Executable

object M()
  opr [i: ZZ32]: ZZ32 = 100 + i
  opr [i: ZZ32, j: ZZ32]: ZZ32 = 1000 + 10 i + j
end

object Lane(base: ZZ32)
  opr [j: ZZ32]: ZZ32 = base + j
end

object Grid()
  opr [i: ZZ32]: Lane = Lane(100 i)
  opr [i: ZZ32, j: ZZ32]: Lane = Lane(1000 i + 100 j)
end

object B
  f(): M = M()
end

run(): () = do
  m = M()
  assert(m[3,7]^2, (m[3,7])^2, "two indices, then a superscript")
  assert(m[7]^2, (m[7])^2, "one index, then a superscript")
  x: ZZ32[7] = [1 2 3 4 5 6 7]
  assert(x[5]^2, 36, "an array's element, then a superscript")
  assert(B.f()[5]^2, 11025, "after a dotted call, one index, then a superscript")
  g = Grid()
  assert(g[3][7], 307, "one index, then another subscript")
  assert(g[3,7][2], 3702, "two indices, then another subscript")
  println("PASS")
end

end

component SkTaskNestedPlain
export Executable

lbl(x: ZZ32): String = x.asString

nestedPlain(): String = do
  var r1: String := ""
  var r2: String := ""
  var r3: String := ""
  do
    r1 := lbl(1)
  also do
    k = fn (): String => lbl(2)
    do r2 := k() also do r3 := lbl(3) end
  end
  r1 || r2 || r3
end

nestedNoFn(): String = do
  var r1: String := ""
  var r2: String := ""
  var r3: String := ""
  do
    r1 := lbl(1)
  also do
    j: ZZ32 = 2
    do r2 := lbl(j) also do r3 := lbl(3) end
  end
  r1 || r2 || r3
end

run(): () = do
  println("nestedNoFn: " nestedNoFn())
  println("nestedPlain: " nestedPlain())
end

end

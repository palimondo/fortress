(* Under the one library's selection, a program that makes an array by array1, writes its elements and reads one compiles. *)
component OneLibraryArray1
export Executable

run(): () = do
  a = array1[\ZZ32, 8\]()
  for i <- seq(0#8) do a[i] := i i end
  assert(a[5] = 25, "a[5] = 25")
  println("PASS")
end

end

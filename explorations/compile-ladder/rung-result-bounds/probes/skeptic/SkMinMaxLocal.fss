component SkMinMaxLocal
export Executable

trait MM[\T extends MM[\T\]\]
    abstract opr MINMAX(self, other: T): (T, T)
    opr MIN(self, other: T): T = do (r, _) = self MINMAX other; r end
    opr MAX(self, other: T): T = do (_, r) = self MINMAX other; r end
end

object Pt(v: ZZ32) extends MM[\Pt\]
    opr MINMAX(self, other: Pt): (Pt, Pt) =
        if other.v < v then (other, self) else (self, other) end
end

run(): () = do
    a = Pt(3)
    b = Pt(5)
    println((a MIN b).v)
    println((b MIN a).v)
    println((a MAX b).v)
    println((b MAX a).v)
    m: Pt = (Pt(9) MIN Pt(7)) MAX Pt(1)
    println(m.v)
  end

end

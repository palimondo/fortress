(* An object's declarations with the modifier override widen the parameter of the methods they override, so the object does not provide the overridden ones, and the program compiles and runs its own (row 610). *)
component XXXOverrideFunctionalMethodWiden
export Executable

trait A
  f(self, other:ZZ32):String = "f FAIL"
  g(other:ZZ32):String = "g FAIL"
end

object B extends A
  override f(self, other:Number):String = "f PASS"
  override g(other:Number):String = "g PASS"
end

run():() = do
    println(f(B, 17))
    println(B.g(17))
  end

end

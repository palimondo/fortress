component RvwSumOverload2
import List.{...}
export Executable
object V(x: RR64)
  opr +(self, o: V): V = V(x + o.x)
end
object SumV extends CommutativeMonoidReduction[\V\]
  getter asString(): String = "SumV"
  empty(): V = V(0)
  join(a: V, b: V): V = a + b
end
opr SUM(): BigReduction[\V, V\] = BigReduction[\V, V\](SumV)
opr SUM(g: Generator[\V\]): V = g.generate[\V\](SumV, fn (v: V) => v)
run(): () = do
  println("user nofix, no except: " (SUM[v <- <|[\V\] V(1), V(2) |>] v).x)
  println("user prefix, no except: " (SUM <|[\V\] V(1), V(2), V(3) |>).x)
  println("library nofix on numbers in the same component: " (SUM[i <- 1:3] i))
end
end

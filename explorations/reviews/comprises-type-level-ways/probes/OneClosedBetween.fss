component OneClosedBetween
export Executable

(* The intersection example (Specification/basic/types-vals-vars.tex:590-604) with a generic trait G
   that stands unlisted under one closed trait only: G extends the listed U of S, and T, where it is
   unlisted (the rule's third case, Specification/basic/traits.tex:243-246).  Every value of
   G[\ZZ32\] is an H, below V; G[\ZZ32\] is a subtype of S and T and not of V. *)

trait S comprises { U, V } end
trait T comprises { V, W } end
trait U extends S excludes W end
trait V extends { S, T } end
trait W extends T end
trait G[\X\] extends { U, T } end
object H extends { G[\ZZ32\], V } end

run(): () = do
    g: G[\ZZ32\] = H
    v: V = g
    println("PASS")
end
end

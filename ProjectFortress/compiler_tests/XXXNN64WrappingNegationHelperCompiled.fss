(* The wraparound negation of the NN64 1, through the helper that NN64's prefix DOTMINUS would name, is 2^64-1; opr-overview.tex, section "Addition and Subtraction Operators". *)
component XXXNN64WrappingNegationHelperCompiled
export Executable

wrappingNeg(a:NN64):NN64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedLongArith.unsignedLongWrappingNeg")

run():() = do
  zero: NN64 = 0
  one: NN64 = 1
  println("REACHED")
  assert(wrappingNeg(zero) = zero, "the wraparound negation of the NN64 0 is 0")
  assert(wrappingNeg(one) = 18446744073709551615, "the wraparound negation of the NN64 1 is 2^64-1")
  println("PASS")
end

end

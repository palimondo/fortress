component OptEmptyExpl2
export Executable
(*) B2c: contrast -- static argument written out.
trait Opt[\T\] comprises { Full[\T\], Empty[\T\] } end
value object Full[\T\](x: T) extends Opt[\T\] end
value object Empty[\T\] extends Opt[\T\] end

f(o: Opt[\String\]): ZZ32 =
    typecase o of
        Full[\String\] => 1
        else => 0
    end

run():() = do
    print("OptEmptyExpl2=")
    println(f(Empty[\\String\\]))
end
end

(* att_b -- run-c3 attention probe, form B: a `cells` lift over a uniform
   layout.  Every per-head array is a matrix of N rows whose columns are the
   NH heads side by side; cell (d,h) of a matrix with c columns is the
   zero-copy block(m, 16 d, h (c DIV 4), 16, c DIV 4).  No array is copied. *)
component att_b
export Executable
import NatReflect.{...}
import System.{...}

(* ----------------------------------------------------- shared header ---- *)
nEmbd: ZZ32 = 16
blockSize: ZZ32 = 16
nHead: ZZ32 = 4
headDim: ZZ32 = 4
bsz: ZZ32 = 2
nn: ZZ32 = 32

vec(n: ZZ32, f: ZZ32 -> RR64): Array[\RR64,ZZ32\] = array[\RR64\](n).fill(f)
mat(r: ZZ32, c: ZZ32, f: (ZZ32,ZZ32) -> RR64): Array[\RR64,(ZZ32,ZZ32)\] = array[\RR64\](r,c).fill(f)
zerosM(r: ZZ32, c: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] = array[\RR64\](r,c).fill(0.0)

object Row[\nat r, nat c\](base: Matrix[\RR64,r,c\], i: ZZ32) extends Vector[\RR64,c\]
    get(j: ZZ32): RR64 = base.get(i, j)
    put(j: ZZ32, x: RR64): () = base.put((i, j), x)
    init0(j: ZZ32, x: RR64): () = base.init0((i, j), x)
    replica[\U\](): Array1[\U,0,c\] = array1[\U,c\]()
end

object Block[\nat br, nat bc, nat r, nat c\](base: Matrix[\RR64,br,bc\], r0: ZZ32, c0: ZZ32)
        extends Matrix[\RR64,r,c\]
    get(ij:(ZZ32,ZZ32)): RR64 = do (i,j) = ij; base.get(r0 + i, c0 + j) end
    put(ij:(ZZ32,ZZ32), x: RR64): () = do (i,j) = ij; base.put((r0 + i, c0 + j), x) end
    init0(ij:(ZZ32,ZZ32), x: RR64): () = do (i,j) = ij; base.init0((r0 + i, c0 + j), x) end
    replica[\U\](): Array2[\U,0,r,0,c\] = array2[\U,r,c\]()
end
blockOf[\nat br, nat bc, nat r, nat c\](base: Matrix[\RR64,br,bc\], r0: ZZ32, c0: ZZ32, _: N[\r\], _: N[\c\]): Matrix[\RR64,r,c\] =
    Block[\br,bc,r,c\](base, r0, c0)
block[\nat br, nat bc\](base: Matrix[\RR64,br,bc\], r0: ZZ32, c0: ZZ32, rows: ZZ32, cols: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] =
    blockOf(base, r0, c0, reflect(rows), reflect(cols))
head[\nat br, nat bc\](a: Matrix[\RR64,br,bc\], d: ZZ32, h: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] =
    block(a, d blockSize, h headDim, blockSize, headDim)
headCell[\nat br, nat bc\](a: Matrix[\RR64,br,bc\], d: ZZ32, h: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] =
    block(a, (d nHead + h) blockSize, 0, blockSize, blockSize)
assignInto[\nat r, nat c, nat p, nat s\](dest: Matrix[\RR64,r,c\], src: Matrix[\RR64,p,s\]): () = do
    dest.assign(fn (i: ZZ32, j: ZZ32): RR64 => src[i,j])
  end

opr (m: Matrix[\RR64,r,c\])^T[\nat r, nat c\]: Matrix[\RR64,c,r\] = m.t()
opr /[\nat r, nat c\](m: Matrix[\RR64,r,c\], s: RR64): Array[\RR64,(ZZ32,ZZ32)\] = do
    (rows, cols) = m.sizes
    mat(rows, cols, fn (i: ZZ32, j: ZZ32): RR64 => m[i,j] / s)
  end

smRows[\nat r, nat c\](z: Matrix[\RR64,r,c\]): Array[\RR64,(ZZ32,ZZ32)\] = do
    (n, d) = z.sizes
    mx = vec(n, fn (i: ZZ32): RR64 => BIG MAX[j <- 0#d] z[i,j])
    e = mat(n, d, fn (i: ZZ32, j: ZZ32): RR64 => exp(z[i,j] - mx[i]))
    sums = vec(n, fn (i: ZZ32): RR64 => SUM[j <- 0#d] e[i,j])
    mat(n, d, fn (i: ZZ32, j: ZZ32): RR64 => e[i,j] / sums[i])
  end
smRowsB[\nat r, nat c, nat p, nat s\](pm: Matrix[\RR64,r,c\], dy: Matrix[\RR64,p,s\]): Array[\RR64,(ZZ32,ZZ32)\] = do
    (n, d) = pm.sizes
    pd = vec(n, fn (i: ZZ32): RR64 => SUM[j <- 0#d] pm[i,j] dy[i,j])
    mat(n, d, fn (i: ZZ32, j: ZZ32): RR64 => pm[i,j] (dy[i,j] - pd[i]))
  end
causalMask: Array[\RR64,(ZZ32,ZZ32)\] =
    mat(blockSize, blockSize, fn (i: ZZ32, j: ZZ32): RR64 => if j > i then -(10.0^10) else 0.0 end)

(* -------------------------------------------------------- test data ----- *)
q: Array[\RR64,(ZZ32,ZZ32)\] = mat(nn, nEmbd, fn (i: ZZ32, j: ZZ32): RR64 => sin(0.1 i + 0.37 j))
k: Array[\RR64,(ZZ32,ZZ32)\] = mat(nn, nEmbd, fn (i: ZZ32, j: ZZ32): RR64 => sin(0.1 i + 0.37 j + 1.0))
v: Array[\RR64,(ZZ32,ZZ32)\] = mat(nn, nEmbd, fn (i: ZZ32, j: ZZ32): RR64 => sin(0.1 i + 0.37 j + 2.0))
dH: Array[\RR64,(ZZ32,ZZ32)\] = mat(nn, nEmbd, fn (i: ZZ32, j: ZZ32): RR64 => sin(0.1 i + 0.37 j + 3.0))

sumOf[\nat r, nat c\](m: Matrix[\RR64,r,c\]): RR64 = do
    (rows, cols) = m.sizes
    SUM[i <- 0#rows, j <- 0#cols] m[i,j]
  end

(* ------------------------------------------------------ the cells lift -- *)
(* typed readers on a cell result, AplCore's assemble-by-first-result *)
colsOfA[\nat r, nat c\](m: Matrix[\RR64,r,c\]): ZZ32 = do (rows, cols) = m.sizes; cols end
nth2[\nat r, nat c\](m: Matrix[\RR64,r,c\], i: ZZ32, j: ZZ32): RR64 = m[i,j]

cell[\nat r, nat c\](m: Matrix[\RR64,r,c\], d: ZZ32, h: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] = do
    (rows, cols) = m.sizes
    w = cols DIV nHead
    block(m, d blockSize, h w, blockSize, w)
  end

(* NOTE: `type Cell = Array[\RR64,(ZZ32,ZZ32)\]` is rejected by the walk
   interpreter (`** bug! Not yet implemented: TypeAlias`), so the full
   spelling is written out at every cell-function parameter below. *)

cells(f: (Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\]) -> Array[\RR64,(ZZ32,ZZ32)\], a: Array[\RR64,(ZZ32,ZZ32)\], b: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] = do
    rs = array[\Any\](bsz nHead)
    for d <- 0#bsz, h <- 0#nHead do rs[d nHead + h] := f(cell(a,d,h), cell(b,d,h)) end
    w = colsOfA(rs[0])
    mat(nn, nHead w, fn (i: ZZ32, j: ZZ32): RR64 =>
        nth2(rs[(i DIV blockSize) nHead + (j DIV w)], i MOD blockSize, j MOD w))
  end

cells(f: (Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\]) -> Array[\RR64,(ZZ32,ZZ32)\], a: Array[\RR64,(ZZ32,ZZ32)\], b: Array[\RR64,(ZZ32,ZZ32)\], c: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] = do
    rs = array[\Any\](bsz nHead)
    for d <- 0#bsz, h <- 0#nHead do rs[d nHead + h] := f(cell(a,d,h), cell(b,d,h), cell(c,d,h)) end
    w = colsOfA(rs[0])
    mat(nn, nHead w, fn (i: ZZ32, j: ZZ32): RR64 =>
        nth2(rs[(i DIV blockSize) nHead + (j DIV w)], i MOD blockSize, j MOD w))
  end

(* the same lift, writing through block views into a preallocated matrix; the
   width still has to come from a first result, so it is two lines longer *)
cellsW(f: (Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\]) -> Array[\RR64,(ZZ32,ZZ32)\], a: Array[\RR64,(ZZ32,ZZ32)\], b: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] = do
    w = colsOfA(f(cell(a,0,0), cell(b,0,0)))
    out = zerosM(nn, nHead w)
    for d <- 0#bsz, h <- 0#nHead do assignInto(cell(out,d,h), f(cell(a,d,h), cell(b,d,h))) end
    out
  end

(* named top-level cell functions, the alternative to the lambdas *)
scores(qc: Array[\RR64,(ZZ32,ZZ32)\], kc: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] = smRows((qc (kc^T)) / (SQRT (1.0 headDim)) + causalMask)
weigh(ac: Array[\RR64,(ZZ32,ZZ32)\], vc: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] = ac vc
backV(ac: Array[\RR64,(ZZ32,ZZ32)\], dc: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] = (ac^T) dc
backS(ac: Array[\RR64,(ZZ32,ZZ32)\], dc: Array[\RR64,(ZZ32,ZZ32)\], vc: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] = smRowsB(ac, dc (vc^T))
backQ(sc: Array[\RR64,(ZZ32,ZZ32)\], kc: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] = sc kc
backK(sc: Array[\RR64,(ZZ32,ZZ32)\], qc: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] = (sc^T) qc

(* ---------------------------------------------- form B: the attention --- *)
attnB(): (Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\]) = do
    att = cells(fn (qc: Array[\RR64,(ZZ32,ZZ32)\], kc: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] => smRows((qc (kc^T)) / (SQRT (1.0 headDim)) + causalMask), q, k)
    hc  = cells(fn (ac: Array[\RR64,(ZZ32,ZZ32)\], vc: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] => ac vc, att, v)
    dV  = cells(fn (ac: Array[\RR64,(ZZ32,ZZ32)\], dc: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] => (ac^T) dc, att, dH)
    dS  = cells(fn (ac: Array[\RR64,(ZZ32,ZZ32)\], dc: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] => smRowsB(ac, dc), att,
                cells(fn (dc: Array[\RR64,(ZZ32,ZZ32)\], vc: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] => dc (vc^T), dH, v)) / (SQRT (1.0 headDim))
    dQ  = cells(fn (sc: Array[\RR64,(ZZ32,ZZ32)\], kc: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] => sc kc, dS, k)
    dK  = cells(fn (sc: Array[\RR64,(ZZ32,ZZ32)\], qc: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] => (sc^T) qc, dS, q)
    (att, hc, dS, dQ, dK, dV)
  end

(* the same six lines with the three-argument lift and the named functions *)
attnB3(): (Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\]) = do
    att = cells(scores, q, k)
    hc  = cells(weigh, att, v)
    dV  = cells(backV, att, dH)
    dS  = cells(backS, att, dH, v) / (SQRT (1.0 headDim))
    dQ  = cells(backQ, dS, k)
    dK  = cells(backK, dS, q)
    (att, hc, dS, dQ, dK, dV)
  end

(* the write-through variant of the forward, for the copy comparison *)
attnBW(): (Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\]) = do
    att = cellsW(scores, q, k)
    hc  = cellsW(weigh, att, v)
    (att, hc)
  end

report(att: Array[\RR64,(ZZ32,ZZ32)\], hc: Array[\RR64,(ZZ32,ZZ32)\], dSa: Array[\RR64,(ZZ32,ZZ32)\], dQ: Array[\RR64,(ZZ32,ZZ32)\], dK: Array[\RR64,(ZZ32,ZZ32)\], dV: Array[\RR64,(ZZ32,ZZ32)\]): () = do
    println "att sum " sumOf(att)
    println "dS  sum " sumOf(dSa)
    println "hc  sum " sumOf(hc) "  hc[5,7] " hc[5,7]
    println "dQ  sum " sumOf(dQ) "  dQ[5,7] " dQ[5,7]
    println "dK  sum " sumOf(dK) "  dK[5,7] " dK[5,7]
    println "dV  sum " sumOf(dV) "  dV[5,7] " dV[5,7]
  end

run(): () = do
    (att, hc, dSa, dQ, dK, dV) = attnB()
    report(att, hc, dSa, dQ, dK, dV)
    println "-- three-argument lift + named functions --"
    (a3, h3, s3, q3, k3, v3) = attnB3()
    report(a3, h3, s3, q3, k3, v3)
    println "-- write-through cellsW, forward only --"
    (aw, hw) = attnBW()
    println "att sum " sumOf(aw) "  hc  sum " sumOf(hw) "  hc[5,7] " hw[5,7]
    t0 = nanoTime()
    for r <- seq(0#10) do
        (a2, h2, s2, q2, k2, v2) = attnB()
    end
    println "form B: 10 reps of forward+backward " ((nanoTime() - t0) DIV 1000000) " ms"
  end
end

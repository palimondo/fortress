component SkTcShort
export Executable

trait Cond end
trait Rel extends Cond end
object R extends Rel end
object C extends Cond end

useRel(r: Rel): String = "rel"

pick(c: Cond): String =
  typecase c of
    Rel => useRel(c)
    else => "plain"
  end

run() = do
    println(pick(R))
    println(pick(C))
    println("done")
  end

end

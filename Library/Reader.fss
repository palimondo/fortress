component Reader
import FlatString.FlatString
import Stream.{...}
export Reader

stdIn: Reader = Reader("<stdin>", makeJavaBufferedStdIn())

Reader(fileName: String): Reader = typecase fileName.asFlatString of
    f:FlatString ⇒ Reader(fileName, makeJavaBufferedReader(f))
    f:String ⇒ fail[\Reader\]("Reader: asFlatString answered a string that is not flat")
  end

object Reader(fileName: String, under: JavaBufferedReader) (* extends { ReadStream } *)
    getter asString(): String = "Reader on " self.fileName.asExprString

    getter eof():Boolean = under.eof()

    getter isReady():Boolean = under.ready()

    whenUnconsumed():() = under.whenUnconsumed()
    consume():() = under.consume()

    uncheckedReadLine():String = under.readLine()

    (* The reader answers char(0) at the end and sets eof; the Reader answers -1 there. *)
    uncheckedReadChar():ZZ32 = do
        c = under.read()
        if under.eof() then -1 else c.codePoint end
      end

    uncheckedRead(k:ZZ32):String = under.readk(k)

    close():() = under.close()
end Reader

end

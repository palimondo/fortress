component SkK08
export Executable

shw(v: Any): String =
  typecase v of
    v1: ZZ32 => v1.asString || ":ZZ32"
    v2: ZZ64 => v2.asString || ":ZZ64"
    v3: NN32 => v3.asString || ":NN32"
    v4: RR64 => v4.asString || ":RR64"
    v5: String => v5 || ":String"
    else => "other"
  end

object PairS[\T\](p: T, q: T)
  show(): String = shw(p) " " shw(q)
end

run(): () = do
    z: ZZ32 = 100000
    w: ZZ64 = widen(200000)
    u: NN32 = unsigned(7)
    r: RR64 = 0.5
    println("PairS(z,w) = " (PairS(z, w).show()))
  end

end

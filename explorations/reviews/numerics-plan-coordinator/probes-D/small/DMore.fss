component DMore
export Executable
(* measure-D probe: further shapes the expected type at f(x) reaches *)
object BoxV[\T\](v: T) end
idt[\T\](x: T): T = x
sink[\T\](x: T): () = ()
curry[\T\](x: T): T -> T = fn (y: T): T => y
make[\T\](): T = fail[\T\]("make")
z: ZZ32 = 5
(* a generic constructor under a typed binding *)
d01(): () = do a: BoxV[\ZZ32\] = BoxV(3); () end
d02(): () = do a: BoxV[\ZZ64\] = BoxV(3); () end
d03(): () = do a: BoxV[\ZZ32\] = BoxV(z); () end
(* a generic call as a non-last statement of a block: Misc.scala:432 checks it against () *)
d04(): () = do idt(3); () end
d05(): () = do sink(3); () end
(* a chain f(x)(y): the expected type goes to the outer application only *)
d06(): ZZ32 = curry(z)(z)
(* a generic call as an if's test *)
d07(): ZZ32 = if idt(true) then 1 else 2 end
(* make() in the middle of an arithmetic expression: no context there *)
d08(): ZZ64 = make() + 1
(* a parenthesized call *)
d09(): ZZ64 = (make())
run(): () = ()
end

component SkR2IntNeg
export Executable

object TagI[\int k\](v: ZZ32) end

untagI[\int k\](t: TagI[\k\]): ZZ32 = t.v + k

intFrom[\int k\](): ZZ32 = do
  var c: ZZ32 = 0
  for x <- seq(k:3) do c := c + 1 end
  c
end

run(): () = do
  println("N1 untagI(TagI[\\0-3\\](4)), a negative int parameter the argument's type fixes: " untagI(TagI[\0-3\](4)))
  println("N2 k:3, int k = 0-2, elements " (intFrom[\0-2\]()).asString)
end

end

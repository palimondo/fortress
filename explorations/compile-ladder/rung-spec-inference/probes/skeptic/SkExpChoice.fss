component SkExpChoice
export Executable

object BoxT[\T\](v: T) end

object O
  k[\T extends ZZ32\](x: T): BoxT[\T\] = do println("  ran k generic"); BoxT[\T\](x) end
  k(x: ZZ64): BoxT[\ZZ64\] = do println("  ran k(ZZ64)"); BoxT[\ZZ64\](x) end
end

run(): () = do
  z: ZZ32 = 5
  println("E1 a: BoxT[ZZ32] = O.k(z)")
  a: BoxT[\ZZ32\] = O.k(z)
  println("E2 b: BoxT[ZZ64] = O.k(z)")
  b: BoxT[\ZZ64\] = O.k(z)
  println("done")
end

end

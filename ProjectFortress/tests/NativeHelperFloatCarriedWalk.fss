(* Under walk, a builtinPrimitive helper binding whose parameter or result is declared RR64 carries the value in a Java double. *)
component NativeHelperFloatCarriedWalk
export Executable

floatSum(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleAdd")
floatNegated(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleNeg")

run():() = do
  assert(floatSum(asFloat(2.5), asFloat(-0.75)), 1.75, "floatSum")
  assert(floatNegated(2.5), -2.5, "floatNegated")
  assert(floatNegated(0.0).asString, "-0.0", "floatNegated of 0.0")
  assert(floatSum(floatNegated(1.0), floatNegated(2.0)), -3.0, "an RR64 result passed at an RR64 parameter")
end

end

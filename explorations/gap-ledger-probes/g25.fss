(* g25 (merge pass): the Meet-Rule rejection of two overloads on unrelated
   library traits (run-b row 84, run-b2 row 112) -- and the new fact that the
   check is cache-dependent: it fires only when the component has no entry in
   default_repository/caches/interpreter_parsed_cache. *)
component g25
import List.{...}
export Executable

object Box(xs: Array[\ZZ32,ZZ32\])
    opr [ts: List[\ZZ32\]]: ZZ32 = |ts|
    opr [r: Range[\ZZ32\]]: ZZ32 = 999
end

run(): () = do
    a = array[\ZZ32\](4).fill(fn (i: ZZ32): ZZ32 => i)
    b = Box(a)
    println("b[list]  = " b[<|[\ZZ32\] 1, 2, 3|>])
    println("b[range] = " b[0#2])
  end
end

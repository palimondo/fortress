component FailCaught
export Executable

(*) explorations/compile-ladder/rung-result-bounds/REPORT.md, section 5

group(g: () -> ()): ZZ32 =
    try
        g()
        0
    catch e
        FailCalled => 1
    end

run(): () = do
    println("statement: " group(fn () => fail("B1 in a statement")))
    println("at ZZ32: " group(fn () => do x: ZZ32 = fail("B2 at ZZ32"); println x end))
    println("at a tuple: " group(fn () => do p: (ZZ32, ZZ32) = fail("B3 at a tuple"); println p end))
    println("at (): " group(fn () => do u: () = fail("B4 at ()"); println u end))
    println("at an arrow: " group(fn () => do f: ZZ32 -> ZZ32 = fail("B5 at an arrow"); println f(1) end))
    println("written ZZ32: " group(fn () => do x: ZZ32 = fail[\ZZ32\]("B6 written ZZ32"); println x end))
    ok: ZZ32 = if 1 < 2 then 7 else fail("B7 never") end
    println("unreached in a branch: " ok)
    println("uncaught next")
    y: (ZZ32, String) = fail("B8 uncaught at a tuple")
    println y
  end

end

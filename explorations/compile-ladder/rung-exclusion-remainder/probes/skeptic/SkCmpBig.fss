component SkCmpBig
import List.{...}
export Executable

run() = do
    println("BIG LEXICO: " (BIG LEXICO <|[\TotalComparison\] EqualTo, GreaterThan, LessThan |>))
    println("BIG MAX of comparisons: " (BIG MAX <|[\TotalComparison\] LessThan, GreaterThan, EqualTo |>))
    println("BIG MIN of comparisons: " (BIG MIN <|[\TotalComparison\] GreaterThan, EqualTo, LessThan |>))
    println("done")
  end

end

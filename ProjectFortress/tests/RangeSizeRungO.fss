(*) explorations/compile-ladder/rung-ranges-zz32/REPORT.md

component RangeSizeRungO
export Executable

run(): () = do
    println("REACHED")
    one: ZZ32 = 1
    three: ZZ32 = 3
    r = narrow(widen(one)):narrow(widen(three))
    rSize = r.size
    assert(rSize = 3, "ranges.tex:140-143")
    rCard = |r|
    assert(rCard = 3, "ranges.tex:140-143")
    uOne: NN32 = unsigned(one)
    uThree: NN32 = unsigned(three)
    rN = signed(uOne):signed(uThree)
    rNCard = |rN|
    assert(rNCard = 3, "ranges.tex:140-143")
    println("PASS")
  end

end

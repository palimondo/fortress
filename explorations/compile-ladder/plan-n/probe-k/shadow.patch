+/**
+ * Probe K of climb batch N (explorations/compile-ladder/plan-n/probe-k/PROBE-K.md): the switch and
+ * the log of the logging shadow of walk's inference rule.  -Dprobe.k=off (the default) leaves the
+ * shadow identical to the tree; log computes today's answer and the rule's at every generic
+ * inference, overloaded dispatch and coercion lookup, writes each difference and keeps today's;
+ * apply writes each difference and takes the rule's.  -Dprobe.k.log names the file the lines go to.
+ */
+public final class ProbeK {
+
+    public static final int OFF = 0, LOG = 1, APPLY = 2;
+    public static final int MODE;
+
+    static {
+        String m = System.getProperty("probe.k", "off");
+        MODE = m.equals("apply") ? APPLY : m.equals("log") ? LOG : OFF;
+    }
+
+    private ProbeK() {
+    }
+
+    public static boolean on() {
+        return MODE != OFF;
+    }
+
+    /* null at the top level; TRUE or FALSE inside one side of a comparison. */
+    private static final ThreadLocal<Boolean> forced = new ThreadLocal<Boolean>();
+
+    public static boolean nested() {
+        return forced.get() != null;
+    }
+
+    public static boolean useRule() {
+        Boolean f = forced.get();
+        return f != null ? f.booleanValue() : MODE == APPLY;
+    }
+
+    public static Boolean force(Boolean b) {
+        Boolean old = forced.get();
+        forced.set(b);
+        return old;
+    }
+
+    public static void restore(Boolean old) {
+        forced.set(old);
+    }
+
+    /* The call sites of the functions being applied, innermost last (Fcn.functionInvocation). */
+    private static final ThreadLocal<ArrayList<HasAt>> sites = new ThreadLocal<ArrayList<HasAt>>() {
+        protected ArrayList<HasAt> initialValue() {
+            return new ArrayList<HasAt>();
+        }
+    };
+
+    public static void push(HasAt site) {
+        sites.get().add(site);
+    }
+
+    public static void pop() {
+        ArrayList<HasAt> s = sites.get();
+        if (!s.isEmpty()) s.remove(s.size() - 1);
+    }

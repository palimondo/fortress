component RestatedLinesProbe
export Executable

run(): () = do
    one: ZZ32 = 1
    three: ZZ32 = 3
    lMax: ZZ64 = 7FFFFFFFFFFFFFFF_16
    wideTop = 0 # three
    wideTopSize = SUM[\ZZ32\][k <- wideTop, (lMax - widen(2)) + widen(k) <= lMax] 1
    assert(wideTopSize = 3, "XXXRangeBoundsRungO.fss:19-21")
    lLo = lMax - widen(2)
    wideSeq = seq(0:2)
    var wideCount: ZZ32 = 0
    for k <- wideSeq do
        assert(lLo + widen(k) >= lLo, "XXXSeqRangeTopRungO.fss:19-22")
        wideCount += 1
    end
    assert(wideCount = 3, "XXXSeqRangeTopRungO.fss:25")
    r = narrow(widen(one)):narrow(widen(three))
    assert(r.size = 3 AND |r| = 3, "RangeSizeRungO.fss:10-14")
    uOne: NN32 = unsigned(one)
    uThree: NN32 = unsigned(three)
    rN = signed(uOne):signed(uThree)
    assert(|rN| = 3, "RangeSizeRungO.fss:17-19")
    println("PASS " wideTopSize " " wideCount " " r.asDebugString " " rN.asDebugString)
  end

end

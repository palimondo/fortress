component IlkProbe
export Executable

shown(v: Any): String = v.asString || " : " || v.ilkName

run() = do
    three: ZZ32 = 3
    println(shown(three))
    println(shown(widen(three)))
    println(shown(big(three)))
    println(shown(unsigned(three)))
    println(shown(widen(unsigned(three))))
    println(shown(1/2))
    println(shown(6/2))
    println(shown(0.5))
    println(shown(0.5 + 0.25))
    println(shown(narrow(0.5)))
    println(shown(9223372036854775807))
    println(shown(92233720368547758070))
    x: ZZ64 = 2147483647
    println(shown(x + 1))
    r: RR64 = three
    println(shown(r))
    q: QQ = three
    println(shown(q))
    println(shown((widen(1) LSHIFT 62) < 1/4))
    println(shown((widen(1) LSHIFT 61)/3 < 5/7))
    println(shown((widen(1) LSHIFT 40)/3 + 1/(widen(1) LSHIFT 40)))
    println(shown(SUM[\ZZ32\][j <- 0#0] j))
    println(shown(PROD[\ZZ32\][j <- 0#0] j))
end
end

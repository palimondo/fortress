(* c06: does the interpreter accept a `value object` (basic/objects.tex,
   Value Objects) holding an array and a closure, and what does === do on it? *)
component c06_value_object
export Executable

value object Dual(v: Array[\RR64,ZZ32\], back: Array[\RR64,ZZ32\] -> Array[\RR64,ZZ32\])
  opr +(self, o: Dual): Dual = Dual(v + o.v, fn g => back(g) + (o.back)(g))
end

run(): () = do
  x = array[\RR64\](3).fill(fn i => 1.0 (i + 1))
  a = Dual(x, fn g => g)
  b = Dual(x.scale(2.0), fn g => g.scale(2.0))
  c = a + b
  println("c.v = " c.v)
  println("c.back(ones) = " (c.back)(array[\RR64\](3).fill(1.0)))
  println("a === a: " (a === a) "  a === Dual(x, fn g => g): " (a === Dual(x, fn g => g)))
end
end

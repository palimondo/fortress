(* A top-level mutable variable of arrow type: the cast after the cell read
   goes through InstantiatingClassloader.generalizedCastTo, whose arrow branch
   emits a castTo call rather than a CHECKCAST (:2370-2390). *)
component P12Arrow
export Executable
f: ZZ32 -> ZZ32 := fn (x: ZZ32): ZZ32 => x + 1
run(): () = do
    f := fn (x: ZZ32): ZZ32 => x + 2
    println("f(1) = " f(1) " expected 3")
  end
end

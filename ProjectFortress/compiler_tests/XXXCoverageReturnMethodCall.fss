(* A method of either result type called on a call whose argument sits between two closed traits, a call typed by the intersection of its candidates' return types, gets that result type's answer. *)
component XXXCoverageReturnMethodCall
export Executable

trait S comprises { U, V } end
trait T comprises { V, W } end
trait U extends S excludes W end
trait M extends { S, T } comprises { V } end
trait V extends M end
trait W extends T end
object Vo extends V end

trait LeftResult
  left(): String = "left"
end
trait RightResult
  right(): String = "right"
end
object LeftOnly extends LeftResult end
object RightOnly extends RightResult end
object BothResult extends { LeftResult, RightResult } end

choose(s: S): LeftResult = LeftOnly
choose(t: T): RightResult = RightOnly
choose(v: V): BothResult = BothResult

run(): () = do
  m: M = Vo
  assert(choose(m).left(), "left", "the call's result has the method of LeftResult")
  assert(choose(m).right(), "right", "the call's result has the method of RightResult")
  println("PASS")
end

end

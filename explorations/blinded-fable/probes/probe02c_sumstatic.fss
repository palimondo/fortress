component probe02c_sumstatic
import List.{...}
export Executable

(* Variant: nofix SUM with a static parameter bounded by the user type. *)
object V(x: RR64)
  opr +(self, other: V): V = V(x + other.x)
  opr juxtaposition(self, other: V): V = V(x other.x)
end

object VSum extends CommutativeMonoidReduction[\V\]
  getter asString(): String = "VSum"
  empty(): V = V(0.0)
  join(a: V, b: V): V = a + b
end

opr SUM[\T extends V\](): BigReduction[\V,V\] = BigReduction[\V,V\](VSum)

run(): () = do
  xs = <|V(1.0), V(2.0), V(3.5)|>
  s2 = SUM[v <- xs] v v
  println("SUM[v<-xs] v v = " s2.x " (expect 17.25)")
end
end

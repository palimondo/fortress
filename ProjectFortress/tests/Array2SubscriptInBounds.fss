(* A rank-2 array's subscripts inside its bounds read and write the element at the index less the lower bounds, at lower bounds zero and one, and through a row and a column. *)
component Array2SubscriptInBounds
export Executable

run(): () = do
    a = array[\ZZ32\](2,3).fill(0)
    for i <- 0#2, j <- 0#3 do a[i,j] := 10 i + j end
    assert(a[0,0], 0, "the corner (0,0)")
    assert(a[1,2], 12, "the corner (1,2)")
    assert(a[(1,0)], 10, "the pair subscript (1,0)")
    a[0,2] := 99
    assert(a[0,2], 99, "the write at (0,2)")
    s = a.subarray[\1,2,1,2,0,1\](1,1)
    assert(s[1,1], 1, "the subarray based at (1,1) has a's (0,1) at its (1,1)")
    assert(s[2,2], 12, "the subarray based at (1,1) has a's (1,2) at its (2,2)")
    s[2,1] := 77
    assert(a[1,1], 77, "a write at the subarray's (2,1) reaches a's (1,1)")
    assert((a[:,1])[1], 77, "the column 1 at row 1")
    assert((a[1,:])[2], 12, "the row 1 at column 2")
    println("PASS")
  end

end

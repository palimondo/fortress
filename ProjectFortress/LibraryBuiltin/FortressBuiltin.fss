    opr |/self\| : ZZ64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleICeiling")
    truncate(self):ZZ64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleTruncate")
    round(self):ZZ64 =

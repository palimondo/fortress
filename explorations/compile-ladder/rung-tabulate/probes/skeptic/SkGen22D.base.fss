component SkGen22D
import Generator22D.{...}
import List.{...}
export Executable

run() = do
  xs = array[\Number\]((3,3)).fill(fn (ij:(ZZ32,ZZ32)):ZZ32 => do (i,j) = ij; ((3 i + j) MOD 5) - 2 end)
  println("xs = " xs)
  println("rows xs = " (rows xs))
  println("cols xs = " (cols xs))
  println("rects xs = " (rects xs))
  switchDispatching(false)
  a = BIG MAX[\Number\] <|[\Number\] SUM[\Number\] r | r <- rects xs |>
  switchDispatching(true)
  b = BIG MAX[\Number\] <|[\Number\] SUM[\Number\] r | r <- rects xs |>
  println("maximum rectangle sum without and with the optimization: " a " " b)
end
end

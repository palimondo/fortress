(* The signs U+2211 and U+220F begin a reduction wherever SUM and PROD do, and name the same operators in a declaration: reductions.tex, section "Summations and Other Reduction Expressions", Accumulator. *)
component SumSignAccumulator
import List.{...}
export Executable

object Bag(n: ZZ32) end

opr ∑(b: Bag): ZZ32 = b.n + 1000
opr ∏(b: Bag): ZZ32 = b.n + 2000

f(x: ZZ32): ZZ32 = 2 x + 1
body(x: ZZ32): RR64 = if x MOD 2 = 0 then x else 1.0 x end

total(n: ZZ32): ZZ32 = ∑[j <- 0#n] f(j)
fact(n: ZZ32): ZZ32 = ∏[j <- 1#n] j

run(): () = do
    assert(∑[\ZZ32\] [x <- 0#10] x, 45, "sum sign, static argument, clause")
    assert(∑[\ZZ32\][x <- 0#10] x, SUM[\ZZ32\][x <- 0#10] x, "sum sign as SUM")
    assert(∑[\ZZ32\] [x <- 0#10] 2 x + 1, 100, "the body is the whole expression")
    assert(∑[\RR64\] [x <- 0#10] body(3 x + 1), 145.0, "at RR64")
    assert(∑[\ZZ32\] [x <- 0#10, 2 DIVIDES x] 3 x + 1, 65, "a filter")
    assert(∑[\ZZ32\] [x <- 1#0] x, 0, "an empty sum")
    assert(∏[\ZZ32\][x <- 1#5] x, 120, "product sign, static argument, clause")
    assert(∏[\ZZ32\][x <- 1#5] x, PROD[\ZZ32\][x <- 1#5] x, "product sign as PROD")
    assert(total(10), 100, "sum sign, clause, a declared return type")
    assert(fact(5), 120, "product sign, clause, a declared return type")
    s: ZZ32 = ∑[x <- 0#10] x
    assert(s, 45, "sum sign, clause, a declared local")
    assert(∑ (0#10), 45, "sum sign, a generator")
    assert(∑ (5#0), 0, "sum sign, an empty generator")
    xs = <|[\ZZ32\] 1, 2, 3, 4 |>
    assert(∑ xs, 10, "sum sign, a list")
    assert(∏ xs, 24, "product sign, a list")
    assert(∑[\ZZ32\] xs, 10, "sum sign, static argument, a list")
    assert(∏[\ZZ32\] xs, 24, "product sign, static argument, a list")
    assert(∑⟦ZZ32⟧[x ← 0#10] x, 45, "sum sign, white brackets")
    assert(1 + (∑[\ZZ32\][x <- 0#4] x) + 1, 8, "in parentheses")
    pre = <|[\ZZ32\] ∑[\ZZ32\] xs[0:i] | i <- (0#(|xs|)) |>
    assert(pre, <|[\ZZ32\] 1, 3, 6, 10 |>, "in a comprehension")
    b = Bag(7)
    assert(∑ b, 1007, "the program's own declaration, by the sign")
    assert(SUM b, 1007, "the program's own declaration, by SUM")
    assert(∏ b, 2007, "the program's own declaration, by the sign")
    assert(PROD b, 2007, "the program's own declaration, by PROD")
end

end

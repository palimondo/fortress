component ComprisesUnlistedExtender
export Executable

(* An object that explicitly extends two traits with comprises clauses and is below none of the types either lists is refused at load; Specification/basic/traits.tex, section "Trait Declarations". *)

trait S comprises { U, V } end
trait T comprises { V, W } end
trait U extends S excludes W end
trait V extends { S, T } end
trait W extends T end
object Z extends { S, T } end

f(s: S): String = "f(S)"
f(t: T): String = "f(T)"
f(v: V): String = "f(V)"

run(): () = do
    println(f(Z))
  end

end

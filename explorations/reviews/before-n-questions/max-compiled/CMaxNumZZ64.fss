component CMaxNumZZ64
export Executable
(* Row 484's line on the compiled path, whose compiler library declares MAX on ZZ64 itself
   (ProjectFortress/LibraryBuiltin/CompilerBuiltin.fsi:199). *)
typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    IntLiteral => "IntLiteral"
    else => "other"
  end
run(): () = do
    b: ZZ64 = 3
    r = b MAX 1
    println("b MAX 1 = " r " : " typeOf(r))
  end
end

    z: ZZ32 = 3
    w: ZZ64 = widen(4)
    r: RR64 = 2.5
    u: NN32 = unsigned(5)
    b: Box[\RR64\] = Box[\RR64\](1.0)
    println("sameAdd(z, r): " sameAdd(z, r))
  end

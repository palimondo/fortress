component SkCtxForms
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    IntLiteral => "IntLiteral"
    else => "other"
  end

object BoxV[\T\](v: T) end
object Fac
  wrap[\T\](x: T): BoxV[\T\] = BoxV[\T\](x)
end
opr BOXOF[\T\](x: T): BoxV[\T\] = BoxV[\T\](x)
opr OPLUS[\T\](x: T, y: ZZ32): BoxV[\T\] = BoxV[\T\](x)
wrapV[\T\](x: T): BoxV[\T\] = BoxV[\T\](x)

run(): () = do
    a: BoxV[\ZZ64\] = Fac.wrap(3)
    println("Fac.wrap(3): " || typeOf(a.v))
    b: BoxV[\ZZ64\] = BOXOF 3
    println("BOXOF 3: " || typeOf(b.v))
    c: BoxV[\ZZ64\] = 3 OPLUS 4
    println("3 OPLUS 4: " || typeOf(c.v))
    d: BoxV[\ZZ64\] = (wrapV(3))
    println("(wrapV(3)): " || typeOf(d.v))
    e: BoxV[\ZZ64\] = wrapV 3
    println("wrapV 3: " || typeOf(e.v))
end

end

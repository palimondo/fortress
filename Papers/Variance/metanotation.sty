\newif\if@withinnorep   \@withinnorepfalse
\newcommand\norep[1]{\mathord{\mskip1mu\supermathpalette\@norep{#1}\mskip1mu}}
\newcommand\@norep[3]{{\setbox0\vtop{\hbox{\@withinnoreptrue$#1#3$}%
                                           \kern 2.25\fontdimen 8 #2 3
                                           \hrule height \fontdimen 8 #2 3}%
                       \if@withinnorep\else\dimen0=\dp0 \advance \dimen0 by \fontdimen 8 #2 3 \dp0=\dimen0\fi
                       \box0}}
\newcommand\same{\norep}

\newcommand\repetition[1]{\@repetition{\repoverline}{#1}}
\newcommand\leftrepetition[1]{\@repetition{\overleftharpoon}{#1}}
\newcommand\rightrepetition[1]{\@repetition{\overrightharpoon}{#1}}

\def\@repetition#1#2{\@ifnextchar<{\@repetitionWithSeparator{#1}{#2}}{\@repetitionCheckPlus{#1}{#2}{}}}
\def\@repetitionWithSeparator#1#2<#3>{\@repetitionCheckPlus{#1}{#2}{#3}}
\def\@repetitionCheckPlus#1#2#3{\@ifnextchar+{\@repetitionWithPlus{#1}{#2}{#3}}{\@repetitionCheckOptional{#1}{#2}{#3}}}
\def\@repetitionWithPlus#1#2#3+{\@repetitionCheckBinding{#1}{#2}{#3}{+}}
\def\@repetitionCheckOptional#1#2#3{\@ifnextchar?{\@repetitionWithOptional{#1}{#2}{#3}}{\@repetitionCheckBinding{#1}{#2}{#3}{}}}
\def\@repetitionWithOptional#1#2#3?{\@repetitionCheckBinding{#1}{#2}{#3}{?}}
\def\@repetitionCheckBinding#1#2#3#4{\@ifnextchar[{\@repetitionWithBinding{#1}{#2}{#3}{#4}}{\@repetitionFinal{#1}{#2}{#3}{#4}{}}} %]
\def\@repetitionWithBinding#1#2#3#4[#5]{\@repetitionFinal{#1}{#2}{#3}{#4}{#5}}
\def\@repetitionFinal#1#2#3#4#5{{\def\@empty{}\def\@optional{?}\def\arg@overline{#1}\def\arg@body{#2}\relax
                                 \def\arg@separator{#3}\def\arg@multiplicity{#4}\def\arg@binding{#5}\relax
  \ifx\arg@separator\@empty
    \ifx\arg@multiplicity\@empty
      \ifx\arg@binding\@empty
        \def\@contents{}\relax
      \else
        \def\@contents{\,\arg@binding}\relax
      \fi
    \else
      \ifx\arg@binding\@empty
        \def\@contents{\ifx\arg@multiplicity\@optional\else\,\fi\arg@multiplicity}\relax
      \else
        \def\@contents{\ifx\arg@multiplicity\@optional\else\,\fi\arg@multiplicity\,\arg@binding}\relax
      \fi
    \fi
  \else 
    \ifx\arg@multiplicity\@empty
      \ifx\arg@binding\@empty
        \def\@contents{\mskip 0.5\thinmuskip\arg@separator}\relax
      \else
        \def\@contents{\mskip 0.5\thinmuskip\arg@separator\,\arg@binding}\relax
      \fi
    \else
      \ifx\arg@binding\@empty
        \def\@contents{\mskip 0.5\thinmuskip\arg@separator\mskip 0.5\thinmuskip\arg@multiplicity}\relax
      \else
        \def\@contents{\mskip 0.5\thinmuskip\arg@separator\mskip 0.5\thinmuskip\arg@multiplicity\,\arg@binding}\relax
      \fi
    \fi
  \fi
  \ifx\@contents\@empty
    \mathord{\mskip1mu\arg@overline{\arg@body}\mskip1mu}\relax
  \else
    \setbox0\hbox{$\arg@overline{\arg@body}$}\relax
    \setbox1\vbox{\hrule width 0pt}\relax
    \setbox2\hbox{$\scriptstyle\@contents$}\relax
    \setbox3\vbox{$\scriptstyle\vcenter{}$}\relax
    \meta@dimen=\ht0\advance\meta@dimen-1.5\ht1\advance\meta@dimen-\ht3
    \mathord{\mskip1mu\box0}\mathord{\raise\meta@dimen\box2}\relax
  \fi}}


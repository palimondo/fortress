component CompiledGenericFn
export Executable

(* The compiled side of XXXCoercionGenericFnRungC. *)
trait Wide excludes { Narrow }
  coerce(x: Narrow) = WideOf(widen(x.small))
  getter big(): ZZ64
end
trait Narrow excludes { Wide }
  getter small(): ZZ32
end
object WideOf(b: ZZ64) extends Wide
  getter big(): ZZ64 = b
end
object NarrowOf(s: ZZ32) extends Narrow
  getter small(): ZZ32 = s
end

gf[\T\](x: Wide, y: T): String = "gf got " x.big " and " y

run(): () = do
  println(gf(WideOf(widen(1)), "one"))
  println(gf(NarrowOf(2), "two"))
end
end

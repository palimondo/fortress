component probe02_sum
import List.{...}
export Executable

(* Can a user type participate in the SUM big operator? *)
object V(x: RR64)
  opr +(self, other: V): V = V(x + other.x)
  opr juxtaposition(self, other: V): V = V(x other.x)
end

object VSum extends CommutativeMonoidReduction[\V\]
  getter asString(): String = "VSum"
  empty(): V = V(0.0)
  join(a: V, b: V): V = a + b
end

(* prefix form: SUM xs *)
opr SUM(g: Generator[\V\]): V = g.generate[\V\](VSum, fn (v: V) => v)
(* nofix form used by the desugaring of SUM[gs] body *)
opr SUM(): BigReduction[\V,V\] = BigReduction[\V,V\](VSum)

run(): () = do
  xs = <|V(1.0), V(2.0), V(3.5)|>
  s1 = SUM xs
  println("SUM xs = " s1.x " (expect 6.5)")
  s2 = SUM[v <- xs] v v
  println("SUM[v<-xs] v v = " s2.x " (expect 17.25)")
  ys = <|1.0, 2.0, 3.5|>
  s3 = SUM[y <- ys] y
  println("library SUM over RR64 list = " s3 " (expect 6.5)")
  n = 4
  s4 = SUM[i <- 0#n] V(i)
  println("SUM[i<-0#4] V(i) = " s4.x " (expect 6)")
end
end

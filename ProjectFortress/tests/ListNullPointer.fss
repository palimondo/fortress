component ListNullPointer
import PureList.{...}
export Executable

(* Causes null pointer exception during sum computation *)

run():() = do
  testLens : List[\ZZ32\] = <|[\ZZ32\] |>
  s0 = testLens.generate[\ZZ32\](SumReduction[\ZZ32\], identity[\ZZ32\])
  assert(s0,0,"Sum s0")
  s1 = testLens.generate[\ZZ32\](SumReduction[\ZZ32\], identity[\ZZ32\])
  assert(s1,0,"Sum s1")
  tl2 : List[\ZZ32\] = <| 5 asif ZZ32 |>
  s2 = tl2.generate[\ZZ32\](SumReduction[\ZZ32\], identity[\ZZ32\])
  assert(s2,5,"Sum s2")
  tl3 : List[\ZZ32\] = <| 0 asif ZZ32,1,2,7,10 |>
  s3 = tl3.generate[\ZZ32\](SumReduction[\ZZ32\], fn (x:ZZ32):ZZ32 => x)
  assert(s3,20,"Sum s3")
end

end

component NatP25
export Executable
run() = do
  two: ZZ64 = 2
  three: ZZ64 = 3
  mtwo: ZZ64 = -2
  n66: ZZ64 = 66
  n67: ZZ64 = 67
  n68: ZZ64 = 68
  n62: ZZ64 = 62
  five: ZZ64 = 5
  caseName = "ZZ64 n68 CHOOSE 34 = "
  r: String = try
      v = n68 CHOOSE 34
      v.asString
    catch e
      IntegerOverflow => "IntegerOverflow"
    end
  println(caseName || r)
end
end

component OverflowBounds
export Executable

tryZZ32(f: () -> ZZ32): String =
  try
    (f()).asString
  catch e
    IntegerOverflow => "IntegerOverflow"
    Exception => "THROWS"
  end

tryZZ64(f: () -> ZZ64): String =
  try
    (f()).asString
  catch e
    IntegerOverflow => "IntegerOverflow"
    Exception => "THROWS"
  end

tryNN32(f: () -> NN32): String =
  try
    (f()).asString
  catch e
    IntegerOverflow => "IntegerOverflow"
    Exception => "THROWS"
  end

tryNN64(f: () -> NN64): String =
  try
    (f()).asString
  catch e
    IntegerOverflow => "IntegerOverflow"
    Exception => "THROWS"
  end

run(): () = do
  one: ZZ32 = 1
  mOne: ZZ32 = -1
  two: ZZ32 = 2
  k46340: ZZ32 = 46340
  k46341: ZZ32 = 46341
  zMax: ZZ32 = 7FFFFFFF_16
  zMin: ZZ32 = -zMax - 1
  println("ZZ32 MAX + 1 = " tryZZ32(fn () => zMax + one))
  println("ZZ32 MAX + 0 = " tryZZ32(fn () => zMax + (one - one)))
  println("ZZ32 MIN - 1 = " tryZZ32(fn () => zMin - one))
  println("ZZ32 MIN - -1 = " tryZZ32(fn () => zMin - mOne))
  println("ZZ32 -MIN = " tryZZ32(fn () => -zMin))
  println("ZZ32 -MAX = " tryZZ32(fn () => -zMax))
  println("ZZ32 |MIN| = " tryZZ32(fn () => |zMin|))
  println("ZZ32 MIN DIV -1 = " tryZZ32(fn () => zMin DIV mOne))
  println("ZZ32 MIN DIV 1 = " tryZZ32(fn () => zMin DIV one))
  println("ZZ32 46341 DOT 46341 = " tryZZ32(fn () => k46341 DOT k46341))
  println("ZZ32 46340 DOT 46340 = " tryZZ32(fn () => k46340 DOT k46340))
  println("ZZ32 MIN DOT -1 = " tryZZ32(fn () => zMin DOT mOne))
  println("ZZ32 MAX 2 = " tryZZ32(fn () => zMax two))
  println("ZZ32 MIN TIMES 1 = " tryZZ32(fn () => zMin TIMES one))

  lOne: ZZ64 = widen(one)
  lMOne: ZZ64 = widen(mOne)
  lTwo: ZZ64 = widen(two)
  s00: ZZ64 = 3037000500
  s499: ZZ64 = 3037000499
  lMax: ZZ64 = 7FFFFFFFFFFFFFFF_16
  lMin: ZZ64 = -lMax - 1
  println("ZZ64 MAX + 1 = " tryZZ64(fn () => lMax + lOne))
  println("ZZ64 MIN - 1 = " tryZZ64(fn () => lMin - lOne))
  println("ZZ64 MIN - -1 = " tryZZ64(fn () => lMin - lMOne))
  println("ZZ64 -MIN = " tryZZ64(fn () => -lMin))
  println("ZZ64 -MAX = " tryZZ64(fn () => -lMax))
  println("ZZ64 |MIN| = " tryZZ64(fn () => |lMin|))
  println("ZZ64 MIN DIV -1 = " tryZZ64(fn () => lMin DIV lMOne))
  println("ZZ64 MIN DIV 1 = " tryZZ64(fn () => lMin DIV lOne))
  println("ZZ64 3037000500 DOT 3037000500 = " tryZZ64(fn () => s00 DOT s00))
  println("ZZ64 3037000499 DOT 3037000499 = " tryZZ64(fn () => s499 DOT s499))
  println("ZZ64 MIN DOT -1 = " tryZZ64(fn () => lMin DOT lMOne))
  println("ZZ64 MIN DOT 2 = " tryZZ64(fn () => lMin DOT lTwo))
  println("ZZ64 -2^31 DOT 2^32 = " tryZZ64(fn () => (lMOne LSHIFT 31) DOT (lOne LSHIFT 32)))
  println("ZZ64 2^31 DOT 2^32 = " tryZZ64(fn () => (lOne LSHIFT 31) DOT (lOne LSHIFT 32)))

  zeroU: NN32 = unsigned(0)
  oneU: NN32 = unsigned(1)
  maxU: NN32 = BITNOT zeroU
  bigU: NN32 = unsigned(65536)
  println("NN32 MAX + 1 = " tryNN32(fn () => maxU + oneU))
  println("NN32 MAX + 0 = " tryNN32(fn () => maxU + zeroU))
  println("NN32 0 - 1 = " tryNN32(fn () => zeroU - oneU))
  println("NN32 MAX - MAX = " tryNN32(fn () => maxU - maxU))
  println("NN32 -1 = " tryNN32(fn () => -oneU))
  println("NN32 -MAX = " tryNN32(fn () => -maxU))
  println("NN32 -0 = " tryNN32(fn () => -zeroU))
  println("NN32 2^16 DOT 2^16 = " tryNN32(fn () => bigU DOT bigU))
  println("NN32 (2^16-1) DOT (2^16+1) = " tryNN32(fn () => (bigU - oneU) DOT (bigU + oneU)))
  println("NN32 MAX DOT MAX = " tryNN32(fn () => maxU DOT maxU))
  println("NN32 MAX 1 = " tryNN32(fn () => maxU oneU))

  zeroUL: NN64 = widen(zeroU)
  oneUL: NN64 = widen(oneU)
  maxUL: NN64 = BITNOT zeroUL
  bigUL: NN64 = widen(bigU) DOT widen(bigU)
  hiUL: NN64 = (widen(unsigned(32768)) DOT widen(bigU)) DOT bigUL
  println("NN64 MAX + 1 = " tryNN64(fn () => maxUL + oneUL))
  println("NN64 MAX + 0 = " tryNN64(fn () => maxUL + zeroUL))
  println("NN64 0 - 1 = " tryNN64(fn () => zeroUL - oneUL))
  println("NN64 MAX - MAX = " tryNN64(fn () => maxUL - maxUL))
  println("NN64 -1 = " tryNN64(fn () => -oneUL))
  println("NN64 -MAX = " tryNN64(fn () => -maxUL))
  println("NN64 -0 = " tryNN64(fn () => -zeroUL))
  println("NN64 2^32 DOT 2^32 = " tryNN64(fn () => bigUL DOT bigUL))
  println("NN64 (2^32-1) DOT (2^32+1) = " tryNN64(fn () => (bigUL - oneUL) DOT (bigUL + oneUL)))
  println("NN64 MAX DOT MAX = " tryNN64(fn () => maxUL DOT maxUL))
  println("NN64 MAX 1 = " tryNN64(fn () => maxUL oneUL))
  println("NN64 2^63 DOT 2 = " tryNN64(fn () => hiUL DOT (oneUL + oneUL)))
  println("NN64 (2^63+1) + (2^63-1) = " tryNN64(fn () => (hiUL + oneUL) + (hiUL - oneUL)))
  println("done")
end

end

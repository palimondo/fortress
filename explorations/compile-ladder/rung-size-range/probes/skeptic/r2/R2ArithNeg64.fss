component R2ArithNeg64
export Executable
object Box[\nat k\](v: ZZ32) end
object IBox[\int k\](v: ZZ32) end
sz[\nat k\](b: Box[\k\]): ZZ64 = k
isz[\int k\](b: IBox[\k\]): ZZ64 = k
run(): () = do
  println("REACHED")
  println("m1 0 - 9223372036854775807 - 2 = " || isz(IBox[\0 - 9223372036854775807 - 2\](0)))
  println("END")

component Sk2EmptyHashDraft
export Executable

run(): () = do
    println("REACHED")
    zMax: ZZ32 = 7FFFFFFF_16
    zMin: ZZ32 = -zMax - 1
    zero: ZZ32 = 0
    emptyAtMin = zMin # zero
    maxInside = zMax IN emptyAtMin
    assert(NOT maxInside, "ranges.tex:64-65")
    emptySize = emptyAtMin.size
    assert(emptySize = 0, "ranges.tex:64-65, :103-106")
    println("PASS")
  end

end

component MaxVarZZ64ZZ32
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    NN32 => "NN32"
    NN64 => "NN64"
    ZZ => "ZZ"
    QQ => "QQ"
    RR64 => "RR64"
    else => "other"
  end

run() = do
    w: ZZ64 = widen(4)
    z: ZZ32 = 3
    r = w MAX z
    println("w MAX z = " r " : " typeOf(r))
end

end

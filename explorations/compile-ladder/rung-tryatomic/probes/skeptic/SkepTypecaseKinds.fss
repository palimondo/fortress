component SkepTypecaseKinds
export Executable

(*) See explorations/compile-ladder/rung-tryatomic/SKEPTIC.md

object Wrap
    getter asString(): String = "Wrap"
end

kind(x: Object): String =
    typecase x of
        ZZ32 => "ZZ32"
        String => "String"
        Wrap => "Wrap"
        else => "other"
    end

run():() = do
    n: ZZ32 = 7
    println("literal 7: " kind(7))
    println("ZZ32 var:  " kind(n))
    println("String:    " kind("s"))
    println("object:    " kind(Wrap))
end

end

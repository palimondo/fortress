component XXXUnwrittenSumRungF
export Executable

(*) explorations/compile-ladder/rung-flat-tower/REPORT.md

emptySum(n: ZZ32): ZZ32 = SUM[j <- 0#n] j

run() = do
    println("REACHED")
    e = emptySum(0)
    assert(e, 0, "row 424; reductions.tex, section \"Summations and Other Reduction Expressions\"; defining-generators.tex, subsection \"Simple Desugaring of Expressions with Generators\"")
    s = SUM[j <- 0#4] j
    assert(s, 6, "row 424; reductions.tex, section \"Summations and Other Reduction Expressions\"; defining-generators.tex, subsection \"Simple Desugaring of Expressions with Generators\"")
    p = PROD[j <- 1#3] j
    assert(p, 6, "row 424; reductions.tex, section \"Summations and Other Reduction Expressions\"; defining-generators.tex, subsection \"Simple Desugaring of Expressions with Generators\"")
    println("PASS")
  end

end

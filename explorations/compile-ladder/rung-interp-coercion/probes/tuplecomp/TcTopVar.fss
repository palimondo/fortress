component TcTopVar
export Executable

trait Wide excludes { Narrow }
  coerce(x: Narrow) = WideOf(x.small)
  getter big(): ZZ32
end
trait Narrow excludes { Wide }
  getter small(): ZZ32
end
object WideOf(b: ZZ32) extends Wide
  getter big(): ZZ32 = b
end
object NarrowOf(s: ZZ32) extends Narrow
  getter small(): ZZ32 = s
end

var topT: (Wide, ZZ32) = (WideOf(16), 17)

run() = do
    topT := (WideOf(18), 19)
    (ta1, tb1) = topT
    println("top var: ta1.big = " ta1.big " tb1 = " tb1)
  end

end

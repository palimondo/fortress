component MethRenamed
export Executable

(* The renamed-arm program of XXXDispatchRenamedArmRungG as two generic dotted methods of
   one object, no double membership: through b: Tag[Blue] the call is checked as the Tag
   method at X = Blue and dispatched. *)
trait Tag[\X\] end
trait Sub[\X\] extends Tag[\X\] end
object Red end
object Blue end
object SubBlue extends Sub[\Blue\] end
object TagBlue extends Tag[\Blue\] end
trait Marker[\X\] end
object TagM[\X\] extends Marker[\X\] end
object SubM[\X\] extends Marker[\X\] end

object K
  grab[\X\](t: Tag[\X\]): Marker[\X\] = TagM[\X\]
  grab[\Y\](t: Sub[\Y\]): Marker[\Y\] = SubM[\Y\]
end

name(m: Any): String = typecase m of
    TagM[\Blue\] => "TagM[Blue]"
    SubM[\Blue\] => "SubM[Blue]"
    else => "other"
  end

run(): () = do
  b2: Tag[\Blue\] = SubBlue
  println("K.grab(b2), b2: Tag[Blue] = SubBlue -> " || name(K.grab(b2)))
  b3: Tag[\Blue\] = TagBlue
  println("K.grab(b3), b3: Tag[Blue] = TagBlue -> " || name(K.grab(b3)))
end
end

component BGenCk2
export Executable
(* evidence-B probe; the compiled checker over the one library, one function per
   case so that an untyped binding left by one refusal does not hide the next.
   vN = call binds untyped (no expected type); String = vN reveals its type. *)
object BoxT[\T\](v: ZZ32) end
twice[\T extends Integral[\T\]\](x: T, y: T): T = x + y
pick[\T\](x: T, y: T): T = x
idt[\T\](x: T): T = x
takes64(x: ZZ64): ZZ64 = x
scale64[\T\](b: BoxT[\T\], m: ZZ64): ZZ64 = m
scaleR[\T\](b: BoxT[\T\], m: RR64): RR64 = m
scaleT[\T\](b: BoxT[\T\], m: ZZ32): ZZ32 = m
l: ZZ64 = widen(5)
z: ZZ32 = 5
k06(): () = do v = twice(l, 3); c: String = v; () end
k07(): () = do v = twice(l, z); c: String = v; () end
k08(): () = do v = twice(3, 4); c: String = v; () end
k09(): () = do v = pick(l, 3); c: String = v; () end
k10(): () = do v = pick(3, 4); c: String = v; () end
k11(): () = do v = idt(3); c: String = v; () end
k12(): () = do v = pick(l, z); c: String = v; () end
a01(): () = do a: ZZ64 = idt(3); () end
a02(): () = do a: RR64 = idt(3); () end
a03(): () = do a: ZZ64 = takes64(idt(3)); () end
a04(): () = do a: ZZ64 = scale64(BoxT[\String\](2), 3); () end
a05(): () = do a: RR64 = scaleR(BoxT[\String\](2), 3); () end
a06(): () = do a: ZZ32 = scaleT(BoxT[\String\](2), 3); () end
a07(): () = do a: ZZ64 = scale64(BoxT[\String\](2), z); () end
a08(): () = do a: ZZ64 = scale64[\String\](BoxT[\String\](2), 3); () end
a09(): () = do a: ZZ64 = idt(z); () end
a10(): () = do a: ZZ64 = pick(l, 3); () end
a11(): () = do a: ZZ64 = pick(l, z); () end
a12(): () = do a = idt(3); b: ZZ64 = a; () end
a13(): () = do a: RR64 = scaleR(BoxT[\String\](2), 3.0); () end
retIdt(): ZZ64 = idt(3)
run(): () = ()
end

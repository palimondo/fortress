(* Each name of a top-level tuple binding has its element's type, so a
   use at another type is refused
   (variables.tex, section "Top-Level Variable Declarations"). *)
component TopLevelTupleBindingType
export Executable

(nHead, headDim) = (4, 4)

run(): () = do
    z: String = headDim
    println(z)
end

end

component XXXInferLoneBoundUnion
export Executable

object BoxT[\T\]() end

pick[\T extends Number\](x: T, y: T): BoxT[\T\] = BoxT[\T\]()
pick0[\T\](x: T, y: T): BoxT[\T\] = BoxT[\T\]()
same[\T\](a: BoxT[\T\], b: BoxT[\T\]): String = "same"

run(): () = do
  w: ZZ64 = 4
  r: RR64 = 2.5
  assert(same(pick0(w, r), pick(w, r)), "same", "ledger row 516: a written bound permits and is not a candidate, both instances at the union; Specification/basic/inference.tex:89-98, basic/types-vals-vars.tex:575-581; the conversion judgement's decision 1 (POSITIONS 2026-09-28)")
  println("PASS")
end

end

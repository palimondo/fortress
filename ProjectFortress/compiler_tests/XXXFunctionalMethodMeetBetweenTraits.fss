(* A trait between two closed traits and the one type both list provides their functional methods and no declaration below both, so the overloading is invalid in that trait, although the declaration in the listed type covers the overlap for the top-level check. *)
component XXXFunctionalMethodMeetBetweenTraits
export Executable

trait T comprises { V, W }
  choose(self): ZZ32 = 2
end
trait S comprises { U, V }
  choose(self): ZZ32 = 1
end
trait U extends S excludes W end
trait M extends { S, T } comprises { V } end
trait V extends M
  choose(self): ZZ32 = 3
end
trait W extends T end
object Vo extends V end

run(): () = do
  println(choose(Vo))
end
end

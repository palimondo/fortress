diff --git a/ProjectFortress/src/com/sun/fortress/Shell.java b/ProjectFortress/src/com/sun/fortress/Shell.java
index ebedff14d..1df7072b8 100644
--- a/ProjectFortress/src/com/sun/fortress/Shell.java
+++ b/ProjectFortress/src/com/sun/fortress/Shell.java
@@ -369,7 +369,7 @@ public final class Shell {
     }
 
     public static void useCompilerLibraries() {
-	setExtendsObjectPreDesugaring(true);
+	setExtendsObjectPreDesugaring(false);
 	setAssignmentPreDesugaring(false);
 	setAssignmentDesugaring(true);
         WellKnownNames.useCompilerLibraries();
diff --git a/explorations/coordinator/tools/distance/DistanceMulti.java b/explorations/coordinator/tools/distance/DistanceMulti.java
index 3d0f9863b..4c10be2cf 100644
--- a/explorations/coordinator/tools/distance/DistanceMulti.java
+++ b/explorations/coordinator/tools/distance/DistanceMulti.java
@@ -42,7 +42,7 @@ public class DistanceMulti {
             throw new RuntimeException("unknown -setting " + setting);
 
         Shell.useInterpreterLibraries();
-        Shell.setExtendsObjectPreDesugaring(setting.equals("compile"));
+        Shell.setExtendsObjectPreDesugaring(setting.equals("compile") && compileCommandExtendsObject());
         Shell.setCompiledExprDesugaring(!setting.equals("walk"));
         Shell.setTypeChecking(true);
         Shell.setScala(true);
@@ -72,4 +72,18 @@ public class DistanceMulti {
         System.out.println("### all seconds=" + (System.nanoTime() - t0) / 1000000000L + " rc=" + worst);
         System.exit(worst);
     }
+
+    // -setting compile: the extends-Object switch of the compile command, as Shell.useCompilerLibraries()
+    // sets it in the tracked source, read at each run so that the stage follows that line. Calling the
+    // method here would not do: Types' constants would then name the compiler's prelude.
+    static boolean compileCommandExtendsObject() throws java.io.IOException {
+        String src = new String(java.nio.file.Files.readAllBytes(
+                java.nio.file.Paths.get("ProjectFortress/src/com/sun/fortress/Shell.java")), "UTF-8");
+        java.util.regex.Matcher m = java.util.regex.Pattern.compile(
+                "public static void useCompilerLibraries\\(\\) \\{\\s*setExtendsObjectPreDesugaring\\((true|false)\\);")
+                .matcher(src);
+        if (!m.find())
+            throw new RuntimeException("Shell.useCompilerLibraries() does not open with setExtendsObjectPreDesugaring");
+        return Boolean.parseBoolean(m.group(1));
+    }
 }

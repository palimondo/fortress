(* A call whose argument's static type G[\ZZ32\] sits below S and T and not below V has f(S) and f(T) as its most specific candidates, and the value, a V, runs f(V). *)
component ComprisesBetweenTwoClosed
export Executable

trait S comprises { U, V } end
trait T comprises { V, W } end
trait U extends S excludes W end
trait V extends { S, T } end
trait W extends T end
trait G[\X\] extends { S, T } end
object H extends { G[\ZZ32\], V } end

f(s: S): ZZ32 = 1
f(t: T): ZZ32 = 2
f(v: V): ZZ32 = 3

run(): () = do
    g: G[\ZZ32\] = H
    println("f(g) = " f(g))
    assert(f(g), 3, "the value of g is a V, so f(V) runs")
    println("PASS")
end

end

(* g4: unary minus on a runtime vector and matrix *)
component alg_g4
export Executable
run(): () = do
    v = array[\RR64\](4).fill(fn (i: ZZ32): RR64 => 1.0 i - 1.0)
    mx = array[\RR64\](2,3).fill(fn (i: ZZ32, j: ZZ32): RR64 => 1.0 (i + j) - 1.0)
    nv = -v
    nm = -mx
    println "(1) -v = " (BIG |||[i <- seq(0#|nv|)] ("" nv[i]))
    (r, c) = nm.sizes
    println "(2) -m = " (BIG |||[i <- seq(0#r), j <- seq(0#c)] ("" nm[i,j]))
  end
end

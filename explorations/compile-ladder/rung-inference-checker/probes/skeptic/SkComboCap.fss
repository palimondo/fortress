component SkComboCap
export Executable

g2[\A, B\](a: A, b: B, m: ZZ64): ZZ64 = m + m
g3[\A, B, C\](a: A, b: B, c: C, m: ZZ64): ZZ64 = m + m

run(): () = do
    z: ZZ32 = 1
    println("g2(1, 2, 4): " || g2(1, 2, 4))
    println("g3(z, z, z, 4): " || g3(z, z, z, 4))
    println("g3(1, 2, 3, 4): " || g3(1, 2, 3, 4))
end

end

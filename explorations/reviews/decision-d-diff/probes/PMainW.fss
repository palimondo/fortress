(* The six mechanics decision D's diff rests on, one per function so that one failure hides no other. *)
component PMainW
import PScal.{...}
import NatReflect.{...}
export Executable
object Obj
  mk[\nat r\](): Vector[\ZZ32,r\] = vector[\ZZ32,r\](fn (i: ZZ32): ZZ32 => i)
end
mk2[\nat r\](): Vector[\ZZ32,r\] = vector[\ZZ32,r\](fn (i: ZZ32): ZZ32 => i)
mkw[\nat r\](_: N[\r\]): Vector[\ZZ32,r\] = vector[\ZZ32,r\](fn (i: ZZ32): ZZ32 => i)
twice[\nat s\](x: Vector[\RR64,s\]): Vector[\RR64,s\] = 2.0 x
rowsV[\nat r, nat c\](f: Vector[\RR64,c\] -> Vector[\RR64,c\], m: Matrix[\RR64,r,c\]): Matrix[\RR64,r,c\] = do
    out = matrix[\RR64,r,c\]()
    for i <- 0#r do
        y = f(vector[\RR64,c\](fn (j: ZZ32): RR64 => m[i,j]))
        for j <- 0#c do out[i,j] := y[j] end
    end
    out
  end
(* 1. expected type at a method invocation *)
p1(): ZZ32 = do x: Vector[\ZZ32,5\] = Obj.mk(); x DOT x end
(* 1b. expected type at a call written f(x) *)
p1b(): ZZ32 = do y: Vector[\ZZ32,5\] = mk2(); y DOT y end
(* 2. a witness *)
p2(): ZZ32 = do z = mkw(N[\5\]); z DOT z end
(* 3. a generic sized function passed as a function value *)
p3(): RR64 = do m = matrix[\RR64,2,3\](1.0); w = rowsV(twice, m); w[1,1] end
(* 4. sized scalar operators beside the library's scalar extension *)
p4(): RR64 = do
    v = vector[\RR64,3\](fn (i: ZZ32): RR64 => 1.0 i)
    w = v - 1.0
    m = matrix[\RR64,2,2\](1.0)
    mm = 0.0 MAX m
    (w DOT w) + (mm[0,0])
  end
(* 5. the reflect bridge *)
p5inner[\nat r\](_: N[\r\]): ZZ32 = do z = vector[\ZZ32,r\](fn (i: ZZ32): ZZ32 => i); z DOT z end
p5(n: ZZ32): ZZ32 = p5inner(reflect(n))
(* 6. a local function inside a size-generic function, using its sizes and a witness *)
p6[\nat r, nat c\](m: Matrix[\RR64,r,c\]): RR64 = do
    h(x: Matrix[\RR64,r,c\]): Vector[\RR64,c\] = vector[\RR64,c\](fn (j: ZZ32): RR64 => x[0,j])
    k = mkw(N[\c\])
    (h(m) DOT h(m)) + (1.0 |k|)
  end
run(): () = do
  (* p1: walk has no expected type *)
  (* p1b: refused by the checker *)
  println("p2 " p2())
  println("p3 " p3())
  println("p4 " p4())
  println("p5 " p5(4))
  println("p6 " p6(matrix[\RR64,2,3\](1.0)))
end
end

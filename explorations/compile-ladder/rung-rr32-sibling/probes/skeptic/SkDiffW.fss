component SkDiffW
export Executable

kind(v: Any): String = typecase v of
    RR32 => "RR32"
    RR64 => "RR64"
    else => "other"
  end

gen[\T extends Number\](x: T, y: T): T = x
gen3[\T extends Number\](x: T, y: T, z: T): T = z
retR64(x: RR32): RR64 = x
num(x: Number): String = kind(x)

run(): () = do
    a: RR32 = narrow(1.5)
    b: RR32 = narrow(2.5)
    f: RR64 = 3.0
    println("01 a - b      " kind(a - b))
    println("02 a DOT f    " kind(a DOT f))
    v02: RR64 = a DOT f
    println(v02)
    println("03 f a        " kind(f a))
    v03: RR64 = f a
    println(v03)
    println("04 a MAX b    " kind(a MAX b))
    println("05 a MAX f    " kind(a MAX f))
    v05: RR64 = a MAX f
    println(v05)
    println("06 a MIN 2.5  " kind(a MIN 2.5))
    v06: RR64 = a MIN 2.5
    println(v06)
    println("07 a < b      " (a < b))
    println("08 a <= f     " (a <= f))
    println("09 a > f      " (a > f))
    println("10 f >= a     " (f >= a))
    println("11 SQRT a     " kind(SQRT a))
    println("12 gen(f, a)  " kind(gen(f, a)))
    v12: RR64 = gen(f, a)
    println(v12)
    println("13 gen3(a, b, f) " kind(gen3(a, b, f)))
    println("14 gen3(a, b, b) " kind(gen3(a, b, b)))
    println("15 retR64(a)  " kind(retR64(a)))
    m: RR64 := f
    m := a
    println("16 m := a     " kind(m))
    println(m)
    println("17 num(a)     " num(a))
    println("18 a^2        " kind(a^2))
    v18: RR64 = a^2
    println(v18)
    println("DONE")
  end
end

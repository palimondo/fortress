(* Q2 probe 19: q17's unit-parameterized operator, now actually CALLED.
   q17 showed the declaration is accepted; this shows whether the declaration
   is merely tolerated (never elaborated) or genuinely usable.
   Spec: Specification/basic/trait-parameters.tex:147-149. *)
component q19_unit_param_called
export Executable

dim Area = Length^2  SI_unit squareMeter sqm_ = 1.0
dim Length  SI_unit meter meters m_ = 1.0

opr SQRTU[\unit U\](x: RR64 U^2): RR64 U = numericalsqrt(x/U^2) U

numericalsqrt(x: RR64): RR64 = x^0.5

run() = println("SQRTU = " SQRTU[\meter\](9.0))

end

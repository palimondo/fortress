(* See explorations/compile-ladder/rung-unknown-size-arm/REPORT.md. *)
component XXXNatBigSizeWalk
export Executable

object Box[\nat k\](v: ZZ32) end

size64[\nat k\](b: Box[\k\]): ZZ64 = k

run(): () = do
    e1: ZZ64 = 4294967295
    r1 = size64(Box[\4294967295\](0))
    println(r1)
    assert(r1 = e1, "row 418; Specification/basic/trait-parameters.tex:84-85")
    e2: ZZ64 = 3000000000
    r2 = size64(Box[\3000000000\](0))
    println(r2)
    assert(r2 = e2, "row 418; Specification/basic/trait-parameters.tex:84-85")
    println("PASS")
  end

end

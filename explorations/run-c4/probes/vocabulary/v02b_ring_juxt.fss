(* v02b_ring_juxt: v02 continued past the broken +.  With the carrier both a
   Matrix and a MultiplicativeRing, which juxtaposition does h h pick: the
   ring's (self TIMES other, elementwise) or the library's product? and does
   binary - survive? *)
component v02b_ring_juxt
export Executable

object HMat[\nat r, nat c\](base: Matrix[\RR64,r,c\])
        extends { Matrix[\RR64,r,c\], MultiplicativeRing[\HMat[\r,c\]\] }
    getter one(): HMat[\r,c\] = HMat[\r,c\](base.map[\RR64\](fn (e: RR64): RR64 => 1.0))
    get(ij: (ZZ32,ZZ32)): RR64 = base.get(ij)
    put(ij: (ZZ32,ZZ32), x: RR64): () = base.put(ij, x)
    init0(ij: (ZZ32,ZZ32), x: RR64): () = base.init0(ij, x)
    replica[\U\](): Array2[\U,0,r,0,c\] = array2[\U,r,c\]()
    opr TIMES(self, o: HMat[\r,c\]): HMat[\r,c\] =
        HMat[\r,c\](base.ivmap[\RR64\](fn (ij: (ZZ32,ZZ32), e: RR64): RR64 => e o.get(ij)))
end
hmat[\nat r, nat c\](m: Matrix[\RR64,r,c\]): HMat[\r,c\] = HMat[\r,c\](m)

run(): () = do
    m = array[\RR64\](2, 2).fill(fn (i: ZZ32, j: ZZ32): RR64 => 1.0 (2 i + j + 1))
    h = hmat(m)
    println "(1) h h = " (h h) "  (product would be [7 10; 15 22], elementwise [1 4; 9 16])"
    println "(2) h.t() = " (h.t())
    println "(3) 2.0 h = " (2.0 h)
    println "(4) h - h = " (h - h)
  end
end

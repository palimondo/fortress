(* P09: Same __bigOperator hijack as P08, but WITHOUT explicit static args:
   plain  SUM [v <- vs] v.  This makes the interpreter call the library's
   nullary  SUM()  with T uninstantiated. *)
component p09_hijack_nostaticargs
import List.{...}
export Executable

object V(data: RR64)
    getter asString(): String = "V(" data ")"
    opr +(self, other: V): V = V(data + other.data)
end

object VSumReduction extends CommutativeMonoidReduction[\V\]
    getter asString(): String = "VSumReduction"
    empty(): V = V(0.0)
    join(a: V, b: V): V = a + b
end

__bigOperator(o: Comprehension[\V,Number,Number,Number\],
              desugaredClauses:(Reduction[\V\],V->V)->V): V = do
    r = VSumReduction
    desugaredClauses(r, fn (x:V):V => x)
  end

run(): () = do
    vs = <| V(1.0), V(2.0), V(3.5) |>
    println("SUM [v <- vs] v = " (SUM [v <- vs] v))
end
end

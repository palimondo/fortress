component SkRangeEdges
export Executable

object RunsPastTop extends UncheckedException end

show(f: () -> String): String =
  try
    f()
  catch e
    IntegerOverflow => "IntegerOverflow"
    RunsPastTop => "RUNS PAST THE TOP (a fourth element, or more)"
    Exception => "OTHER"
  end

run(): () = do
  zMax: ZZ32 = 2147483647
  zMin: ZZ32 = -2147483647 - 1
  lMax: ZZ64 = 9223372036854775807
  one: ZZ32 = 1
  three: ZZ32 = 3
  lOne: ZZ64 = widen(one)
  lThree: ZZ64 = widen(three)

  println("E01 |(MAX-2):MAX| = " show(fn () => (|(zMax - 2):zMax|).asString))
  println("E02 SUM[ZZ64] over (MAX-2):MAX, parallel = " show(fn () => (SUM[\ZZ64\][i <- (zMax - 2):zMax] widen(i)).asString))
  println("E03 SUM[ZZ64] over MIN:(MIN+2), parallel = " show(fn () => (SUM[\ZZ64\][i <- zMin:(zMin + 2)] widen(i)).asString))
  println("E04 |MAX # 1| = " show(fn () => (|zMax # one|).asString))
  println("E05 |(MAX-2) # 3| = " show(fn () => (|(zMax - 2) # three|).asString))
  println("E06 SUM[ZZ64] over (MAX-2) # 3 = " show(fn () => (SUM[\ZZ64\][i <- (zMax - 2) # three] widen(i)).asString))
  println("E08 |MAX:MIN| (empty) = " show(fn () => (|zMax:zMin|).asString))
  println("E09 |1:MIN| (empty) = " show(fn () => (|one:zMin|).asString))
  println("E10 |0:MAX| = " show(fn () => (|0:zMax|).asString))
  println("E11 sequential for over seq((MAX-2):MAX), elements seen = " show(fn () => do
      var n: ZZ32 = 0
      for i <- seq((zMax - 2):zMax) do
        n += 1
        if n > 3 then throw RunsPastTop end
      end
      n.asString
    end))
  println("E12 sequential for over seq(MIN:(MIN+2)), elements seen = " show(fn () => do
      var n: ZZ32 = 0
      for i <- seq(zMin:(zMin + 2)) do
        n += 1
        if n > 3 then throw RunsPastTop end
      end
      n.asString
    end))
  println("E13 sequential for over seq(1:3), elements seen = " show(fn () => do
      var n: ZZ32 = 0
      for i <- seq(one:three) do
        n += 1
        if n > 3 then throw RunsPastTop end
      end
      n.asString
    end))
  println("E14 ZZ64 sequential for over seq((MAX-2):MAX), elements seen = " show(fn () => do
      var n: ZZ32 = 0
      for i <- seq((lMax - widen(2)):lMax) do
        n += 1
        if n > 3 then throw RunsPastTop end
      end
      n.asString
    end))
  println("E16 sequential for over seq((MAX-4):MAX:2), elements seen = " show(fn () => do
      var n: ZZ32 = 0
      for i <- seq((zMax - 4):zMax:2) do
        n += 1
        if n > 3 then throw RunsPastTop end
      end
      n.asString
    end))
  println("E18 MAX IN (MAX-2) # 3 = " show(fn () => (zMax IN ((zMax - 2) # three)).asString))
  println("E07 (last: on the base it ends the run) ZZ64 |(MAX-2) # 3| = " show(fn () => (|(lMax - widen(2)) # lThree|).asString))
  println("END")
end

end

component O2FbAny
export Executable
(* An F-bounded generic arm (the library's usual shape, T extends Equality[\T\]) beside a plain arm
   over Any. For (ZZ32, ZZ64) no T within the bound takes both unconverted, so the generic arm fits the
   call only by answer 8's promotion. *)
eqop[\T extends Equality[\T\]\](a: T, b: T): String = "eqop generic[" (typeOf a) "," (typeOf b) "]"
eqop(a: Any, b: Any): String = "eqop plain[" (typeOf a) "," (typeOf b) "]"
typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    IntLiteral => "IntLiteral"
    else => "other"
  end
run(): () = do
    z: ZZ32 = 3
    w: ZZ64 = 4
    println("eqop(z, w): " eqop(z, w))
    println("eqop(z, z): " eqop(z, z))
    println("eqop(w, w): " eqop(w, w))
    println("eqop[ZZ64](z, w): " eqop[\ZZ64\](z, w))
  end
end

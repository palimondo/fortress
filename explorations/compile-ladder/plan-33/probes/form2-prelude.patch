@@ -601,6 +601,47 @@ public class NamingCzar {
         bl(NodeFactory.makeVoidType(span), "FVoid");
     }
 
+    /**
+     * PROBE 33 (way C, form 2): the built-in number types that are value objects
+     * whose class the code generator writes over a hand-written payload class.
+     * Each entry: the type's name, its payload class, the JVM type of its payload.
+     */
+    private static final String[][] payloadObjects = {
+        { "ZZ32", runtimeValues + "FZZ32", "I" },
+        { "ZZ64", runtimeValues + "FZZ64", "J" },
+        { "ZZ",   runtimeValues + "FZZ",   "Ljava/lang/String;" },
+        { "NN32", runtimeValues + "FNN32", "I" },
+        { "NN64", runtimeValues + "FNN64", "J" },
+        { "RR32", runtimeValues + "FRR32", "F" },
+        { "RR64", runtimeValues + "FRR64", "D" },
+    };
+
+    /** The payload class and JVM payload type of the object {@code name} of component {@code api}, or null. */
+    public static String[] payloadFor(String name, APIName api) {
+        if (!api.getText().equals(WellKnownNames.fortressBuiltin())) return null;
+        for (String[] e : payloadObjects) if (e[0].equals(name)) return new String[] { e[1], e[2] };
+        return null;
+    }
+
+    /** PROBE 33: the prelude's object class whose payload class is {@code payloadClass}, or null. */
+    public static String payloadObjectClassOfPayload(String payloadClass) {
+        for (String[] e : payloadObjects)
+            if (e[1].equals(payloadClass)) return javaPackageClassForApi(fortLib, "/") + "$" + e[0];
+        return null;
+    }
+
+    /** The class that the code generator writes for a payload object's type, or null. */
+    public static String payloadObjectClass(com.sun.fortress.nodes.Type t) {
+        if (!(t instanceof com.sun.fortress.nodes.TraitType)) return null;
+        Id id = ((com.sun.fortress.nodes.TraitType) t).getName();
+        String name = id.getText();
+        if (((com.sun.fortress.nodes.TraitType) t).getArgs().size() > 0) return null;
+        if (id.getApiName().isSome() && !id.getApiName().unwrap().getText().equals(WellKnownNames.fortressBuiltin())) return null;
+        for (String[] e : payloadObjects)
+            if (e[0].equals(name)) return javaPackageClassForApi(fortLib, "/") + "$" + name;
+        return null;
+    }
+
     /**
      * Determine whether given TraitType is special, meaning, implemented
      * by hand, with a non-standard naming convention.

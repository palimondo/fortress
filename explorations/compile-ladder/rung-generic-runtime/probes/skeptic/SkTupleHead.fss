component SkTupleHead
export Executable

object Box[\nat k\](v: ZZ32) end
object Oops(code: ZZ32) extends CheckedException end
object Other(code: ZZ32) extends CheckedException end
boom(k: ZZ32): ZZ32 = throw Oops(k)
boom2(k: ZZ32): ZZ32 = throw Other(k)
boomU(k: ZZ32): () = throw Oops(k)

second(a: ZZ32, s: String): String = s || a.asString
tupleRead(z: ZZ32): String =
  typecase (z, "s") of
      p: (ZZ32, String) => second(p)
      else => "other"
    end

run(): () = do
  z: ZZ32 = 3 + 4
  println(tupleRead(z))
end

end

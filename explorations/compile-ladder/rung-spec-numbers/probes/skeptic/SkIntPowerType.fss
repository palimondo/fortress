component SkIntPowerType
export Executable
run() = do
  a: ZZ32 = 2
  b: ZZ32 = 3
  c: ZZ32 = -1
  p = a^b
  q = a^c
  println("2^3 and 2^(-1) with ZZ32 operands, each with its run-time type:")
  println(p)
  println(typecase p of ZZ32 => "ZZ32"; RR64 => "RR64"; else => "other" end)
  println(q)
  println(typecase q of ZZ32 => "ZZ32"; RR64 => "RR64"; else => "other" end)
end
end

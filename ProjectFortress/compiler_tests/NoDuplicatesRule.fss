component NoDuplicatesRule
export Executable

(* Two generic declarations whose parameter types Box[T] and Box[U] are each as specific as the other break the No Duplicates Rule, a static error (overloading.tex, section "Declarations with Static Parameters"). *)

object Box[\T\] end

dup[\T\](x: Box[\T\]): ZZ32 = 1
dup[\U\](x: Box[\U\]): ZZ32 = 2

run(): () = do
  println(dup(Box[\String\]))
end

end

component O2Explicit
export Executable
(* Option 2's checker output written by hand: the generic arm at ZZ64 named by an explicit static
   argument beside the plain arm over Any, to see what the run time does with the call the option-2
   checker would produce (z converted, T = ZZ64), and the inferred call beside it. *)
op[\T extends Number\](a: T, b: T): String = "op generic[" (typeOf a) "," (typeOf b) "]"
op(a: Any, b: Any): String = "op plain[" (typeOf a) "," (typeOf b) "]"
typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    IntLiteral => "IntLiteral"
    else => "other"
  end
run(): () = do
    z: ZZ32 = 3
    w: ZZ64 = 4
    println("op(z, w): " op(z, w))
    println("op[ZZ64](z, w): " op[\ZZ64\](z, w))
    println("op[ZZ64](z, z): " op[\ZZ64\](z, z))
  end
end

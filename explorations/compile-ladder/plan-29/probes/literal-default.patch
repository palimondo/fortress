+(* The exact value of a numeral's decimal text, as a rational: 3.125 is 3125/1000. *)
+private numeralRatio(t: String): QQ = do
+    var n: ZZ := 0
+    var d: ZZ := 1
+    var point: Boolean := false
+    for c <- seq(t) do
+        if c = '.' then point := true
+        else
+            n := 10 n + (c.codePoint - 48)
+            if point then d := 10 d end
+        end
+    end
+    n / d
+  end

(* c02c: vector pasting [ u v ] (which c02b showed works with literal sizes)
   at RUNTIME sizes and with no declared LHS type -- the spelling head
   concatenation would want: [ h_1 h_2 h_3 h_4 ].  Also a 2-D paste of
   runtime-sized matrices, to see whether c02b's failure is size-related. *)
component c02c_pasting_runtime
export Executable

run(): () = do
  n: ZZ32 = 2
  u = array[\RR64\](n).fill(fn i => 1.0 (i + 1))
  v = array[\RR64\](n).fill(fn i => 10.0 (i + 1))
  w = [ u v ]
  println("[ u v ] untyped, runtime sizes = " w)
  typecase w of
    AnyVector => println("  IS an AnyVector")
    else => println("  is NOT an AnyVector")
  end
  w4: Array[\RR64,ZZ32\] = [ u v u v ]
  println("[ u v u v ] = " w4 "  |w4| = " |w4|)
  A = array[\RR64\](n, n).fill(fn (i, j) => 1.0 (n i + j + 1))
  B = array[\RR64\](n, n).fill(fn (i, j) => 10.0 (n i + j + 1))
  D: Array[\RR64,(ZZ32,ZZ32)\] = [ A ; B ]
  println("[ A ; B ] = " D)
  C: Array[\RR64,(ZZ32,ZZ32)\] = [ A B ]
  println("[ A B ] = " C)
end
end

component SkZilchLocal
export Executable

stopz(s: String): Zilch = do
    println("stopz: " s)
    throw FailCalled(s)
  end

guard(x: ZZ32): ZZ32 = if x > 0 then x else stopz("not positive") end
pair(x: ZZ32): (ZZ32, ZZ32) = if x > 0 then (x, x) else stopz("no pair") end

run(): () = do
    println(guard(4))
    println(pair(2))
    try
        println(guard(0))
    catch e
        FailCalled => println("caught")
    end
    try
        println(pair(0))
    catch e
        FailCalled => println("caught pair")
    end
    println("end")
  end

end

(* MicroGptApl -- microGPT as APL text, line for line against
   explorations/apl/reference/hsu-flat/microgpt_concise.dyalog (L6-L30), inside
   apl⦇ … ⦈ over explorations/apl/base, expanding into what Run C4 writes by
   hand (explorations/run-c4/src/MicroGptFlat.fss).  The design, with the
   line-by-line table, is DESIGN.md beside this file; the probes that settled
   its open questions are probes/PROBES.md.  C4's array vocabulary FlatArrays
   and its loaders FlatData are imported unchanged.
   Run from explorations/apl/microgpt: the paths are relative. *)
component MicroGptApl
export MicroGptApl
export Executable
import AplCore.{...}
import AplSyntax.{...}
import FlatArrays.{...}
import FlatData.{...}
import System.{...}

(* ------------------------------------------------------------ L6: ⎕IO←0 is
   the base's own index origin; the two hyperparameter lines are host, because
   a top level has no rest for a binding to be the body of *)
(Ne, Blk, Nh, Hd, Vs, Bos) = (16.0, 16.0, 4.0, 4.0, 27.0, 26.0)
(Eps, Lr0, B1, B2, Epsa, Nsteps) = (10.0^(-5), 0.01, 0.85, 0.99, 10.0^(-8), 1000.0)
(corpusPath, weightsDir) = ("../reference/dzaima/docs.txt", "../reference/dzaima/w")

(* ------------------------------------------------------ L7, L8: the four
   vector functions and the causal mask, as APL text *)
rmsn = apl⦇ {⍵÷(Eps+(+/⍵*2)÷≢⍵)*0.5} ⦈
sm = apl⦇ {e←*⍵-⌈/⍵ ⋄ e÷+/e} ⦈
Mk = apl⦇ (-10*10)×~(⍳Blk)∘.≥⍳Blk ⦈
rmsn_b = apl⦇ {r←(Eps+(+/⍵*2)÷≢⍵)*0.5 ⋄ y←⍵÷r ⋄ (⍺-y×(+/y×⍺)÷≢y)÷r} ⦈
sm_b = apl⦇ {⍺×⍵-+/⍺×⍵} ⦈

(* ---------------------------------------------------------- L9, L11: the
   layout table SHP CNT OFF and the view v are host -- a vector of pairs is a
   nested array -- and C4's layout functions are their replacement *)
matName(i: ZZ32): String =
    if i = 0 then "wte" elif i = 1 then "wpe" elif i = 2 then "lm_head" elif i = 3 then "attn_wq" elif i = 4 then "attn_wk"
    elif i = 5 then "attn_wv" elif i = 6 then "attn_wo" elif i = 7 then "mlp_fc1" else "mlp_fc2" end
matShape(i: ZZ32): (ZZ32, ZZ32) =
    if (i = 0) OR (i = 2) then (aplInt(Vs), aplInt(Ne)) elif i = 7 then (4 aplInt(Ne), aplInt(Ne)) elif i = 8 then (aplInt(Ne), 4 aplInt(Ne)) else (aplInt(Ne), aplInt(Ne)) end
matCount(i: ZZ32): ZZ32 = do (r, c) = matShape(i); r c end
matOffset(i: ZZ32): ZZ32 = SUM[j <- 0#i] matCount(j)
nParams(): ZZ32 = matOffset(9)
view(p: Array[\RR64,ZZ32\], i: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] = do (r, c) = matShape(i); view(p, matOffset(i), r, c) end

(* ------------------------------------------------------------- L12: the
   corpus.  Characters and ⎕A are outside the sub-language, so the corpus is
   C4's; its two integer arrays are converted ONCE here, in host code, because
   ⍎( … ) cannot stand on the right-hand side of a binding. *)
aplOfInt[\nat s\](v: Vector[\ZZ32,s\]): Array[\RR64,ZZ32\] =
    aplVec(|v|, fn (i: ZZ32): RR64 => 1.0 v[i])
aplOfInt[\nat r, nat c\](m: Matrix[\ZZ32,r,c\]): Array[\RR64,(ZZ32,ZZ32)\] = do
    (nr, nc) = m.sizes
    aplMat(nr, nc, fn (i: ZZ32, j: ZZ32): RR64 => 1.0 m[i,j])
  end
corpus: Corpus = loadCorpus(corpusPath, aplInt(Blk), aplInt(Bos))
Tokm = aplOfInt(corpus.tokm)
Len = aplOfInt(corpus.len)

(* ------------------------------------------- L13-L28: STEP, one APL block.
   The keys arrive as ZZ32 and are converted before the block; the three host
   adapters vw h u have the dfn calling shape (a zero-parameter lambda that
   reads ⍵ off the frame stack), because a view of the flat vector, rank 4 and
   its inverse are outside the sub-language.  Every statement ends in ⋄ : a
   line break does not separate two statements when the next line can continue
   the one above, and the program's strand names are exactly the ones that
   continue a line. *)
step(P: Array[\RR64,ZZ32\], b: Array[\ZZ32,ZZ32\]): (RR64, Array[\RR64,ZZ32\]) = do
    bb = aplOfInt(b)
    vw = fn (): Any => view(P, aplInt(aplOmega()))
    h = fn (): Any => heads(aplOmega(), aplInt(Blk), aplInt(Nh), aplInt(Hd))
    u = fn (): Any => unheads(aplOmega(), aplInt(Nh))
    apl⦇ B←≢bb ⋄ N←B×Blk ⋄ R←Tokm[bb;] ⋄ ids←,R[;⍳Blk] ⋄ tg←,R[;1+⍳Blk] ⋄ vm←,Len[bb]∘.>⍳Blk ⋄ nv←+/vm ⋄ pos←N⍴⍳Blk ⋄
      wte wpe lm wq wk wv wo f1 f2←vw¨⍳9 ⋄
      X←wte[ids;]+wpe[pos;] ⋄ Xp←rmsn⍤1⊢X ⋄ X1←rmsn⍤1⊢Xp ⋄
      Q K Vv←{X1+.×⍉⍵}¨wq wk wv ⋄ Qh Kh Vh←h¨Q K Vv ⋄
      A←sm⍤1⊢Mk+⍤2⊢(Qh+.×⍤2⊢⍉⍤2⊢Kh)÷Hd*0.5 ⋄ Hc←u A+.×⍤2⊢Vh ⋄
      X2←Xp+Hc+.×⍉wo ⋄ X3←rmsn⍤1⊢X2 ⋄ M0←X3+.×⍉f1 ⋄ Mr←0⌈M0 ⋄ X4←X2+Mr+.×⍉f2 ⋄
      Pr←sm⍤1⊢X4+.×⍉lm ⋄ loss←-(+/vm×⍟tg⌷⍤0 1⊢Pr)÷nv ⋄
      dL←(vm÷nv)×⍤0 1⊢Pr-tg∘.=⍳Vs ⋄ gLM←(⍉dL)+.×X4 ⋄ dX4←dL+.×lm ⋄
      gF2←(⍉dX4)+.×Mr ⋄ dM0←(dX4+.×f2)×M0>0 ⋄ gF1←(⍉dM0)+.×X3 ⋄ dX3←dM0+.×f1 ⋄
      dX2←dX4+dX3(rmsn_b⍤1)X2 ⋄ gWO←(⍉dX2)+.×Hc ⋄ dH←h dX2+.×wo ⋄
      dVh←(⍉⍤2⊢A)+.×⍤2⊢dH ⋄ dS←(A(sm_b⍤1)dH+.×⍤2⊢⍉⍤2⊢Vh)÷Hd*0.5 ⋄
      dQh←dS+.×⍤2⊢Kh ⋄ dKh←(⍉⍤2⊢dS)+.×⍤2⊢Qh ⋄ dQ dK dV←u¨dQh dKh dVh ⋄
      gWQ gWK gWV←{(⍉⍵)+.×X1}¨dQ dK dV ⋄ dX1←(dQ+.×wq)+(dK+.×wk)+dV+.×wv ⋄
      dXp←dX2+dX1(rmsn_b⍤1)Xp ⋄ dX←dXp(rmsn_b⍤1)X ⋄
      gWTE←(⍉ids∘.=⍳Vs)+.×dX ⋄ gWPE←(⍉pos∘.=⍳Blk)+.×dX ⋄
      gr←⊃,/,¨gWTE gWPE gLM gWQ gWK gWV gWO gF1 gF2 ⋄ loss gr ⦈
  end

(* ------------------------------------------------------------ L29: ADAM.
   ∘← (a write to an outer name) has no rule and C4 returns the new state, so
   the three modified assignments are three bindings and a three-name strand.
   The step counter is converted to an APL number before the block. *)
adam(P: Array[\RR64,ZZ32\], M: Array[\RR64,ZZ32\], V: Array[\RR64,ZZ32\], gr: Array[\RR64,ZZ32\], ti: ZZ32, lr: RR64):
    (Array[\RR64,ZZ32\], Array[\RR64,ZZ32\], Array[\RR64,ZZ32\]) = do
    t = 1.0 ti
    apl⦇ Mn←(B1×M)+(1-B1)×gr ⋄ Vn←(B2×V)+(1-B2)×gr*2 ⋄ Pn←P-lr×(Mn÷1-B1*t)÷Epsa+(Vn÷1-B2*t)*0.5 ⋄ Pn Mn Vn ⦈
  end

(* ----------------------------------------------- L30: the schedule is APL,
   the loop is host -- it threads Adam's state, which the sub-language cannot
   write to an outer name *)
learningRate(s: ZZ32): RR64 = do sf = 1.0 s; apl⦇ Lr0×1-sf÷Nsteps ⦈ end

run(): () = do
    println "microgpt apl | params " nParams() " | corpus " corpus.size() " x " (aplInt(Blk) + 1) " | batch 1, 5 steps"
    bsz = 1
    p: Array[\RR64,ZZ32\] := loadParams(weightsDir, matName, 9, nParams())
    m: Array[\RR64,ZZ32\] := zeros(nParams())
    v: Array[\RR64,ZZ32\] := zeros(nParams())
    for s <- seq(0#5) do
        t0 = nanoTime()
        (l, g) = step(p, keys(bsz, fn (i: ZZ32): ZZ32 => (s bsz + i) MOD corpus.size()))
        (p, m, v) := adam(p, m, v, g, s + 1, learningRate(s))
        println "step " (s + 1) " loss " l "  (" ((nanoTime() - t0) DIV 1000000) " ms)"
    end
  end
end

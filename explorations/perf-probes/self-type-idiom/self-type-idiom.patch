diff --git a/ProjectFortress/src/com/sun/fortress/interpreter/evaluator/BuildEnvironments.java b/ProjectFortress/src/com/sun/fortress/interpreter/evaluator/BuildEnvironments.java
index f64e6986c..e58429b54 100644
--- a/ProjectFortress/src/com/sun/fortress/interpreter/evaluator/BuildEnvironments.java
+++ b/ProjectFortress/src/com/sun/fortress/interpreter/evaluator/BuildEnvironments.java
@@ -922,7 +922,12 @@ public class BuildEnvironments extends NodeAbstractVisitor<Boolean> {
         Option<List<NamedType>> comprs = NodeUtil.getComprisesClause(x);
         if (!comprs.isNone()) {
             List<FType> c = et.getFTypeListFromList(comprs.unwrap());
-            ftt.setComprises(Useful.<FType>set(c));
+            // A type variable listed in the clause, as T in comprises T, is a symbolic type
+            // in the generic's own symbolic instance: it is left out there, so that exclusion
+            // does not recur through the variable's bound, the trait itself.
+            List<FType> listed = new ArrayList<FType>();
+            for (FType f : c) if (!(f instanceof SymbolicType)) listed.add(f);
+            if (!listed.isEmpty() || c.isEmpty()) ftt.setComprises(Useful.<FType>set(listed));
         }
         //List<Decl> fns = NodeUtil.getDecls(x);
 
diff --git a/ProjectFortress/tests/ComprisesOwnTypeParameter.fss b/ProjectFortress/tests/ComprisesOwnTypeParameter.fss
new file mode 100644
index 000000000..2931e13e6
--- /dev/null
+++ b/ProjectFortress/tests/ComprisesOwnTypeParameter.fss
@@ -0,0 +1,26 @@
+(* Under walk, a trait that lists its own type parameter in its comprises clause loads, with overloads over it beside other types. *)
+component ComprisesOwnTypeParameter
+export Executable
+
+trait Selfish[\T extends Selfish[\T\]\] comprises T
+    tag(self): String = "selfish"
+end
+
+trait Sample extends Selfish[\Sample\] comprises { S } end
+object S extends Sample end
+
+kind(x: Selfish[\Sample\]): String = "selfish"
+kind(x: String): String = "string"
+
+pair[\T extends Selfish[\T\]\](x: T, y: ZZ32): String = "generic"
+pair(x: String, y: String): String = "strings"
+
+run(): () = do
+    assert(tag(S), "selfish", "tag(S)")
+    assert(kind(S), "selfish", "kind(S)")
+    assert(kind("a"), "string", "kind of a string")
+    assert(pair(S, 1), "generic", "pair(S, 1)")
+    assert(pair("a", "b"), "strings", "pair of strings")
+end
+
+end

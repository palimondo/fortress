(* The same local mutable arrow variable, assigned from inside a `for` body, so
   that it is captured by a nested code-generation context
   (MutableTaskVarCodeGen). *)
component P16LocalArrowTask
export Executable
run(): () = do
    var f: ZZ32 -> ZZ32 := fn (x: ZZ32): ZZ32 => x + 1
    for i <- 1#1 do
        f := fn (x: ZZ32): ZZ32 => x + 2
    end
    println("f(1) = " f(1) " expected 3")
  end
end

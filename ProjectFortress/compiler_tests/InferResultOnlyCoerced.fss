(* A type parameter only the result mentions, of a generic declaration chosen with coercion, takes its bound and the call runs; ledger row 447. *)
component InferResultOnlyCoerced
export Executable

trait N
  getter n(): ZZ32
end
object NOf(k: ZZ32) extends N
  getter n(): ZZ32 = k
end
trait W2 excludes { N }
  coerce(x: N) = W2Of(x.n)
end
trait W1 extends W2
  coerce(x: N) = W1Of(x.n)
end
object W2Of(k: ZZ32) extends W2 end
object W1Of(k: ZZ32) extends W1 end
object BoxT[\T\](v: ZZ32) end

q[\T\](x: W1): BoxT[\T\] = BoxT[\T\](1)
q(x: W2): Any = "q(W2)"

describe(x: Any): String = typecase x of
    String => "q(W2)"
    BoxT[\ZZ32\] => "BoxT[ZZ32]"
    else => "other"
  end

run(): () = do
    d = describe(q(NOf(1)))
    println("q: " || d)
    assert(d, "other", "q(NOf(1)) runs the generic q, applicable with coercion and more specific than q(W2), at the bound of T, which nothing at the call fixes: its result is neither the String of q(W2) nor a BoxT[ZZ32]; Specification/basic/inference.tex, section \"The Static Arguments of a Call\"")
    println("PASS")
  end

end

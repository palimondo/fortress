(* A shift's count of any integer type as a ZZ32, for the shifts of an NN32: a
   count beyond the ZZ32 range saturates at 2^31-1 in magnitude. *)
private countNN32(b:AnyIntegral):ZZ32 =
    typecase b of
        c:ZZ32 => c
        c:ZZ64 => narrow((c MAX (-2147483647)) MIN 2147483647)
        c:NN32 => do m:ZZ32 = 2147483647; signed(c MIN unsigned(m)) end
        c:NN64 => do m:ZZ64 = 2147483647; narrow(signed(c MIN unsigned(m))) end
        c:ZZ => narrow((c MAX (-2147483647)) MIN 2147483647)
    end

(* A power's exponent of any integer type as a ZZ32 of its sign, for the power
   of an NN32: beyond the ZZ32 range it keeps its parity. *)
private exponentNN32(b:AnyIntegral):ZZ32 =
    typecase b of
        c:ZZ32 => c
        c:ZZ64 => if c > 2147483647 then (if odd(c) then 2147483647 else 2147483646 end)
                  elif c < -2147483647 - 1 then (if odd(c) then -2147483647 else -2147483647 - 1 end)
                  else narrow(c) end
        c:NN32 => do s:ZZ32 = signed(c); if s >= 0 then s elif odd(c) then 2147483647 else 2147483646 end end
        c:NN64 => do
                    s:ZZ64 = signed(c)
                    if s < 0 OR: s > 2147483647 then (if odd(c) then 2147483647 else 2147483646 end)
                    else narrow(s) end
                  end
        c:ZZ => if c > 2147483647 then (if odd(c) then 2147483647 else 2147483646 end)
                elif c < -2147483647 - 1 then (if odd(c) then -2147483647 else -2147483647 - 1 end)
                else narrow(c) end
    end

value object NN32 extends { AnyIntegral, Integral[\NN32\] }
    coerce(x: IntLiteral) = x.asNN32
    getter zero(): Number = unsigned(0)
    getter one(): Number = unsigned(1)
    getter asString(): String =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedIntArith.unsignedIntToString")
    getter asExprString(): String =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedIntArith.unsignedIntToString")

    asFloat(self): RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedIntArith.unsignedIntToDouble")

    opr |self| : NN32 = self
    opr =(self, b:NN32):Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedIntArith.unsignedIntEQ")
    opr =(self, b:IntLiteral):Boolean = do c: NN32 = b; (self = c) end
    opr =(self, b:QQ):Boolean = do c: QQ = self; (c = b) end
    opr =(self, b:ZZ):Boolean = do c: ZZ = self; (c = b) end
    opr =(self, b:ZZ64):Boolean = do c: ZZ64 = self; (c = b) end
    opr =(self, b:NN64):Boolean = do c: NN64 = self; (c = b) end
    opr <(self, b:NN32):Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedIntArith.unsignedIntLT")
    opr >(self, b:NN32):Boolean = b < self
    opr >=(self, b:NN32):Boolean = NOT (self < b)
    opr <=(self, b:NN32):Boolean = NOT (b < self)
    opr CMP(self, b:NN32): TotalComparison =
        if self < b then LessThan
        elif b < self then GreaterThan
        else EqualTo end
    opr MIN(self, other:NN32): NN32 = if other < self then other else self end
    opr MAX(self, other:NN32): NN32 = if other < self then self else other end
    opr MINMAX(self, other:NN32): (NN32, NN32) =

(* Under the one library's selection, a function with a varargs parameter compiles, with its calls of none, one and three arguments, of arguments that fork and of a tuple's elements. *)
component OneLibraryVarargsCount
export Executable

count(xs: ZZ32...): ZZ32 = |xs|

run(): () = do
  println("REACHED")
  println(count() + count(4) + count(4, 5, 6))
  println(count(count(4), count(5, 6)))
  t: (ZZ32, ZZ32) = (4, 5)
  println(count(t))
end

end

(* A lone type parameter bounded by Any with no narrowest argument type is instantiated at Any, so pick0 at a ZZ64 and an RR64 is a BoxT[Any]; ledger row 516. *)
component InferLoneUnbounded
export Executable

object BoxT[\T extends Any\]() end

pick0[\T extends Any\](x: T, y: T): BoxT[\T\] = BoxT[\T\]()
same[\T extends Any\](a: BoxT[\T\], b: BoxT[\T\]): String = "same"

run(): () = do
  w: ZZ64 = 4
  r: RR64 = 2.5
  a: BoxT[\Any\] = BoxT[\Any\]()
  assert(same(pick0(w, r), a), "same", "pick0 at a ZZ64 and an RR64, with nothing expected of its result, is a BoxT[Any], an instance at its bound Any; Specification/basic/inference.tex, section \"The Static Arguments of a Call\"")
  println("PASS")
end

end

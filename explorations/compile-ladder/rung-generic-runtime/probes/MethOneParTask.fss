component MethOneParTask
export Executable

(* Row 420's control: the method's own parameter alone, but both operands of || built over
   it, so the parallelism analyzer runs the second operand as a task. *)
object BoxT[\T\](v: ZZ32) end
which(x: Any): String = typecase x of BoxT[\String\] => "string"; BoxT[\ZZ32\] => "zz32"; else => "other" end
object G[\T\](v: ZZ32)
  m[\U\](b: BoxT[\U\]): String = which(BoxT[\U\](1)) || which(BoxT[\U\](2))
end
run() = println(G[\String\](0).m[\ZZ32\](BoxT[\ZZ32\](0)))
end

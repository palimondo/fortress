component pExtLit
export Executable
(* A control for probe 1 of ../size-rung-probes.md: the third place that
   makes a size literal's descriptor, a literal size in an extends clause
   (../size-probes/extends-b.patch), which none of the eight programs of the
   size probes and the size cost reaches.  The library has the shape: trait
   Rank1 extends { Rank[\1\] } (Library/FortressLibrary.fsi:1077, Rank2 at
   :1080).  The arm generic in k finds its size in a supertype of the value.
   The first two calls are resolved by the checker, the last three are
   dispatched. *)
trait Rnk[\nat k\] end
trait Rnk1 extends Rnk[\1\] end
trait Rnk2 extends Rnk[\2\] end
object Vec[\T, nat s\](x: T) extends Rnk1 end
object Mat[\T, nat r, nat c\](x: T) extends Rnk2 end
rank[\nat k\](x: Rnk[\k\]): () = println(k)
rank(x: Any): () = println(-1)
run() = do
  v: Vec[\RR64,3\] = Vec[\RR64,3\](2.5)
  m: Mat[\RR64,2,4\] = Mat[\RR64,2,4\](2.5)
  rank(v)
  rank(m)
  a: Any = v
  rank(a)
  b: Any = m
  rank(b)
  c: Any = 2.5
  rank(c)
end
end

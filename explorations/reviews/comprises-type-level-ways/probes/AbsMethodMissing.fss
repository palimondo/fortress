component AbsMethodMissing
export Executable

(* AbsMethodBetween without the definition for the listed type P.  Only N.name(O) is called. *)

trait A comprises { O, P } end
trait Gen[\X\] extends A end
object O extends Gen[\ZZ32\] end
object P extends Gen[\String\] end

trait Namer
    name(a: A): String
end
object N extends Namer
    name(o: O): String = "O"
end

run(): () =
    if N.name(O) = "O" then println("PASS") else println("FAIL") end
end

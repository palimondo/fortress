component IntegerMaxNumMinNum
export Executable

(*) MAXNUM and MINNUM over the integer types answer at the type the arguments promote to; row 517.

shown(v: Any): String =
  typecase v of
    ZZ32 => v.asString || " : ZZ32"
    ZZ64 => v.asString || " : ZZ64"
    NN32 => v.asString || " : NN32"
    NN64 => v.asString || " : NN64"
    ZZ => v.asString || " : ZZ"
    QQ => v.asString || " : QQ"
    RR64 => v.asString || " : RR64"
    else => v.asString || " : another type"
  end

run(): () = do
    b: ZZ64 = widen(3)
    assert(shown(b MAXNUM 1), "3 : ZZ64", "basic-integers.tex, section \"Integers\", opr MAX, MIN, MAXNUM and MINNUM; conversions-coercions.tex, section \"Coercion Resolution\": ZZ64 MAXNUM a numeral")
    assert(shown(b MINNUM 1), "1 : ZZ64", "basic-integers.tex, section \"Integers\", opr MAX, MIN, MAXNUM and MINNUM; conversions-coercions.tex, section \"Coercion Resolution\": ZZ64 MINNUM a numeral")
    g: ZZ = big(3)
    assert(shown(g MAXNUM 1), "3 : ZZ", "basic-integers.tex, section \"Integers\", opr MAX, MIN, MAXNUM and MINNUM; conversions-coercions.tex, section \"Coercion Resolution\": ZZ MAXNUM a numeral")
    w: ZZ64 = widen(4)
    z: ZZ32 = 3
    assert(shown(w MAXNUM z), "4 : ZZ64", "basic-integers.tex, section \"Integers\", opr MAX, MIN, MAXNUM and MINNUM; conversions-coercions.tex, section \"Coercion Resolution\": ZZ64 MAXNUM ZZ32 at ZZ64")
    u: NN32 = unsigned(3)
    v: NN64 = unsigned(widen(4))
    assert(shown(v MAXNUM u), "4 : NN64", "basic-integers.tex, section \"Integers\", opr MAX, MIN, MAXNUM and MINNUM; conversions-coercions.tex, section \"Coercion Resolution\": NN64 MAXNUM NN32 at NN64")
    println "PASS"
  end

end

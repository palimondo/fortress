(* A generic functional method declared in a trait with static parameters and inherited by an object: the call runs the declaration and answers what its function argument returns. *)
component XXXGenericTraitGenericFunctionalMethod
export Executable

trait Gen[\E\]
    gen[\R\](self, x: E, f: E -> R): R = f(x)
end
object P(y: ZZ32) extends Gen[\ZZ32\]
end

run(): () = do
    p = P(3)
    println("REACHED")
    assert(gen[\String\](p, 3, fn (q: ZZ32): String => "gen"), "gen", "the inherited generic functional method runs")
    println("PASS")
end
end

component MinNumNN32
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    NN32 => "NN32"
    NN64 => "NN64"
    ZZ => "ZZ"
    QQ => "QQ"
    RR64 => "RR64"
    else => "other"
  end

run() = do
    b: NN32 = unsigned(3)
    r = b MIN 1
    println("b MIN 1 = " r " : " typeOf(r))
end

end

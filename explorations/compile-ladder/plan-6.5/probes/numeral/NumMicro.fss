(* NumMicro -- plan 6.5's numeral probe, the first programs: what a numeral is and does
   under walk once it is a value of the library's IntLiteral (the compiler library's model). *)
component NumMicro
export Executable

f32(x: ZZ32): String = "ZZ32 " x
f64(x: ZZ64): String = "ZZ64 " x
fR(x: RR64): String = "RR64 " x

run(): () = do
  println("7 is " (typecase 7 of ZZ32 => "a ZZ32"; IntLiteral => "an IntLiteral"; else => "other" end))
  println("3 + 4 = " (3 + 4))
  z: ZZ32 = 5
  println("z = " z " is " (typecase z of ZZ32 => "a ZZ32"; else => "other" end))
  println("z + 1 = " (z + 1))
  println(f32(6))
  println(f64(6))
  println(fR(6))
  w: ZZ64 = 3000000000
  println("w = " w)
  s: RR64 = 3000000000
  println("s = " s)
  println("sum over 0#4 = " (SUM[\ZZ32\][i <- 0#4] i))
  n: ZZ32 = 4
  for i <- seq(0#n) do print(i " ") end
  println()
  println("END")
end
end

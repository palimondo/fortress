component mgnative_a
import List.{...}
export Executable

(* microgpt-native design alternative A (explorations/microgpt-native.md):
   uniform tape node as in micrograd.fss, but with the papers' surface
   notation -- juxtaposition for multiplication, ^ for powers, prefix
   exp/log/relu, negation as its own primitive -- and summation as an
   n-ary Sum node built by BIG OPLUS over a list-concatenation monoid:
   construction may regroup freely (concat is exactly associative), the
   addends are folded once, in generator order, inside the node. *)

object V(var data: RR64, children: List[\V\], grads: List[\RR64\])
  var grad: RR64 := 0.0
  var visited: Boolean := false
  opr +(self, o: V): V = V(data + o.data, <|[\V\] self, o|>, <|[\RR64\] 1.0, 1.0|>)
  opr juxtaposition(self, o: V): V =
    V(data o.data, <|[\V\] self, o|>, <|[\RR64\] o.data, data|>)
  opr -(self): V = V(-data, <|[\V\] self|>, <|[\RR64\] -1.0|>)
  opr -(self, o: V): V = self + (-o)
  opr ^(self, n: RR64): V = V(data^n, <|[\V\] self|>, <|[\RR64\] n data^(n-1.0)|>)
end

konst(d: RR64): V = V(d, emptyList[\V\](), emptyList[\RR64\]())

exp(v: V): V = V(exp v.data, <|[\V\] v|>, <|[\RR64\] exp v.data|>)
log(v: V): V = V(log v.data, <|[\V\] v|>, <|[\RR64\] 1.0/v.data|>)
relu(v: V): V = if v.data > 0.0
                then V(v.data, <|[\V\] v|>, <|[\RR64\] 1.0|>)
                else V(0.0, <|[\V\] v|>, <|[\RR64\] 0.0|>) end

(* n-ary summation node: dSum/dAddend_i = 1.  The forward value is the
   one sequential fold, in list order, at the leaf. *)
vsum(addends: List[\V\]): V =
  V(SUM[a <- seq(addends)] a.data, addends, addends.map[\RR64\](fn a => 1.0))

(* BIG OPLUS[i <- g] expr: map each addend to a singleton list, join by
   concatenation (exactly associative -- parallel construction cannot
   perturb the result), lift the addend list into one Sum node. *)
object VConcat extends MonoidReduction[\List[\V\]\]
  getter asString(): String = "VConcat"
  empty(): List[\V\] = emptyList[\V\]()
  join(a: List[\V\], b: List[\V\]): List[\V\] = a || b
end

opr BIG OPLUS(): Comprehension[\V,V,List[\V\],List[\V\]\] =
  Comprehension[\V,V,List[\V\],List[\V\]\](fn l => vsum(l), VConcat,
                                           fn v => singleton[\V\](v))
opr BIG OPLUS(g: Generator[\V\]): V =
  __bigOperatorSugar[\V,V,List[\V\],List[\V\]\](BIG OPLUS(), g)

(* Reverse topological order, as in micrograd.fss *)
object Topo()
  var items: List[\V\] := emptyList[\V\]()
  build(v: V): () = do
    if NOT v.visited then
      v.visited := true
      for ch <- seq(v.children) do self.build(ch) end
      items := items.addRight(v)
    end
  end
end

backward(root: V): () = do
  t = Topo()
  t.build(root)
  root.grad := 1.0
  for v <- seq(t.items.reverse) do
    for (ch, lg) <- seq(v.children.zip[\RR64\](v.grads)) do
      ch.grad := ch.grad + lg v.grad
    end
  end
end

initW(i: ZZ32, j: ZZ32): RR64 = (((31 i + 17 j) REM 97) - 48) / 100.0

run() = do
  eps = 10.0^(-12)
  (* --- analytic golden checks, as in micrograd.fss --- *)
  a = konst(2.0); b = konst(3.0); c = konst(-4.0)
  f = relu(a b + c)                   (* f = relu(2 3 - 4) = 2 *)
  backward(f)
  assert(|f.data - 2.0| < eps, "f fwd")
  assert(|a.grad - 3.0| < eps, "df/da = b")
  assert(|b.grad - 2.0| < eps, "df/db = a")
  assert(|c.grad - 1.0| < eps, "df/dc = 1")

  a2 = konst(2.0); b2 = konst(3.0)
  g = log(a2^2.0 b2)                  (* g = ln(a^2 b); dg/da = 2/a; dg/db = 1/b *)
  backward(g)
  assert(|a2.grad - 1.0| < eps, "dg/da = 2/a = 1")
  assert(|b2.grad - (1.0/3.0)| < eps, "dg/db = 1/b")

  h0 = konst(0.5)
  h = (exp(-h0) + h0)^3.0             (* h = (e^-x + x)^3 *)
  backward(h)
  hd = (exp (-0.5)) + 0.5
  hg = 3.0 hd^2.0 (1.0 - (exp (-0.5)))
  assert(|h.data - hd^3.0| < eps, "h fwd")
  assert(|h0.grad - hg| < eps, "dh/dx")

  (* n-ary Sum: value and gradients *)
  s0 = konst(1.0); s1 = konst(2.0); s2 = konst(3.0)
  s = BIG OPLUS[t <- <|[\V\] s0, s1, s2|>] t t   (* sum of squares = 14 *)
  backward(s)
  assert(|s.data - 14.0| < eps, "sum fwd")
  assert(|s1.grad - 4.0| < eps, "d(sum t^2)/ds1 = 2 s1")
  println("golden gradient checks: PASS")

  (* --- tiny MLP on XOR: 2 -> 4 relu -> 1, summed squared error, SGD --- *)
  nH: ZZ32 = 4
  w1 = array[\V\](2 nH).fill(fn (k:ZZ32) => konst(initW(k DIV nH, k REM nH)))
  b1 = array[\V\](nH).fill(fn (k:ZZ32) => konst(initW(k, 13)))
  w2 = array[\V\](nH).fill(fn (k:ZZ32) => konst(initW(k + 7, 2 k + 3)))
  b2v = konst(0.0)

  x1s = array[\RR64\](4).fill(fn (k:ZZ32) => if k >= 2 then 1.0 else 0.0 end)
  x2s = array[\RR64\](4).fill(fn (k:ZZ32) => if k REM 2 = 1 then 1.0 else 0.0 end)
  ys  = array[\RR64\](4).fill(fn (k:ZZ32) => if (if k >= 2 then 1 else 0 end) + (k REM 2) = 1 then 1.0 else 0.0 end)

  (* the network, one definition: y(x) = b2 + SUM_j w2_j relu(w1_j x1 + w1_j' x2 + b1_j) *)
  yhat(xa: V, xb: V): V =
    b2v + (BIG OPLUS[j <- 0#nH] w2[j] relu(xa w1[j] + xb w1[nH+j] + b1[j]))

  params = (<|[\V\] w1[k] | k <- 0#(2 nH) |> || <|[\V\] b1[j] | j <- 0#nH |>
            || <|[\V\] w2[j] | j <- 0#nH |> || <|[\V\] b2v |>)

  lr = 0.05
  epochs: ZZ32 = 400
  var lastLoss: RR64 := 0.0
  t0 = nanoTime()
  for ep <- seq(1#epochs) do
    loss = BIG OPLUS[p <- 0#4] (yhat(konst(x1s[p]), konst(x2s[p])) - konst(ys[p]))^2.0
    backward(loss)
    lastLoss := loss.data
    for q <- params do
      q.data := q.data - lr q.grad
      q.grad := 0.0
      q.visited := false
    end
    if ep REM 100 = 0 then println("epoch " ep "  loss " lastLoss) end
  end
  t1 = nanoTime()
  assert(lastLoss < 0.05, "XOR loss should fall below 0.05, got " lastLoss)
  println("XOR MLP training: PASS (final loss " lastLoss ", "
          (((t1-t0) + 500000) DIV 1000000) " ms)")
end
end

(* The six mechanics decision D's diff rests on, one per function so that one failure hides no other. *)
component P7
import PScal.{...}
import NatReflect.{...}
export Executable
object Obj
  mk[\nat r\](): Vector[\ZZ32,r\] = vector[\ZZ32,r\](fn (i: ZZ32): ZZ32 => i)
end
mk2[\nat r\](): Vector[\ZZ32,r\] = vector[\ZZ32,r\](fn (i: ZZ32): ZZ32 => i)
mkw[\nat r\](_: N[\r\]): Vector[\ZZ32,r\] = vector[\ZZ32,r\](fn (i: ZZ32): ZZ32 => i)
twice[\nat s\](x: Vector[\RR64,s\]): Vector[\RR64,s\] = 2.0 x
rowsV[\nat r, nat c\](f: Vector[\RR64,c\] -> Vector[\RR64,c\], m: Matrix[\RR64,r,c\]): Matrix[\RR64,r,c\] = do
    out = matrix[\RR64,r,c\]()
    for i <- 0#r do
        y = f(vector[\RR64,c\](fn (j: ZZ32): RR64 => m[i,j]))
        for j <- 0#c do out[i,j] := y[j] end
    end
    out
  end
p7a[\nat s\](v: Vector[\RR64,s\], w: Vector[\RR64,s\]): Vector[\RR64,s\] = v + w
p7b[\nat s\](v: Vector[\RR64,s\], w: Vector[\RR64,s\]): Vector[\RR64,s\] = v - w
p7c[\nat s\](v: Vector[\RR64,s\]): Vector[\RR64,s\] = - v
p7d[\nat r, nat c\](v: Matrix[\RR64,r,c\], w: Matrix[\RR64,r,c\]): Matrix[\RR64,r,c\] = v - w
p7e[\nat r, nat c, nat k\](v: Matrix[\RR64,r,c\], w: Matrix[\RR64,c,k\]): Matrix[\RR64,r,k\] = v w
p7f[\nat s\](v: Vector[\RR64,s\]): RR64 = SUM v
p7g[\nat s\](v: Vector[\RR64,s\]): RR64 = BIG MAX v
p7h[\nat s\](v: Vector[\RR64,s\]): Vector[\RR64,s\] = do for i <- 0#s do v.assign(fn (j: ZZ32): RR64 => 1.0) end; v end
p7i[\nat s\](v: Vector[\RR64,s\]): ZZ32 = |v|
run(): () = do v7 = p7a(vector[\RR64,2\](1.0), vector[\RR64,2\](2.0)); println("P7 " v7[0] " " p7f(v7) " " p7g(v7) " " p7i(v7)) end
end

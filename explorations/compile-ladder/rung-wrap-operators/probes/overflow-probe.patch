diff -ru a/ProjectFortress/src/com/sun/fortress/interpreter/glue/prim/NN32.java b/ProjectFortress/src/com/sun/fortress/interpreter/glue/prim/NN32.java
--- a/ProjectFortress/src/com/sun/fortress/interpreter/glue/prim/NN32.java	2026-09-26 11:18:46.905957860 +0000
+++ b/ProjectFortress/src/com/sun/fortress/interpreter/glue/prim/NN32.java	2026-09-26 11:18:46.953251002 +0000
@@ -102,24 +102,28 @@
 
     public static final class Negate extends N2N {
         protected int f(int x) {
+            if (x != 0) Int.probe("NN32$Negate", x & 0xffffffffL, 0);
             return Unsigned.subtract(0, x);
         }
     }
 
     public static final class Add extends NN2N {
         protected int f(int x, int y) {
+            if ((((x & 0xffffffffL) + (y & 0xffffffffL)) >>> 32) != 0) Int.probe("NN32$Add", x & 0xffffffffL, y & 0xffffffffL);
             return Unsigned.add(x, y);
         }
     }
 
     public static final class Sub extends NN2N {
         protected int f(int x, int y) {
+            if (Integer.compareUnsigned(x, y) < 0) Int.probe("NN32$Sub", x & 0xffffffffL, y & 0xffffffffL);
             return Unsigned.subtract(x, y);
         }
     }
 
     public static final class Mul extends NN2N {
         protected int f(int x, int y) {
+            if ((((x & 0xffffffffL) * (y & 0xffffffffL)) >>> 32) != 0) Int.probe("NN32$Mul", x & 0xffffffffL, y & 0xffffffffL);
             return Unsigned.multiplyToInt(x, y);
         }
     }

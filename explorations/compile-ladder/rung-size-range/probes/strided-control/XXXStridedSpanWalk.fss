component XXXStridedSpanWalk
export Executable

run(): () = do
    println("REACHED")
    zMax: ZZ32 = 2147483647
    zMin: ZZ32 = -zMax - 1
    emptyAcross = 10:1:1
    assert(|emptyAcross|, 0, "a strided range whose elements all fit, empty, across the bounds; ranges.tex:68-70, :140-143")
    wideStride = 1:10:3
    assert(|wideStride|, 4, "a strided range whose elements all fit, spanning more than ZZ32's maximum; ranges.tex:68-70, :140-143")
    println("PASS")
  end

end

(* A trait method with a varargs parameter called with none, one and six varargs arguments type checks (functions.tex, section "Function Applications"); code generation stops on the method's varargs parameter. *)
component XXXVarargsMethodCodeGeneration
export Executable

trait Tagger
    tag(x: String, rest: ZZ32...): String = x
end

object T extends Tagger end

run(): () = do
    z: ZZ32 = 1
    println(T.tag("a") T.tag("b", z) T.tag("c", z, z, z, z, z, z))
  end

end

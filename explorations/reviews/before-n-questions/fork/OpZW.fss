component OpZW
export Executable
(* Probe K's fork (PROBE-K.md section 6, the second item) on the compiled path:
   a generic arm beside a plain arm over Number, called with a ZZ32 and a ZZ64. *)
op[\T extends Number\](a: T, b: T): String = "op generic[" (typeOf a) "," (typeOf b) "]"
op(a: Number, b: Number): String = "op plain[" (typeOf a) "," (typeOf b) "]"
typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    else => "other"
  end
run(): () = do
    z: ZZ32 = 3
    w: ZZ64 = 4
    println("op(z, w): " op(z, w))
  end
end

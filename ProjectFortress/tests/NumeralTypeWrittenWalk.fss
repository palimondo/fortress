(* A numeral type is written only as a parameter's type: an object that extends one, and a numeral type as a static argument, are refused. *)
component NumeralTypeWrittenWalk
export Executable

object O extends NaturalNumeral[\1, 10, 3\] end
object Wrap[\T\](w: ZZ32) end

run(): () = do
    c = Wrap[\NaturalNumeral[\1, 10, 3\]\](3)
    println("REACHED: an object extends a numeral type, and a numeral type is a static argument")
  end

end

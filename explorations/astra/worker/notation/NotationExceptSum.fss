component NotationExceptSum
import FortressLibrary.{...} except { opr BIG + }
export Executable

object D(v:RR64, d:RR64)
end
opr +(x:D, y:D):D = D(x.v+y.v, x.d+y.d)
object DSumReduction extends CommutativeMonoidReduction[\D\]
  empty():D = D(0.0,0.0)
  join(x:D,y:D):D = x+y
end
opr SUM(): Comprehension[\D,D,D,D\] =
  Comprehension[\D,D,D,D\](fn (x:D) => x, DSumReduction, fn (x:D) => x)

run():() = do
  s:D = SUM[i <- 1#4] D(1.0 i, 1.0)
  println(s.v)
  println(s.d)
end
end

+/*******************************************************************************
+ A builtinPrimitive whose string names a static Java method ("pkg.Class.method")
+ rather than a glue class: the method is called directly, each argument unboxed
+ and the result boxed by its Java type (ForeignNativeApp's conversions).  A
+ top-level function passes its arguments; a method or functional method passes
+ self first.
+ ******************************************************************************/
+
+package com.sun.fortress.interpreter.glue;
+
+import static com.sun.fortress.exceptions.ProgramError.error;
+import com.sun.fortress.interpreter.evaluator.values.FObject;
+import com.sun.fortress.interpreter.evaluator.values.FValue;
+import com.sun.fortress.nodes.Applicable;
+import com.sun.fortress.nodes_util.NodeUtil;
+
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.List;
+
+public class StaticNativeApp extends NativeMeth {
+    private final Method m;
+    private final Class<?>[] ps;
+    private int arity;
+
+    /** The static method named by s, or null when s names none. */
+    static Method find(String s, int nparams) {
+        int dot = s.lastIndexOf('.');
+        if (dot < 0) return null;
+        try {
+            Class<?> c = Class.forName(s.substring(0, dot));
+            for (Method m : c.getMethods())
+                if (m.getName().equals(s.substring(dot + 1)) && java.lang.reflect.Modifier.isStatic(m.getModifiers())
+                    && (m.getParameterCount() == nparams || m.getParameterCount() == nparams + 1)) return m;
+        }
+        catch (ClassNotFoundException e) { }
+        return null;
+    }
+
+    StaticNativeApp(Method m) { this.m = m; this.ps = m.getParameterTypes(); }
+
+    public int getArity() { return arity; }
+
+    protected void init(Applicable app, boolean isFunctionalMethod) {
+        arity = NodeUtil.getParams(app).size() - (isFunctionalMethod ? 1 : 0);
+        super.init(app, isFunctionalMethod);
+    }
+
+    public FValue applyToArgs(List<FValue> args) { return call(args); }
+
+    public FValue applyMethod(FObject self, List<FValue> args) {
+        List<FValue> all = new ArrayList<FValue>(args.size() + 1);
+        all.add(self);
+        all.addAll(args);
+        return call(all);
+    }
+
+    private FValue call(List<FValue> args) {
+        if (args.size() != ps.length) return error("Native " + m + " given " + args.size() + " arguments");
+        Object[] xs = new Object[ps.length];
+        for (int i = 0; i < ps.length; i++) xs[i] = ForeignNativeApp.unbox(ps[i], args.get(i));
+        try {
+            return ForeignNativeApp.box(m.getReturnType(), m.invoke(null, xs));
+        }
+        catch (InvocationTargetException e) {
+            Throwable t = e.getCause();
+            if (t instanceof RuntimeException) throw (RuntimeException) t;
+            if (t instanceof Error) throw (Error) t;
+            return error(t.toString());
+        }
+        catch (IllegalAccessException e) {
+            return error(e.toString());
+        }
+    }
+}

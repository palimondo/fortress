(* Char's comparisons, Unicode queries and case maps bound to nativeHelpers keep their values under walk, on ASCII and on characters past U+00FF and U+FFFF. *)
component NativeHelperFamilyCharWalk
export Executable

run():() = do
  sigma = char(931)
  sigmaLower = char(963)
  longI = char(66560)
  longILower = char(66600)
  high = char(55296)
  low = char(56320)
  dz = char(453)
  dzUpper = char(452)
  dzLower = char(454)
  unassigned = char(888)
  nul = char(0)
  newline = char(10)
  assert('a'.asString, "a", "asString of a letter")
  assert('7'.asString, "7", "asString of a digit")
  assert(' '.asString, " ", "asString of a space")
  assert(sigma.asString = "Σ", true, "asString past U+00FF")
  assert(dz.asString = "ǅ", true, "asString of a title-case letter")
  assert('a' = 'a', true, "=")
  assert('a' = 'A', false, "= unequal")
  assert(longI = char(66560), true, "= past U+FFFF")
  assert(high = low, false, "= of two surrogates")
  assert('A' < 'a', true, "<")
  assert('a' < 'Z', false, "< not")
  assert(sigma < longI, true, "< past U+FFFF")
  assert(high < low, true, "< of two surrogates")
  assert('a' SIMEQ 'A', true, "SIMEQ")
  assert('a' SIMEQ 'b', false, "SIMEQ not")
  assert(sigma SIMEQ sigmaLower, true, "SIMEQ past U+00FF")
  assert(longI SIMEQ longILower, true, "SIMEQ past U+FFFF")
  assert('a' NSIMEQ 'B', true, "NSIMEQ")
  assert('Z' NSIMEQ 'z', false, "NSIMEQ not")
  assert('a' LNSIM 'B', true, "LNSIM")
  assert('b' LNSIM 'A', false, "LNSIM not")
  assert('a' LNSIM 'A', false, "LNSIM of one letter")
  assert('A' LESSSIM 'a', true, "LESSSIM")
  assert('b' LESSSIM 'A', false, "LESSSIM not")
  assert('b' GNSIM 'A', true, "GNSIM")
  assert('a' GNSIM 'A', false, "GNSIM of one letter")
  assert('a' GTRSIM 'A', true, "GTRSIM")
  assert('A' GTRSIM 'b', false, "GTRSIM not")
  assert(digit('7').get, 7, "digit, through javaDigit")
  assert(digit('F', 16).get, 15, "digit radix 16, through javaDigit")
  assert(digit('z').isEmpty, true, "digit of a letter, through javaDigit")
  assert(digit(sigma).isEmpty, true, "digit past U+00FF, through javaDigit")
  assert(getDirectionality('a'), 0, "getDirectionality of a letter")
  assert(getDirectionality('7'), 3, "getDirectionality of a digit")
  assert(getDirectionality(' '), 12, "getDirectionality of a space")
  assert(getDirectionality(unassigned), -1, "getDirectionality of an unassigned code point")
  assert(getNumericValue('7'), 7, "getNumericValue of a digit")
  assert(getNumericValue('Z'), 35, "getNumericValue of a letter")
  assert(getNumericValue(' '), -1, "getNumericValue of a space")
  assert(getType('a'), 2, "getType of a lower-case letter")
  assert(getType('Z'), 1, "getType of an upper-case letter")
  assert(getType('7'), 9, "getType of a digit")
  assert(getType(' '), 12, "getType of a space")
  assert(getType(dz), 3, "getType of a title-case letter")
  assert(getType(high), 19, "getType of a surrogate")
  assert(getType(longI), 1, "getType past U+FFFF")
  assert(isDefined('a'), true, "isDefined")
  assert(isDefined(unassigned), false, "isDefined of an unassigned code point")
  assert(isDigit('7'), true, "isDigit")
  assert(isDigit('a'), false, "isDigit of a letter")
  assert(isFortressIdentifierPart('_'), true, "isFortressIdentifierPart of _")
  assert(isFortressIdentifierPart('7'), true, "isFortressIdentifierPart of a digit")
  assert(isFortressIdentifierPart(' '), false, "isFortressIdentifierPart of a space")
  assert(isFortressIdentifierStart('_'), true, "isFortressIdentifierStart of _")
  assert(isFortressIdentifierStart(sigma), true, "isFortressIdentifierStart past U+00FF")
  assert(isFortressIdentifierStart('7'), false, "isFortressIdentifierStart of a digit")
  assert(isHighSurrogate(high), true, "isHighSurrogate")
  assert(isHighSurrogate(low), false, "isHighSurrogate of a low surrogate")
  assert(isHighSurrogate(longI), false, "isHighSurrogate past U+FFFF")
  assert(isIdentifierIgnorable(nul), true, "isIdentifierIgnorable")
  assert(isIdentifierIgnorable('a'), false, "isIdentifierIgnorable of a letter")
  assert(isISOControl(newline), true, "isISOControl")
  assert(isISOControl('a'), false, "isISOControl of a letter")
  assert(isJavaIdentifierPart('$'), true, "isJavaIdentifierPart of $")
  assert(isJavaIdentifierPart('7'), true, "isJavaIdentifierPart of a digit")
  assert(isJavaIdentifierPart(' '), false, "isJavaIdentifierPart of a space")
  assert(isJavaIdentifierStart('$'), true, "isJavaIdentifierStart of $")
  assert(isJavaIdentifierStart('7'), false, "isJavaIdentifierStart of a digit")
  assert(isLetter(sigma), true, "isLetter past U+00FF")
  assert(isLetter(longI), true, "isLetter past U+FFFF")
  assert(isLetter('7'), false, "isLetter of a digit")
  assert(isLetterOrDigit('7'), true, "isLetterOrDigit")
  assert(isLetterOrDigit(' '), false, "isLetterOrDigit of a space")
  assert(isLowerCase('a'), true, "isLowerCase")
  assert(isLowerCase(longILower), true, "isLowerCase past U+FFFF")
  assert(isLowerCase('Z'), false, "isLowerCase of an upper-case letter")
  assert(isLowerCase(dz), false, "isLowerCase of a title-case letter")
  assert(isLowSurrogate(low), true, "isLowSurrogate")
  assert(isLowSurrogate(high), false, "isLowSurrogate of a high surrogate")
  assert(isMirrored('('), true, "isMirrored")
  assert(isMirrored('a'), false, "isMirrored of a letter")
  assert(isSpaceChar(' '), true, "isSpaceChar")
  assert(isSpaceChar(newline), false, "isSpaceChar of a newline")
  assert(isSupplementaryCodePoint(longI), true, "isSupplementaryCodePoint")
  assert(isSupplementaryCodePoint(sigma), false, "isSupplementaryCodePoint below U+FFFF")
  assert(isSurrogatePair(high, low), true, "isSurrogatePair")
  assert(isSurrogatePair(low, high), false, "isSurrogatePair reversed")
  assert(isTitleCase(dz), true, "isTitleCase")
  assert(isTitleCase('Z'), false, "isTitleCase of an upper-case letter")
  assert(isUnicodeIdentifierPart('7'), true, "isUnicodeIdentifierPart of a digit")
  assert(isUnicodeIdentifierPart(' '), false, "isUnicodeIdentifierPart of a space")
  assert(isUnicodeIdentifierStart(sigma), true, "isUnicodeIdentifierStart past U+00FF")
  assert(isUnicodeIdentifierStart('7'), false, "isUnicodeIdentifierStart of a digit")
  assert(isUpperCase('Z'), true, "isUpperCase")
  assert(isUpperCase(longI), true, "isUpperCase past U+FFFF")
  assert(isUpperCase('a'), false, "isUpperCase of a lower-case letter")
  assert(isValidCodePoint('a'), true, "isValidCodePoint")
  assert(isValidCodePoint(longI), true, "isValidCodePoint past U+FFFF")
  assert(isValidCodePoint(high), true, "isValidCodePoint of a surrogate")
  assert(isWhitespace(' '), true, "isWhitespace")
  assert(isWhitespace(newline), true, "isWhitespace of a newline")
  assert(isWhitespace('a'), false, "isWhitespace of a letter")
  assert(toLowerCase('Z') = 'z', true, "toLowerCase")
  assert(toLowerCase('7') = '7', true, "toLowerCase of a digit")
  assert(toLowerCase(sigma).codePoint, 963, "toLowerCase past U+00FF")
  assert(toLowerCase(longI).codePoint, 66600, "toLowerCase past U+FFFF")
  assert(toLowerCase(dz).codePoint, 454, "toLowerCase of a title-case letter")
  assert(toTitleCase('a') = 'A', true, "toTitleCase")
  assert(toTitleCase(dzLower).codePoint, 453, "toTitleCase of a lower-case digraph")
  assert(toTitleCase(dzUpper).codePoint, 453, "toTitleCase of an upper-case digraph")
  assert(toUpperCase('a') = 'A', true, "toUpperCase")
  assert(toUpperCase(' ') = ' ', true, "toUpperCase of a space")
  assert(toUpperCase(dz).codePoint, 452, "toUpperCase of a title-case letter")
  assert(toUpperCase(longILower).codePoint, 66560, "toUpperCase past U+FFFF")
end

end

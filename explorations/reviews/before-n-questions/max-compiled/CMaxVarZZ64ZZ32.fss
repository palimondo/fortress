component CMaxVarZZ64ZZ32
export Executable
(* A ZZ64 and a ZZ32 variable through MAX on the compiled path. *)
typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    IntLiteral => "IntLiteral"
    else => "other"
  end
run(): () = do
    w: ZZ64 = 4
    z: ZZ32 = 3
    r = w MAX z
    println("w MAX z = " r " : " typeOf(r))
  end
end

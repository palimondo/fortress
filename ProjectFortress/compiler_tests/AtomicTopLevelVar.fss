(* A mutable variable declared at the top level of a component, incremented
   inside `atomic do ... end` by the two implicit threads of a
   `do ... also do ... end` (Specification/basic/expressions/also.tex:17-21).

   Specification/basic/expressions/atomic.tex:38-42 requires the read and the
   write of `counter` to appear to occur in a single atomic step with respect to
   any action of a thread dynamically outside, so the two threads together must
   perform exactly 2 * iterations increments.  The shape follows
   compiler_tests/Compiled170.fss, which does the same with a local variable.

   The increment is in a top-level function rather than written out in the loop
   body because a nested code-generation context captures the variable instead
   of referring to it; that is the second half of this repair and
   compiler_tests/MutableTopLevelVarInLoop.fss covers it.

   At FORTRESS_THREADS=1 the two arms run one after the other
   (runtimeSystem/BaseTask.unsafeWorthSpawning, BaseTask.java:113-116, requires
   numThreads > 1), so at the thread count every gate target uses this program
   passes whether or not the implementation is correct.  It fails at
   FORTRESS_THREADS=4; the captured runs and the reason the gate cannot raise
   the thread count are in
   explorations/compile-ladder/repair-r1-atomic-static/REPORT.md. *)

component AtomicTopLevelVar
export Executable

counter: ZZ32 := 0

iterations: ZZ32 = 20000

bump(): () = atomic do counter := counter + 1 end

run(): () = do
    do
        for i <- 1#iterations do bump() end
    also do
        for i <- 1#iterations do bump() end
    end
    if counter = 2 iterations then
        println("PASS")
    else
        println("FAIL: counter = " counter " expected " (2 iterations))
    end
  end

end

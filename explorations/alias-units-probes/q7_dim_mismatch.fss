(* Q2 probe 7: the dimension CHECK, which is the whole point.
   Spec: Specification/basic/dimensions.tex:206-215 -- "certain programming
   errors may be detected at compile time.  When dimensioned values are added,
   subtracted, or compared, it is a static error if the units do not match."
   Here a RR64 Time value is passed where RR64 Length is declared.  If any
   dimension checking exists, this must be rejected. *)
component q7_dim_mismatch
export Executable

dim Length   SI_unit meter meters m_
dim Time     SI_unit second seconds s_

stride(d: RR64 Length): RR64 Length = d

run() = do
  t: RR64 Time = 5.0
  println("stride of a TIME = " stride(t))
end

end

(* PowProbe -- probe Q: a numeral exponent under the switch without device A, where a declaration
   reached by coercion answers instead of a refusal (RandomTest's 0#n^2).  One value per line. *)
component PowProbe
export Executable

ty(v: Any): String =
  typecase v of
    IntLiteral => v.asString || " : IntLiteral"
    ZZ32 => v.asString || " : ZZ32"
    ZZ64 => v.asString || " : ZZ64"
    RR64 => v.asString || " : RR64"
    QQ => v.asString || " : QQ"
    else => v.asString || " : other"
  end

run(): () = do
  z: ZZ32 = 3
  println("z^2 [9 : ZZ32]: " ty(z^2))
  w: ZZ64 = widen(3)
  println("w^2 [9 : ZZ64]: " ty(w^2))
  println("3^2 [9]: " ty(3^2))
  println("END")
end
end

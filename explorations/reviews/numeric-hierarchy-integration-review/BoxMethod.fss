component BoxMethod
export Executable

trait Wide excludes { Narrow }
  coerce(x: Narrow) = WideOf(x.small)
  getter big(): ZZ32
end
trait Narrow excludes { Wide }
  getter small(): ZZ32
end
object WideOf(b: ZZ32) extends Wide
  getter big(): ZZ32 = b
end
object NarrowOf(s: ZZ32) extends Narrow
  getter small(): ZZ32 = s
end

(* An invariant container with a non-generic method over its parameter. *)
object Box[\T\]()
  accept(x: T): T = x
end

(* The two top-level forwarders, the shape of the library's Matrix scalar
   product (Library/FortressLibrary.fss:2650-2654). *)
acceptBox[\T\](b: Box[\T\], x: T): T = b.accept(x)
opr juxtaposition[\T\](b: Box[\T\], x: T): T = b.accept(x)

run(): () = do
  b: Box[\Wide\] = Box[\Wide\]()
  w: Wide = WideOf(1)
  n: Narrow = NarrowOf(3)
  println("REACHED")
  c: Wide = b.accept(w)
  println("control b.accept(w).big = " c.big)
  r: Wide = b.accept(n)
  println("case 1 b.accept(n).big = " r.big)
  println("DONE")
end

end

component ZrMethClosureT
export Executable
object BoxT[\T\](v: ZZ32) end
which(x: Any): String = typecase x of BoxT[\String\] => "string"; BoxT[\ZZ32\] => "zz32"; else => "other" end
object H[\T\](v: ZZ32)
  m[\U\](b: BoxT[\U\]): String = (fn (): String => which(BoxT[\T\](1)) || which(BoxT[\U\](2)))()
end
run() = println(H[\String\](0).m[\ZZ32\](BoxT[\ZZ32\](0)))
end

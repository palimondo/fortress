(* See explorations/compile-ladder/rung-inference-checker/REPORT.md. *)
component XXXInferAmbiguousCoercion
export Executable

trait N
  getter n(): ZZ32
end
object NOf(k: ZZ32) extends N
  getter n(): ZZ32 = k
end
trait A excludes { B, N }
  coerce(x: N) = AOf(x.n)
end
trait B excludes { A, N }
  coerce(x: N) = BOf(x.n)
end
object AOf(k: ZZ32) extends A end
object BOf(k: ZZ32) extends B end

f(x: A): String = "f(A)"
f(x: B): String = "f(B)"

run(): () = do
    println(f(NOf(1)))
    println("PASS")
end

end

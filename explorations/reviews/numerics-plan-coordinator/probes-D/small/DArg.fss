component DArg
export Executable
(* measure-D probe: what else the expected type changes at f(x), where an argument, not only
   the context, fixes the static argument. Stock passes the call and converts after it. *)
object BoxT[\T\](v: ZZ32) end
idt[\T\](x: T): T = x
wrapT[\T\](x: T): BoxT[\T\] = BoxT[\T\](1)
pick[\T\](x: T, y: T): T = x
inc[\T extends Integral[\T\]\](x: T): T = x
l: ZZ64 = 5
z: ZZ32 = 5
a01(): () = do a: ZZ64 = idt(3); () end
a02(): () = do r: RR64 = idt(3); () end
a03(): () = do s: String = idt(3); () end
a04(): () = do a: BoxT[\ZZ64\] = wrapT(3); () end
a05(): ZZ64 = idt(3)
a06(): ZZ64 = idt(z)
a07(): ZZ64 = pick(l, 3)
a08(): ZZ64 = inc(5)
a09(): ZZ32 = idt(3)
a10(): Any = idt(3)
a11(): () = do a: ZZ64 = idt(l); () end
a12(): IntLiteral = idt(3)
run(): () = ()
end

\begin{document}
\begin{preview}
`value object Node(data: Mat, pullback: Mat -> Params)
  getter rows(): ZZ32 = data.rows
  getter cols(): ZZ32 = data.cols
  pull(C_bar: Mat): Params = pullback(C_bar)
  opr[ts: List[\ZZ32\]]: Node = do
    (T, m) = (|ts|, data.cols)
    E_bar(C_bar: Mat): Params = pull(mat(data.rows, m, fn (v, j) => SUM[t <- 0 # T, ts[t] = v] C_bar[t, j]))
    Node(mat(T, m, fn (t, j) => data[ts[t], j]), E_bar)
  end
end

param(name: String, W: Mat): Node = Node(W, fn (C_bar) => Params({[\String, Mat\] name |-> C_bar }))

opr +(A: Node, B: Node): Node = Node(A.data + B.data, fn (C_bar) => A.pull(C_bar) + B.pull(C_bar))
opr +(A: Node, M: Mat): Node = Node(A.data + M, fn (C_bar) => A.pull(C_bar))
opr juxtaposition(A: Node, B: Node): Node =
  Node(A.data B.data, fn (C_bar) => A.pull(C_bar (B.data)^T) + B.pull((A.data)^T C_bar))
opr /(A: Node, s: RR64): Node = Node(A.data / s, fn (C_bar) => A.pull(C_bar / s))
opr (A: Node)^T: Node = Node((A.data)^T, fn (C_bar) => A.pull(C_bar^T))

relu(A: Node): Node = do
  A_bar(C_bar: Mat): Params = A.pull(C_bar ODOT A.data.map(fn (x) => if x > 0.0 then 1.0 else 0.0 end))
  Node(A.data.map(fn (x) => x MAX 0.0), A_bar)
end

rmsnorm(X: Node): Node = do
  (n, m) = (X.rows, X.cols)
  x = X.data
  r = <|[\RR64\] SQRT((SUM[j <- 0 # m] (x[i, j])^2) / m + epsilon) | i <- 0 # n |>
  Y = mat(n, m, fn (i, j) => x[i, j] / r[i])
  X_bar(Y_bar: Mat): Params =
    X.pull(mat(n, m, fn (i, j) => Y_bar[i, j] / r[i] - x[i, j] (SUM[k <- 0 # m] Y_bar[i, k] x[i, k]) / (m (r[i])^3)))
  Node(Y, X_bar)
end

softmax(S: Node): Node = do
  (n, m) = (S.rows, S.cols)
  s = S.data
  mx = <|[\RR64\] BIG MAX[j <- 0 # m] s[i, j] | i <- 0 # n |>
  z = <|[\RR64\] SUM[j <- 0 # m] exp(s[i, j] - mx[i]) | i <- 0 # n |>
  P = mat(n, m, fn (i, j) => exp(s[i, j] - mx[i]) / z[i])
  S_bar(P_bar: Mat): Params = S.pull(mat(n, m, fn (i, j) => P[i, j] (P_bar[i, j] - (SUM[k <- 0 # m] P_bar[i, k] P[i, k]))))
  Node(P, S_bar)
end

concat(hs: List[\Node\]): Node = do
  (n, w) = ((hs[0]).rows, (hs[0]).cols)
  C = mat(n, w (|hs|), fn (i, j) => (hs[j DIV w]).data[i, j MOD w])
  H_bar(C_bar: Mat): Params = SUM[h <- hs.indices] (hs[h]).pull(mat(n, w, fn (i, j) => C_bar[i, w h + j]))
  Node(C, H_bar)
end

nll(P: Node, ys: List[\ZZ32\]): (RR64, Params) = do
  T = |ys|
  L = -(SUM[t <- 0 # T] log(P.data[t, ys[t]])) / T
  P_bar = mat(T, P.cols, fn (t, v) => if v = ys[t] then -1.0 / (T P.data[t, v]) else 0.0 end)
  (L, P.pull(P_bar))
end

causal(T: ZZ32): Mat = mat(T, T, fn (i, j) => if j <= i then 0.0 else -infinity end)
`
\end{preview}
\end{document}

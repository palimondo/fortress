+    /**
+     * Whether a call is the desugaring of a reduction or a comprehension whose
+     * big operator writes no static argument: __bigOperator(BIG OP, clauses).
+     */
+    private static boolean unwrittenBigOperator(Expr fn, Expr arg) {
+        if (!(fn instanceof VarRef) || !(arg instanceof TupleExpr)) return false;
+        if (!((VarRef) fn).getVarId().getText().equals(WellKnownNames.bigOperator)) return false;
+        List<Expr> es = ((TupleExpr) arg).getExprs();
+        if (es.size() != 2 || !(es.get(0) instanceof OpExpr)) return false;
+        OpExpr o = (OpExpr) es.get(0);
+        return o.getArgs().isEmpty() && o.getOp().getStaticArgs().isEmpty();
+    }
+
+    /**
+     * The desugaring by the elements' type: the clauses run once, collecting
+     * their elements with the join of their run-time types; the big operator
+     * is instantiated at that join, at its bound where there is no element;
+     * the reduction then runs over the collected elements.
+     */
+    private FValue bigOperatorByElements(_RewriteFnApp that, Expr fn, TupleExpr arg) {
+        FValue clauses = eval(arg.getExprs().get(1));
+        Environment lib = Driver.getFortressLibrary();
+        FValue elems = Fcn.functionInvocation(Useful.list(clauses), lib.getRootValue("__elemsOf"), that);
+        FType j = null;
+        if (elems.type() instanceof com.sun.fortress.interpreter.evaluator.types.GenericTypeInstance) {
+            List<FType> ps = ((com.sun.fortress.interpreter.evaluator.types.GenericTypeInstance) elems.type()).getTypeParams();
+            if (ps.size() == 1) j = ps.get(0);
+        }
+        FValue op;
+        EvaluatorBase.elementTypeHint.set(j);
+        try {
+            op = eval(arg.getExprs().get(0));
+        }
+        finally {
+            EvaluatorBase.elementTypeHint.remove();
+        }
+        FValue replay = Fcn.functionInvocation(Useful.list(elems), lib.getRootValue("__replayOf"), that);
+        return Fcn.functionInvocation(FTuple.make(Useful.list(op, replay)), eval(fn), that);
+    }
+

component BigMaxZZ64
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    NN32 => "NN32"
    NN64 => "NN64"
    ZZ => "ZZ"
    QQ => "QQ"
    RR64 => "RR64"
    else => "other"
  end

run(): () = do
    ignored: ZZ32 = 0
    r = BIG MAX [i <- 1#5] widen(i)
    println("BIG MAX [i <- 1#5] widen(i) = " r " : " typeOf(r))
  end

end

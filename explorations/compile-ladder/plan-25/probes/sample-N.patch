index 235fbc3e5..ea9524f18 100644
--- a/ProjectFortress/src/com/sun/fortress/nativeHelpers/simpleIntArith.java
+++ b/ProjectFortress/src/com/sun/fortress/nativeHelpers/simpleIntArith.java
@@ -412,4 +412,23 @@ public class simpleIntArith {
         return (double) a;
     }
     
+
+    /* The planner's sample of rung N: GCD of ZZ32 and partitionL, as walk's Int$Gcd and Int$Partition. */
+    public static int intGcd(int u, int v) {
+        long g = gcdOfLongs(u, v);
+        if (g > Integer.MAX_VALUE) throw Utility.makeFortressException("fortress.CompilerBuiltin$IntegerOverflow");
+        return (int) g;
+    }
+
+    private static long gcdOfLongs(long u, long v) {
+        if (u < 0) u = -u;
+        if (v < 0) v = -v;
+        while (v != 0) { long t = u % v; u = v; v = t; }
+        return u;
+    }
+
+    public static int intPartition(int u) {
+        return Integer.highestOneBit(u - 1);
+    }
+
 }

component PowProbe
export Executable

shown(v: Any): String = v.asString || " : " || v.ilkName
ring[\T extends MultiplicativeRing[\T\]\](x: T): T = x
adds[\T extends AdditiveGroup[\T\]\](x: T): T = x

run() = do
    println(shown(2^3))
    println(shown(2^(-1)))
    println(shown((widen(2))^3))
    println(shown((big(2))^3))
    println(shown(1.5^2))
    println(shown(ring[\ZZ32\](3)))
    println(shown(adds[\ZZ32\](3)))
    println(shown(ring[\RR64\](3.5)))
end
end

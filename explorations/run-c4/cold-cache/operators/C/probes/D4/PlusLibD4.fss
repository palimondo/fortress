component PlusLibD4
export PlusLibD4
opr +(x: Array[\RR64,ZZ32\], y: RR64): Array[\RR64,ZZ32\] = x.map[\RR64\](fn (e: RR64): RR64 => e + y)
opr +(y: RR64, x: Array[\RR64,ZZ32\]): Array[\RR64,ZZ32\] = x.map[\RR64\](fn (e: RR64): RR64 => y + e)
zerosM(r: ZZ32, c: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] = array[\RR64\](r,c).fill(fn (i: ZZ32, j: ZZ32): RR64 => 1.0 (i - j))
end

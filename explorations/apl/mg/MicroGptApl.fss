(* MicroGptApl -- microGPT as APL text over the FOCUSED base, line for line
   against explorations/apl/reference/hsu-flat/microgpt_concise.dyalog (L6-L30),
   inside apl⦇ … ⦈ over AplMgSyntax + AplMg beside this file, expanding into what
   Run C4 writes by hand (explorations/run-c4/src/MicroGptFlat.fss).  The design,
   with the line-by-line table, is DESIGN.md beside this file; the probes that
   settled its two mechanisms are ../probes-4b/PROBES.md.  C4's array vocabulary
   FlatArrays and its loaders FlatData are imported unchanged, and every APL
   line expands to C4's own line -- no aplCall, no frame stack, no Any, no
   Object.  Run from explorations/apl/mg: the paths are relative. *)
component MicroGptApl
export MicroGptApl
export Executable
import AplMg.{...}
import AplMgSyntax.{...}
import FlatArrays.{...}
import FlatData.{...}
import System.{...}

(* ------------------------------------------------------------ L6: index
   origin 0 is the base's own; the two hyperparameter lines are host, because a
   top level has no rest for a binding to be the body of.  C4:17-18 verbatim
   but for the APL spellings of the names: a word of two or more uppercase
   letters is a Fortress operator (gaps row 78). *)
(Ne, Blk, Nh, Hd, Vs, Bos) = (16, 16, 4, 4, 27, 26)
(Eps, Lr0, B1, B2, Epsa, Nsteps) = (10.0^(-5), 0.01, 0.85, 0.99, 10.0^(-8), 1000)
(corpusPath, weightsDir) = ("../reference/dzaima/docs.txt", "../reference/dzaima/w")

(* ------------------------------------------------------ L7, L8: the four
   vector functions are host, C4:27-34 verbatim -- a dfn body is out of the
   focused subset, and the function IS Fortress.  The causal mask is APL. *)
rmsn(x: Array[\RR64,ZZ32\]): Array[\RR64,ZZ32\] = x / SQRT (Eps + (x DOT x) / |x|)
sm(z: Array[\RR64,ZZ32\]): Array[\RR64,ZZ32\] = do e = exp(z - (BIG MAX[t <- z] t)); e / (SUM e) end
Mk = apl⦇ (-10*10)×~(⍳Blk)∘.≥⍳Blk ⦈
rmsn_b(dy: Array[\RR64,ZZ32\], x: Array[\RR64,ZZ32\]): Array[\RR64,ZZ32\] = do
    r = SQRT (Eps + (x DOT x) / |x|); y = x / r
    (dy - y ((y DOT dy) / |y|)) / r
  end
sm_b(p: Array[\RR64,ZZ32\], dy: Array[\RR64,ZZ32\]): Array[\RR64,ZZ32\] = p × (dy - (p DOT dy))

(* ---------------------------------------------------------- L9, L11: the
   layout table and the view are host, C4:37-45 -- a vector of shape pairs is a
   nested array, which no rung of the ladder has *)
matName(i: ZZ32): String =
    if i = 0 then "wte" elif i = 1 then "wpe" elif i = 2 then "lm_head" elif i = 3 then "attn_wq" elif i = 4 then "attn_wk"
    elif i = 5 then "attn_wv" elif i = 6 then "attn_wo" elif i = 7 then "mlp_fc1" else "mlp_fc2" end
matShape(i: ZZ32): (ZZ32, ZZ32) =
    if (i = 0) OR (i = 2) then (Vs, Ne) elif i = 7 then (4 Ne, Ne) elif i = 8 then (Ne, 4 Ne) else (Ne, Ne) end
matCount(i: ZZ32): ZZ32 = do (r, c) = matShape(i); r c end
matOffset(i: ZZ32): ZZ32 = SUM[j <- 0#i] matCount(j)
nParams(): ZZ32 = matOffset(9)
view(p: Array[\RR64,ZZ32\], i: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] = do (r, c) = matShape(i); view(p, matOffset(i), r, c) end

(* ------------------------------------------------------------- L12: the
   corpus is host, C4:48 -- characters and the system alphabet are outside the
   sub-language.  Its two integer arrays are read AS THEY ARE: keys are ZZ32
   throughout the focused base, so there is no conversion anywhere. *)
corpus: Corpus = loadCorpus(corpusPath, Blk, Bos)
Tokm = corpus.tokm
Len = corpus.len

(* ------------------------------------------- L13-L28: STEP, one APL block.
   The three adapters vw h u are ordinary TYPED local functions, as C4:54-55
   are, because a name in APL text is a call of a typed host function now, not
   a push on a frame stack; a view of the flat vector, rank 4 and its inverse
   stay outside the sub-language.  Every statement ends in ⋄ : a line break does
   not separate two statements when the next line can continue the one above,
   and the program's strand names are exactly the ones that continue a line. *)
step(P: Array[\RR64,ZZ32\], b: Array[\ZZ32,ZZ32\]): (RR64, Array[\RR64,ZZ32\]) = do
    vw(i: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] = view(P, i)
    h(m: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32,ZZ32)\] = heads(m, Blk, Nh, Hd)
    u(t: Array[\RR64,(ZZ32,ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] = unheads(t, Nh)
    apl⦇ B←≢b ⋄ N←B×Blk ⋄ R←Tokm[b;] ⋄ ids←,R[;⍳Blk] ⋄ tg←,R[;1+⍳Blk] ⋄ vm←,Len[b]∘.>⍳Blk ⋄ nv←+/vm ⋄ pos←N⍴⍳Blk ⋄
      wte wpe lm wq wk wv wo f1 f2←vw¨⍳9 ⋄
      X←wte[ids;]+wpe[pos;] ⋄ Xp←rmsn⍤1⊢X ⋄ X1←rmsn⍤1⊢Xp ⋄
      Q K Vv←X1∘(+.×⍉)¨wq wk wv ⋄ Qh Kh Vh←h¨Q K Vv ⋄
      A←sm⍤1⊢Mk+⍤2⊢(Qh+.×⍤2⊢⍉⍤2⊢Kh)÷Hd*0.5 ⋄ Hc←u A+.×⍤2⊢Vh ⋄
      X2←Xp+Hc+.×⍉wo ⋄ X3←rmsn⍤1⊢X2 ⋄ M0←X3+.×⍉f1 ⋄ Mr←0⌈M0 ⋄ X4←X2+Mr+.×⍉f2 ⋄
      Pr←sm⍤1⊢X4+.×⍉lm ⋄ loss←-(+/vm×⍟tg⌷⍤0 1⊢Pr)÷nv ⋄
      dL←(vm÷nv)×⍤0 1⊢Pr-tg∘.=⍳Vs ⋄ gLM←(⍉dL)+.×X4 ⋄ dX4←dL+.×lm ⋄
      gF2←(⍉dX4)+.×Mr ⋄ dM0←(dX4+.×f2)×M0>0 ⋄ gF1←(⍉dM0)+.×X3 ⋄ dX3←dM0+.×f1 ⋄
      dX2←dX4+dX3(rmsn_b⍤1)X2 ⋄ gWO←(⍉dX2)+.×Hc ⋄ dH←h dX2+.×wo ⋄
      dVh←(⍉⍤2⊢A)+.×⍤2⊢dH ⋄ dS←(A(sm_b⍤1)dH+.×⍤2⊢⍉⍤2⊢Vh)÷Hd*0.5 ⋄
      dQh←dS+.×⍤2⊢Kh ⋄ dKh←(⍉⍤2⊢dS)+.×⍤2⊢Qh ⋄ dQ dK dV←u¨dQh dKh dVh ⋄
      gWQ gWK gWV←X1∘(+.×⍨⍉)¨dQ dK dV ⋄ dX1←(dQ+.×wq)+(dK+.×wk)+dV+.×wv ⋄
      dXp←dX2+dX1(rmsn_b⍤1)Xp ⋄ dX←dXp(rmsn_b⍤1)X ⋄
      gWTE←(⍉ids∘.=⍳Vs)+.×dX ⋄ gWPE←(⍉pos∘.=⍳Blk)+.×dX ⋄
      gr←⊃,/,¨gWTE gWPE gLM gWQ gWK gWV gWO gF1 gF2 ⋄ loss gr ⦈
  end

(* ------------------------------------------------------------ L29: ADAM.
   A write to an outer name has no rule and C4 returns the new state, so the
   three modified assignments are three bindings and a three-name strand.  The
   step counter stays ZZ32, as C4:79's exponent is. *)
adam(P: Array[\RR64,ZZ32\], M: Array[\RR64,ZZ32\], V: Array[\RR64,ZZ32\], gr: Array[\RR64,ZZ32\], t: ZZ32, lr: RR64):
    (Array[\RR64,ZZ32\], Array[\RR64,ZZ32\], Array[\RR64,ZZ32\]) =
    apl⦇ Mn←(B1×M)+(1-B1)×gr ⋄ Vn←(B2×V)+(1-B2)×gr*2 ⋄ Pn←P-lr×(Mn÷1-B1*t)÷Epsa+(Vn÷1-B2*t)*0.5 ⋄ Pn Mn Vn ⦈

(* ----------------------------------------------- L30: the schedule is APL,
   the loop is host -- it threads Adam's state, which the sub-language cannot
   write to an outer name.  The step number is widened once in host code, as
   C4:82 widens it. *)
learningRate(s: ZZ32): RR64 = do sf = 1.0 s; apl⦇ Lr0×1-sf÷Nsteps ⦈ end

run(): () = do
    println "microgpt apl (focused base) | params " nParams() " | corpus " corpus.size() " x " (Blk + 1) " | batch 1, 5 steps"
    bsz = 1
    p: Array[\RR64,ZZ32\] := loadParams(weightsDir, matName, 9, nParams())
    m: Array[\RR64,ZZ32\] := zeros(nParams())
    v: Array[\RR64,ZZ32\] := zeros(nParams())
    for s <- seq(0#5) do
        t0 = nanoTime()
        (l, g) = step(p, keys(bsz, fn (i: ZZ32): ZZ32 => (s bsz + i) MOD corpus.size()))
        (p, m, v) := adam(p, m, v, g, s + 1, learningRate(s))
        println "step " (s + 1) " loss " l "  (" ((nanoTime() - t0) DIV 1000000) " ms)"
    end
  end
end

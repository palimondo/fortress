component SvA19
export Executable

run(): () = do
  a = array[\RR64\](3).fill(fn (i:ZZ32):RR64 => 1.0 + i)
  b = array[\RR64\](3).fill(fn (i:ZZ32):RR64 => 10.0 + i)
  m = array[\RR64\](2,3).fill(fn (t:(ZZ32,ZZ32)):RR64 => do (i,j) = t; 1.0 + 3 i + j end)
  m2 = array[\RR64\](3,2).fill(fn (t:(ZZ32,ZZ32)):RR64 => do (i,j) = t; 1.0 + 2 i + j end)
  println("a.indices: OK " (BIG ||[i <- a.indices] ("" i)))
  println("a.ivmap: OK " a.ivmap[\RR64\](fn (i:ZZ32, x:RR64):RR64 => i x))
end
end

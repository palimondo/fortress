component SkTaskTuple
export Executable

object BoxT[\T\](v: ZZ32) end
object Box[\nat k\](v: ZZ32) end
which(x: Any): String = typecase x of
    BoxT[\String\] => "string"
    BoxT[\ZZ32\] => "zz32"
    BoxT[\Boolean\] => "bool"
    Box[\3\] => "three"
    Box[\4\] => "four"
    else => "other"
  end
lbl(x: Any): String = which(x)
idz(n: ZZ32): ZZ32 = n

pairOf[\T\](): String = do
  (a, b) = (BoxT[\T\](1), BoxT[\T\](2))
  which(a) || which(b)
end

run(): () = do
  println("pairOf: " pairOf[\String\]() " " pairOf[\ZZ32\]())
end

end

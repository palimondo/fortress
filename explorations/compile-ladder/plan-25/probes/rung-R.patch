diff --git a/ProjectFortress/src/com/sun/fortress/nativeHelpers/simpleArbitraryPrecisionArith.java b/ProjectFortress/src/com/sun/fortress/nativeHelpers/simpleArbitraryPrecisionArith.java
index 93fa1284d..258108ff6 100644
--- a/ProjectFortress/src/com/sun/fortress/nativeHelpers/simpleArbitraryPrecisionArith.java
+++ b/ProjectFortress/src/com/sun/fortress/nativeHelpers/simpleArbitraryPrecisionArith.java
@@ -44,6 +44,19 @@ public class simpleArbitraryPrecisionArith {
     	return a.divide(b);
     }
 
+    /* REM and MOD of ZZ, as walk's BigNum$Rem and BigNum$Mod compute them, raising DivisionByZero at a zero divisor;
+       MOD has the sign of the divisor. */
+    public static BigInteger rem(BigInteger a, BigInteger b) {
+        if (b.signum() == 0) throw Utility.makeFortressException("fortress.CompilerBuiltin$DivisionByZero");
+        return a.remainder(b);
+    }
+
+    public static BigInteger mod(BigInteger a, BigInteger b) {
+        if (b.signum() == 0) throw Utility.makeFortressException("fortress.CompilerBuiltin$DivisionByZero");
+        if (b.signum() < 0) return a.negate().mod(b.negate()).negate();
+        return a.mod(b);
+    }
+
     public static BigInteger neg(BigInteger a) { 
     	return a.negate();
     }
diff --git a/ProjectFortress/src/com/sun/fortress/nativeHelpers/simpleIntArith.java b/ProjectFortress/src/com/sun/fortress/nativeHelpers/simpleIntArith.java
index 235fbc3e5..764ffff5b 100644
--- a/ProjectFortress/src/com/sun/fortress/nativeHelpers/simpleIntArith.java
+++ b/ProjectFortress/src/com/sun/fortress/nativeHelpers/simpleIntArith.java
@@ -81,6 +81,18 @@ public class simpleIntArith {
         return a / b;
     }
 
+    /* REM and MOD of ZZ32, as walk's Int$Rem and Int$Mod compute them, raising DivisionByZero at a zero divisor;
+       MOD has the sign of the divisor. */
+    public static int intRem(int a, int b) {
+        if (b == 0) throw Utility.makeFortressException("fortress.CompilerBuiltin$DivisionByZero");
+        return a % b;
+    }
+
+    public static int intMod(int a, int b) {
+        if (b == 0) throw Utility.makeFortressException("fortress.CompilerBuiltin$DivisionByZero");
+        return Math.floorMod(a, b);
+    }
+
     public static int intOverflowingNeg(int a) {
 	if (a==Integer.MIN_VALUE) throw Utility.makeFortressException("fortress.CompilerBuiltin$IntegerOverflow");
         return -a;

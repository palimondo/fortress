component SkRel
import List.{...}
import Generator2.{...}
export Executable

run() = do
    xs : ZZ32[10] = [ 1 3 4 2 5 1 7 6 8 9 ]
    p1 = relationalPredicate[\ZZ32\](fn (a, b) => |a-b| < 4)
    p2 = relationalPredicate[\ZZ32\](fn (a, b) => a < b)
    p3 = relationalPredicate[\ZZ32\](fn (a, b) => a =/= b)
    q = fn (ys: Generator[\ZZ32\]): Boolean => (SUM[\ZZ32\] ys) > 3
    naive3 = <|[\ZZ32\] SUM[\ZZ32\] xs[0:i] | i <- (0#(|xs|)), p1 xs[0:i], p2 xs[0:i], p3 xs[0:i] |>
    gg3 = <|[\ZZ32\] SUM[\ZZ32\] ys | ys <- inits xs, p1 ys, p2 ys, p3 ys |>
    println("three relational guards: naive " naive3 " gg " gg3)
    g3 = (inits xs).filter(p1).filter(p2).filter(p3)
    println("relational after three filters: " relational[\ZZ32\](g3.p))
    gm = (inits xs).filter(p1).filter(q).filter(p2)
    println("relational after rel, plain, rel: " relational[\ZZ32\](gm.p))
    mixedNaive = <|[\ZZ32\] SUM[\ZZ32\] xs[0:i] | i <- (0#(|xs|)), p1 xs[0:i], q xs[0:i], p2 xs[0:i] |>
    mixedGg = <|[\ZZ32\] SUM[\ZZ32\] ys | ys <- inits xs, p1 ys, q ys, p2 ys |>
    println("rel, plain, rel guards: naive " mixedNaive " gg " mixedGg)
    println("BIG MAX, three guards: gg " (BIG MAX[\ZZ32\] <|[\ZZ32\] SUM[\ZZ32\] ys | ys <- inits xs, p1 ys, p2 ys, p3 ys |>) " naive " (BIG MAX[\ZZ32\] naive3))
    println("tails, two guards: " <|[\ZZ32\] SUM[\ZZ32\] ys | ys <- tails xs, p1 ys, p2 ys |>)
    println("segs, BIG MAX, two guards: " (BIG MAX[\ZZ32\] <|[\ZZ32\] SUM[\ZZ32\] ys | ys <- segs xs, p1 ys, p2 ys |>))
    println("own p1 ANDCOND p2 relational: " relational[\ZZ32\](p1 ANDCOND p2))
    println("own p1 ANDCOND q relational: " relational[\ZZ32\](p1 ANDCOND q))
    println("own (p1 ANDCOND p2)(inits-prefix) holds: " ((p1 ANDCOND p2)(xs[0:3])).holds " " ((p1 ANDCOND p2)(xs[0:9])).holds)
    println("done")
  end

end

component NumberMixedEqualityWalk
export Executable

(*) Two numbers of different types compare by = where a coercion carries one into the other, in either order, and otherwise by a written conversion into RR64.

run(): () = do
    i0: ZZ32 = 0
    l0: ZZ64 = 0
    u0: NN32 = 0
    w0: NN64 = 0
    g0: ZZ = 0
    q0: QQ = 0
    r0: RR64 = 0
    i3: ZZ32 = 3
    i4: ZZ32 = 4
    l3: ZZ64 = widen(i3)
    l4: ZZ64 = widen(i4)
    u3: NN32 = unsigned(i3)
    u4: NN32 = unsigned(i4)
    w3: NN64 = widen(u3)
    w4: NN64 = widen(u4)
    g3: ZZ = big(i3)
    g4: ZZ = big(i4)
    q3: QQ = 6/2
    q4: QQ = 8/2
    r3: RR64 = 3.0
    r4: RR64 = 4.0
    f3: RR32 = narrow(r3)
    f4: RR32 = narrow(r4)
    assert(r3 = i3, "numbers.tex, section \"Rational Numbers\", and conversions-coercions.tex, section \"Coercion Resolution\": RR64 coerces from ZZ32, so the two compare at RR64; an RR64 and a ZZ32 of one value are equal, the RR64 first")
    assert(i3 = r3, "numbers.tex, section \"Rational Numbers\", and conversions-coercions.tex, section \"Coercion Resolution\": RR64 coerces from ZZ32, so the two compare at RR64; a ZZ32 and an RR64 of one value are equal, the ZZ32 first")

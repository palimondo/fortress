(* A subscript followed by a superscript applies the subscript with all its indices: m[i,j]^2 is (m[i,j])^2. *)
component P35SubscriptThenSuperscriptCompiled
export Executable

object M()
  opr [i: ZZ32]: ZZ32 = 100 + i
  opr [i: ZZ32, j: ZZ32]: ZZ32 = 1000 + 10 i + j
end

run(): () = do
  m = M()
  assert(m[3,7]^2, 1075369, "two indices, then a superscript")
  assert(m[7]^2, 11449, "one index, then a superscript")
  println("PASS")
end

end

(* A loop body that calls a local function which leaves the type of its parameter out is refused with the name of the parameter, as a top-level function is, since the compiled checker infers no parameter type (type-inference.tex, section "Type Inference for Components", and its revision). *)
component LocalFunctionUntypedParamInLoop
export Executable

run(): () = do
    r: ZZ32 := 0
    row(k) = do r := r + k end
    for i <- seq(1#3) do
        row(i)
    end
    println(r)
  end

end

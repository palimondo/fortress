    opr SQRT_DOWN(self):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSqrtDown")
    opr IEEE_PLUS_UP(self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleAddUp")
    opr IEEE_MINUS_UP(self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSubUp")
    opr IEEE_DOT_UP(self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleMulUp")
    opr IEEE_SLASH_UP(self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleDivUp")
    opr IEEE_PLUS_DOWN(self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleAddDown")
    opr IEEE_MINUS_DOWN(self,b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSubDown")
    opr IEEE_DOT_DOWN(self,b:Float):RR64 =

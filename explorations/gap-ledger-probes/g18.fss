(* g18 (merge pass): settles the run-b / run-b2 disagreement about matrix
   pasting.  Two 2x2 blocks stacked, [ a ; b ], into a literal-sized Matrix.
   run-b's worker reported that [ A ; B ] fails; run-b2's g1d_paste4 shows the
   2x2 block form [ a b ; c d ] working. *)
component g18
export Executable

blk(base: RR64): Matrix[\RR64,2,2\] =
    matrix[\RR64,2,2\]().fill(fn (i:ZZ32,j:ZZ32):RR64 => base + 1.0 (2 i + j))

run(): () = do
    a: Matrix[\RR64,2,2\] = blk(10.0)
    b: Matrix[\RR64,2,2\] = blk(20.0)
    s: Matrix[\RR64,4,2\] = [ a ; b ]
    println("[ a ; b ] = " s)
  end
end

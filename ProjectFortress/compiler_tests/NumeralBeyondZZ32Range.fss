(* A numeral outside the range of the type that its place fixes is a static error: beyond ZZ32 at a ZZ32 binding and as a range's bound, and a float numeral whose one rounding into RR64 is an infinity. *)
component NumeralBeyondZZ32Range
export Executable

run(): () = do
  a: ZZ32 = 4294967295
  for x <- seq(3000000000#2) do println("  element " x) end
  r: RR64 = .0
  u: NN32 = -3
  println("PASS")
end

end

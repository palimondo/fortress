component SkAddNN32
export Executable

sh(v: Any): String =
  typecase v of
    RR32 => v.asString || " : RR32"
    RR64 => v.asString || " : RR64"
    else => v.asString || " : other"
  end


run() = do
  a: RR32 = narrow(1.5)
  println("REACHED")
  println("a + unsigned(3) " sh(a + unsigned(3)))
  println("DONE")
end

end

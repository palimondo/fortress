component CrossRangeJ
export Executable

run(): () = do
    n: ZZ32 = 4
    var a: ZZ32 := 0
    for i <- seq(3#n) do a := a + i end
    println("seq(3#4) sum " a)
    var b: ZZ32 := 0
    for i <- seq(2:6) do b := b + i end
    println("seq(2:6) sum " b)
    var c: ZZ32 := 0
    for i <- seq(5:4) do c := c + 1 end
    println("seq(5:4) count " c)
    var d: ZZ32 := 0
    for i <- seq(0#n) do d := d + i i end
    println("seq(0#4) squares " d)
    if 4 IN (2:6) then println("4 IN 2:6") else println("4 NOT IN 2:6") end
    if 7 IN (2:6) then println("7 IN 2:6") else println("7 NOT IN 2:6") end
    if 6 IN (3#n) then println("6 IN 3#4") else println("6 NOT IN 3#4") end
    if 7 IN (3#n) then println("7 IN 3#4") else println("7 NOT IN 3#4") end
    var e: ZZ32 := 0
    for i <- seq(10:1) do e := e + 1 end
    println("seq(10:1) count " e)
  end

end

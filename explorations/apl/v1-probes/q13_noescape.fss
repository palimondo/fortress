(* q13 -- the two things the lambda route cannot do, each gated by the attempt.
   The grammar is AplSyntaxB.fsi and NOTHING is declared by the host, so the only
   way a name can exist is as the lambda parameter the block's own ← introduces.

   1. a ← b ← 1 2, the chapter's chained assignment (rung 2's X11): the inner
      b ← 1 2 is the right-hand side of the outer binding, and a right-hand side
      is an AplbE, whose ← is a PUT on an existing cell -- there is no cell.
   2. a binding surviving from one apl⦇ … ⦈ to the next, which is what rung 2's
      workspace gave and what the chapter's session assumes: the first block
      binds nothing, because a binding needs a rest to be the body of, so its ←
      is also a put. *)
component q13_noescape
import AplCore.{...}
import AplSyntaxB.{...}
import List.{...}
export Executable

object AplCell(init: AplArr)
    var cur: AplArr := init
    put(x: AplArr): AplArr = do cur := x; x end
    get(): AplArr = cur
end
aplCellNew(x: AplArr): AplCell = AplCell(x)
aplCellPut(c: AplCell, x: AplArr): AplArr = c.put(x)
aplCellGet(c: AplCell): AplArr = c.get()
str(a: AplArr): String = ("" a)

run(): () = do
    println(("1. a ← b ← 1 2 with nothing declared: " str(apl⦇ a ← b ← 1 2 ⦈)))
    println(("2. one block binds, the next reads:   " str(apl⦇ v ← 1 2 ⦈)
             " then " str(apl⦇ v ⦈)))
  end

end

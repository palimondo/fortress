(* A dotted method whose single parameter is a type parameter with the bound Any written cannot be overloaded; the compiled checker accepts it beside a method of two parameters, and the run then dies at the call of that method (row 619). *)
component XXXOverloadDottedSingleParamBoundAny
export Executable

object Ob
  m[\T extends Any\](x: T): ZZ32 = 1
  m(x: ZZ32, y: ZZ32): ZZ32 = 2
end

run(): () = do
    println("Ob.m(3) = " Ob.m(3))
    println("REACHED")
    println("Ob.m(3, 4) = " Ob.m(3, 4))
  end

end

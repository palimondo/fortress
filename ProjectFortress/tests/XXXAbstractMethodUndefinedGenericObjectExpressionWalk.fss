component XXXAbstractMethodUndefinedGenericObjectExpressionWalk
export Executable

(* An object expression in a generic function that inherits an abstract method and declares no body for it is a static error, so the program is refused at load, under walk (traits.tex, section "Method Declarations"). *)

trait S
  tag(self, x: ZZ32): ZZ32
end

mk[\T\](x: T): S = object extends S end

run(): () = do
    println("loaded")
  end

end

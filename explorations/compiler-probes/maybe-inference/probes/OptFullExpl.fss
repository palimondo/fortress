component OptFullExpl
export Executable
(*) B2a contrast: the full case with its static argument written out.
trait Opt[\T\] comprises { Full[\T\], Empty[\T\] } end
value object Full[\T\](x: T) extends Opt[\T\] end
value object Empty[\T\] extends Opt[\T\] end

f(o: Opt[\ZZ32\]): ZZ32 =
    typecase o of
        Full[\ZZ32\] => 1
        else => 0
    end

run():() = do
    print("OptFullExpl=")
    println(f(Full[\ZZ32\](3)))
end
end

component CoercionMostSpecificRungC
export Executable

(*) explorations/compile-ladder/rung-interp-coercion/REPORT.md

trait Small excludes { Mid, Big }
  getter v(): ZZ32
end
trait Mid excludes { Small, Big }
  coerce(x: Small) = MidOf(x.v)
  getter m(): ZZ32
end
trait Big excludes { Small, Mid }
  coerce(x: Small) = BigOf(x.v)
  coerce(x: Mid) = BigOf(x.m)
  getter b(): ZZ32
end
object SmallOf(s: ZZ32) extends Small
  getter v(): ZZ32 = s
end
object MidOf(s: ZZ32) extends Mid
  getter m(): ZZ32 = s
end
object BigOf(s: ZZ32) extends Big
  getter b(): ZZ32 = s
end

f(x: Big): String = "f(Big) got " x.b
f(x: Mid): String = "f(Mid) got " x.m

h(x: Mid): String = "h(Mid) got " x.m
h(x: Big): String = "h(Big) got " x.b

k(x: Mid, y: Mid): String = "k(Mid, Mid)"
k(x: Big, y: Big): String = "k(Big, Big)"

run() = do
    assert(f(SmallOf(1)), "f(Mid) got 1", "row 19: of two coercions the one to the more specific type is chosen; conversions-coercions.tex:458-460, :525-536")
    assert(h(SmallOf(2)), "h(Mid) got 2", "row 19: the choice does not depend on declaration order; conversions-coercions.tex:525-536")
    assert(k(SmallOf(3), SmallOf(4)), "k(Mid, Mid)", "row 19: the most specific choice elementwise over two arguments; conversions-coercions.tex:477-484, :493-496")
    assert(f(MidOf(5)), "f(Mid) got 5", "control: an argument that needs no coercion")
    assert(k(MidOf(6), SmallOf(7)), "k(Mid, Mid)", "row 19: one argument plain and one converted; conversions-coercions.tex:311-330")
    b: Big = MidOf(8)
    assert(b.b, 8, "row 19: a binding converts by the coercion whose parameter the value matches; conversions-coercions.tex:100-101")
    println("PASS")
  end

end

component CoercionCallRungC
export Executable

(*) explorations/compile-ladder/rung-interp-coercion/REPORT.md

trait Wide excludes { Narrow, String }
  coerce(x: Narrow) = WideOf(widen(x.small))
  getter big(): ZZ64
end
trait Narrow excludes { Wide }
  getter small(): ZZ32
end
object WideOf(b: ZZ64) extends Wide
  getter big(): ZZ64 = b
end
object NarrowOf(s: ZZ32) extends Narrow
  getter small(): ZZ32 = s
end

f(x: Wide): ZZ64 = x.big

object Holder(w: Wide) end

object Scaler(k: ZZ64)
  scale(x: Wide): ZZ64 = k x.big
end

natf(x: Wide, y: String): String = builtinPrimitive("com.sun.fortress.interpreter.glue.TestFn")
natr(y: String, xs: Wide...): String = builtinPrimitive("com.sun.fortress.interpreter.glue.TestFn")

run() = do
    assert(f(WideOf(widen(7))), 7, "control: a Wide where a Wide is declared")
    assert(f(NarrowOf(3)), 3, "row 19: a function's parameter converts by the declared type's coerce; conversions-coercions.tex:98-110")
    assert(Holder(NarrowOf(4)).w.big, 4, "row 19: a constructor's parameter converts; conversions-coercions.tex:98-110")
    assert(Scaler(widen(2)).scale(NarrowOf(5)), 10, "row 19: a method's parameter converts; conversions-coercions.tex:98-110")
    assert((fn (x: Wide): ZZ64 => x.big)(NarrowOf(6)), 6, "row 19: a function expression's parameter converts; conversions-coercions.tex:98-110")
    assert(natf(NarrowOf(7), "native"), "testFn WideOf,native", "row 19: a native function's parameter converts; conversions-coercions.tex:98-110")
    assert(natr("rest", NarrowOf(8)), "testFn rest,WideOf", "row 19: a native function's varargs parameter converts; conversions-coercions.tex:98-110, :442-449")
    println("PASS")
  end

end

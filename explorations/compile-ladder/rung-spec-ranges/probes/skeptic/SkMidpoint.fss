component SkMidpoint
export Executable

mid(lo: ZZ32, hi: ZZ32): ZZ32 = lo + (hi - lo) DIV 2

show(lo: ZZ32, hi: ZZ32): () =
  println("M " lo.asString " " hi.asString " -> " (mid(lo, hi)).asString)

run(): () = do
  show(1, 10)
  show(1, 5)
  show(6, 10)
  show(-3, -2)
  show(-7, 7)
  show(-8, -1)
  show(0, 0)
  top: ZZ32 = 2147483647
  show(top - 7, top)
  bot: ZZ32 = -top - 1
  show(bot, bot + 3)
end

end

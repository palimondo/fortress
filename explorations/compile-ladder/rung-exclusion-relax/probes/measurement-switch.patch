 object TypeAnalyzer {
   def make(traits: TraitTable) = new TypeAnalyzer(traits, KindEnv.makeFresh)
+  // PROBE (rung P measurement build, not for landing): off | hier | over | broad
+  final val probeMode: String = System.getProperty("probe.rungP", "off")
+  final val probeDefaultInstantiationsExclude: Boolean = probeMode != "broad"
+  final val probeRelaxHier: Boolean = probeMode == "hier" || probeMode == "over"
+  final val probeRelaxOver: Boolean = probeMode == "over"
 }

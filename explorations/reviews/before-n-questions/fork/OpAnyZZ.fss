component OpAnyZZ
export Executable
(* The control for OpAnyZW: the same pair, called with two ZZ32s, where no conversion is needed. *)
op[\T extends Number\](a: T, b: T): String = "op generic[" (typeOf a) "," (typeOf b) "]"
op(a: Any, b: Any): String = "op plain[" (typeOf a) "," (typeOf b) "]"
typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    else => "other"
  end
run(): () = do
    z: ZZ32 = 3
    println("op(z, z): " op(z, z))
  end
end

(* A numeral at a call goes to the most specific declaration that takes it, also beside a declaration whose parameter is a type parameter without a bound. *)
component NumeralBesideTypeParameterWalk
export Executable

g[\T\](x: T): String = "generic"
g(x: NN32): String = "nn32"

run(): () = do
    assert(g(5), "nn32", "conversions-coercions.tex, section \"Principles of Coercion\": a type parameter without a bound fixes no type for the numeral, whose own conversion reaches the more specific declaration")
    println("PASS")
  end

end

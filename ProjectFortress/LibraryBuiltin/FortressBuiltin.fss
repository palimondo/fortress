    opr ^(self, b:ZZ32):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doublePowInt")
    opr ^(self, b:AnyIntegral):RR64 = typecase b of
        c:ZZ32 ⇒ self^(asFloat(c))
        c:ZZ64 ⇒ self^(asFloat(c))
        c:NN32 ⇒ self^(asFloat(c))
        c:NN64 ⇒ self^(asFloat(c))
        c:ZZ ⇒ self^(asFloat(c))
      end
    sin(self):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSin")
    cos(self):RR64 =

(* The smallest form of the crash found on the way: two plain arms, ZZ32 beside Any,
   called with a ZZ32; nothing else in the component. *)
component EeMin
export Executable
ee(x: ZZ32): ZZ32 = 1
ee(x: Any): ZZ32 = 2
run(): () = do
    z: ZZ32 = 3
    println("ee(z): " ee(z))
    println("ee(\"s\"): " ee("s"))
  end
end

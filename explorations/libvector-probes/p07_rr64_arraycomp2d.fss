(* Baseline 4b: 2-D array comprehension (spec's identity-matrix example). *)
component p07_rr64_arraycomp2d
export Executable

run(): () = do
    m: RR64[3,3] = [ (x,y) |-> 0.0 | x <- 0:2, y <- 0:2
                     (x,x) |-> 1.0 | x <- 0:2 ]
    println("identity by array comprehension = " m)
  end
end

component CEdgeZZ64ZZMin
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    NN32 => "NN32"
    NN64 => "NN64"
    ZZ => "ZZ"
    IntLiteral => "IntLiteral"
    RR64 => "RR64"
    else => "other"
  end

run(): () = do
    g: ZZ = 9903520300447984150353281023
    w: ZZ64 = -1
    r = w MIN g
    println("w MIN g = " r " : " typeOf(r))
  end

end

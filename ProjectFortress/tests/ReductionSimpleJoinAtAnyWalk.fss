component ReductionSimpleJoinAtAnyWalk
export Executable

(* A reduction that extends AssociativeReduction at an element type and declares simpleJoin only at Any defines no body for the abstract simpleJoin at that type, so the program is refused at load, under walk (traits.tex, section "Method Declarations"; FortressLibrary.fss, trait AssociativeReduction). *)

object AnyJoin extends AssociativeReduction[\ZZ32\]
  getter asString(): String = "AnyJoin"
  simpleJoin(a: Any, b: Any): Any = a
end

run(): () = do
    println(AnyJoin.join(Just[\ZZ32\](1), Just[\ZZ32\](2)))
  end

end

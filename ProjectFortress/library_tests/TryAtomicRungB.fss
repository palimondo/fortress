component TryAtomicRungB
export Executable

(*) See explorations/compile-ladder/rung-tryatomic/REPORT.md

throwTryAtomicFailure(): ZZ32 = throw TryAtomicFailure

caughtByOwnName(): String =
    try
        ignore throwTryAtomicFailure()
        "NOT THROWN"
    catch e
        TryAtomicFailure => e.asString
    end

caughtAsChecked(): String =
    try
        ignore throwTryAtomicFailure()
        "NOT THROWN"
    catch e
        CheckedException => e.asString
    end

escapesUncheckedCatch(): String =
    try
        try
            ignore throwTryAtomicFailure()
            "NOT THROWN"
        catch inner
            UncheckedException => "CAUGHT AS UNCHECKED"
        end
    catch outer
        TryAtomicFailure => "PROPAGATED"
    end

run():() = do
    assert(caughtByOwnName(), "Try/atomic failure",
           "asString of Library/FortressLibrary.fss:1570")
    assert(caughtAsChecked(), "Try/atomic failure",
           "checked exception, Specification/advanced/parallelism-locality/transactions.tex:38")
    assert(escapesUncheckedCatch(), "PROPAGATED",
           "excludes UncheckedException, ProjectFortress/LibraryBuiltin/CompilerBuiltin.fsi:745")
    println("PASS")
end

end

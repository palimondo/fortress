component XXXInferLoneUnboundedWalk
export Executable

(* An unbounded lone type parameter that the arguments do not fix takes its implicit bound Any; walk takes their common supertype Number (ledger row 516). *)

object BoxU[\T\]() end

pickU[\T\](a: T, b: T): BoxU[\T\] = BoxU[\T\]()

kindU(x: Any): String = typecase x of
    BoxU[\Any\] => "BoxU[Any]"
    BoxU[\Number\] => "BoxU[Number]"
    else => "other"
  end

run(): () = do
    l: ZZ64 = widen(7)
    r: RR64 = 2.5
    assert(kindU(pickU(l, r)), "BoxU[Any]", "a ZZ64 and an RR64 leave the unbounded parameter to its bound Any (Type Inference)")
    println("PASS")
  end

end

component UnwrittenBigOperatorsWalk
import List.{...}
import Map.{...}
export Executable

(* The library's big operators, with a generator clause list and no static argument, reduce a non-empty generator to the value their operator gives under walk. *)

run(): () = do
    assert(BIG MIN <|[\ZZ32\] 4, 2, 7 |>, 2, "BIG MIN over 4, 2 and 7 is 2 (reductions.tex, section \"Summations and Other Reduction Expressions\")")
    assert(BIG MIN[i <- 0#4] (3 - i), 0, "BIG MIN of 3 - i over 0#4 is 0 (reductions.tex, section \"Summations and Other Reduction Expressions\")")
    assert(BIG MAX[i <- 0#4] i, 3, "BIG MAX over 0#4 is 3 (reductions.tex, section \"Summations and Other Reduction Expressions\")")
    assert(SUM[i <- 0#4] i, 6, "SUM over 0#4 is 6 (reductions.tex, section \"Summations and Other Reduction Expressions\")")
    assert(PROD[i <- 1#3] i, 6, "PROD over 1#3 is 6 (reductions.tex, section \"Summations and Other Reduction Expressions\")")
    assert(BIG AND[i <- 0#4] (i < 4), true, "BIG AND of i < 4 over 0#4 is true (reductions.tex, section \"Summations and Other Reduction Expressions\")")
    assert(BIG OR[i <- 0#4] (i = 2), true, "BIG OR of i = 2 over 0#4 is true (reductions.tex, section \"Summations and Other Reduction Expressions\")")
    assert(BIG BITXOR[i <- 0#3] i, 3, "BIG BITXOR over 0#3 is 3 (reductions.tex, section \"Summations and Other Reduction Expressions\")")
    assert(BIG ||[i <- 0#3] i, "012", "BIG || over 0#3 is 012 (reductions.tex, section \"Summations and Other Reduction Expressions\")")
    assert(BIG |||[i <- 0#3] i, "0 1 2", "BIG ||| over 0#3 is 0 1 2 (reductions.tex, section \"Summations and Other Reduction Expressions\")")
    assert(BIG //[i <- 0#3] i, ("0" // "1") // "2", "BIG // over 0#3 is 0, 1 and 2 on three lines (reductions.tex, section \"Summations and Other Reduction Expressions\")")
    assert(BIG LEXICO[i <- 1#2] (i CMP 1), GreaterThan, "BIG LEXICO of i CMP 1 over 1#2 is GreaterThan (reductions.tex, section \"Summations and Other Reduction Expressions\")")
    m = BIG UNION[i <- 0#3] {[\ZZ32,ZZ32\] i |-> 10 i}
    assert(|m|, 3, "BIG UNION of one-entry maps over 0#3 has 3 entries (reductions.tex, section \"Summations and Other Reduction Expressions\")")
    assert(m[2], 20, "BIG UNION of the maps i |-> 10 i over 0#3 maps 2 to 20 (reductions.tex, section \"Summations and Other Reduction Expressions\")")
    println("PASS")
  end

end

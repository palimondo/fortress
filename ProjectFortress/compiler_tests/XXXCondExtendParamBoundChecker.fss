(* A static parameter's bound holds at every instance, so it is checked without a conditional extends entry's condition: W[\E\] needs an E that extends Shows, which only that entry assumes; trait-parameters.tex, section "Where Clauses". *)
component XXXCondExtendParamBoundChecker
export Executable

trait Shows end
trait W[\T extends Shows\] end
trait D[\E, F extends W[\E\]\] extends { Shows where { E extends Shows } } end

run(): () = println("unreachable")

end

component SkMix
export Executable
f(x: ZZ64): ZZ64 = x + 2147483647
run() = do
    x: ZZ64 = 2147483647
    println(x + 1)
    a: ZZ32 = 7
    b: ZZ64 = a
    println(b)
    c: ZZ64 = 5
    println(a + c)
    println(f(1))
    na: Any = a
    typecase na of
        ZZ64 => println("a is a ZZ64")
        else => println("a is not a ZZ64")
    end
    nc: Any = c
    typecase nc of
        ZZ32 => println("c is a ZZ32")
        else => println("c is not a ZZ32")
    end
    d: ZZ64 = 3000000000
    println(d + d)
end
end

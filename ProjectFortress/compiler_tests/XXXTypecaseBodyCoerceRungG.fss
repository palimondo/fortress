(* See explorations/compile-ladder/climb-batch-6.5/RECORD.md. *)
component XXXTypecaseBodyCoerceRungG
export Executable

trait S end
object A extends S end
object B extends S end

f(o: S): ZZ32 =
  typecase o of
      A => 1
      else => 0
    end

run(): () = do
  println("REACHED")
  assert(f(A), 1, "a typecase as a function body whose value is coerced from a numeral, row 340; Specification/basic/expressions/typecase.tex, section \"Typecase Expressions\"")
  assert(f(B), 0, "row 340; Specification/basic/expressions/typecase.tex, section \"Typecase Expressions\"")
  println("PASS")
end

end

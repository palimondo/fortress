component R2ArithCancel
export Executable
object Box[\nat k\](v: ZZ32) end
object IBox[\int k\](v: ZZ32) end
sz[\nat k\](b: Box[\k\]): ZZ64 = k
isz[\int k\](b: IBox[\k\]): ZZ64 = k
run(): () = do
  println("REACHED")
  println("c1 2^64 - 2^64 = " || sz(Box[\4294967296 4294967296 - 4294967296 4294967296\](0)))
  println("END")
end
end

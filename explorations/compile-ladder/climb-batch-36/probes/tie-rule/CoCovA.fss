component CoCovA
export Executable

trait S comprises { U, V } end
trait T comprises { V, W } end
trait U extends S excludes W end
trait M extends { S, T } comprises { V } end
trait V extends M end
trait W extends T end
object Vo extends V end

object K(tag: String)
  coerce(s: S) = K("coercion from S")
  coerce(t: T) = K("coercion from T")
  coerce(v: V) = K("coercion from V")
end

show(k: K): String = k.tag

run(): () = do
  m: M = Vo
  println(show(m))
end
end

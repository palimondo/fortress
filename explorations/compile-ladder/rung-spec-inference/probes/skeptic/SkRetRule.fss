component SkRetRule
export Executable

object O
  h[\T extends Number\](x: T): T = x
  h(x: Any): String = "h plain"
end

opr OPLUS[\T extends Number\](a: T, b: T): T = a
opr OPLUS(a: Any, b: Any): String = "OPLUS plain"

run(): () = do
  z: ZZ32 = 5
  s: String = O.h(z)
  println("M2 s: String = O.h(z) -> " s)
  t: String = z OPLUS z
  println("M4 t: String = z OPLUS z -> " t)
end

end

(* EqProbe -- probe Q: a comparison of a number with a numeral under the switch, for each device
   for Number's = (make-eq.py).  Each line prints the answer; the expected answer is in brackets. *)
component EqProbe
export Executable

isZero[\T\](x: T): Boolean = (x = 0)
isThree[\T extends Number\](x: T): Boolean = (x = 3)

tm(what: String, n: ZZ32, f: ZZ32 -> Boolean): () = do
  t0 = nanoTime()
  c: ZZ32 := 0
  for k <- seq(0#n) do if f(k) then c += 1 end end
  println(what " x" n ": " c " true, " ((nanoTime() - t0) DIV 1000000) " ms")
end

run(): () = do
  z: ZZ32 = 0
  w: ZZ64 = 0
  u: NN32 = unsigned(0)
  v: NN64 = widen(unsigned(0))
  b: ZZ = big(0)
  r: RR64 = 0.0
  q: QQ = 0
  t: ZZ32 = 3
  println("ZZ32 z = 0 [true]: " (z = 0) "; z =/= 0 [false]: " (z =/= 0) "; 0 = z [true]: " (0 = z) "; z = 1 [false]: " (z = 1))
  println("ZZ64 w = 0 [true]: " (w = 0) "; w =/= 0 [false]: " (w =/= 0))
  println("NN32 u = 0 [true]: " (u = 0) "; u =/= 0 [false]: " (u =/= 0))
  println("NN64 v = 0 [true]: " (v = 0))
  println("ZZ b = 0 [true]: " (b = 0))
  println("RR64 r = 0 [true]: " (r = 0))
  println("QQ q = 0 [true]: " (q = 0))
  println("0 = 0 [true]: " (0 = 0) "; 0 = 1 [false]: " (0 = 1))
  println("ZZ32 z = 3000000000 [false]: " (z = 3000000000) "; NN32 u = -1 [false]: " (u = -1))
  println("generic isZero(z) [true]: " isZero(z) "; isZero(w) [true]: " isZero(w) "; isZero(u) [true]: " isZero(u))
  println("generic isThree(t) [true]: " isThree(t))
  println("assert(t, 3, msg):")
  assert(t, 3, "assert(t, 3) with t: ZZ32 = 3")
  println("  passed")
  tm("ZZ32 i = 0", 20000, fn (i: ZZ32): Boolean => (i = 0))
  tm("ZZ32 i = j (control, both ZZ32)", 20000, fn (i: ZZ32): Boolean => (i = z))
  println("END")
end
end

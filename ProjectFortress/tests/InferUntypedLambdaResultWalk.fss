component InferUntypedLambdaResultWalk
export Executable

(* Pins walk's instance for a type parameter that only the result of a function expression without a declared return type fixes: BottomType, neither that result's type nor the bound. *)

trait Fruit end
object Apple extends Fruit end

object BoxU[\T\]() end

thunk[\T\](g: () -> T): BoxU[\T\] = BoxU[\T\]()

kindU(x: Any): String = typecase x of
    BoxU[\Apple\] => "BoxU[Apple]"
    BoxU[\Any\] => "BoxU[Any]"
    else => "other"
  end

run(): () = do
    assert(kindU(thunk(fn (): Apple => Apple)), "BoxU[Apple]", "a function expression declared to return Apple fixes the parameter at Apple")
    assert(kindU(thunk(fn () => Apple)), "other", "a function expression without a declared return type fixes the parameter at neither Apple nor Any under walk")
    println("PASS")
  end

end

#Ignore the interpreter's cached files
*.tfs
/default_repository/caches/analyzed_cache/
/default_repository/caches/fortress_cache_checked/
/default_repository/caches/fortress_cache/
/default_repository/caches/interpreter_cache/
/default_repository/caches/interpreter_parsed_cache/
/default_repository/caches/presyntax_cache/
/default_repository/caches/logs/
/ProjectFortress/build/*

#Ignore swap files
*.swp

# Local-only research materials (copyrighted decks etc.; see research/README.md)
/research/decks/

# Compiler-path caches missing from the imported ignore list
/default_repository/caches/bytecode_cache/
/default_repository/caches/environment_cache/
/default_repository/caches/nativewrapper_cache/
/default_repository/caches/optimizedbytecode_cache/
/default_repository/caches/syntax_cache/

# Transient test-run artifacts
/ProjectFortress/TEST-RESULTS/
/ProjectFortress/test-tmp/
/junit-results/
/junit*.properties

# Scratch file written by file-IO interpreter tests (tests/writeTest*.fss)
/testFile.txt

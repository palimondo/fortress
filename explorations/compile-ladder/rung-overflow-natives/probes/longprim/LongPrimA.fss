component LongPrimA
export Executable

kind(v: Any): String =
  typecase v of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    else => "other"
  end

run() = do
    a: ZZ64 = 0
    println("a holds " kind(a))
    println("a.minimum = " a.minimum " : " kind(a.minimum))
    println("a.maximum = " a.maximum " : " kind(a.maximum))
    println("a.minimum - 1 = " (a.minimum - 1) " : " kind(a.minimum - 1))
    b: ZZ32 = 0
    println("b.minimum - 1 = " (b.minimum - 1) " : " kind(b.minimum - 1))
end

end

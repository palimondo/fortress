+    /**
+     * Whether a bound of the type parameter tp mentions tp itself (an F-bound).
+     */
+    private static boolean mentionsItself(StaticParam tp) {
+        Set<String> self = Collections.singleton(NodeUtil.getName(tp));
+        for (Type tr : tp.getExtendsClause()) if (!mentions(tr, self).isEmpty()) return true;
+        return false;
+    }
+
+    /**
+     * Probe P1, way "the bound without the parameter": an F-bounded type parameter that nothing at the call fixes
+     * takes the narrowest named supertype of its bounds that does not mention it (each bound evaluated with the
+     * parameter at BottomType, and its supertypes that are instances with a BottomType argument dropped); Any where
+     * no one such type is narrowest.
+     */
+    private static FType unfixedSelfBounded(StaticParam tp, GenericFunctionOrMethod g) {
+        String name = NodeUtil.getName(tp);
+        Environment e = g.getWithin().extend();
+        e.putType(name, BottomType.ONLY);
+        EvalType et = new EvalType(e);
+        List<FType> cands = new ArrayList<FType>();
+        for (Type tr : tp.getExtendsClause()) {
+            FType b;
+            try {
+                b = et.evalType(tr);
+            }
+            catch (FortressException ex) {
+                return FTypeTop.ONLY;
+            }
+            List<FType> sups = new ArrayList<FType>(b.getTransitiveExtends());
+            if (!sups.contains(b)) sups.add(0, b);
+            for (FType c : sups) {
+                if (c instanceof FTypeTop || c instanceof BottomType || mentionsBottom(c)) continue;
+                if (!cands.contains(c)) cands.add(c);
+            }
+        }
+        FType best = null;
+        for (FType c : cands) {
+            boolean narrowest = true;
+            for (FType d : cands) if (d != c && !c.subtypeOf(d)) { narrowest = false; break; }
+            if (narrowest) {
+                if (best != null && best != c) return FTypeTop.ONLY;
+                best = c;
+            }
+        }
+        return best == null ? FTypeTop.ONLY : best;
+    }
+
+    private static boolean mentionsBottom(FType c) {
+        if (c instanceof BottomType) return true;
+        if (c instanceof GenericTypeInstance) {
+            for (FType a : ((GenericTypeInstance) c).getTypeParams()) if (mentionsBottom(a)) return true;
+        }
+        return false;
+    }

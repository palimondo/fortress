component XXXCoercionAnyOverloadRungC
export Executable

(*) explorations/compile-ladder/rung-interp-coercion/REPORT.md

trait Wide excludes { Narrow }
  coerce(x: Narrow) = WideOf(x.small)
  getter big(): ZZ32
end
trait Narrow excludes { Wide }
  getter small(): ZZ32
end
object WideOf(b: ZZ32) extends Wide
  getter big(): ZZ32 = b
end
object NarrowOf(s: ZZ32) extends Narrow
  getter small(): ZZ32 = s
end

p(x: Wide): String = "p(Wide)"
p(x: Any): String = "p(Any)"

run(): () = do
    println("REACHED")
    assert(p(NarrowOf(1)), "p(Any)", "row 390 (provisional): a declaration applicable without coercion is chosen; conversions-coercions.tex:455-458, :522-525")
    println("PASS")
end

end

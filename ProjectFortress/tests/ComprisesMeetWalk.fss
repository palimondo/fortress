(* See explorations/compile-ladder/rung-spec-comprises/REPORT.md. *)
component ComprisesMeetWalk
export Executable

trait S comprises { U, V } end
trait T comprises { V, W } end
trait U extends S excludes W end
trait V extends { S, T } end
trait W extends T end
object X extends V end

f(s: S): ZZ32 = 1
f(t: T): ZZ32 = 2
f(v: V): ZZ32 = 3

run(): () = do
    g: S = X
    assert(f(g), 3, "by the comprises clauses of S and T and the excludes clause of U every value of both S and T is a value of V, so V covers their intersection, f(V) disambiguates f(S) and f(T) and is the most specific declaration applicable to a V; Specification/advanced/overloading.tex, paragraph \"The Meet Rule for Functions\"")
    println("PASS")
  end

end

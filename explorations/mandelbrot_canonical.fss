component mandelbrot_canonical
export Executable

asciiGradient: String = " .,:;|!([$O0*%#@"
maxIter: ZZ32 = |asciiGradient|

toAscii(n: ZZ32): Char = asciiGradient[n - 1]

object C(re: RR64, im: RR64)
  isPotentiallyInSet(): Boolean = ((re re) + (im im)) <= 4.0
  opr +(self, other: C): C = C(re + other.re, im + other.im)
  opr TIMES(self, other: C): C =
    C((re other.re) - (im other.im), (im other.re) + (re other.im))
  opr juxtaposition(self, other: C): C = self TIMES other
end

countOrbit(z0: C, c: C, i: ZZ32): ZZ32 = do
  z = (z0 z0) + c
  j = i + 1
  if z.isPotentiallyInSet() AND (j < maxIter) then countOrbit(z, c, j) else j end
end

mandelbrot(c: C): ZZ32 = countOrbit(C(0.0, 0.0), c, 0)

dx: RR64 = 4.0 / 64.0
dy: RR64 = 4.0 / 32.0

(* Canonical register: implicitly parallel comprehension, no seq, no var *)
art(): String =
  BIG //[r <- 0#32]
    (BIG ||[k <- 0#64] toAscii(mandelbrot(C(-2.0 + k dx, -2.0 + r dy))))

run() = println(art())
end

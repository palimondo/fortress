component CGenericZZ64
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    NN32 => "NN32"
    NN64 => "NN64"
    ZZ => "ZZ"
    IntLiteral => "IntLiteral"
    RR64 => "RR64"
    else => "other"
  end

bigger[\T extends StandardTotalOrder[\T\]\](a: T, c: T): T = a MAX c
run(): () = do
    w: ZZ64 = 3
    y: ZZ64 = 7
    r = bigger(w, y)
    println("bigger(w, y) = " r " : " typeOf(r))
  end

end

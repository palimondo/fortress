component O2FbLone
export Executable
(* O2FbAny's F-bounded generic alone: for (ZZ32, ZZ64) it applies only by answer 8's promotion. *)
eqonly[\T extends Equality[\T\]\](a: T, b: T): String = "eqonly[" (typeOf a) "," (typeOf b) "]"
typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    IntLiteral => "IntLiteral"
    else => "other"
  end
run(): () = do
    z: ZZ32 = 3
    w: ZZ64 = 4
    println("eqonly(z, w): " eqonly(z, w))
  end
end

component SkK23
export Executable

shw(v: Any): String =
  typecase v of
    v1: ZZ32 => v1.asString || ":ZZ32"
    v2: ZZ64 => v2.asString || ":ZZ64"
    v3: NN32 => v3.asString || ":NN32"
    v4: RR64 => v4.asString || ":RR64"
    v5: String => v5 || ":String"
    else => "other"
  end

trait QQk end
object Q1 extends QQk end
object Q2 extends QQk end
object Q3 extends QQk end
kindQ(x: Any): String = typecase x of
    Q1 => "Q1"
    Q2 => "Q2"
    Q3 => "Q3"
    else => "other"
  end
triQ[\T\](a: T, b: T, c: T): String = kindQ(a) " " kindQ(b) " " kindQ(c)

run(): () = do
    z: ZZ32 = 100000
    w: ZZ64 = widen(200000)
    u: NN32 = unsigned(7)
    r: RR64 = 0.5
    println("triQ(Q1,Q2,Q3) = " (triQ(Q1, Q2, Q3)))
  end

end

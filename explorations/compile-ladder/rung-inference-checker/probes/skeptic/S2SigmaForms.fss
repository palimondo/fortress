component S2SigmaForms
export Executable

trait N
  getter n(): ZZ32
end
object NOf(k: ZZ32) extends N
  getter n(): ZZ32 = k
end
trait W2 excludes { N }
  coerce(x: N) = W2Of(x.n)
end
trait W1 extends W2
  coerce(x: N) = W1Of(x.n)
end
object W2Of(k: ZZ32) extends W2 end
object W1Of(k: ZZ32) extends W1 end

object O
  g[\T\](x: W1, y: T): String = "O.g(W1, T)"
  g(x: W2, y: Any): String = "O.g(W2, Any)"
end

opr OPLUS[\T\](x: W1, y: T): String = "OPLUS(W1, T)"
opr OPLUS(x: W2, y: Any): String = "OPLUS(W2, Any)"

gg[\T\](x: W1, y: T): String = "gg(W1, T)"
gg(x: W2, y: Any): String = "gg(W2, Any)"

run(): () = do
    println("method: " || O.g(NOf(1), 5))
    println("infix: " || (NOf(1) OPLUS 5))
    s: String = gg(NOf(1), 5)
    println("f(x) under a context: " || s)
    t: Object = gg(NOf(1), 5)
    println("f(x) under Object: " || t)
end

end

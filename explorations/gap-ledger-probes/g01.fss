component g01
export Executable
(* chained subscript, indexed power, call-then-subscript: grammar vs implementation *)
object Row(xs: Array[\RR64,ZZ32\])
  opr [i: ZZ32]: RR64 = xs[i]
end
mkrow(): Row = do
  a = array[\RR64\](3)
  for i <- 0#3 do a[i] := 1.0 (i+1) end
  Row(a)
end
run(): () = do
  r = mkrow()
  rows = array[\Row\](2)
  for i <- 0#2 do rows[i] := mkrow() end
  println("baseline (r)[1] = " (r[1]))
  q = rows[0]
  println("bound then index q[1] = " (q[1]))
  println("parenthesized (rows[0])[1] = " ((rows[0])[1]))
  println("CHAINED rows[0][1] = " (rows[0][1]))
end
end

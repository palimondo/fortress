component O2Lone
export Executable
(* The instance split under batch N's rule without any plain arm: a lone generic called with a static
   type wider than the value (n: Number holding a ZZ32), and the compiled dispatcher's reach from the
   plain arm into the generic arm when both arguments are statically Any. *)
same[\T extends Number\](a: T, b: T): String = "same[" (typeOf a) "," (typeOf b) "]"
op[\T extends Number\](a: T, b: T): String = "op generic[" (typeOf a) "," (typeOf b) "]"
op(a: Any, b: Any): String = "op plain[" (typeOf a) "," (typeOf b) "]"
typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    IntLiteral => "IntLiteral"
    else => "other"
  end
run(): () = do
    z: ZZ32 = 3
    w: ZZ64 = 4
    n: Number = z
    a: Any = z
    a2: Any = z
    aw: Any = w
    println("same(z, w): " same(z, w))
    println("same(n, w): " same(n, w))
    println("op(a, a2): " op(a, a2))
    println("op(a, aw): " op(a, aw))
    println("op(aw, aw): " op(aw, aw))
  end
end

(* u01: can an inner function's parameters reuse an outer function's parameter
   names?  An APL dfn {⍺+⍵} is to expand to fn (alpha, omega) => ... and dfns
   NEST, so the expansion of { a ← 45 ⋄ _ ← {⍵+1} 3 ⋄ a } puts a lambda with
   parameters (alpha, omega) inside the body of a lambda with the same two.
   gaps.md row 29 says the host refuses that; this pins the exact text and
   measures the neighbouring cases.

   (a) lambda (alpha, omega) inside lambda (alpha, omega)  -- REJECTED, the text
       is in u01_name.out.0, lines 17:22-25 and 17:35-38:
           Variable alpha is already declared.
           Variable omega is already declared.
   (c) do-block local `omega = 3` inside lambda (omega)    -- REJECTED the same
       way, u01_name.out.0 line 31:14-17:
           Variable omega is already declared.
   Both come from ExprDisambiguator.checkForShadowingVar, which errors whenever
   the name is already an explicit variable or function in the environment and
   is not `self`, `_` or `outcome`.

   What is left, and is measured below:
   (b) a lambda parameter of a DIFFERENT name nested inside another lambda
   (d) `_` as a nested lambda's parameter -- the disambiguator's own exemption
   (e) the same question one level up: a lambda parameter that reuses the name
       of an enclosing TOP-LEVEL function's parameter *)
component u01_name
export Executable

(* (e) *)
top(alpha: ZZ32, omega: ZZ32): ZZ32 = do
    g = fn (beta: ZZ32, psi: ZZ32): ZZ32 => psi + 1
    alpha + omega + g(0, 3)
  end

run(): () = do
    println("(b) nested lambdas, DIFFERENT parameter names:")
    fb = fn (x: ZZ32): ZZ32 => do
             g = fn (omega: ZZ32): ZZ32 => omega + 1
             x + g(3)
           end
    println(("  fb(1) = " fb(1)))

    println("(d) `_` as the inner lambda's parameters:")
    fd = fn (alpha: ZZ32, omega: ZZ32): ZZ32 => do
             g = fn (_: ZZ32, _: ZZ32): ZZ32 => 7
             alpha + omega + g(0, 3)
           end
    println(("  fd(1,2) = " fd(1,2)))

    println("(e) lambda inside a top-level function, fresh names:")
    println(("  top(1,2) = " top(1,2)))
  end
end

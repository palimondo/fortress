(*) The specification's Empty list, Specification/basic/trait-parameters.tex:384-399, with the
(*) List and Cons of SpecData/examples/basic/Object.Decl.Cons.fss; names prefixed with S so that
(*) no library name is shadowed, and the methods typed so that only the extends clause is at issue.
component SpecEmpty
export Executable

trait SList[\T extends Any\]
  append(xs: SList[\T\]): SList[\T\]
  size(): ZZ32
end

object SCons[\T extends Any\](first: T, rest: SList[\T\]) extends SList[\T\]
  append(xs: SList[\T\]): SList[\T\] = SCons[\T\](first, rest.append(xs))
  size(): ZZ32 = 1 + rest.size()
end

object SEmpty extends SList[\T\] where {T extends Object}
  append(xs: SList[\T\]): SList[\T\] = xs
  size(): ZZ32 = 0
end

run():() = do
  e: SList[\ZZ32\] = SEmpty
  s: SList[\String\] = SEmpty
  l: SList[\ZZ32\] = SCons[\ZZ32\](7, e)
  println(l.size())
  println(s.size())
end

end

component SkJWalk
export Executable

run(): () = do
    println("|3:7| " |3:7|)
    println("|1:100:2| " |1:100:2|)
    println("SUM 1:1000 " (SUM[\ZZ32\][i <- 1:1000] i))
    var acc: ZZ32 := 0
    for i <- 1:100 do atomic do acc += i end end
    println("parallel atomic sum 1:100 " acc)
    println("10:1:-3 " (10:1:-3).asString " size " (10:1:-3).size " " (4 IN (10:1:-3)) " " (5 IN (10:1:-3)))
    println("1:10:-1 size " (1:10:-1).size)
    println("(3::2)#4 " ((3::2)#4).asString)
    println("(1:10:3) CAP (4:20) " ((1:10:3) CAP (4:20)).asString)
    println("(1:3) CAP (5:9) size " ((1:3) CAP (5:9)).size)
    println("(2:6) < (1:7) " ((2:6) < (1:7)) " (2:6) = (2#5) " ((2:6) = (2#5)))
    m: ZZ32[2,3] = [1 2 3; 4 5 6]
    println("m.bounds " m.bounds.asDebugString)
    var ms: ZZ32 := 0
    for (i, j) <- m.indices do atomic do ms += m[i, j] end end
    println("m sum by indices " ms)
    v: ZZ32[5] = [10 20 30 40 50]
    println("v.bounds " v.bounds.asDebugString " v[1:3] " v[1:3])
    c: ZZ32[2,2,2] = [1 2; 3 4;; 5 6; 7 8]
    println("c.bounds " c.bounds.asDebugString)
    var cs: ZZ32 := 0
    for (i, j, k) <- c.indices do atomic do cs += c[i, j, k] end end
    println("c sum by indices " cs)
  end

end

(* See explorations/compile-ladder/climb-batch-N/JUDGE-review.md. *)
component XXXNumeralBeyondWidthMax
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    ZZ => "ZZ"
    IntLiteral => "IntLiteral"
    else => "other"
  end

run(): () = do
    z: ZZ32 = 3
    w: ZZ64 = 4
    zz: ZZ64 = z
    g: ZZ = w
    println("REACHED")
    r = zz MAX 3000000000
    assert("z MAX 3000000000 = " r " : " typeOf(r), "z MAX 3000000000 = 3000000000 : ZZ64", "ledger row 325: a numeral converts only into a type that holds its value; Specification/basic/expressions/literals.tex:83-86, :146-148, basic/conversions-coercions.tex:533-553")
    s = g MAX 100000000000000000000
    assert("w MAX 100000000000000000000 = " s " : " typeOf(s), "w MAX 100000000000000000000 = 100000000000000000000 : ZZ", "ledger row 325: a numeral converts only into a type that holds its value; Specification/basic/expressions/literals.tex:83-86, :146-148, basic/conversions-coercions.tex:533-553")
    println("PASS")
  end

end

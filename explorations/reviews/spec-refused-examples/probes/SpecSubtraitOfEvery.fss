(*) The specification's where-clause example without static parameters,
(*) Specification/basic/trait-parameters.tex:355-376:
(*)     trait C extends D[\T\] where {T extends Object} end
(*) with one method on D and one object of C added so that a use can be run.
component SpecSubtraitOfEvery
export Executable

trait D[\T extends Any\]
  describe(): String
end

trait C extends D[\T\] where {T extends Object}
  describe(): String = "C, a D of every T"
end

object O extends C end

run():() = do
  x: D[\ZZ32\] = O
  y: D[\String\] = O
  println(x.describe())
  println(y.describe())
end

end

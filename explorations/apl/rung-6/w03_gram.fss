(* w03: the rung-6 GRAMMAR, against the extended ../base/AplSyntax.fsi -- one
   line per new production.  Asked in the order the rules stand in: ⍤0 1 in both
   spellings, the eight direct outer products and the general one, the commuted
   outer products, the direct +.× and +.= and the general f.g , `+.×` as a
   function VALUE under ⍤2, and ⌷ as a member of the glyph table.  The last
   group re-asks three rules rungs 1-5 already had, beside the new ones. *)
component w03_gram
import AplCore.{...}
import AplSyntax.{...}
export Executable

p(tag: String, s: String): () = println(("  " tag " = " s))

run(): () = do
    println("(a) ⍤0 1")
    p("1 2 3×⍤0 1⊢0 1 2 3", aplShow(apl⦇ 1 2 3×⍤0 1⊢0 1 2 3 ⦈))
    p("1 2 3(×⍤0 1)0 1 2 3", aplShow(apl⦇ 1 2 3(×⍤0 1)0 1 2 3 ⦈))
    p("0 1 2⌷⍤0 1⊢3 3⍴⍳9", aplShow(apl⦇ 0 1 2⌷⍤0 1⊢3 3⍴⍳9 ⦈))
    p("1 2{⍺+⍵}⍤0 1⊢2 3⍴⍳6", aplShow(apl⦇ 1 2{⍺+⍵}⍤0 1⊢2 3⍴⍳6 ⦈))
    println("(b) ∘.g direct, all eight glyphs")
    p("1 2 3∘.×0 1 2", aplShow(apl⦇ 1 2 3∘.×0 1 2 ⦈))
    p("0 1 2∘.=0 1 2", aplShow(apl⦇ 0 1 2∘.=0 1 2 ⦈))
    p("0 1 2∘.≠0 1 2", aplShow(apl⦇ 0 1 2∘.≠0 1 2 ⦈))
    p("0 1 2∘.<0 1 2", aplShow(apl⦇ 0 1 2∘.<0 1 2 ⦈))
    p("0 1 2∘.≤0 1 2", aplShow(apl⦇ 0 1 2∘.≤0 1 2 ⦈))
    p("0 1 2∘.>0 1 2", aplShow(apl⦇ 0 1 2∘.>0 1 2 ⦈))
    p("0 1 2∘.≥0 1 2", aplShow(apl⦇ 0 1 2∘.≥0 1 2 ⦈))
    p("2 3∘.|4 5 6", aplShow(apl⦇ 2 3∘.|4 5 6 ⦈))
    println("(c) ∘.g commuted, and general")
    p("∘.×⍨1 2 3", aplShow(apl⦇ ∘.×⍨1 2 3 ⦈))
    p("∘.<⍨0 1 2", aplShow(apl⦇ ∘.<⍨0 1 2 ⦈))
    p("1 2 3∘.{⍺+⍵}0 1", aplShow(apl⦇ 1 2 3∘.{⍺+⍵}0 1 ⦈))
    p("∘.{⍺+⍵}⍨1 2", aplShow(apl⦇ ∘.{⍺+⍵}⍨1 2 ⦈))
    println("(d) f.g inner product")
    p("1 2 3+.×1 2 3", aplShow(apl⦇ 1 2 3+.×1 2 3 ⦈))
    p("1 2 3+.=1 9 3", aplShow(apl⦇ 1 2 3+.=1 9 3 ⦈))
    p("(2 3⍴⍳6)+.×3 2⍴⍳6", aplShow(apl⦇ (2 3⍴⍳6)+.×3 2⍴⍳6 ⦈))
    p("1 2 3{⍺+⍵}.{⍺×⍵}1 2 3", aplShow(apl⦇ 1 2 3{⍺+⍵}.{⍺×⍵}1 2 3 ⦈))
    p("(2 3⍴⍳6){⍺+⍵}.{⍺×⍵}3 2⍴⍳6", aplShow(apl⦇ (2 3⍴⍳6){⍺+⍵}.{⍺×⍵}3 2⍴⍳6 ⦈))
    println("(e) +.× as a function VALUE under ⍤2, over rank 3")
    p("⍴(2 2 3⍴⍳12)+.×⍤2⊢2 3 2⍴⍳12",
      aplShow(apl⦇ ⍴(2 2 3⍴⍳12)+.×⍤2⊢2 3 2⍴⍳12 ⦈))
    p("(2 2 3⍴⍳12)+.×⍤2⊢2 3 2⍴⍳12",
      aplShow(apl⦇ (2 2 3⍴⍳12)+.×⍤2⊢2 3 2⍴⍳12 ⦈))
    println("(f) the rules rungs 1-5 already had, re-asked beside the new ones")
    p("+/1 2 3 4", aplShow(apl⦇ +/1 2 3 4 ⦈))
    p("relu ← 0∘⌈ ⋄ relu ¯2 3", aplShow(apl⦇ relu ← 0∘⌈ ⋄ relu ¯2 3 ⦈))
    p("1 2 3 4↑⍨2", aplShow(apl⦇ 1 2 3 4↑⍨2 ⦈))
    p("⌽⍤1⊢2 3⍴⍳6", aplShow(apl⦇ ⌽⍤1⊢2 3⍴⍳6 ⦈))
    p("×⍨¨1+⍳4", aplShow(apl⦇ ×⍨¨1+⍳4 ⦈))
  end
end

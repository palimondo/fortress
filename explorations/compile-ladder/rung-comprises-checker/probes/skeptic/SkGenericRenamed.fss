component SkGenericRenamed
export Executable
trait Box[\T\] comprises { Full[\T\] } end
trait Full[\T\] extends Box[\T\] end
trait Tag[\T, U\] extends Box[\T\] end
trait Both[\S\] extends { Full[\S\], Tag[\S, ZZ32\] } end
object B[\S\](x: S) extends Both[\S\] end
isFull[\T\](b: Box[\T\]): String = typecase b of
    Full[\T\] => "full"
    else => "not full"
  end
run(): () = println(isFull[\String\](B[\String\]("a")))
end

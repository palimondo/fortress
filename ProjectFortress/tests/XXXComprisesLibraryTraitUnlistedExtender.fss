component XXXComprisesLibraryTraitUnlistedExtender
export Executable

(* An object that explicitly extends the library's trait AnyIntegral, whose comprises clause lists ZZ, ZZ64, ZZ32, NN64 and NN32, and is below none of them is refused at load (row 22); Specification/basic/traits.tex, section "Trait Declarations". *)

object Value extends AnyIntegral
  asFloat(self): RR64 = 0.0
end

run(): () = do
    println(Value)
  end

end

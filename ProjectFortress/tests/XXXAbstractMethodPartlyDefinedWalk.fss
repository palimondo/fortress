component XXXAbstractMethodPartlyDefinedWalk
export Executable

(* An object that inherits an abstract method and declares a body only for a narrower parameter type does not define the method, a static error, so the program is refused at load, under walk (traits.tex, section "Method Declarations"). *)

trait S
  tag(self, x: Number): ZZ32
end
object O extends S
  tag(self, x: ZZ32): ZZ32 = 1
end

run(): () = do
    println(tag(O, 3))
  end

end

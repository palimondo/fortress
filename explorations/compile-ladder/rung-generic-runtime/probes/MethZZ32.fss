component MethZZ32
export Executable

(* The ZZ32 program of XXXDispatchZZ32ArmRungG as two generic dotted methods of one object. *)
trait Tag[\X\] end
trait Sub[\X\] extends Tag[\X\] end
object IntSub extends Sub[\ZZ32\] end
trait Marker[\X\] end
object TagM[\X\] extends Marker[\X\] end
object SubM[\X\] extends Marker[\X\] end

object K
  grab[\X\](t: Tag[\X\]): Marker[\X\] = TagM[\X\]
  grab[\X\](t: Sub[\X\]): Marker[\X\] = SubM[\X\]
end

run(): () = do
  t: Tag[\ZZ32\] = IntSub
  println("K.grab(t), t: Tag[ZZ32] = IntSub -> " || (typecase K.grab(t) of
      SubM[\ZZ32\] => "SubM[ZZ32]"; TagM[\ZZ32\] => "TagM[ZZ32]"; else => "other" end))
end
end

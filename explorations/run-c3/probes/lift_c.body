
(* ---- the lifts: a preallocated matrix, one row written per iteration ------
   The shape of the result comes from the first row's result; the write is
   Row(out, i).assign(y) (lift_c2).  lift_c1 (assign of a function) also
   works; the slice assignment out[i, 0#cols] := y does not (lift_c3). *)
rows[\nat r, nat c\](f: Array[\RR64,ZZ32\] -> Array[\RR64,ZZ32\], m: Matrix[\RR64,r,c\]):
        Array[\RR64,(ZZ32,ZZ32)\] = do
    (nr, nc) = m.sizes
    y0 = f(Row[\r,c\](m, 0))
    out = mat(nr, |y0|, fn (u: ZZ32, w: ZZ32): RR64 => 0.0)
    for i <- 0#nr do rowOf(out, i).assign(f(Row[\r,c\](m, i))) end
    out
  end

rows[\nat r, nat c\](f: Array[\RR64,ZZ32\] -> RR64, m: Matrix[\RR64,r,c\]):
        Array[\RR64,ZZ32\] = do
    (nr, nc) = m.sizes
    out = vec(nr, fn (u: ZZ32): RR64 => 0.0)
    for i <- 0#nr do out[i] := f(Row[\r,c\](m, i)) end
    out
  end

rows[\nat r, nat c, nat p, nat q\](f: (Array[\RR64,ZZ32\], Array[\RR64,ZZ32\]) -> Array[\RR64,ZZ32\],
        d: Matrix[\RR64,r,c\], e: Matrix[\RR64,p,q\]): Array[\RR64,(ZZ32,ZZ32)\] = do
    (nr, nc) = d.sizes
    y0 = f(Row[\r,c\](d, 0), Row[\p,q\](e, 0))
    out = mat(nr, |y0|, fn (u: ZZ32, w: ZZ32): RR64 => 0.0)
    for i <- 0#nr do rowOf(out, i).assign(f(Row[\r,c\](d, i), Row[\p,q\](e, i))) end
    out
  end

rows[\nat n, nat r, nat c\](f: (RR64, Array[\RR64,ZZ32\]) -> Array[\RR64,ZZ32\],
        v: Vector[\RR64,n\], m: Matrix[\RR64,r,c\]): Array[\RR64,(ZZ32,ZZ32)\] = do
    (nr, nc) = m.sizes
    y0 = f(v[0], Row[\r,c\](m, 0))
    out = mat(nr, |y0|, fn (u: ZZ32, w: ZZ32): RR64 => 0.0)
    for i <- 0#nr do rowOf(out, i).assign(f(v[i], Row[\r,c\](m, i))) end
    out
  end

x: Array[\RR64,(ZZ32,ZZ32)\] = mat(64, 16, fn (i: ZZ32, j: ZZ32): RR64 => sin(1.0 i + 0.3 j))
x2: Array[\RR64,(ZZ32,ZZ32)\] = mat(64, 16, fn (i: ZZ32, j: ZZ32): RR64 => cos(0.7 i - 0.2 j))
nv: Array[\RR64,ZZ32\] = vec(64, fn (i: ZZ32): RR64 => 1.0 + 0.01 i)

report(tag: String, m: Array[\RR64,(ZZ32,ZZ32)\]): () =
    println tag " sum = " sumOf(m) "  [5,7] = " m[5,7]

run(): () = do
    report("(1) rows(rmsn, x)          ", rows(rmsn, x))
    report("(2) rows(sm, x)            ", rows(sm, x))
    report("(5) rows(rmsnB, x2, x)     ", rows(rmsnB, x2, x))
    report("(6) rows(scale, nv, x)     ",
           rows(fn (w: RR64, r: Array[\RR64,ZZ32\]): Array[\RR64,ZZ32\] => w r, nv, x))
    sv = rows(fn (r: Array[\RR64,ZZ32\]): RR64 => sumV(r), x)
    println "(7) scalar-result overload: |sv| = " |sv| "  sv[5] = " sv[5]

    t0 = nanoTime()
    for k <- seq(0#10) do rows(rmsn, x) end
    t1 = nanoTime()
    for k <- seq(0#10) do rows(sm, x) end
    t2 = nanoTime()
    println "(t) 10 x rows(rmsn,x): " ms(t0,t1) " ms   10 x rows(sm,x): " ms(t1,t2) " ms"
    println "done"
  end
end

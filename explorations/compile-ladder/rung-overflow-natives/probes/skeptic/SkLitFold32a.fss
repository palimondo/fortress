component SkLitFold32a
export Executable

sz(f: () -> ZZ32): String =
  try
    (f()).asString
  catch e
    IntegerOverflow => "IntegerOverflow"
    Exception => "OTHER"
  end

lit(): ZZ32 = 2147483647 + 1

run(): () = do
  println("F01 ZZ32 numerals 2147483647 + 1 = " sz(fn () => lit()))
  println("END")
end

end

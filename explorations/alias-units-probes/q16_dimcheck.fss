(* Q2 probe 16: the dimension CHECK -- the spec's stated payoff.
   Specification/basic/dimensions.tex:206-215:
     "There are two reasons for using dimensions and units.  One is that the
      `in` operator can supply conversion factors automatically.  The other is
      that certain programming errors may be detected at compile time.
      When dimensioned values are added, subtracted, or compared, it is a
      static error if the units do not match."
   A RR64 Time is passed where a RR64 Length is declared.  Parser bugs dodged
   as in q15. *)
component q16_dimcheck
export Executable

dim Length  SI_unit meter meters m_ = 1.0
dim Time    SI_unit second seconds s_ = 1.0

stride(d: RR64 Length): RR64 = d

run() = do
  t: RR64 Time = 5.0
  println("stride of a TIME = " stride(t))
end

end

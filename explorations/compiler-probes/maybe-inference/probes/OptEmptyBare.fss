component OptEmptyBare
export Executable
(*) B2b: static argument to be inferred from the PARAMETER TYPE of the call.
trait Opt[\T\] comprises { Full[\T\], Empty[\T\] } end
value object Full[\T\](x: T) extends Opt[\T\] end
value object Empty[\T\] extends Opt[\T\] end

f(o: Opt[\ZZ32\]): ZZ32 =
    typecase o of
        Full[\ZZ32\] => o.x
        else => 0
    end

run():() = do
    print("OptEmptyBare=")
    println(f(Empty))
end
end

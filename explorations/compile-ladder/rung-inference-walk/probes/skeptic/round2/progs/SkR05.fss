component SkR05
export Executable

shownR(v: Any): String = typecase v of
    v1: ZZ32 => v1.asString || ":ZZ32"
    v2: ZZ64 => v2.asString || ":ZZ64"
    v3: NN32 => v3.asString || ":NN32"
    v4: RR64 => v4.asString || ":RR64"
    v5: String => v5 || ":String"
    else => "other"
  end

varR[\T\](xs: T...): String = "[" || shownR(xs[0]) || "," || shownR(xs[1]) || "]"

run(): () = do
    z: ZZ32 = 3
    w: ZZ64 = widen(4)
    println("varR[\\ZZ64\\](w, w) = " || varR[\ZZ64\](w, w))
    println("varR[\\ZZ64\\](z, w) = " || varR[\ZZ64\](z, w))
  end

end

component RuleLI
export Executable
(* Q1's cases, answer 8's ZZ32 with NN32 and the library's two numeral strides, against the one
   library, one declaration per case. A declaration that binds its call to an untyped local and then
   to the type Seen reports the type the call inferred in its error; the others report nothing when
   accepted. *)
object Seen end
lohi[\I extends AnyIntegral\](lo: I, hi: I): I = lo
twice[\T extends Integral[\T\]\](x: T, y: T): T = x
pick[\T\](x: T, y: T): T = x
pickn(x: NN32): NN32 = x
pickn(x: ZZ32): ZZ32 = x
z: ZZ32 = 3
u: NN32 = unsigned(5)
q1a(): () = do v = lohi(2, 46); s: Seen = v; () end
q1b(): () = do v = twice(3, 4); s: Seen = v; () end
q1c(): () = do v = lohi(2, 3000000000); s: Seen = v; () end
q1d(): () = do v = widen(4); s: Seen = v; () end
q1e(): () = do v = pickn(3); s: Seen = v; () end
q1f(): () = do v = z CMP 0; s: Seen = v; () end
q1g(): () = do v = lohi(2, 46); () end
q1h(): () = do w: ZZ64 = widen(4); () end
a8a(): () = do v = pick(z, u); s: Seen = v; () end
a8b(): ZZ64 = pick(z, u)
a8c(): () = do v = pick(3, u); s: Seen = v; () end
st1(x: Array[\ZZ32,ZZ32\]): () = do for i <- seq((|x| - 2):0:-1) do () end end
st2(a: Array[\ZZ32,ZZ32\]): () = do for i <- seq((|a| - 1):-1:-1) do () end end
st3(x: Array[\ZZ32,ZZ32\]): Seen = (|x| - 2):0:-1
run(): () = ()
end

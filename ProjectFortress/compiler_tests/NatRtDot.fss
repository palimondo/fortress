(* See explorations/compile-ladder/rung-size-runtime/REPORT.md. *)
component NatRtDot
export Executable
object Vec[\T, nat s\](x: T) end
dot[\nat n\](a: Vec[\RR64,n\], b: Vec[\RR64,n\]): () = println(n)
dot(a: Any, b: Any): () = println(-1)
run() = do
  v3: Vec[\RR64,3\] = Vec[\RR64,3\](2.5)
  w3: Vec[\RR64,3\] = Vec[\RR64,3\](1.5)
  w4: Vec[\RR64,4\] = Vec[\RR64,4\](1.5)
  println("(i) static, same sizes")
  dot(v3, w3)
  println("(ii) static, different sizes")
  dot(v3, w4)
  a: Any = v3
  b: Any = w3
  c: Any = w4
  println("(iii) dispatched, same sizes")
  dot(a, b)
  println("(iv) dispatched, different sizes, both orders")
  dot(a, c)
  dot(c, a)
end
end

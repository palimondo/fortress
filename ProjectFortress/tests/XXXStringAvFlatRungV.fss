component XXXStringAvFlatRungV
export Executable

(*) explorations/compile-ladder/rung-rr32-sibling/REPORT.md

shownA(v: Any): String =
  typecase v of
    RR32 => v.asString || " : RR32"
    RR64 => v.asString || " : RR64"
    else => v.asString || " : other"
  end

run() = do
    s = "abcd" || "efgh"
    st = s.stats()
    println("REACHED")
    assert(shownA(st.avFlat), "8.0 : RR32", "String.fss:508 declares avFlat an RR32; conversions-coercions.tex, section \"Principles of Coercion\", numbers.tex, section \"Rational Numbers\": its RR64 body does not convert, so the body must be an RR32")
    println("PASS")
  end

end

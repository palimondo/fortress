component CNumeralBigNN32
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    NN32 => "NN32"
    NN64 => "NN64"
    ZZ => "ZZ"
    IntLiteral => "IntLiteral"
    RR64 => "RR64"
    else => "other"
  end

run(): () = do
    k: ZZ32 = 3
    u: NN32 = unsigned(k)
    r = u MIN 3000000000
    println("u MIN 3000000000 = " r " : " typeOf(r))
  end

end

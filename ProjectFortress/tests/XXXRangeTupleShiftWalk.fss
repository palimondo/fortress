(*) explorations/compile-ladder/rung-size-range/REPORT.md

component XXXRangeTupleShiftWalk
export Executable

run(): () = do
    println("REACHED")
    left3 = ((1,2,3):)
    right3 = (:(2,3,4))
    strided2 = (((1,1):(9,9)):(2,2))
    assert(left3.shiftLeft((1,1,1)).asDebugString, "LeftRange3D(0,1,2, 1,1,1)", "row 503: shiftLeft moves each component by its own amount; Library/FortressLibrary.fsi:2132")
    assert(left3.shiftRight((1,1,1)).asDebugString, "LeftRange3D(2,3,4, 1,1,1)", "row 503: shiftRight moves each component by its own amount; Library/FortressLibrary.fsi:2133")
    assert(right3.shiftLeft((1,1,1)).asDebugString, "RightRange3D(1,2,3, 1,1,1)", "row 503: shiftLeft moves each component by its own amount; Library/FortressLibrary.fsi:2132")
    assert(right3.shiftRight((1,1,1)).asDebugString, "RightRange3D(3,4,5, 1,1,1)", "row 503: shiftRight moves each component by its own amount; Library/FortressLibrary.fsi:2133")
    assert(strided2.shiftLeft((1,1)).asDebugString, "StridedFullRange2D(0,0, 8,8, 2,2)", "row 503: shiftLeft moves each component by its own amount; Library/FortressLibrary.fsi:2132")
    assert(strided2.shiftRight((1,1)).asDebugString, "StridedFullRange2D(2,2, 10,10, 2,2)", "row 503: shiftRight moves each component by its own amount; Library/FortressLibrary.fsi:2133")
    println("PASS")
  end

end

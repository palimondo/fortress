(* An atomic expression has its body's value and runs it as one step: one of many tasks wins a var value parameter, and each ticket of a top-level var is given once. *)
component AtomicExprCompiled
export Executable

object OneShot(var canTryIt: Boolean)
    getter canTry(): Boolean = canTryIt
    tryOnce(): Boolean =
        atomic if canTryIt then canTryIt := false; true else false end
end

limit: ZZ32 = 20000

wins: ZZ32 := 0
tickets: ZZ32 := 0
sum: ZZ32 := 0

ticket(): ZZ32 =
    atomic if tickets < limit then tickets := tickets + 1; tickets else 0 end

run(): () = do
    o = OneShot(true)
    for i <- 1#limit do
        if o.tryOnce() then atomic wins := wins + 1 end
    end
    for i <- 1#(limit + 10000) do
        t = ticket()
        atomic sum := sum + t
    end
    seen: ZZ32 = atomic (tickets + wins)
    again = o.tryOnce()
    all: ZZ32 = limit + 1
    if (wins = 1) AND (NOT again) AND (NOT o.canTry) AND (tickets = limit)
            AND (sum = 200010000) AND (seen = all) then
        println("PASS")
    else
        println("FAIL: wins = " wins " (expected 1), tickets = " tickets
                " (expected " limit "), sum = " sum " (expected 200010000), seen = " seen)
    end
  end

end

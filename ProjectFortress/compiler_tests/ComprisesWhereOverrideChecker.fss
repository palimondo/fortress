(* A generic trait whose comprises clause lists a type at a type where-clause variable overrides an inherited dotted method and an inherited functional method. *)
component ComprisesWhereOverrideChecker
export Executable

trait Ord[\T\]
  lt(o: T): Boolean = false
  gt(self, o: T): Boolean = false
end
trait P[\E\] extends Ord[\P[\E\]\] comprises { S[\E, F\] } where [\F extends Object\]
  lt(o: P[\E\]): Boolean = true
  gt(self, o: P[\E\]): Boolean = true
end
object S[\E, F\](e: E, f: F) extends P[\E\] end

run(): () = do
  a: P[\ZZ32\] = S[\ZZ32, String\](1, "a")
  b: Boolean = a.lt(a)
  c: Boolean = gt(a, a)
  println("PASS")
end

end

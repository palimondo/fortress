component O2FbMeetNo
export Executable
(* The F-bounded generic arm beside a plain arm more specific in one position, (ZZ32, Any), with no
   meet declaration: does the checker's overloading check ask for one, and which? *)
eqop[\T extends Equality[\T\]\](a: T, b: T): String = "eqop generic[" (typeOf a) "," (typeOf b) "]"
eqop(a: ZZ32, b: Any): String = "eqop z32any[" (typeOf a) "," (typeOf b) "]"
typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    IntLiteral => "IntLiteral"
    else => "other"
  end
run(): () = do
    z: ZZ32 = 3
    w: ZZ64 = 4
    println("eqop(z, w): " eqop(z, w))
  end
end

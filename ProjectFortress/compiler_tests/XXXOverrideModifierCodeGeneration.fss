(* A method declaration may have the modifier override (traits.tex, section "Method Declarations"), so the program runs the object's declarations and prints f PASS and g PASS; the code generator refuses the modifier, "Don't know how to compile this kind of FnDecl". *)
component XXXOverrideModifierCodeGeneration
export Executable

trait A
  f(self, other:ZZ32):String = "f FAIL"
  g(other:ZZ32):String = "g FAIL"
end

object B extends A
  override f(self, other:Number):String = "f PASS"
  override g(other:Number):String = "g PASS"
end

run():() = do
    println(f(B, 17))
    println(B.g(17))
  end

end

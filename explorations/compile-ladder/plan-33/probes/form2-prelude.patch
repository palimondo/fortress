diff --git a/ProjectFortress/src/com/sun/fortress/compiler/runtimeValues/LibraryNames.java b/ProjectFortress/src/com/sun/fortress/compiler/runtimeValues/LibraryNames.java
new file mode 100644
index 0000000000..ab8154c18c
--- /dev/null
+++ b/ProjectFortress/src/com/sun/fortress/compiler/runtimeValues/LibraryNames.java
@@ -0,0 +1,19 @@
+/*******************************************************************************
+    PROBE 33: the names of the classes that the code generator writes for the
+    built-in number objects, in the library that the compiled path reads.
+ ******************************************************************************/
+
+package com.sun.fortress.compiler.runtimeValues;
+
+public final class LibraryNames {
+    private LibraryNames() {}
+
+    /** The selected library: the prelude unless FORTRESS_LIBRARY or fortress.library says "one". */
+    public static final boolean ONE_LIBRARY =
+        "one".equals(System.getProperty("fortress.library", System.getenv("FORTRESS_LIBRARY")));
+
+    /** The JVM name of the class of the value object that is the number type {@code t}. */
+    public static String numberObjectClass(String t) {
+        return (ONE_LIBRARY ? "fortress.FortressLibrary$" : "fortress.CompilerBuiltin$") + t;
+    }
+}

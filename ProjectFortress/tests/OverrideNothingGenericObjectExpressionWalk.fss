component OverrideNothingGenericObjectExpressionWalk
export Executable

(* An object expression in a generic function whose method declaration with the modifier override overrides no inherited declaration is a static error, so the program is refused at load, under walk (traits.tex, section "Method Declarations"). *)

trait A
  f(x: ZZ32): String = "A"
end

mk[\T\](x: T): A = object extends A
    override f(y: String): String = "G"
  end

run(): () = do
    println(mk[\ZZ32\](1).f("s"))
  end

end

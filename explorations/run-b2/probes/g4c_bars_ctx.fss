component g4c_bars_ctx
import List.{...}
export Executable
f(x: ZZ32): ZZ32 = x + 100
run(): () = do
  hs: List[\ZZ32\] = <|[\ZZ32\] 10, 20, 30 |>
  w: ZZ32 = 5
  println("in println juxta: " (w |hs|))
  y1 = w |hs| + 1
  println("w |hs| + 1 = " y1)
  y2 = 2 + w |hs|
  println("2 + w |hs| = " y2)
  y3 = f(w |hs|)
  println("f(w |hs|) = " y3)
  if w |hs| > 2 then println("cmp ok") end
  k: ZZ32 := 0
  while k < w |hs| do k := k + 5 end
  println("while ok k = " k)
  println("string juxta: " w " " |hs|)
end
end

+    /* Scope probe: -Dprobe.spSentence=own|lifted enforces overloading.tex:100-105; own reads a
+     * functional method's static parameters without its trait's, lifted with them. */
+    private val spSentence = System.getProperty("probe.spSentence", "off")
+
+    private def sentenceParams(t: (ArrowType,Option[Int],Option[JavaFunctional])): List[StaticParam] =
+      if (spSentence == "own" && t._3.isDefined) toListFromImmutable(t._3.get.staticParameters)
+      else toListFromImmutable(t._1.getInfo.getStaticParams)
+
+    private def staticParamsDiffer(p: List[StaticParam], q: List[StaticParam]): Boolean =
+      p.size != q.size || p.zip(q).exists { case (a, b) => a.getKind.getClass != b.getKind.getClass } || {
+        val pq = p.zip(q).filter(_._1.getKind.isInstanceOf[KindType])
+        val r = new StaticTypeReplacer(toJavaList(pq.map(_._2)), toJavaList(pq.map(x =>
+                  NF.makeTypeArg(NF.makeVarType(NU.getSpan(x._1), x._1.getName.getText)).asInstanceOf[StaticArg])))
+        def bounds(sp: StaticParam, f: Type => Type) =

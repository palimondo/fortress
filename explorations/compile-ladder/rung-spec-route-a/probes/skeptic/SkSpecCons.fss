component SkSpecCons
export Executable
trait List[\T\]
  append(List[\T\]):List[\T\]
end
object Nil[\T\] extends List[\T\]
  append(xs: List[\T\]): List[\T\] = xs
end
object Cons[\T\](first:T, rest:List[\T\])
  extends List[\T\]
  cons(x) = Cons(x,self)
  append(xs) = Cons(first,rest.append(xs))
end
run():() = do
  l: List[\ZZ32\] = Cons[\ZZ32\](1, Nil[\ZZ32\])
  m = l.append(Cons[\ZZ32\](2, Nil[\ZZ32\]))
  println("appended")
end
end

diff --git a/ProjectFortress/tests/HardSetSampleWalk.fss b/ProjectFortress/tests/HardSetSampleWalk.fss
new file mode 100644
index 0000000..4d10e78
--- /dev/null
+++ b/ProjectFortress/tests/HardSetSampleWalk.fss
@@ -0,0 +1,56 @@
+(* The hard set's sample under walk: NN32's +, NN64's +, Char's toUpperCase and javaDigit (through digit), and ZZ32's LSHIFT over AnyIntegral, at ordinary values and at their edges. *)
+component HardSetSampleWalk
+export Executable
+
+overflows32(f: () -> NN32): Boolean =
+  try
+    f()
+    false
+  catch e
+    IntegerOverflow => true
+  end
+
+overflows64(f: () -> NN64): Boolean =
+  try
+    f()
+    false
+  catch e
+    IntegerOverflow => true
+  end
+
+run():() = do
+  m: ZZ32 = -1
+  h: ZZ32 = 2147483647
+  top32 = unsigned(m)
+  five32 = unsigned(5)
+  assert((five32 + five32).asString, "10", "NN32 +")
+  assert((unsigned(h) + unsigned(h)).asString, "4294967294", "NN32 + past ZZ32")
+  assert(overflows32(fn () => top32 + five32), "NN32 + overflows")
+  m64: ZZ64 = -1
+  f64: ZZ64 = 5
+  h64: ZZ64 = 9223372036854775807
+  top64 = unsigned(m64)
+  five64 = unsigned(f64)
+  assert((five64 + five64).asString, "10", "NN64 +")
+  assert((unsigned(h64) + unsigned(h64)).asString, "18446744073709551614", "NN64 + past ZZ64")
+  assert(overflows64(fn () => top64 + five64), "NN64 + overflows")
+  assert(toUpperCase('a'), 'A', "toUpperCase")
+  assert(toUpperCase('7'), '7', "toUpperCase of a digit")
+  assert(digit('7').get, 7, "digit, through javaDigit")
+  assert(digit('f', 16).get, 15, "digit radix 16, through javaDigit")
+  assert(digit('z').isEmpty, true, "digit of no digit, through javaDigit")
+  d64: ZZ64 = 3
+  assert(1 LSHIFT 3, 8, "LSHIFT")
+  assert(1 LSHIFT 40, 0, "LSHIFT past 32")
+  assert((-8) LSHIFT (-1), -4, "LSHIFT by a negative count")
+  assert((-5) LSHIFT (-40), -1, "LSHIFT by a negative count past 32")
+  assert(1 LSHIFT d64, 8, "LSHIFT by a ZZ64")
+  assert(1 LSHIFT unsigned(3), 8, "LSHIFT by an NN32")
+  assert(1 LSHIFT unsigned(d64), 8, "LSHIFT by an NN64")
+  assert(1 LSHIFT big(3), 8, "LSHIFT by a ZZ")
+  assert(1 LSHIFT (big(1) LSHIFT 100), 0, "LSHIFT by a ZZ past 2^64")
+  assert(1 LSHIFT unsigned(m64), 0, "LSHIFT by an NN64 past 2^63")
+  println("PASS")
+end
+
+end
diff --git a/ProjectFortress/compiler_tests/HardSetSampleCompiled.fss b/ProjectFortress/compiler_tests/HardSetSampleCompiled.fss
new file mode 100644
index 0000000..1da143e
--- /dev/null
+++ b/ProjectFortress/compiler_tests/HardSetSampleCompiled.fss
@@ -0,0 +1,34 @@
+(* The hard set's sample on the compiled path, way 3: each operation over NN32, NN64 or Character converts to and from a bare binding at its helper's Java types, through the six transfer helpers. *)
+component HardSetSampleCompiled
+export Executable
+
+add32(a:ZZ32, b:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedIntArith.unsignedIntOverflowingAdd")
+add64(a:ZZ64, b:ZZ64):ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedLongArith.unsignedLongOverflowingAdd")
+upperZZ32(c:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charToUpperCase")
+bits32(x:NN32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedIntArith.makeZZ32FromNN32WithSpecialCompilerHackForNN32ArgumentType")
+nn32(x:ZZ32):NN32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedIntArith.makeNN32FromZZ32WithSpecialCompilerHackForNN32ResultType")
+bits64(x:NN64):ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedLongArith.makeZZ64FromNN64WithSpecialCompilerHackForNN64ArgumentType")
+nn64(x:ZZ64):NN64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedLongArith.makeNN64FromZZ64WithSpecialCompilerHackForNN64ResultType")
+codePoint(c:Character):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charCodePointWithSpecialCompilerHackForCharacterArgumentType")
+character(x:ZZ32):Character = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleChar.charMakeCharacterWithSpecialCompilerHackForCharacterResultType")
+
+addN32(a:NN32, b:NN32):NN32 = nn32(add32(bits32(a), bits32(b)))
+addN64(a:NN64, b:NN64):NN64 = nn64(add64(bits64(a), bits64(b)))
+upper(c:Character):Character = character(upperZZ32(codePoint(c)))
+
+run():() = do
+  assert(addN32(5, 5) = 10, "addN32(5, 5)")
+  assert(addN32(2147483647, 2147483647) = 4294967294, "addN32 past ZZ32")
+  n: NN32 := 0
+  try
+    n := addN32(4294967295, 1)
+  catch e
+    IntegerOverflow => n := 7
+  end
+  assert(n = 7, "addN32 overflows")
+  assert(addN64(5, 5) = 10, "addN64(5, 5)")
+  assert(upper('a') = 'A', "upper('a')")
+  println("PASS")
+end
+
+end

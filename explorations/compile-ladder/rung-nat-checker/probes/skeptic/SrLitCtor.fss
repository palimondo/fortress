component SrLitCtor
export Executable

object Box[\nat k\](v: ZZ32) end
object Pair[\nat k\](b: Box[\k\], m: ZZ32) end
object BoxT[\T\](v: ZZ32) end
object PairT[\T\](b: BoxT[\T\], m: ZZ32) end

run(): () = do
    z: ZZ32 = 3
    println(Pair(Box[\3\](1), z).m)
    println(Pair(Box[\3\](1), 3).m)
    println(PairT(BoxT[\String\](1), z).m)
    println(PairT(BoxT[\String\](1), 3).m)
  end

end

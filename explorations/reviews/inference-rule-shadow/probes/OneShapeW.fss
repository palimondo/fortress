wRange0W(): () = do
    z: ZZ32 = 3
    w: ZZ64 = widen(4)
    r: RR64 = 2.5
    u: NN32 = unsigned(5)
    b: Box[\RR64\] = Box[\RR64\](1.0)
    do c: ZZ32 := 0; for i <- seq(0#w) do c += 1 end; println("0#w: " c) end
  end

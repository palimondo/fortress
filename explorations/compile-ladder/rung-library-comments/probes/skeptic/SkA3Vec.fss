component SkA3Vec
import SkA3VecVocab.{...}
export Executable

run(): () = do
    v = array[\RR64\](2).fill(fn (i: ZZ32): RR64 => 1.0 i + 1.0)
    t = array3[\RR64,2,2,2\]().fill(fn (ix: (ZZ32,ZZ32,ZZ32)): RR64 => do (p, i, j) = ix; 10.0 p end)
    println("v is a Vector: " instanceOf[\Vector[\RR64,2\]\](v))
    println("(v + t)[1,0,1] = " (v + t)[1,0,1])
    println("(t + v)[1,1,0] = " (t + v)[1,1,0])
end

end

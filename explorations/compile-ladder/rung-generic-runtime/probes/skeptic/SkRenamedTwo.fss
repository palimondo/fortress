component SkRenamedTwo
export Executable

trait Two[\A,B\] end
trait SubTwo[\A,B\] extends Two[\A,B\] end
object Red end
object Blue end
object RedBlue extends SubTwo[\Red,Blue\] end
object PlainRedBlue extends Two[\Red,Blue\] end

pick[\A,B\](t: Two[\A,B\], a: A): String = "two"
pick[\C,D\](t: SubTwo[\C,D\], c: C): String = "subtwo"

run(): () = do
  t: Two[\Red,Blue\] = RedBlue
  u: Two[\Red,Blue\] = PlainRedBlue
  println(pick(t, Red) " " pick(u, Red))
end

end

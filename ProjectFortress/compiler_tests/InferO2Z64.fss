(* See explorations/compile-ladder/rung-inference-checker/REPORT.md. *)
component InferO2Z64
export Executable

op[\T extends Number\](a: T, b: T): String = "op generic[" || typeOf(a) || "," || typeOf(b) || "]"
op(a: ZZ64, b: ZZ64): String = "op plain64[" || typeOf(a) || "," || typeOf(b) || "]"
typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    IntLiteral => "IntLiteral"
    else => "other"
  end

run(): () = do
    z: ZZ32 = 3
    w: ZZ64 = 4
    assert(op(z, w), "op plain64[ZZ64,ZZ64]", "the conversion judgement's decision 1 (POSITIONS 2026-09-28): the converted call dispatches to the more specific declaration")
    assert(op(w, w), "op plain64[ZZ64,ZZ64]", "the conversion judgement's decision 1 (POSITIONS 2026-09-28)")
    assert(op(z, z), "op generic[ZZ32,ZZ32]", "the conversion judgement's decision 1 (POSITIONS 2026-09-28)")
    assert(op[\ZZ64\](z, w), "op plain64[ZZ64,ZZ64]", "the conversion judgement's decision 1 (POSITIONS 2026-09-28)")
    assert(op[\ZZ64\](w, w), "op plain64[ZZ64,ZZ64]", "the conversion judgement's decision 1 (POSITIONS 2026-09-28)")
    println("PASS")
  end
end

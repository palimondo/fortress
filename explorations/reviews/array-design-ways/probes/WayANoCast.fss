(* Decision A: the library's selection device without the cast, the array-design review's p1b
   (explorations/compiler-probes/array-design-review/p1b_typecase.fss) on today's tree. *)
component WayANoCast
export Executable

trait Arr[\T\]
  abstract get(i: ZZ32): T
end
object DStore(v: RR64) extends Arr[\RR64\]
  get(i: ZZ32): RR64 = v
end
object BStore[\T\](x: T) extends Arr[\T\]
  get(i: ZZ32): T = x
end

witness[\T\](): T = throw InvalidRange

mk[\T\](x: T): Arr[\T\] =
  typecase witness[\T\] of
    () -> RR64 => DStore(cast[\RR64\](x))
    else => BStore[\T\](x)
  end

which(a: Any): String =
  typecase a of
    DStore => "DStore"
    else => "BStore"
  end

run(): () = do
  r: RR64 = 1.5
  z: ZZ32 = 7
  a = mk[\RR64\](r)
  b = mk[\ZZ32\](z)
  println("WayANoCast RR64 " which(a) " " a.get(0))
  println("WayANoCast ZZ32 " which(b) " " b.get(0))
end

end

component PQRProbe
export Executable

trait P excludes { Q }
  getter n(): ZZ32
end
trait Q excludes { P }
  getter n(): ZZ32
end
trait R excludes { P, Q }
  coerce(x: P) = ROf(x.n)
  coerce(x: Q) = ROf(x.n)
end
object POf(k: ZZ32) extends P
  getter n(): ZZ32 = k
end
object QOf(k: ZZ32) extends Q
  getter n(): ZZ32 = k
end
object ROf(k: ZZ32) extends R end

kind(x: Any): String = typecase x of
    R => "R"
    P => "P"
    Q => "Q"
    else => "other"
  end

pick[\T\](x: T, y: T): String = kind(x) || "," || kind(y)
reveal[\T\](x: T, y: T): T = x

run(): () = do
    pp: P = POf(1)
    qq: Q = QOf(2)
    v = reveal(pp, qq)
    println(kind(v))
    println(pick(pp, qq))
end

end

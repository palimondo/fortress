(* See explorations/compile-ladder/rung-size-range/REPORT.md. *)
component XXXInferResultOnlyAny
export Executable

fAny[\T extends Any\](): T = throw InvalidRange
c1(): ZZ32 = fAny()

run(): () = do
    println("REACHED")
    r = try c1() catch e InvalidRange => -1 end
    shown = "c1: " || r
    println(shown)
    assert(shown =/= "", "row 505: the call returns or throws InvalidRange, whatever T is bound to; Specification/basic/inference.tex:191-196")
    println("PASS")
  end

end

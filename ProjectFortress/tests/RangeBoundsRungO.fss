(*) explorations/compile-ladder/rung-overflow-natives/REPORT.md

component RangeBoundsRungO
export Executable

run(): () = do
    println("REACHED")
    one: ZZ32 = 1
    three: ZZ32 = 3
    zMax: ZZ32 = 7FFFFFFF_16
    zMin: ZZ32 = -zMax - 1
    lMax: ZZ64 = 7FFFFFFFFFFFFFFF_16
    topOne = zMax # one
    topOneSize = |topOne|
    assert(topOneSize = 1, "ranges.tex, section \"Ranges\"")
    topThree = (zMax - 2) # three
    topThreeSize = |topThree|
    assert(topThreeSize = 3, "ranges.tex, section \"Ranges\"")
    wideTop = 0 # three
    wideTopSize = SUM[\ZZ32\][k <- wideTop, (lMax - widen(2)) + widen(k) <= lMax] 1
    assert(wideTopSize = 3, "ranges.tex, section \"Ranges\"")
    r = one:zMin
    rSize = r.size
    assert(rSize = 0, "ranges.tex, section \"Ranges\"")
    rCard = |r|
    assert(rCard = 0, "ranges.tex, section \"Ranges\"")
    downward = zMax:zMin
    downwardCard = |downward|
    assert(downwardCard = 0, "ranges.tex, section \"Ranges\"")
    println("PASS")
  end

end

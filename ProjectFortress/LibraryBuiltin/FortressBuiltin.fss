value object RR32 extends { Number, StandardPartialOrder[\RR32\], StandardMinMax[\RR32\],
                            AdditiveGroup[\RR32\], MultiplicativeRing[\RR32\] }
    getter zero(): RR32 = narrow(0.0)
    getter one(): RR32 = narrow(1.0)
    getter asString(): String =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatToString")
    getter asExprString(): String =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatToString")

    (** returns true if the value is an IEEE NaN **)
    getter isNaN(): Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatIsNaN")
    (** returns true if the value is an IEEE infinity **)
    getter isInfinite(): Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatIsInfinite")
    (** returns true if the value is a valid number (not NaN) **)
    getter isNumber(): Boolean = NOT self.isNaN
    (** returns true if the value is finite **)
    getter isFinite(): Boolean = NOT (self.isInfinite OR self.isNaN)
    (** check returns Just(its argument) if it is finite, otherwise Nothing. **)
    getter check(): Maybe[\RR32\] =
        if self.isFinite then Just[\RR32\](self) else Nothing[\RR32\] end
    (** check_star returns Just(its argument) if it is non-NaN, otherwise Nothing. **)
    getter check_star(): Maybe[\RR32\] =
        if self.isNaN then Nothing[\RR32\] else Just[\RR32\](self) end
    (** obtain the raw bits of the IEEE floating-point representation of this value. **)
    getter rawBits():ZZ32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatRawBits")
    getter signBit():ZZ32 = if self.rawBits < 0 then 1 else 0 end
    (** next higher IEEE float **)
    getter nextUp():RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatNextUp")
    (** next lower IEEE float **)
    getter nextDown():RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatNextDown")

    asFloat(self): RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.floatToDouble")

    opr |self| : RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatAbs")
    opr =(self, b:RR32):Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatEQ")
    opr =(self, b:RR64):Boolean = do c: RR64 = self; (c = b) end
    opr =/=(self, b:RR32):Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatNE")
    opr <(self, b:RR32):Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatLT")
    opr <=(self, b:RR32):Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatLE")
    opr >(self, b:RR32):Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatGT")
    opr >=(self, b:RR32):Boolean =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatGE")
    opr CMP(self, b:RR32):Comparison =
        if self<b then LessThan
        elif self>b then GreaterThan
        elif self=b then EqualTo
        else Unordered
        end
    (** In case of NaN, %MIN% and %MAX% return a NaN, otherwise it respects the
        total order. **)
    opr MIN(self, b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMin")
    opr MAX(self, b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMax")
    opr MINMAX(self, b:RR32): (RR32,RR32) =
        (self MIN b, self MAX b)

    opr -(self):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatNeg")
    opr +(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatAdd")
    opr -(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSub")
    opr DOT(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMul")
    opr TIMES(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMul")
    opr juxtaposition
         (self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMul")
    opr /(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatDiv")
    opr SQRT(self):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSQRT")
    opr PLUS_UP(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatAddUpNoNaN")
    opr MINUS_UP(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSubUpNoNaN")
    opr DOT_UP(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMulUpNoNaN")
    opr SLASH_UP(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatDivUpNoNaN")
    opr SQRT_UP(self):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSQRTUp")
    opr PLUS_DOWN(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatAddDownNoNaN")
    opr MINUS_DOWN(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSubDownNoNaN")
    opr DOT_DOWN(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMulDownNoNaN")
    opr SLASH_DOWN(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatDivDownNoNaN")
    opr SQRT_DOWN(self):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSQRTDown")
    opr IEEE_PLUS_UP(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatAddUp")
    opr IEEE_MINUS_UP(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSubUp")
    opr IEEE_DOT_UP(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMulUp")
    opr IEEE_SLASH_UP(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatDivUp")
    opr IEEE_PLUS_DOWN(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatAddDown")
    opr IEEE_MINUS_DOWN(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSubDown")
    opr IEEE_DOT_DOWN(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMulDown")
    opr IEEE_SLASH_DOWN(self,b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatDivDown")
    opr ^(self, b:RR32):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatPow")
    opr ^(self, b:Float):RR64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatPowDouble")
    opr ^(self, b:AnyIntegral):RR32 = narrow((asFloat(self))^b)
    floor(self):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatFloor")
    opr |\self/| : ZZ64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatIFloor")
    ceiling(self):RR32 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatCeiling")
    opr |/self\| : ZZ64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatICeiling")
    truncate(self):ZZ64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatTruncate")
    round(self):ZZ64 =
        builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatRound")

    (** %MINNUM% and %MAXNUM% return a numeric result where possible (avoiding NaN).
        Note that %MINNUM% and %MAX% form a lattice with NaN at the top, and
        that %MAXNUM% and %MIN% form a lattice with NaN at the bottom.  **)
    opr MINNUM(self, b:RR32):RR32 = do
        r = self MIN b
        if r.isNaN then
            if self.isNumber then self
            elif b.isNumber then b
            else r end
        else
            r
        end
      end
    opr MAXNUM(self, b:RR32):RR32 = do
        r = self MAX b
        if r.isNaN then
            if self.isNumber then self
            elif b.isNumber then b
            else r end
        else
            r
        end
      end
end


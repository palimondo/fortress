component OverrideObjectExpressionWhereBoundWalk
export Executable

(* An object expression in a generic function whose where clause bounds its static parameter by ZZ32 overrides, with an override over ZZ32, the declaration it inherits over that parameter, so the program loads and runs it, under walk (traits.tex, section "Method Declarations"; trait-parameters.tex, section "Where Clauses"). *)

trait A[\T\]
  f(x: T): String = "A"
end

mk[\T\](y: T): A[\T\] where { T extends ZZ32 } = object extends A[\T\]
    override f(x: ZZ32): String = "E"
  end

run(): () = do
    assert(mk[\ZZ32\](1).f(3), "E", "the object expression's f over ZZ32 overrides A[\\T\\]'s over T, which mk's where clause bounds by ZZ32 (traits.tex, section \"Method Declarations\"; trait-parameters.tex, section \"Where Clauses\")")
    println("PASS")
  end

end

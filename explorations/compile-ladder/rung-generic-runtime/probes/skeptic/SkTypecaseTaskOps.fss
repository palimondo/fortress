component SkTypecaseTaskOps
export Executable

object Wrap(n: ZZ32) end
g(w: Wrap): ZZ32 = w.n
h(w: Wrap): ZZ32 = w.n + 1

plain(y: Wrap): ZZ32 = g(y) + h(y)

unnamed(x: Any, y: Wrap): ZZ32 =
  typecase x of
      Wrap => g(y) + h(y)
      else => 0
    end

run(): () = do
  println(plain(Wrap(3)).asString " " unnamed(Wrap(3), Wrap(3)).asString)
end

end

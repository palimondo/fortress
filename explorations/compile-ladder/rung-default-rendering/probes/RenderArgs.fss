component RenderArgs
export Executable

object Box(n: ZZ32) end
object Cell[\T\](v: T) end
object Two[\A, B\](a: A, b: B) end
object AnyCell[\T extends Any\](v: T) end
value object Pt(x: ZZ32) end

inc(x: ZZ32): ZZ32 = x + 1
add(x: ZZ32, y: ZZ32): ZZ32 = x + y

run(): () = do
    b = Box(1)
    c = Cell[\ZZ32\](1)
    p = Pt(1)
    t = Two[\ZZ32, String\](1, "a")
    cb = Cell[\Box\](Box(2))
    cc = Cell[\Cell[\ZZ32\]\](Cell[\ZZ32\](3))
    ct = AnyCell[\(ZZ32, String)\]((1, "a"))
    ca = AnyCell[\ZZ32 -> ZZ32\](inc)
    ca2 = AnyCell[\(ZZ32, ZZ32) -> ZZ32\](add)
    println("plain:  " || b.asString)
    println("generic: " || c.asString)
    println("value:  " || p.asString)
    println("two:    " || t.asString)
    println("userarg: " || cb.asString)
    println("nested: " || cc.asString)
    println("escape: " || "Cell[\\ZZ32\\]")
    println("tuple:  " || ct.asString)
    println("arrow:  " || ca.asString)
    println("arrow2: " || ca2.asString)
  end

end

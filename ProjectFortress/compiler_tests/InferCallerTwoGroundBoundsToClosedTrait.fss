(* A call whose argument's type carries the caller's own type parameter, bounded by a trait with a comprises clause and by a trait without static parameters that excludes one of its listed types, is applicable to a callee whose type parameter is bounded by the first trait alone. *)
component InferCallerTwoGroundBoundsToClosedTrait
export Executable

trait Q excludes { C } end
trait K comprises { A, B, C } end
object A extends { K, Q } end
object B extends { K, Q } end
object C extends K end
object Box[\T\](v: T) end

h[\T extends K\](x: Box[\T\]): T = x.v
g[\T extends { K, Q }\](x: Box[\T\]): T = h(x)
tag(a: A): String = "A"
tag(b: B): String = "B"

run(): () = do
    assert(tag(g(Box[\A\](A))), "A", "h(x) in g, whose argument has type Box[T] with g's T below h's bound K, is applicable at h's instance T; Specification/basic/inference.tex, section \"The Static Arguments of a Call\"")
    assert(tag(g(Box[\B\](B))), "B", "h(x) in g, whose argument has type Box[T] with g's T below h's bound K, is applicable at h's instance T; Specification/basic/inference.tex, section \"The Static Arguments of a Call\"")
    println("PASS")
  end

end

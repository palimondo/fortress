component probe19_bigcat
import List.{...}
export Executable

object V(x: RR64) end
object Vec(e: List[\V\])
  opr |self|: ZZ32 = |e|
  opr [i: ZZ32]: V = e[i]
  opr ||(self, y: Vec): Vec = Vec(e || y.e)
end
object Mat(rows: List[\Vec\])
  opr [i: ZZ32]: Vec = rows[i]
  opr [i: ZZ32, j: ZZ32]: V = (rows[i])[j]
end
object CatVecs extends MonoidReduction[\Vec\]
  getter asString(): String = "CatVecs"
  empty(): Vec = Vec(<|[\V\] |>)
  join(a: Vec, b: Vec): Vec = a || b
end
opr BIG ||(): BigReduction[\Vec,Vec\] = BigReduction[\Vec,Vec\](CatVecs)

run(): () = do
  vs = <| Vec(<| V(1.0), V(2.0) |>), Vec(<| V(3.0) |>), Vec(<| V(4.0), V(5.0) |>) |>
  c = BIG ||[v <- vs] v
  println("BIG || : |c| = " |c| " c[3] = " c[3].x " (expect 5, 4)")
  m = Mat(vs)
  println("m[2] = " |m[2]| " m[2,1] = " m[2,1].x " (expect 2, 5)")
  h(k: ZZ32): Vec = Vec(<| V(10 k + i) | i <- 0#2 |>)
  c2 = BIG ||[k <- 0#3] h(k)
  println("BIG ||[k<-0#3] h(k): |c2| = " |c2| " c2[5] = " c2[5].x " (expect 6, 21)")
end
end

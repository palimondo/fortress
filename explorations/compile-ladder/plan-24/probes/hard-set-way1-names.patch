+    /* The hard set's way 1: the six special names generalised to a suffix.  A helper whose name ends in
+     * WithSpecialCompilerHackFor, then <T>ArgumentType, <T>ResultType, <T>ArgumentAndResultType or
+     * <T>ArgumentTypeAnd<U>ResultType, with T and U each NN32, NN64 or Character, has every parameter of
+     * T's carrier read as T, and its result of U's (or T's) carrier read as U (or T): int carries NN32 and
+     * Character, long NN64.  The six fixed names are cases of the rule.
+     */
+    private static final String HACK = "WithSpecialCompilerHackFor";
+    static String specialHackType(String s, String method_name, boolean isResultType) {
+        int i = method_name.indexOf(HACK);
+        if (i < 0) return null;
+        String tail = method_name.substring(i + HACK.length());
+        String arg = null, res = null;
+        java.util.regex.Matcher m;
+        if ((m = java.util.regex.Pattern.compile("(NN32|NN64|Character)ArgumentAndResultType").matcher(tail)).matches()) {
+            arg = res = m.group(1);
+        } else if ((m = java.util.regex.Pattern.compile("(NN32|NN64|Character)ArgumentTypeAnd(NN32|NN64|Character)ResultType").matcher(tail)).matches()) {
+            arg = m.group(1); res = m.group(2);
+        } else if ((m = java.util.regex.Pattern.compile("(NN32|NN64|Character)ArgumentType").matcher(tail)).matches()) {
+            arg = m.group(1);
+        } else if ((m = java.util.regex.Pattern.compile("(NN32|NN64|Character)ResultType").matcher(tail)).matches()) {
+            res = m.group(1);
+        } else return null;
+        String t = isResultType ? res : arg;
+        if (t == null) return null;
+        String carrier = t.equals("NN64") ? "J" : "I";
+        return s.equals(carrier) ? t : null;
+    }
+

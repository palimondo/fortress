component PSilent
export Executable
(* 1: a primed local bound to a scalar-times-vector sum, as adam's first line *)
s1[\nat n\](m: Vector[\RR64,n\], g: Vector[\RR64,n\]): Vector[\RR64,n\] = do
    m' = 0.5 m + 0.5 g
    zz: ZZ32 = "after s1"
    m'
  end
(* 2: the same, no prime *)
s2[\nat n\](m: Vector[\RR64,n\], g: Vector[\RR64,n\]): Vector[\RR64,n\] = do
    mm = 0.5 m + 0.5 g
    zz: ZZ32 = "after s2"
    mm
  end
(* 3: a primed local bound to something plain *)
s3[\nat n\](m: Vector[\RR64,n\]): Vector[\RR64,n\] = do
    m' = m
    zz: ZZ32 = "after s3"
    m'
  end
(* 4: scalar times vector alone, a variable scalar *)
s4[\nat n\](m: Vector[\RR64,n\], b: RR64): Vector[\RR64,n\] = do
    mm = b m
    zz: ZZ32 = "after s4"
    mm
  end
(* 5: the unsized original, as the baseline's adam *)
s5(m: Array[\RR64,ZZ32\], g: Array[\RR64,ZZ32\]): Array[\RR64,ZZ32\] = do
    m' = 0.5 m + 0.5 g
    zz: ZZ32 = "after s5"
    m'
  end
run(): () = ()
end

component PrecDotMixed
export Executable
run() = do
  a: ZZ32 = 3
  println("a DOTMINUS a DOTMINUS a, left -3, right 3: " (a DOTMINUS a DOTMINUS a))
  println("a DOTMINUS a DOTPLUS a, left 3, right -3: " (a DOTMINUS a DOTPLUS a))
  println("a DOTPLUS a DOTTIMES a, DOTTIMES tighter 12, looser 18: " (a DOTPLUS a DOTTIMES a))
  println("a DOTTIMES a DOTMINUS a, DOTTIMES tighter 6, looser 0: " (a DOTTIMES a DOTMINUS a))
end
end

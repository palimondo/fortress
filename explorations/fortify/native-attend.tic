% Attention at the index-formula rung (explorations/microgpt_native.fss),
% excerpted for the presentation's notation ladder. Regenerate:
%   bin/fortick explorations/fortify/native-attend.tic
%   TEXINPUTS=".:$FORTRESS_HOME/Fortify:" latex native-attend.tex
%   dvisvgm --no-fonts --exact-bbox -o native-attend-light.svg native-attend.dvi
\documentclass{article}
\usepackage{fortify}
\usepackage[active,tightpage]{preview}
\setlength\PreviewBorder{6pt}
\begin{document}
\begin{preview}
`attScore(q: List[\V\], k: List[\V\]): V = do
  dk = |q|
  (BIG OPLUS[m <- 0#dk] q[m] k[m]) / (SQRT (dk 1.0))
end

attend(q: List[\V\], ks: List[\List[\V\]\], vs: List[\List[\V\]\]): List[\V\] = do
  n = |ks|
  hsz = |q|
  p = softmax(<|[\V\] (attScore(q, ks[j])) | j <- 0#n|>)
  <|[\V\] (BIG OPLUS[j <- 0#n] p[j] ((vs[j])[m])) | m <- 0#hsz|>
end`
\end{preview}
\end{document}

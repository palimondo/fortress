component SkMaxZW
export Executable
run() = do
  m = BIG MAX[\ZZ32\][i <- 0#5] |i - 2|
  println("written max = " m)
  s = SUM[\ZZ32\][i <- 0#200, j <- 0#200] (i - j)
  println("written nested sum = " s)
  q = SUM[\QQ\][i <- 1#30, j <- 1#30] 1/(i+j)
  println("QQ nested sum = " q)
  z = PROD[\ZZ\][i <- 1#40] big(i)
  println("ZZ prod = " z)
  w = SUM[\ZZ64\][i <- 0#100000, j <- 0#3] widen(i) j
  println("ZZ64 nested sum = " w)
end
end

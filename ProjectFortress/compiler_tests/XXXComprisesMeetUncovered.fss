(* By the comprises clauses every value of both S and T is a V, and no declaration is on V, so f(S) and f(T) are an invalid overloading. *)
component XXXComprisesMeetUncovered
export Executable

trait S comprises { U, V } end
trait T comprises { V, W } end
trait U extends S excludes W end
trait V extends { S, T } end
trait W extends T end
object X extends V end

f(s: S): ZZ32 = 1
f(t: T): ZZ32 = 2

run(): () = do
    g: S = X
    assert(f(g), 1, "the declaration for S")
    println("PASS")
end

end

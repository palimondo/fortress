component XXXDottedMethodMeetAbstractSibling
export Executable

(* An object that inherits an abstract dotted method from one trait and a concrete one with the same parameter types from another, and declares none of its own, provides both and no declaration on their meet, a static error the type checker gives (overloading.tex, section "Meet Rule"; traits.tex, section "Method Declarations"). *)

trait A
  m(): String
end
trait B
  m(): String = "b"
end
object O extends { A, B } end

run(): () = do
  x: A = O
  println(x.m())
end

end

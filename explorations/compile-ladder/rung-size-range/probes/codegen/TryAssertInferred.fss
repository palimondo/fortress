(* See explorations/compile-ladder/rung-size-range/REPORT.md. *)
component TryAssertInferred
export Executable

fAny[\T extends Any\](): T = throw InvalidRange
c1(): ZZ32 = fAny()

run(): () = do
    println("REACHED")
    r = try c1() catch e InvalidRange => -1 end
    println("c1: " || r)
    assert(r = -1, "row 505: fAny's body throws InvalidRange whatever T is bound to; Specification/basic/inference.tex:191-196")
    println("PASS")
  end

end

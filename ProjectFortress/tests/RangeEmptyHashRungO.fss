(*) explorations/compile-ladder/rung-overflow-natives/REPORT.md

component RangeEmptyHashRungO
export Executable

run(): () = do
    println("REACHED")
    zMax: ZZ32 = 7FFFFFFF_16
    zMin: ZZ32 = -zMax - 1
    zero: ZZ32 = 0
    emptyAtMin = zMin # zero
    maxInside = zMax IN emptyAtMin
    assert(NOT maxInside, "ranges.tex, section \"Ranges\"")
    emptySize = emptyAtMin.size
    assert(emptySize = 0, "ranges.tex, section \"Ranges\"")
    println("PASS")
  end

end

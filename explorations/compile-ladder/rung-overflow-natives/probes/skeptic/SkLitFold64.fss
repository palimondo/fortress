component SkLitFold64
export Executable

sz(f: () -> ZZ64): String =
  try
    (f()).asString
  catch e
    IntegerOverflow => "IntegerOverflow"
    Exception => "OTHER"
  end

lit(): ZZ64 = 4611686018427387904 + 4611686018427387904

run(): () = do
  println("F03 ZZ64 numerals 2^62 + 2^62 = " sz(fn () => lit()))
  println("END")
end

end

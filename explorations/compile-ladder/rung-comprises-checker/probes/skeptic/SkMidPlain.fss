component SkMidPlain
export Executable
trait Shape comprises { Round } end
trait Round extends Shape end
trait Sized[\X\] extends Shape end
trait Mid extends Sized[\ZZ32\] end
object M extends Mid end
kind(s: Shape): String = typecase s of
    Round => "round"
    else => "other"
  end
run(): () = println(kind(M))
end

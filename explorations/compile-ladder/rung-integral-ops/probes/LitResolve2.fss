component LitResolve2
export Executable

(*) Probe 2: the two questions the shape of this rung turns on.
(*)
(*) (a) A binary operator applied to two integer literals that the folding
(*) phase does not recognise (desugarer/IntegerLiteralFoldingVisitor.java:105-106
(*) returns the OpExpr unchanged) reaches TYPECHECK with two IntLiteralExprs.
(*) << and >> are not in the folder's list and are declared on ZZ32, ZZ64,
(*) NN32 and NN64 and not on IntLiteral, so "3 << 4" shows whether several
(*) candidates reachable by coercion are ambiguous.
(*) BITAND is also not folded, and IS declared on IntLiteral with a throwing
(*) body (CompilerBuiltin.fss:844), so "3 BITAND 4" shows whether IntLiteral's
(*) own overload beats a coerced numeric one: a throw means it wins, a 0 means
(*) coercion wins.
(*)
(*) (b) what DIV does at the two failure points, which is the precedent for
(*) what MOD and REM must do.  Both operands are computed at run time so the
(*) folding phase cannot reach them.

opaque(x: ZZ32): ZZ32 = if x > 0 then x else x end

run():() = do
    println("literal << literal: " || (3 << 4).asString)
    println("literal >> literal: " || (3 >> 1).asString)
    println("literal BITAND literal: " || (3 BITAND 4).asString)
  end
end

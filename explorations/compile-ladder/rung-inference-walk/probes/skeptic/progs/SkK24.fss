component SkK24
export Executable

shw(v: Any): String =
  typecase v of
    v1: ZZ32 => v1.asString || ":ZZ32"
    v2: ZZ64 => v2.asString || ":ZZ64"
    v3: NN32 => v3.asString || ":NN32"
    v4: RR64 => v4.asString || ":RR64"
    v5: String => v5 || ":String"
    else => "other"
  end

run(): () = do
    m = matrix[\RR64,2,2\]()
    m[0,0] := 1.5
    m[0,1] := 2.0
    m[1,0] := 0.5
    m[1,1] := 4.0
    i: ZZ32 = 3
    a: Array[\RR64,ZZ32\] = array[\RR64\](2)
    a[0] := 1.5
    a[1] := 0.25
    println("(a + i)[1] = " shw((a + i)[1]))
  end

end

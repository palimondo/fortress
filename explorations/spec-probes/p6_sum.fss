component p6_sum
import List.{...}
export Executable

object V(var data: RR64, children: List[\V\], grads: List[\RR64\])
  getter asString(): String = "V(" data ")"
end
konst(d: RR64): V = V(d, emptyList[\V\](), emptyList[\RR64\]())

vsum(addends: List[\V\]): V =
  V(SUM[a <- seq(addends)] a.data, addends, <|[\RR64\] 1.0 | a <- addends|>)

object VConcat extends MonoidReduction[\List[\V\]\]
  getter asString(): String = "VConcat"
  empty(): List[\V\] = emptyList[\V\]()
  join(a: List[\V\], b: List[\V\]): List[\V\] = a || b
end

(* the library declares  opr SUM[\T extends Number\](): Comprehension[...]
   -- try adding an overload for the V carrier.  Spec basic/expressions/
   reductions.tex places no Number constraint on BIG Op. *)
opr SUM(): Comprehension[\V,V,List[\V\],List[\V\]\] =
  Comprehension[\V,V,List[\V\],List[\V\]\](fn l => vsum(l), VConcat,
                                           fn v => singleton[\V\](v))
opr SUM(g: Generator[\V\]): V =
  __bigOperatorSugar[\V,V,List[\V\],List[\V\]\](SUM(), g)

run() = do
  xs = <|[\V\] konst(1.0), konst(2.0), konst(3.0)|>
  s = SUM[x <- xs] x
  println("SUM over V = " s "  children " |s.children|)
  println("SUM over RR64 still works = " (SUM[i <- 1#10] (i 1.0)))
end
end

+    /**
+     * Whether a bound of the type parameter tp mentions tp itself (an F-bound).
+     */
+    private static boolean mentionsItself(StaticParam tp) {
+        Set<String> self = Collections.singleton(NodeUtil.getName(tp));
+        for (Type tr : tp.getExtendsClause()) if (!mentions(tr, self).isEmpty()) return true;
+        return false;
+    }
+
+    /**
+     * Probe P1, way "the witness's first type": an F-bounded type parameter that nothing at the call fixes takes
+     * ZZ32, the first type the library's witness typecases test, where ZZ32 meets its bounds with the parameter at
+     * ZZ32; else BottomType as before.
+     */
+    private static FType unfixedSelfBounded(StaticParam tp, GenericFunctionOrMethod g) {
+        Environment within = g.getWithin();
+        FType z = within.getTypeNull("ZZ32");
+        if (z == null) return null;
+        Environment e = within.extend();
+        e.putType(NodeUtil.getName(tp), z);
+        EvalType et = new EvalType(e);
+        for (Type tr : tp.getExtendsClause()) {
+            try {
+                if (!z.subtypeOf(et.evalType(tr))) return null;
+            }
+            catch (FortressException ex) {
+                return null;
+            }
+        }
+        return z;
+    }

component SkTaskFor
export Executable

object BoxT[\T\](v: ZZ32) end
object Box[\nat k\](v: ZZ32) end
which(x: Any): String = typecase x of
    BoxT[\String\] => "string"
    BoxT[\ZZ32\] => "zz32"
    BoxT[\Boolean\] => "bool"
    Box[\3\] => "three"
    Box[\4\] => "four"
    else => "other"
  end
lbl(x: Any): String = which(x)
idz(n: ZZ32): ZZ32 = n

seen: ZZ32 := 0
forT[\T\](): ZZ32 = do
  for i <- 0#8 do
    if which(BoxT[\T\](i)) = "bool" then atomic do seen := seen + 1 end end
  end
  seen
end

run(): () = do
  println("forT: " forT[\Boolean\]())
end

end

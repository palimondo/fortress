# Minor special-case acceleration here.
if [ -z "$FORTRESS_HOME" ]; then
   export FORTRESS_HOME="`${0%debugOpt}fortress_home`"
fi

if (uname | egrep CYGWIN > /dev/null) ; then
  SEP=";"
else
  SEP=":"
fi

# Tool jars (and ProjectFortress/build + bytecode_cache) come from
# bin/fortress_classpath, the single place that knows toolchain versions.
BASIC_CLASS_PATH="`"${FORTRESS_HOME}"/bin/fortress_classpath`"
CP="expanded.jar${SEP}$FORTRESS_HOME/default_repository/caches/optimizedbytecode_cache/*${SEP}$FORTRESS_HOME/default_repository/caches/bytecode_cache${SEP}$FORTRESS_HOME/default_repository/caches/bytecode_cache/*${SEP}$FORTRESS_HOME/default_repository/caches/nativewrapper_cache${SEP}${BASIC_CLASS_PATH}${SEP}/tmp/expanded.jar${SEP}$CP"
# echo $CP
if [ -z "$JAVA_HOME" ] ; then
  JAVACMD=java
else
  JAVACMD="$JAVA_HOME/bin/java"
fi

if [ -z "$JAVA_FLAGS" ] ; then
  JAVA_FLAGS="-Xmx768m"
fi

JAVA_FLAGS+=" -Dfile.encoding=UTF-8"

# echo "$JAVACMD" $JAVA_FLAGS "-Xbootclasspath/p:$CP" "$@"

"$JAVACMD" $JAVA_FLAGS -cp "$CP" org.objectweb.asm.util.CheckClassAdapter  "$@"

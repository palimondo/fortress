component SuperscriptAfterCallRefusedCompiled
export Executable

(* A call followed directly by a superscript is a static error: juxtameaning.tex, section "Juxtaposition". *)

opr (x: ZZ32)^T: ZZ32 = x + 100

f(x: ZZ32): ZZ32 = x + 1

run(): () = println(f(3)^T)

end

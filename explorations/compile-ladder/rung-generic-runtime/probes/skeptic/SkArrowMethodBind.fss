component SkArrowMethodBind
export Executable

trait Cond[\E\] getter tag(): String end
trait Rel[\E\] extends Cond[\E\] end
object RelOf[\E\](k: ZZ32) extends Rel[\E\] getter tag(): String = "rel" || k.asString end
object CondOf[\E\] extends Cond[\E\] getter tag(): String = "cond" end

object Combiner[\E\](base: ZZ32)
  pick[\F\](p: E -> Cond[\F\], q: F -> Cond[\E\]): String =
    typecase p of
      rp:(E -> Rel[\F\]) =>
        typecase q of
          rq:(F -> Rel[\E\]) =>
            do
              both = fn (e: E, f: F): String => rp(e).tag || "+" || rq(f).tag
              both(self.e0(), self.f0[\F\]())
            end
          else => "p only"
        end
      else => "neither"
    end
  e0(): E = throw MatchFailure
  f0[\F\](): F = throw MatchFailure
end

apply2[\E\](p: ZZ32 -> Cond[\E\]): String =
  typecase p of
    rp:(ZZ32 -> Rel[\E\]) => rp(1).tag || rp(2).tag
    else => "cond"
  end

var hits: ZZ32 = 0
run(): () = do
  r = fn (x: ZZ32): Rel[\String\] => RelOf[\String\](x)
  c = fn (x: ZZ32): Cond[\String\] => CondOf[\String\]
  rb = fn (x: ZZ32): Rel[\Boolean\] => RelOf[\Boolean\](x + 10)
  println(apply2[\String\](r) " " apply2[\String\](c) " " apply2[\Boolean\](rb))
  for i <- 0#64 do
    s = if i MOD 2 = 0 then apply2[\String\](r) else apply2[\Boolean\](rb) end
    if s = "rel1rel2" OR: s = "rel11rel12" then atomic do hits := hits + 1 end end
  end
  println("hits " hits.asString)
end

end

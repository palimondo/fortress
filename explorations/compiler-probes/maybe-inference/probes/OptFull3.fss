component OptFull3
export Executable
(*) B2a: static argument inferred from the constructor argument alone.
trait Opt[\T\] comprises { Full[\T\], Empty[\T\] } end
value object Full[\T\](x: T) extends Opt[\T\] end
value object Empty[\T\] extends Opt[\T\] end

f(o: Opt[\ZZ32\]): ZZ32 =
    typecase o of
        Full[\ZZ32\] => 1
        else => 0
    end

run():() = do
    print("OptFull3=")
    println(f(Full(3)))
end
end

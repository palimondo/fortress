component MethSwapped
export Executable

(* The swapped-parameter program of XXXDispatchSwappedArmRungG as two generic dotted methods. *)
trait Two[\A,B\] end
trait SubTwo[\A,B\] extends Two[\A,B\] end
object Red end
object Blue end
object RedAndBlue extends SubTwo[\Red,Blue\] end
trait Marker[\A,B\] end
object TwoM[\A,B\] extends Marker[\A,B\] end
object SubM[\A,B\] extends Marker[\A,B\] end

object K
  pair[\A,B\](t: Two[\A,B\]): Marker[\A,B\] = TwoM[\A,B\]
  pair[\B,A\](t: SubTwo[\B,A\]): Marker[\B,A\] = SubM[\B,A\]
end

run(): () = do
  t1: Two[\Red,Blue\] = RedAndBlue
  println("K.pair(t1), t1: Two[Red,Blue] = RedAndBlue -> " || (typecase K.pair(t1) of
      SubM[\Red,Blue\] => "SubM[Red,Blue]"; TwoM[\Red,Blue\] => "TwoM[Red,Blue]"; else => "other" end))
end
end

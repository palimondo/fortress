(* A try with a catch clause runs in an arm of a parallel do after the first. *)
component TryInArmRungG
export Executable

object Oops(code: ZZ32) extends CheckedException end
boomU(k: ZZ32): () = throw Oops(k)
var hit: ZZ32 = 0
note(k: ZZ32): () = atomic do hit := hit + k end

tryInArm(k: ZZ32): () = do
  do
    note(1)
  also do
    try boomU(k) catch e Oops => note(e.code) end
  end
end

run(): () = do
  tryInArm(5)
  assert(hit, 6, "a try ... catch in a do ... also arm; Specification/basic/expressions/also.tex, subsection \"Parallel Do Expressions\", Specification/basic/expressions/try.tex, section \"Try Expressions\"")
  println("PASS")
end

end

component EdgeNN64ZZ64Max
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    NN32 => "NN32"
    NN64 => "NN64"
    ZZ => "ZZ"
    QQ => "QQ"
    RR64 => "RR64"
    else => "other"
  end

run(): () = do
    v: NN64 = unsigned(widen(-1))
    w: ZZ64 = widen(-5)
    r = v MAX w
    println("v MAX w = " r " : " typeOf(r))
  end

end

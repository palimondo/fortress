(* A local function that leaves the type of its parameter out is refused with the name of the parameter, as a top-level function is, since the compiled checker infers no parameter type (type-inference.tex, section "Type Inference for Components", and its revision). *)
component LocalFunctionUntypedParam
export Executable

h(x: ZZ32): ZZ32 = do
    body(i): ZZ32 = i + x
    body(3)
  end

run(): () = println(h(4))

end

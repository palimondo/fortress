component MaxNumNN64
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    NN32 => "NN32"
    NN64 => "NN64"
    ZZ => "ZZ"
    QQ => "QQ"
    RR64 => "RR64"
    else => "other"
  end

run() = do
    b: NN64 = unsigned(widen(3))
    r = b MAX 1
    println("b MAX 1 = " r " : " typeOf(r))
end

end

+    private static Type elementTypeOf(GenericFunctionOrMethod g) {
+        Option<Type> rt = g.getReturnType();
+        if (rt.isNone() || !(rt.unwrap() instanceof TraitType)) return null;
+        TraitType tt = (TraitType) rt.unwrap();
+        String head = NodeUtil.nameString(tt.getName());
+        if (!(head.endsWith("Comprehension") || head.endsWith("BigReduction") || head.endsWith("BigOperator"))) return null;
+        List<StaticArg> sas = tt.getArgs();
+        if (sas.isEmpty() || !(sas.get(0) instanceof TypeArg)) return null;
+        return ((TypeArg) sas.get(0)).getTypeArg();
+    }

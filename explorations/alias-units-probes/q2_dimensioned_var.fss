(* Q2 probe 2: the spec's own worked example of a dimensioned variable.
   Specification/basic/dimensions.tex:132-143, ASCII source in the LaTeX
   comments verbatim:
       x: RR64 Length = 1.3 m_
       t: RR64 Time = 5 s_
       v: RR64 Velocity = x / t
   The chapter's own header note (dimensions.tex:15-17) says
   "Dimensions and units are not yet supported.  The examples in this chapter
   are not tested nor run by the interpreter." -- probing to record HOW it
   fails and at which stage. *)
component q2_dimensioned_var
export Executable

dim Length  SI_unit meter meters m_
dim Time    SI_unit second seconds s_
dim Velocity = Length / Time

run() = do
  x: RR64 Length = 1.3 m_
  t: RR64 Time = 5 s_
  v: RR64 Velocity = x / t
  println("v = " v)
end

end

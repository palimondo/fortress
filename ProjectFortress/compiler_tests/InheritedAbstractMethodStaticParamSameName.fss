(* An object whose static parameter has the name of an inherited abstract generic method's own implements that method: the method's parameter stays its own, so the object is valid and the call runs the object's declaration. *)
component InheritedAbstractMethodStaticParamSameName
export Executable

trait Gen[\E\]
    gen[\R\](f: E -> R): R
end
trait Pair[\R\] extends Gen[\Pair[\R\]\]
end
object P[\R\](x: R) extends Pair[\R\]
    gen[\G\](f: Pair[\R\] -> G): G = f(self)
end

run(): () = do
    p = P[\ZZ32\](3)
    assert(p.gen[\String\](fn (q: Pair[\ZZ32\]): String => "gen"), "gen", "the object's declaration of gen implements the abstract method gen it inherits, whose own static parameter R is not the object's, and runs; Specification/basic/traits.tex, section \"Method Declarations\"")
    println("PASS")
end
end

+    /**
+     * The trace of conditional extension: where the environment variable
+     * FORTRESS_CONDEXT_TRACE is set, each entry read under its condition is
+     * printed to the standard error, with whether it holds.  (Probe only.)
+     */
+    private static final boolean CONDEXT_TRACE = System.getenv("FORTRESS_CONDEXT_TRACE") != null;
+
+    /**
+     * The entry ttw of an extends clause holds only where its where clause
+     * holds: the clause binds no variable and states only constraints
+     * X extends B (conditional extension, as the compiled checker reads it,
+     * KindEnv.extendsConditions).  Any other entry is extended at every
+     * instance, its where clause unread.
+     */
+    private static boolean conditional(TraitTypeWhere ttw) {
+        if (ttw.getWhereClause().isNone()) return false;
+        WhereClause wc = ttw.getWhereClause().unwrap();
+        if (!wc.getBindings().isEmpty() || wc.getConstraints().isEmpty()) return false;
+        for (WhereConstraint w : wc.getConstraints()) {
+            if (!(w instanceof WhereExtends)) return false;
+        }
+        return true;
+    }
+
+    /**
+     * The types of the extends clause ttws that the type owner extends, in
+     * the environment interior of its static arguments, et evaluating there:
+     * every entry but a conditional one whose condition fails, that is, where
+     * some X is not a subtype of one of its B, as processWhereClauses checks
+     * a declaration's own constraint.  A condition that cannot be evaluated
+     * fails.
+     */
+    private static List<BaseType> holdingExtends(List<TraitTypeWhere> ttws, EvalType et,
+                                                 Environment interior, FType owner) {
+        List<BaseType> res = new ArrayList<BaseType>(ttws.size());
+        for (TraitTypeWhere ttw : ttws) {
+            if (!conditional(ttw)) {
+                res.add(ttw.getBaseType());
+                continue;
+            }
+            boolean holds = true;
+            String why = "";
+            try {
+                for (WhereConstraint w : ttw.getWhereClause().unwrap().getConstraints()) {
+                    WhereExtends we = (WhereExtends) w;
+                    FType ft = interior.getLeafTypeNull(NodeUtil.nameString(we.getName()));
+                    if (ft == null) {
+                        holds = false;
+                        why = " (" + NodeUtil.nameString(we.getName()) + " unbound)";
+                        break;
+                    }
+                    for (BaseType b : we.getSupers()) {
+                        FType st = et.evalType(b);
+                        if (!ft.subtypeOf(st)) {
+                            holds = false;
+                            why = " (" + ft + " is not a " + st + ")";
+                            break;
+                        }
+                    }
+                    if (!holds) break;
+                }
+            }
+            catch (FortressException ex) {
+                holds = false;
+                why = " (error: " + ex.getMessage() + ")";
+            }
+            if (CONDEXT_TRACE) System.err.println(errorMsg("condext: ", owner, " extends ", ttw.getBaseType(), ": ",
+                                                           holds ? "kept" : "dropped" + why));
+            if (holds) res.add(ttw.getBaseType());
+        }
+        return res;
+    }

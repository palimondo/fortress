(* A function whose where clause bounds its type parameter compiles: a method of the bound is found on a value of that parameter, and the function is compiled. *)
component XXXWhereBoundChecker
export Executable

trait T
  f(): String
end
object O extends T
  f(): String = "O"
end

g[\U\](u: U): String where { U extends T } = u.f()

run(): () = println(g(O))

end

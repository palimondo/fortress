(* FlatArrays -- the array vocabulary for MicroGptFlat (Run C3): the views
   into a flat vector and into a matrix, the elementwise algebra the library
   lacks (declared once, in its own style: top-level opr with nat parameters,
   ledger row 150 and explorations/run-c3/survey.md), the row lift, gather,
   onehot, pick and the transpose operator. Every value stays a library array;
   nothing here wraps. What the library already gives is not redeclared:
   array + array, scalar multiplication both orders, DOT and the juxtaposition
   products, unary minus, .t(), SUM and BIG MAX over any array as a generator. *)
component FlatArrays
export FlatArrays
import NatReflect.{...}

(* ---------------------------------------------------- constructors ------ *)
vec(n: ZZ32, f: ZZ32 -> RR64): Array[\RR64,ZZ32\] = array[\RR64\](n).fill(f)
zeros(n: ZZ32): Array[\RR64,ZZ32\] = array[\RR64\](n).fill(0.0)
keys(n: ZZ32, f: ZZ32 -> ZZ32): Array[\ZZ32,ZZ32\] = array[\ZZ32\](n).fill(f)
mat(r: ZZ32, c: ZZ32, f: (ZZ32,ZZ32) -> RR64): Array[\RR64,(ZZ32,ZZ32)\] = array[\RR64\](r,c).fill(f)
zerosM(r: ZZ32, c: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] = array[\RR64\](r,c).fill(0.0)

(* ------------------------------------------------------------ views ----- *)
(* rows x cols of a flat vector at off, row-major: matrix i of P (Hsu's
   tactic 8); a real Matrix, so the library product, .t() and + apply, and
   writes reach the vector *)
object PView[\nat s, nat r, nat c\](base: Vector[\RR64,s\], off: ZZ32) extends Matrix[\RR64,r,c\]
    get(ij:(ZZ32,ZZ32)): RR64 = do (i,j) = ij; base.get(off + i c + j) end
    put(ij:(ZZ32,ZZ32), x: RR64): () = do (i,j) = ij; base.put(off + i c + j, x) end
    init0(ij:(ZZ32,ZZ32), x: RR64): () = do (i,j) = ij; base.init0(off + i c + j, x) end
    replica[\U\](): Array2[\U,0,r,0,c\] = array2[\U,r,c\]()
end
viewOf[\nat s, nat r, nat c\](base: Vector[\RR64,s\], off: ZZ32, _: N[\r\], _: N[\c\]): Matrix[\RR64,r,c\] =
    PView[\s,r,c\](base, off)
view[\nat s\](p: Vector[\RR64,s\], off: ZZ32, nr: ZZ32, nc: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] =
    viewOf(p, off, reflect(nr), reflect(nc))
(* a rows x cols block of a matrix at (r0, c0) *)
object Block[\nat br, nat bc, nat r, nat c\](base: Matrix[\RR64,br,bc\], r0: ZZ32, c0: ZZ32) extends Matrix[\RR64,r,c\]
    get(ij:(ZZ32,ZZ32)): RR64 = do (i,j) = ij; base.get(r0 + i, c0 + j) end
    put(ij:(ZZ32,ZZ32), x: RR64): () = do (i,j) = ij; base.put((r0 + i, c0 + j), x) end
    init0(ij:(ZZ32,ZZ32), x: RR64): () = do (i,j) = ij; base.init0((r0 + i, c0 + j), x) end
    replica[\U\](): Array2[\U,0,r,0,c\] = array2[\U,r,c\]()
end
blockOf[\nat br, nat bc, nat r, nat c\](base: Matrix[\RR64,br,bc\], r0: ZZ32, c0: ZZ32, _: N[\r\], _: N[\c\]): Matrix[\RR64,r,c\] =
    Block[\br,bc,r,c\](base, r0, c0)
block[\nat br, nat bc\](base: Matrix[\RR64,br,bc\], r0: ZZ32, c0: ZZ32, nr: ZZ32, nc: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] =
    blockOf(base, r0, c0, reflect(nr), reflect(nc))
(* row i of a matrix as a Vector with the whole vector algebra (the library's
   m[i,:] is an Array1 without it, ledger row 54) *)
object Row[\nat r, nat c\](base: Matrix[\RR64,r,c\], i: ZZ32) extends Vector[\RR64,c\]
    get(j: ZZ32): RR64 = base.get(i, j)
    put(j: ZZ32, v: RR64): () = base.put((i, j), v)
    init0(j: ZZ32, v: RR64): () = base.init0((i, j), v)
    replica[\U\](): Array1[\U,0,c\] = array1[\U,c\]()
end
row[\nat r, nat c\](m: Matrix[\RR64,r,c\], i: ZZ32): Vector[\RR64,c\] = Row[\r,c\](m, i)

(* ------------------------------ the elementwise algebra, with scalars ---- *)
zipV[\nat s, nat t\](f: (RR64,RR64) -> RR64, a: Vector[\RR64,s\], b: Vector[\RR64,t\]): Array[\RR64,ZZ32\]
        requires { |a| = |b| } = vec(|a|, fn (i: ZZ32): RR64 => f(a[i], b[i]))
zipM[\nat r, nat c, nat p, nat q\](f: (RR64,RR64) -> RR64, a: Matrix[\RR64,r,c\], b: Matrix[\RR64,p,q\]): Array[\RR64,(ZZ32,ZZ32)\]
        = do (nr, nc) = a.sizes; mat(nr, nc, fn (i: ZZ32, j: ZZ32): RR64 => f(a[i,j], b[i,j])) end
opr ×[\nat s, nat t\](a: Vector[\RR64,s\], b: Vector[\RR64,t\]): Array[\RR64,ZZ32\] = zipV(fn (x: RR64, y: RR64): RR64 => x y, a, b)
opr ×[\nat r, nat c, nat p, nat q\](a: Matrix[\RR64,r,c\], b: Matrix[\RR64,p,q\]): Array[\RR64,(ZZ32,ZZ32)\] = zipM(fn (x: RR64, y: RR64): RR64 => x y, a, b)
opr /[\nat s, nat t\](a: Vector[\RR64,s\], b: Vector[\RR64,t\]): Array[\RR64,ZZ32\] = zipV(fn (x: RR64, y: RR64): RR64 => x / y, a, b)
opr /[\nat s\](v: Vector[\RR64,s\], a: RR64): Array[\RR64,ZZ32\] = v.map[\RR64\](fn (x: RR64): RR64 => x / a)
opr /[\nat r, nat c\](m: Matrix[\RR64,r,c\], a: RR64): Array[\RR64,(ZZ32,ZZ32)\] = m.map[\RR64\](fn (x: RR64): RR64 => x / a)
opr +[\nat s\](v: Vector[\RR64,s\], a: RR64): Array[\RR64,ZZ32\] = v.map[\RR64\](fn (x: RR64): RR64 => x + a)
opr +[\nat s\](a: RR64, v: Vector[\RR64,s\]): Array[\RR64,ZZ32\] = v.map[\RR64\](fn (x: RR64): RR64 => a + x)
opr -[\nat s\](v: Vector[\RR64,s\], a: RR64): Array[\RR64,ZZ32\] = v.map[\RR64\](fn (x: RR64): RR64 => x - a)
opr SQRT[\nat s\](v: Vector[\RR64,s\]): Array[\RR64,ZZ32\] = v.map[\RR64\](fn (x: RR64): RR64 => SQRT x)
exp[\nat s\](v: Vector[\RR64,s\]): Array[\RR64,ZZ32\] = v.map[\RR64\](fn (x: RR64): RR64 => exp x)
log[\nat s\](v: Vector[\RR64,s\]): Array[\RR64,ZZ32\] = v.map[\RR64\](fn (x: RR64): RR64 => log x)
opr MAX[\nat r, nat c\](a: RR64, m: Matrix[\RR64,r,c\]): Array[\RR64,(ZZ32,ZZ32)\] = m.map[\RR64\](fn (x: RR64): RR64 => a MAX x)
(* comparisons on arrays yield 0/1 arrays, as APL's do (ledger row 41, apl base) *)
opr >[\nat r, nat c\](m: Matrix[\RR64,r,c\], a: RR64): Array[\RR64,(ZZ32,ZZ32)\] = m.map[\RR64\](fn (x: RR64): RR64 => if x > a then 1.0 else 0.0 end)

(* ------------------------------------------------------ the row lift ----- *)
(* f⍤1: f on every row, the results stacked; a matrix when f yields a vector,
   a vector when f yields a scalar (the overload is chosen by f's arrow type);
   dyadic over two matrices row by row, and rank 0 1 over a vector and a
   matrix. The result's width is the first row's; the rows run in parallel. *)
rows[\nat r, nat c\](f: Array[\RR64,ZZ32\] -> Array[\RR64,ZZ32\], m: Matrix[\RR64,r,c\]): Array[\RR64,(ZZ32,ZZ32)\] = do
    (nr, nc) = m.sizes
    out = zerosM(nr, |f(row(m, 0))|)
    for i <- 0#nr do row(out, i).assign(f(row(m, i))) end
    out
  end
rows[\nat r, nat c\](f: Array[\RR64,ZZ32\] -> RR64, m: Matrix[\RR64,r,c\]): Array[\RR64,ZZ32\] = do
    (nr, nc) = m.sizes
    vec(nr, fn (i: ZZ32): RR64 => f(row(m, i)))
  end
rows[\nat r, nat c, nat p, nat q\](f: (Array[\RR64,ZZ32\], Array[\RR64,ZZ32\]) -> Array[\RR64,ZZ32\],
        a: Matrix[\RR64,r,c\], b: Matrix[\RR64,p,q\]): Array[\RR64,(ZZ32,ZZ32)\] = do
    (nr, nc) = a.sizes
    out = zerosM(nr, |f(row(a, 0), row(b, 0))|)
    for i <- 0#nr do row(out, i).assign(f(row(a, i), row(b, i))) end
    out
  end
rows[\nat n, nat r, nat c\](f: (RR64, Array[\RR64,ZZ32\]) -> Array[\RR64,ZZ32\],
        v: Vector[\RR64,n\], m: Matrix[\RR64,r,c\]): Array[\RR64,(ZZ32,ZZ32)\] = do
    (nr, nc) = m.sizes
    out = zerosM(nr, |f(v[0], row(m, 0))|)
    for i <- 0#nr do row(out, i).assign(f(v[i], row(m, i))) end
    out
  end

(* ------------------------------------------------- the per-cell lift ----- *)
(* f⍤2 over the cells of matrices laid out as N rows by (nc cells side by
   side): cell (d,h) of a matrix with c columns is the cr x (c DIV nc) block
   at rows d cr.., columns h (c DIV nc)..; the results, in the same layout,
   fill a new matrix of N rows and nc x (result width) columns. Nothing is
   copied in: the cells are block views. The cells run in parallel. *)
cellOf[\nat r, nat c\](m: Matrix[\RR64,r,c\], d: ZZ32, h: ZZ32, cr: ZZ32, ncells: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] = do
    (nr, nc) = m.sizes
    block(m, d cr, h (nc DIV ncells), cr, nc DIV ncells)
  end
colsOf[\nat r, nat c\](m: Matrix[\RR64,r,c\]): ZZ32 = do (nr, nc) = m.sizes; nc end
nth2[\nat r, nat c\](m: Matrix[\RR64,r,c\], i: ZZ32, j: ZZ32): RR64 = m[i,j]
cells(f: (Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\]) -> Array[\RR64,(ZZ32,ZZ32)\],
      a: Array[\RR64,(ZZ32,ZZ32)\], b: Array[\RR64,(ZZ32,ZZ32)\], cr: ZZ32, nc: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] = do
    (n, ca) = a.sizes
    nd = n DIV cr
    rs = array[\Any\](nd nc)
    for d <- 0#nd, h <- 0#nc do rs[d nc + h] := f(cellOf(a, d, h, cr, nc), cellOf(b, d, h, cr, nc)) end
    w = colsOf(rs[0])
    mat(n, nc w, fn (i: ZZ32, j: ZZ32): RR64 => nth2(rs[(i DIV cr) nc + (j DIV w)], i MOD cr, j MOD w))
  end
cells(f: (Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\], Array[\RR64,(ZZ32,ZZ32)\]) -> Array[\RR64,(ZZ32,ZZ32)\],
      a: Array[\RR64,(ZZ32,ZZ32)\], b: Array[\RR64,(ZZ32,ZZ32)\], c: Array[\RR64,(ZZ32,ZZ32)\], cr: ZZ32, nc: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] = do
    (n, ca) = a.sizes
    nd = n DIV cr
    rs = array[\Any\](nd nc)
    for d <- 0#nd, h <- 0#nc do rs[d nc + h] := f(cellOf(a, d, h, cr, nc), cellOf(b, d, h, cr, nc), cellOf(c, d, h, cr, nc)) end
    w = colsOf(rs[0])
    mat(n, nc w, fn (i: ZZ32, j: ZZ32): RR64 => nth2(rs[(i DIV cr) nc + (j DIV w)], i MOD cr, j MOD w))
  end

(* ------------------------------------------------------ keys (tactic 10) - *)
(* the rows of m at the keys: m[ks;] *)
gather[\nat r, nat c, nat k\](m: Matrix[\RR64,r,c\], ks: Vector[\ZZ32,k\]): Array[\RR64,(ZZ32,ZZ32)\] = do
    (nr, nc) = m.sizes
    mat(|ks|, nc, fn (i: ZZ32, j: ZZ32): RR64 => m[ks[i], j])
  end
(* keys to one-hot rows: ks∘.=⍳width *)
onehot[\nat k\](ks: Vector[\ZZ32,k\], width: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] =
    mat(|ks|, width, fn (i: ZZ32, j: ZZ32): RR64 => if ks[i] = j then 1.0 else 0.0 end)
(* one element per row, at the key: ks⌷⍤0 1⊢m *)
pick[\nat r, nat c, nat k\](m: Matrix[\RR64,r,c\], ks: Vector[\ZZ32,k\]): Array[\RR64,ZZ32\] =
    vec(|ks|, fn (i: ZZ32): RR64 => m[i, ks[i]])
end

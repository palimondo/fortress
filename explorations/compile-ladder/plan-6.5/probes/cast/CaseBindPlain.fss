(* CaseBindPlain -- is a typecase clause's binding read on the compiled path at all, with
   no static parameter anywhere?  A clause type that is a plain trait, and one that is
   ZZ32 with a ZZ32 value (not a numeral). *)
component CaseBindPlain
export Executable

object Wrap(v: ZZ32) end

plainTrait(x: Any): String =
  typecase x of
      w: Wrap => "Wrap(" w.v ")"
      else => "other"
    end

plainZZ32(x: Any): String =
  typecase x of
      i: ZZ32 => "ZZ32 " (i + 1)
      else => "other"
    end

run(): () = do
  z: ZZ32 = 3 + 4
  println(plainTrait(Wrap(z)))
  println(plainZZ32(z))
  println("end reached")
end
end

(* On the compiled path, the nativeHelpers that the integer types' shifts and powers name give their values, their IntegerOverflow and their DivisionByZero, an NN32 carried in a ZZ32 and an NN64 in a ZZ64. *)
component NativeHelperFamilyShiftPowerCompiled
export Executable

shl32(a:ZZ32, b:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleIntArith.intBitLeftShift")
shr32(a:ZZ32, b:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleIntArith.intBitRightShift")
pow32(a:ZZ32, b:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleIntArith.intPower")
shl64(a:ZZ64, b:ZZ64):ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleLongArith.longBitLeftShift")
shr64(a:ZZ64, b:ZZ64):ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleLongArith.longBitRightShift")
pow64(a:ZZ64, b:ZZ32):ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleLongArith.longPower")
shlN32(a:ZZ32, b:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedIntArith.unsignedIntBitLeftShift")
shrN32(a:ZZ32, b:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedIntArith.unsignedIntBitRightShift")
powN32(a:ZZ32, b:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedIntArith.unsignedIntPower")
n32ToString(a:ZZ32):JavaString = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedIntArith.unsignedIntToString")
shlN64(a:ZZ64, b:ZZ64):ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedLongArith.unsignedLongBitLeftShift")
shrN64(a:ZZ64, b:ZZ64):ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedLongArith.unsignedLongBitRightShift")
powN64(a:ZZ64, b:ZZ32):ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleUnsignedLongArith.unsignedLongPower")
shlZ(a:ZZ, b:ZZ32):ZZ = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleArbitraryPrecisionArith.bigBitLeftShift")
shrZ(a:ZZ, b:ZZ32):ZZ = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleArbitraryPrecisionArith.bigBitRightShift")
powZ(a:ZZ, b:ZZ32):ZZ = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleArbitraryPrecisionArith.bigPower")
big64(a:ZZ64):ZZ = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleArbitraryPrecisionArith.makeZZfromZZ64")

overflows32(f: () -> ZZ32): Boolean =
  try
    ignore f()
    false
  catch e
    IntegerOverflow => true
    Exception => false
  end

dividesByZero32(f: () -> ZZ32): Boolean =
  try
    ignore f()
    false
  catch e
    DivisionByZero => true
    Exception => false
  end

overflows64(f: () -> ZZ64): Boolean =
  try
    ignore f()
    false
  catch e
    IntegerOverflow => true
    Exception => false
  end

dividesByZero64(f: () -> ZZ64): Boolean =
  try
    ignore f()
    false
  catch e
    DivisionByZero => true
    Exception => false
  end

overflowsZ(f: () -> ZZ): Boolean =
  try
    ignore f()
    false
  catch e
    IntegerOverflow => true
    Exception => false
  end

dividesByZeroZ(f: () -> ZZ): Boolean =
  try
    ignore f()
    false
  catch e
    DivisionByZero => true
    Exception => false
  end

run():() = do
  min32: ZZ32 = -2147483647 - 1
  max32: ZZ32 = 2147483647
  (* ZZ32's shifts *)
  assert(shl32(5, 3), 40, "ZZ32 5 LSHIFT 3")
  assert(shl32(1, 31), min32, "ZZ32 1 LSHIFT 31")
  assert(shl32(1, 32), 0, "ZZ32 1 LSHIFT 32")
  assert(shl32(5, max32), 0, "ZZ32 5 LSHIFT the ZZ32 maximum")
  assert(shl32(5, -1), 2, "ZZ32 5 LSHIFT -1 shifts right")
  assert(shl32(-5, -32), -1, "ZZ32 -5 LSHIFT -32")
  assert(shl32(-5, min32), -1, "ZZ32 -5 LSHIFT the ZZ32 minimum")
  assert(shr32(-40, 3), -5, "ZZ32 -40 RSHIFT 3")
  assert(shr32(5, -2), 20, "ZZ32 5 RSHIFT -2 shifts left")
  assert(shr32(-40, 40), -1, "ZZ32 -40 RSHIFT 40")
  assert(shr32(5, 32), 0, "ZZ32 5 RSHIFT 32")
  assert(shr32(5, min32), 0, "ZZ32 5 RSHIFT the ZZ32 minimum")
  (* ZZ64's shifts *)
  f5: ZZ64 = 5
  m40: ZZ64 = -40
  min64: ZZ64 = -9223372036854775807 - 1
  max64: ZZ64 = 9223372036854775807
  assert(shl64(f5, 40).asString, "5497558138880", "ZZ64 5 LSHIFT 40")
  assert(shl64(1, 63).asString, "-9223372036854775808", "ZZ64 1 LSHIFT 63")
  assert(shl64(1, 64).asString, "0", "ZZ64 1 LSHIFT 64")
  assert(shl64(f5, max64).asString, "0", "ZZ64 5 LSHIFT the ZZ64 maximum")
  assert(shl64(m40, -70).asString, "-1", "ZZ64 -40 LSHIFT -70")
  assert(shl64(m40, min64).asString, "-1", "ZZ64 -40 LSHIFT the ZZ64 minimum")
  assert(shr64(m40, 3).asString, "-5", "ZZ64 -40 RSHIFT 3")
  assert(shr64(f5, -2).asString, "20", "ZZ64 5 RSHIFT -2 shifts left")
  assert(shr64(m40, 64).asString, "-1", "ZZ64 -40 RSHIFT 64")
  assert(shr64(f5, min64).asString, "0", "ZZ64 5 RSHIFT the ZZ64 minimum")
  (* NN32's shifts, 2^31 carried as the ZZ32 minimum *)
  assert(n32ToString(shlN32(3, 31)) = "2147483648", "NN32 3 LSHIFT 31")
  assert(n32ToString(shrN32(min32, 31)) = "1", "NN32 2^31 RSHIFT 31 is logical")
  assert(n32ToString(shlN32(min32, -31)) = "1", "NN32 2^31 LSHIFT -31 is logical")
  assert(n32ToString(shrN32(3, -1)) = "6", "NN32 3 RSHIFT -1 shifts left")
  assert(n32ToString(shrN32(-1, 1)) = "2147483647", "NN32 (2^32-1) RSHIFT 1")
  assert(n32ToString(shlN32(3, 32)) = "0", "NN32 3 LSHIFT 32")
  assert(n32ToString(shrN32(min32, 32)) = "0", "NN32 2^31 RSHIFT 32")
  assert(n32ToString(shlN32(min32, -32)) = "0", "NN32 2^31 LSHIFT -32")
  assert(n32ToString(shrN32(min32, min32)) = "0", "NN32 2^31 RSHIFT the ZZ32 minimum")
  assert(n32ToString(shlN32(3, max32)) = "0", "NN32 3 LSHIFT the ZZ32 maximum")
  (* NN64's shifts, 2^63 carried as the ZZ64 minimum *)
  t3: ZZ64 = 3
  assert(shlN64(t3, 63).asString, "-9223372036854775808", "NN64 3 LSHIFT 63 is 2^63")
  assert(shrN64(min64, 63).asString, "1", "NN64 2^63 RSHIFT 63 is logical")
  assert(shlN64(min64, -1).asString, "4611686018427387904", "NN64 2^63 LSHIFT -1 is logical")
  assert(shrN64(-1, 1).asString, "9223372036854775807", "NN64 (2^64-1) RSHIFT 1")
  assert(shrN64(t3, -1).asString, "6", "NN64 3 RSHIFT -1 shifts left")
  assert(shlN64(t3, 64).asString, "0", "NN64 3 LSHIFT 64")
  assert(shrN64(min64, 64).asString, "0", "NN64 2^63 RSHIFT 64")
  assert(shlN64(min64, min64).asString, "0", "NN64 2^63 LSHIFT the ZZ64 minimum")
  assert(shlN64(t3, max64).asString, "0", "NN64 3 LSHIFT the ZZ64 maximum")
  (* ZZ's shifts *)
  z5: ZZ = big64(5)
  zm5: ZZ = big64(-5)
  z0: ZZ = big64(0)
  assert(shlZ(z5, 100).asString, "6338253001141147007483516026880", "ZZ 5 LSHIFT 100")
  assert(shlZ(z5, -1).asString, "2", "ZZ 5 LSHIFT -1")
  assert(shlZ(zm5, -2).asString, "-2", "ZZ -5 LSHIFT -2 rounds down")
  assert(shlZ(z5, min32).asString, "0", "ZZ 5 LSHIFT the ZZ32 minimum")
  assert(shlZ(zm5, min32).asString, "-1", "ZZ -5 LSHIFT the ZZ32 minimum")
  assert(shlZ(zm5, -max32).asString, "-1", "ZZ -5 LSHIFT -(2^31-1)")
  assert(shlZ(z0, max32).asString, "0", "ZZ 0 LSHIFT the ZZ32 maximum")
  assert(overflowsZ(fn () => shlZ(z5, max32)), "ZZ 5 LSHIFT the ZZ32 maximum throws IntegerOverflow")
  assert(shrZ(z5, 1).asString, "2", "ZZ 5 RSHIFT 1")
  assert(shrZ(zm5, 1).asString, "-3", "ZZ -5 RSHIFT 1 rounds down")
  assert(shrZ(z5, -2).asString, "20", "ZZ 5 RSHIFT -2 shifts left")
  assert(shrZ(zm5, max32).asString, "-1", "ZZ -5 RSHIFT the ZZ32 maximum")
  assert(shrZ(z0, min32).asString, "0", "ZZ 0 RSHIFT the ZZ32 minimum")
  assert(overflowsZ(fn () => shrZ(z5, min32)), "ZZ 5 RSHIFT the ZZ32 minimum throws IntegerOverflow")
  assert(overflowsZ(fn () => shrZ(z5, -max32)), "ZZ 5 RSHIFT -(2^31-1) throws IntegerOverflow")
  (* ZZ32's power *)
  assert(pow32(2, 10), 1024, "ZZ32 2^10")
  assert(pow32(7, 2), 49, "ZZ32 7^2")
  assert(pow32(7, 1), 7, "ZZ32 7^1")
  assert(pow32(7, 0), 1, "ZZ32 7^0")
  assert(pow32(0, 0), 1, "ZZ32 0^0")
  assert(pow32(2, 30), 1073741824, "ZZ32 2^30")
  assert(pow32(-2, 31), min32, "ZZ32 (-2)^31")
  assert(overflows32(fn () => pow32(2, 31)), "ZZ32 2^31 throws IntegerOverflow")
  assert(overflows32(fn () => pow32(2, max32 - 1)), "ZZ32 2^(2^31-2) throws IntegerOverflow")
  assert(pow32(1, -3), 1, "ZZ32 1^(-3)")
  assert(pow32(-1, -3), -1, "ZZ32 (-1)^(-3)")
  assert(pow32(-1, -4), 1, "ZZ32 (-1)^(-4)")
  assert(pow32(-1, max32), -1, "ZZ32 (-1)^(2^31-1)")
  assert(pow32(-1, min32), 1, "ZZ32 (-1)^(the ZZ32 minimum)")
  assert(pow32(0, max32), 0, "ZZ32 0^(2^31-1)")
  assert(overflows32(fn () => pow32(2, -1)), "ZZ32 2^(-1) throws IntegerOverflow")
  assert(overflows32(fn () => pow32(7, -1)), "ZZ32 7^(-1) throws IntegerOverflow")
  assert(dividesByZero32(fn () => pow32(0, -1)), "ZZ32 0^(-1) throws DivisionByZero")
  assert(dividesByZero32(fn () => pow32(0, min32)), "ZZ32 0^(the ZZ32 minimum) throws DivisionByZero")
  (* ZZ64's power *)
  assert(pow64(f5, 20).asString, "95367431640625", "ZZ64 5^20")
  assert(pow64(f5, 1).asString, "5", "ZZ64 5^1")
  assert(pow64(f5, 0).asString, "1", "ZZ64 5^0")
  assert(pow64(-2, 63).asString, "-9223372036854775808", "ZZ64 (-2)^63")
  assert(overflows64(fn () => pow64(2, 63)), "ZZ64 2^63 throws IntegerOverflow")
  assert(overflows64(fn () => pow64(2, max32)), "ZZ64 2^(2^31-1) throws IntegerOverflow")
  assert(pow64(1, -5).asString, "1", "ZZ64 1^(-5)")
  assert(pow64(-1, -5).asString, "-1", "ZZ64 (-1)^(-5)")
  assert(pow64(-1, max32 - 1).asString, "1", "ZZ64 (-1)^(2^31-2)")
  assert(overflows64(fn () => pow64(2, -1)), "ZZ64 2^(-1) throws IntegerOverflow")
  assert(dividesByZero64(fn () => pow64(0, -1)), "ZZ64 0^(-1) throws DivisionByZero")
  (* NN32's power, unsigned *)
  assert(n32ToString(powN32(2, 31)) = "2147483648", "NN32 2^31")
  assert(n32ToString(powN32(65535, 2)) = "4294836225", "NN32 65535^2")
  assert(n32ToString(powN32(-1, 1)) = "4294967295", "NN32 (2^32-1)^1")
  assert(n32ToString(powN32(3, 0)) = "1", "NN32 3^0")
  assert(n32ToString(powN32(1, -1)) = "1", "NN32 1^(-1)")
  assert(n32ToString(powN32(1, max32)) = "1", "NN32 1^(2^31-1)")
  assert(n32ToString(powN32(0, max32)) = "0", "NN32 0^(2^31-1)")
  assert(overflows32(fn () => powN32(2, 32)), "NN32 2^32 throws IntegerOverflow")
  assert(overflows32(fn () => powN32(-1, 2)), "NN32 (2^32-1)^2 throws IntegerOverflow")
  assert(overflows32(fn () => powN32(2, -1)), "NN32 2^(-1) throws IntegerOverflow")
  assert(overflows32(fn () => powN32(-1, -1)), "NN32 (2^32-1)^(-1) throws IntegerOverflow")
  assert(dividesByZero32(fn () => powN32(0, -1)), "NN32 0^(-1) throws DivisionByZero")
  (* NN64's power, unsigned *)
  assert(powN64(2, 63).asString, "-9223372036854775808", "NN64 2^63")
  assert(powN64(t3, 5).asString, "243", "NN64 3^5")
  assert(powN64(min64, 1).asString, "-9223372036854775808", "NN64 (2^63)^1")
  assert(powN64(1, -1).asString, "1", "NN64 1^(-1)")
  assert(powN64(t3, 0).asString, "1", "NN64 3^0")
  assert(overflows64(fn () => powN64(2, 64)), "NN64 2^64 throws IntegerOverflow")
  assert(overflows64(fn () => powN64(min64, 2)), "NN64 (2^63)^2 throws IntegerOverflow")
  assert(overflows64(fn () => powN64(2, -1)), "NN64 2^(-1) throws IntegerOverflow")
  assert(overflows64(fn () => powN64(min64, -1)), "NN64 (2^63)^(-1) throws IntegerOverflow")
  assert(dividesByZero64(fn () => powN64(0, -1)), "NN64 0^(-1) throws DivisionByZero")
  (* ZZ's power *)
  z2: ZZ = big64(2)
  z1: ZZ = big64(1)
  zm1: ZZ = big64(-1)
  assert(powZ(z2, 100).asString, "1267650600228229401496703205376", "ZZ 2^100")
  assert(powZ(z2, 1).asString, "2", "ZZ 2^1")
  assert(powZ(z2, 0).asString, "1", "ZZ 2^0")
  assert(powZ(z0, 0).asString, "1", "ZZ 0^0")
  assert(powZ(z1, -3).asString, "1", "ZZ 1^(-3)")
  assert(powZ(zm1, -3).asString, "-1", "ZZ (-1)^(-3)")
  assert(powZ(zm1, max32 - 1).asString, "1", "ZZ (-1)^(2^31-2)")
  assert(powZ(zm1, max32).asString, "-1", "ZZ (-1)^(2^31-1)")
  assert(powZ(z0, max32).asString, "0", "ZZ 0^(2^31-1)")
  assert(overflowsZ(fn () => powZ(z2, max32)), "ZZ 2^(2^31-1) throws IntegerOverflow")
  assert(overflowsZ(fn () => powZ(z2, -1)), "ZZ 2^(-1) throws IntegerOverflow")
  assert(dividesByZeroZ(fn () => powZ(z0, -1)), "ZZ 0^(-1) throws DivisionByZero")
  assert(dividesByZeroZ(fn () => powZ(z0, min32)), "ZZ 0^(the ZZ32 minimum) throws DivisionByZero")
  println("PASS")
end

end

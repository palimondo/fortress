    do s: RR64 = 3000000000; println("s: RR64 = 3000000000: " (typeOf s)) end
  end
wBindZ(): () = do
    z: ZZ32 = 3
    w: ZZ64 = widen(4)
    r: RR64 = 2.5
    u: NN32 = unsigned(5)
    b: Box[\RR64\] = Box[\RR64\](1.0)
    do s: RR64 = z; println("s: RR64 = z: " (typeOf s)) end
  end

component XXXUnwrittenEmptyFloatSumUntypedWalk
export Executable

(* An empty sum of RR64 elements with no static argument and no declared type is the RR64 identity 0.0, as the sum directed by the expression's type RR64 is. *)

run(): () = do
    e = SUM[j <- 0#0] (j / 2.0)
    kind = typecase e of
        RR64 => "RR64"
        else => "other"
      end
    assert(kind, "RR64", "an empty sum whose expression has type RR64 is SUM[RR64] over no element, whose identity is the RR64 zero, also where no declared type directs it (reductions.tex, section \"Summations and Other Reduction Expressions\"; defining-generators.tex, subsection \"Simple Desugaring of Expressions with Generators\")")
    println("PASS")
  end

end

(* c02b: array PASTING alone (aggregate.tex: an element that is itself an
   array is pasted into the enclosing expression): [ u v ] for two vectors and
   [ A B ], [ A ; B ] for two matrices, with literal-sized types. *)
component c02b_pasting_only
export Executable

run(): () = do
  u: Vector[\RR64,2\] = [ 1.0 2.0 ]
  v: Vector[\RR64,2\] = [ 3.0 4.0 ]
  w: Vector[\RR64,4\] = [ u v ]
  println("[ u v ] = " w)
  A: Matrix[\RR64,2,2\] = [ 1.0 2.0 ; 3.0 4.0 ]
  B: Matrix[\RR64,2,2\] = [ 5.0 6.0 ; 7.0 8.0 ]
  C: Matrix[\RR64,2,4\] = [ A B ]
  println("[ A B ] = " C)
  D: Matrix[\RR64,4,2\] = [ A ; B ]
  println("[ A ; B ] = " D)
end
end

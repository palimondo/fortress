component R2ArithNatEdge
export Executable
object Box[\nat k\](v: ZZ32) end
object IBox[\int k\](v: ZZ32) end
sz[\nat k\](b: Box[\k\]): ZZ64 = k
isz[\int k\](b: IBox[\k\]): ZZ64 = k
run(): () = do
  println("REACHED")
  println("n1 4294967295 + 1 = " || sz(Box[\4294967295 + 1\](0)))
  println("END")
end
end

+
+trait Read comprises {...}
+  header: String
+  sampleACGT: String
+  name: String
+  pos: ZZ32
+  length: ZZ32
+  seqend: ZZ32
+  getter asString(): String
+  getter refACGT(): String
+  getter refColors(): String
+  getter sampleColors(): String

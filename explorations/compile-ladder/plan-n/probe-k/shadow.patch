+            @Override
+            public void forVarTypeOnly(VarType that) {
+                String n = NodeUtil.nameString(that.getName());
+                if (tp_set.contains(n)) found.add(n);
+            }
+
+            @Override
+            public void forIntRefOnly(IntRef that) {
+                String n = NodeUtil.nameString(that.getName());
+                if (tp_set.contains(n)) found.add(n);
+            }
+
+            @Override
+            public void forBoolRefOnly(BoolRef that) {
+                String n = NodeUtil.nameString(that.getName());

component AbsFnMissing
export Executable

(* AbsFnBetween without the definition for the listed type P: no definition covers P.
   Only f(O) is called, so a run that reaches it prints PASS. *)

trait A comprises { O, P } end
trait Gen[\X\] extends A end
object O extends Gen[\ZZ32\] end
object P extends Gen[\String\] end

f(a: A): ZZ32
f(o: O): ZZ32 = 0

run(): () =
    if f(O) = 0 then println("PASS") else println("FAIL") end
end

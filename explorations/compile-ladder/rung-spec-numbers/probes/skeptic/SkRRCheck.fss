component SkRRCheck
export Executable
run() = do
  inf: RR64 = 1.0 / 0.0
  nan: RR64 = 0.0 / 0.0
  x: RR64 = 2.5
  println("check of 1.0/0.0, check_star of 1.0/0.0, check_star of 0.0/0.0, check of 2.5:")
  println(inf.check)
  println(inf.check_star)
  println(nan.check_star)
  println(x.check)
end
end

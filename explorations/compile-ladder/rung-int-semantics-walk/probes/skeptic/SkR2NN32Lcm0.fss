component SkR2NN32Lcm0
export Executable

run(): () = do
    z: ZZ32 = 0
    p4: ZZ32 = 4
    p6: ZZ32 = 6
    a: NN32 = unsigned(p4)
    b: NN32 = unsigned(p6)
    zero: NN32 = unsigned(z)
    println("NN32 4 LCM 6 = " || (a LCM b).asString)
    println("NN32 0 GCD 0 = " || (zero GCD zero).asString)
    println("NN32 4 LCM 0 = " || (a LCM zero).asString)
    println("NN32 0 LCM 0 = " || (zero LCM zero).asString)
    println("END")
end

end

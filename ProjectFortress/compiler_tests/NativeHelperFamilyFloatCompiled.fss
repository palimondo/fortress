(* On the compiled path, the simpleDoubleArith helpers that Float's bindings name give their values at zeros, large values, the infinities and NaN. *)
component NativeHelperFamilyFloatCompiled
export Executable

dToString(a:RR64):JavaString = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleToString")
dAbs(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleAbs")
dEQ(a:RR64, b:RR64):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleEQ")
dLT(a:RR64, b:RR64):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleLT")
dLE(a:RR64, b:RR64):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleLE")
dGT(a:RR64, b:RR64):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleGT")
dGE(a:RR64, b:RR64):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleGE")
dNeg(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleNeg")
dAdd(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleAdd")
dSub(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSub")
dMul(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleMul")
dDiv(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleDiv")
dSqrt(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSQRT")
dPow(a:RR64, b:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doublePow")
dSin(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleSin")
dCos(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleCos")
dTan(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleTan")
dAsin(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleASin")
dAcos(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleACos")
dAtan(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleATan")
dLog(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleLog")
dExp(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleExp")
dFloor(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleFloor")
dCeiling(a:RR64):RR64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleCeiling")
dTruncate(a:RR64):ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleTruncate")
dRound(a:RR64):ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleDoubleArith.doubleRound")

run():() = do
  z: RR64 = 0.0
  nz: RR64 = dNeg(z)
  one: RR64 = 1.0
  two: RR64 = 2.0
  a: RR64 = 2.5
  b: RR64 = dNeg(0.75)
  large: RR64 = 1000000000000000000000.0
  huge: RR64 = dMul(dMul(large, large), dMul(large, large))
  inf: RR64 = dMul(dMul(huge, huge), dMul(huge, huge))
  ninf: RR64 = dNeg(inf)
  nan: RR64 = dDiv(z, z)

  assert(dToString(a) = "2.5", "dToString")
  assert(dToString(0.1) = "0.1", "dToString of 0.1")
  assert(dToString(large) = "1.0E21", "dToString of a large value")
  assert(dToString(z) = "0.0", "dToString of 0.0")
  assert(dToString(nz) = "-0.0", "dToString of -0.0")
  assert(dToString(huge) = "1.0E84", "dToString of 1.0E84")
  assert(dToString(inf) = "Infinity", "dToString of infinity, from an overflow")
  assert(dToString(ninf) = "-Infinity", "dToString of -infinity")
  assert(dToString(nan) = "NaN", "dToString of NaN")
  assert(dToString(b) = "-0.75", "dToString of -0.75")

  assert(dEQ(dAbs(a), a), "dAbs")
  assert(dEQ(dAbs(b), 0.75), "dAbs of a negative")
  assert(dToString(dAbs(z)) = "0.0", "dAbs of 0.0")
  assert(dEQ(dAbs(inf), inf), "dAbs of infinity")
  assert(dToString(dAbs(nz)) = "0.0", "dAbs of -0.0")
  assert(dEQ(dAbs(ninf), inf), "dAbs of -infinity")
  assert(dToString(dAbs(nan)) = "NaN", "dAbs of NaN")
  assert(dEQ(dAbs(large), large), "dAbs of a large value")
  assert(dEQ(dAbs(dNeg(large)), large), "dAbs of -large")

  assert(dEQ(a, a), "dEQ")
  assert(NOT dEQ(a, b), "dEQ unequal")
  assert(dEQ(z, nz), "dEQ of 0.0 and -0.0")
  assert(dEQ(inf, inf), "dEQ of infinities")
  assert(NOT dEQ(inf, large), "dEQ of infinity and a large value")
  assert(dEQ(large, large), "dEQ of large values")
  assert(dEQ(ninf, ninf), "dEQ of -infinities")
  assert(NOT dEQ(ninf, inf), "dEQ of -infinity and infinity")
  assert(dLT(b, a), "dLT")
  assert(NOT dLT(a, b), "dLT not")
  assert(NOT dLT(nz, z), "dLT of -0.0 and 0.0")
  assert(dLT(large, inf), "dLT of a large value and infinity")
  assert(dLT(ninf, b), "dLT of -infinity and b")
  assert(dLE(b, a), "dLE")
  assert(dLE(a, a), "dLE equal")
  assert(NOT dLE(a, b), "dLE not")
  assert(dLE(z, nz), "dLE of 0.0 and -0.0")
  assert(dLE(inf, inf), "dLE of infinities")
  assert(dLE(large, inf), "dLE of a large value and infinity")
  assert(dLE(ninf, nz), "dLE of -infinity and -0.0")
  assert(dGT(a, b), "dGT")
  assert(NOT dGT(b, a), "dGT not")
  assert(NOT dGT(z, nz), "dGT of 0.0 and -0.0")
  assert(dGT(inf, large), "dGT of infinity and a large value")
  assert(dGT(large, a), "dGT of a large value and a")
  assert(NOT dGT(ninf, large), "dGT of -infinity and a large value")
  assert(dGT(inf, ninf), "dGT of infinity and -infinity")
  assert(dGE(a, b), "dGE")
  assert(dGE(b, b), "dGE equal")
  assert(NOT dGE(b, a), "dGE not")
  assert(dGE(nz, z), "dGE of -0.0 and 0.0")
  assert(dGE(ninf, ninf), "dGE of -infinities")
  assert(dGE(z, nz), "dGE of 0.0 and -0.0")
  assert(dGE(large, large), "dGE of large values")
  assert(dGE(inf, ninf), "dGE of infinity and -infinity")

  assert(dEQ(dNeg(a), dNeg(2.5)), "dNeg")
  assert(dEQ(dNeg(b), 0.75), "dNeg of a negative")
  assert(dToString(nz) = "-0.0", "dNeg of 0.0")
  assert(dToString(dNeg(nz)) = "0.0", "dNeg of -0.0")
  assert(dEQ(dNeg(inf), ninf), "dNeg of infinity")
  assert(dToString(dNeg(large)) = "-1.0E21", "dNeg of a large value")
  assert(dEQ(dNeg(ninf), inf), "dNeg of -infinity")
  assert(dToString(dNeg(nan)) = "NaN", "dNeg of NaN")

  assert(dEQ(dAdd(a, b), 1.75), "dAdd")
  assert(dToString(dAdd(z, nz)) = "0.0", "dAdd of 0.0 and -0.0")
  assert(dToString(dAdd(nz, nz)) = "-0.0", "dAdd of -0.0 and -0.0")
  assert(dToString(dAdd(large, large)) = "2.0E21", "dAdd of large values")
  assert(dEQ(dAdd(inf, one), inf), "dAdd of infinity and 1")
  assert(dToString(dAdd(inf, ninf)) = "NaN", "dAdd of infinity and -infinity")
  assert(dToString(dAdd(nan, one)) = "NaN", "dAdd of NaN and 1")
  assert(dEQ(dSub(a, b), 3.25), "dSub")
  assert(dToString(dSub(z, z)) = "0.0", "dSub of 0.0 and 0.0")
  assert(dToString(dSub(nz, z)) = "-0.0", "dSub of -0.0 and 0.0")
  assert(dEQ(dSub(ninf, large), ninf), "dSub of -infinity and a large value")
  assert(dToString(dSub(inf, inf)) = "NaN", "dSub of infinities")
  assert(dToString(dSub(nan, one)) = "NaN", "dSub of NaN and 1")
  assert(dEQ(dMul(a, b), dNeg(1.875)), "dMul")
  assert(dEQ(dMul(a, a), 6.25), "dMul of a and a")
  assert(dToString(dMul(large, large)) = "1.0E42", "dMul of large values")
  assert(dToString(dMul(nz, a)) = "-0.0", "dMul of -0.0 and 2.5")
  assert(dEQ(dMul(inf, b), ninf), "dMul of infinity and b")
  assert(dEQ(dMul(ninf, ninf), inf), "dMul of -infinities")
  assert(dToString(dMul(inf, z)) = "NaN", "dMul of infinity and 0.0")
  assert(dToString(dMul(nan, z)) = "NaN", "dMul of NaN and 0.0")
  assert(dToString(dMul(nz, nz)) = "0.0", "dMul of -0.0 and -0.0")
  assert(dEQ(dMul(ninf, b), inf), "dMul of -infinity and b")
  assert(dEQ(dMul(ninf, a), ninf), "dMul of -infinity and a")
  assert(dToString(dMul(nan, one)) = "NaN", "dMul of NaN and 1")
  assert(dToString(dDiv(a, b)) = "-3.3333333333333335", "dDiv")
  assert(dToString(dDiv(one, ninf)) = "-0.0", "dDiv of 1 and -infinity")
  assert(dEQ(dDiv(large, large), one), "dDiv of large values")
  assert(dToString(dDiv(inf, inf)) = "NaN", "dDiv of infinities")
  assert(dToString(dDiv(nz, a)) = "-0.0", "dDiv of -0.0 and a")
  assert(dEQ(dDiv(inf, a), inf), "dDiv of infinity and a")
  assert(dEQ(dDiv(ninf, b), inf), "dDiv of -infinity and b")
  assert(dToString(dDiv(large, inf)) = "0.0", "dDiv of a large value and infinity")
  assert(dToString(dDiv(nan, one)) = "NaN", "dDiv of NaN and 1")
  assert(dEQ(dSqrt(6.25), a), "dSqrt")
  assert(dToString(dSqrt(nz)) = "-0.0", "dSqrt of -0.0")
  assert(dEQ(dSqrt(inf), inf), "dSqrt of infinity")
  assert(dToString(dSqrt(b)) = "NaN", "dSqrt of a negative")
  assert(dToString(dSqrt(nan)) = "NaN", "dSqrt of NaN")
  assert(dToString(dSqrt(z)) = "0.0", "dSqrt of 0.0")
  assert(dToString(dSqrt(large)) = "3.1622776601683792E10", "dSqrt of a large value")
  assert(dToString(dSqrt(ninf)) = "NaN", "dSqrt of -infinity")

  assert(dEQ(dPow(a, two), 6.25), "dPow")
  assert(dEQ(dPow(two, dNeg(one)), 0.5), "dPow at a negative exponent")
  assert(dEQ(dPow(z, nz), one), "dPow of 0.0 and -0.0")
  assert(dEQ(dPow(two, inf), inf), "dPow of 2.0 and infinity")
  assert(dToString(dPow(b, 0.5)) = "NaN", "dPow of a negative at 0.5")
  assert(dEQ(dPow(4.0, 0.5), two), "dPow at 0.5")
  assert(dEQ(dPow(large, z), one), "dPow of a large value at 0.0")
  assert(dEQ(dPow(ninf, 3.0), ninf), "dPow of -infinity at 3.0")
  assert(dToString(dPow(large, two)) = "1.0E42", "dPow of a large value at 2.0")
  assert(dEQ(dPow(ninf, two), inf), "dPow of -infinity at 2.0")
  assert(dToString(dPow(inf, dNeg(one))) = "0.0", "dPow of infinity at -1.0")
  assert(dEQ(dPow(nan, z), one), "dPow of NaN at 0.0")
  assert(dToString(dPow(two, nan)) = "NaN", "dPow of 2.0 at NaN")
  assert(dToString(dPow(z, 2.0)) = "0.0", "dPow of 0.0 at 2.0")
  assert(dToString(dPow(nz, 3.0)) = "-0.0", "dPow of -0.0 at 3.0")
  assert(dEQ(dPow(inf, 0.5), inf), "dPow of infinity at 0.5")
  assert(dToString(dPow(nan, 2.0)) = "NaN", "dPow of NaN at 2.0")

  assert(dEQ(dSin(z), z), "dSin of 0.0")
  assert(dToString(dSin(nz)) = "-0.0", "dSin of -0.0")
  assert(dToString(dSin(3.141592653589793)) = "1.2246467991473532E-16", "dSin of pi")
  assert(dToString(dSin(inf)) = "NaN", "dSin of infinity")
  assert(dToString(dSin(nan)) = "NaN", "dSin of NaN")
  assert(dToString(dSin(large)) = "-0.6671201770718048", "dSin of a large value")
  assert(dToString(dSin(ninf)) = "NaN", "dSin of -infinity")
  assert(dEQ(dCos(z), one), "dCos of 0.0")
  assert(dEQ(dCos(nz), one), "dCos of -0.0")
  assert(dEQ(dCos(3.141592653589793), dNeg(one)), "dCos of pi")
  assert(dToString(dCos(ninf)) = "NaN", "dCos of -infinity")
  assert(dToString(dCos(large)) = "0.7449501119831339", "dCos of a large value")
  assert(dToString(dCos(inf)) = "NaN", "dCos of infinity")
  assert(dToString(dCos(nan)) = "NaN", "dCos of NaN")
  assert(dEQ(dTan(z), z), "dTan of 0.0")
  assert(dToString(dTan(nz)) = "-0.0", "dTan of -0.0")
  assert(dToString(dTan(0.7853981633974483)) = "0.9999999999999999", "dTan of pi/4")
  assert(dToString(dTan(inf)) = "NaN", "dTan of infinity")
  assert(dToString(dTan(large)) = "-0.8955232925542654", "dTan of a large value")
  assert(dToString(dTan(ninf)) = "NaN", "dTan of -infinity")
  assert(dToString(dTan(nan)) = "NaN", "dTan of NaN")
  assert(dToString(dAsin(0.5)) = "0.5235987755982989", "dAsin of 0.5")
  assert(dToString(dAsin(one)) = "1.5707963267948966", "dAsin of 1")
  assert(dToString(dAsin(nz)) = "-0.0", "dAsin of -0.0")
  assert(dToString(dAsin(two)) = "NaN", "dAsin of 2")
  assert(dToString(dAsin(z)) = "0.0", "dAsin of 0.0")
  assert(dToString(dAsin(large)) = "NaN", "dAsin of a large value")
  assert(dToString(dAsin(inf)) = "NaN", "dAsin of infinity")
  assert(dToString(dAsin(ninf)) = "NaN", "dAsin of -infinity")
  assert(dToString(dAsin(nan)) = "NaN", "dAsin of NaN")
  assert(dToString(dAcos(0.5)) = "1.0471975511965979", "dAcos of 0.5")
  assert(dEQ(dAcos(one), z), "dAcos of 1")
  assert(dToString(dAcos(two)) = "NaN", "dAcos of 2")
  assert(dToString(dAcos(z)) = "1.5707963267948966", "dAcos of 0.0")
  assert(dToString(dAcos(nz)) = "1.5707963267948966", "dAcos of -0.0")
  assert(dToString(dAcos(large)) = "NaN", "dAcos of a large value")
  assert(dToString(dAcos(inf)) = "NaN", "dAcos of infinity")
  assert(dToString(dAcos(ninf)) = "NaN", "dAcos of -infinity")
  assert(dToString(dAcos(nan)) = "NaN", "dAcos of NaN")
  assert(dToString(dAtan(one)) = "0.7853981633974483", "dAtan of 1")
  assert(dToString(dAtan(nz)) = "-0.0", "dAtan of -0.0")
  assert(dToString(dAtan(inf)) = "1.5707963267948966", "dAtan of infinity")
  assert(dToString(dAtan(ninf)) = "-1.5707963267948966", "dAtan of -infinity")
  assert(dToString(dAtan(nan)) = "NaN", "dAtan of NaN")
  assert(dToString(dAtan(z)) = "0.0", "dAtan of 0.0")
  assert(dToString(dAtan(large)) = "1.5707963267948966", "dAtan of a large value")
  assert(dEQ(dLog(2.718281828459045), one), "dLog of e")
  assert(dEQ(dLog(one), z), "dLog of 1")
  assert(dEQ(dLog(z), ninf), "dLog of 0.0")
  assert(dEQ(dLog(nz), ninf), "dLog of -0.0")
  assert(dEQ(dLog(inf), inf), "dLog of infinity")
  assert(dToString(dLog(b)) = "NaN", "dLog of a negative")
  assert(dToString(dLog(large)) = "48.35428695287496", "dLog of a large value")
  assert(dToString(dLog(ninf)) = "NaN", "dLog of -infinity")
  assert(dToString(dLog(nan)) = "NaN", "dLog of NaN")
  assert(dToString(dExp(one)) = "2.718281828459045", "dExp of 1")
  assert(dEQ(dExp(z), one), "dExp of 0.0")
  assert(dEQ(dExp(nz), one), "dExp of -0.0")
  assert(dEQ(dExp(ninf), z), "dExp of -infinity")
  assert(dEQ(dExp(inf), inf), "dExp of infinity")
  assert(dEQ(dExp(large), inf), "dExp of a large value")
  assert(dToString(dExp(nan)) = "NaN", "dExp of NaN")

  assert(dEQ(dFloor(a), two), "dFloor")
  assert(dEQ(dFloor(b), dNeg(one)), "dFloor of a negative")
  assert(dToString(dFloor(nz)) = "-0.0", "dFloor of -0.0")
  assert(dEQ(dFloor(large), large), "dFloor of a large value")
  assert(dToString(dFloor(z)) = "0.0", "dFloor of 0.0")
  assert(dEQ(dCeiling(a), 3.0), "dCeiling")
  assert(dToString(dCeiling(b)) = "-0.0", "dCeiling of -0.75")
  assert(dToString(dCeiling(z)) = "0.0", "dCeiling of 0.0")
  assert(dEQ(dCeiling(large), large), "dCeiling of a large value")
  assert(dToString(dCeiling(nz)) = "-0.0", "dCeiling of -0.0")
  assert(dTruncate(a) = 2, "dTruncate")
  assert(dTruncate(dNeg(2.7)) = -2, "dTruncate toward zero")
  assert(dTruncate(b) = 0, "dTruncate of -0.75")
  assert(dTruncate(4503599627370496.0) = 4503599627370496, "dTruncate of 2^52")
  assert(dTruncate(z) = 0, "dTruncate of 0.0")
  assert(dTruncate(nz) = 0, "dTruncate of -0.0")
  assert(dRound(a) = 2, "dRound half to even, down")
  assert(dRound(3.5) = 4, "dRound half to even, up")
  assert(dRound(dNeg(2.5)) = -2, "dRound of a negative half")
  assert(dRound(2.7) = 3, "dRound up")
  assert(dRound(b) = -1, "dRound of -0.75")
  assert(dRound(4503599627370496.0) = 4503599627370496, "dRound of 2^52")
  assert(dRound(z) = 0, "dRound of 0.0")
  assert(dRound(nz) = 0, "dRound of -0.0")
  println("PASS")
end

end

component PairMinmaxNN32ZZ32
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    NN32 => "NN32"
    NN64 => "NN64"
    ZZ => "ZZ"
    QQ => "QQ"
    RR64 => "RR64"
    else => "other"
  end

run() = do
    x: NN32 = unsigned(4)
    y: ZZ32 = 3
    (p, q) = x MINMAX y
    println("x MINMAX y = (" p ", " q ") : (" typeOf(p) ", " typeOf(q) ")")
end

end

--- indexing a vector ---
  v = 9 2 6 3 5 8 7 4 0 1
  v[5] (scalar index -> scalar) = 8
  v[5 2] (vector index -> vector) = 8 6
--- indexing a matrix ---
  m = 4 1 6
5 2 9
7 8 3
  m[1;1] = 2
  m[1;] (a row VIEW that is a Vector) = 5 2 9
  m[;1] = 1 2 8
  m[1 2;0] = 5 7
  m[0;1 2] = 1 6
  m[;1 2] = 1 6
2 9
8 3
  m[1 2;] = 5 2 9
7 8 3
  m[1 2;1 2] = 2 9
8 3
  +/m[1;] (the view carries the algebra) = 16
--- ⊂ coordinates and scatter ---
  m[⊂1 1] = 2
  m[(0 0)(1 1)(2 2)] = 4 2 3
--- ⌷ squad ---
  2⌷v = 6
  1⌷m = 5 2 9
  1 1⌷m = 2
  (⊂1 1)⌷m = 5 2 9
5 2 9
  (⊂1 2)⌷m = 5 2 9
7 8 3
--- ⍸ where ---
  ⍸0 0 1 0 1 = 2 4
--- / ⌿ compress and replicate ---
  select/data = 2 4 5 7 8
  1 3 0 0 5 0 7 0 0 1/data = 0 1 1 1 4 4 4 4 4 6 6 6 6 6 6 6 9
  2/1 2 3 = 1 1 2 2 3 3
  select⌿m  (select ← 0 1 0) = 5 2 9
  select/m = 1
2
8
--- assignment, in place ---
  v[3] ← ¯1 then v = 9 2 6 ¯1 5 8 7 4 0 1
  q[1;1] ← 99 = 0  1 2
3 99 5
6  7 8
  q[;0] ← 0 0 0 = 0  1 2
0 99 5
0  7 8
  q[0;] ← 7 7 7 = 7  7 7
0 99 5
0  7 8
  (select/data) ← ¯1 ¯1 ¯1 ¯1 ¯1 = 0 1 ¯1 3 ¯1 ¯1 6 ¯1 ¯1 9
  (0 0⍉m) ← ¯1 ¯1 ¯1 = ¯1  2  3
 4 ¯1  0
 6  5 ¯1

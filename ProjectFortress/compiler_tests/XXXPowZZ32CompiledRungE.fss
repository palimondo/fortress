(* See explorations/compile-ladder/rung-size-range/REPORT.md. *)
component XXXPowZZ32CompiledRungE
export Executable

pz(a: ZZ32, b: ZZ32): String = try "" || (a^b) catch e IntegerOverflow => "OVF" end

run(): () = do
    println("REACHED")
    assert(pz(-3, 21), "OVF", "ZZ32 (-3)^21 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"")
    assert(pz(2, 31), "OVF", "ZZ32 2^31 throws IntegerOverflow; basic-integers.tex, section \"Integers\", opr ^, opr-overview.tex, subsection \"Multiplication, Division, Modulo, and Remainder Operators\"")
    println("PASS")
  end

end

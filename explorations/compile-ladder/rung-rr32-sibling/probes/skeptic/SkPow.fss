component SkPow
export Executable

sh(v: Any): String =
  typecase v of
    RR32 => v.asString || " : RR32"
    RR64 => v.asString || " : RR64"
    else => v.asString || " : other"
  end

run() = do
  a: RR32 = narrow(1.5)
  println("REACHED")
  println("01 a^0            " sh(a^0))
  println("02 a^(-2)         " sh(a^(-2)))
  println("03 a^big(3)       " sh(a^(big(3))))
  println("04 a^unsigned(2)  " sh(a^(unsigned(2))))
  println("05 a^widen(unsigned(2)) " sh(a^(widen(unsigned(2)))))
  hh: RR32 = narrow(300000000000000000000000000000000000000.0)
  println("06 narrow(3.0E38)^2 " sh(hh^2))
  println("07 a^100000       " sh(a^100000))
  println("DONE")
end

end

component pNatCase2
export Executable
(* Probe 3 of ../size-probes.md: can a typecase tell Vec[\ZZ32,3\] from
   Vec[\ZZ32,4\] at run time?  ../runtime/pNatCase.fss asked it with integer
   clause bodies coerced to the declared ZZ32, ledger row 340's shape, and the
   code generator died on that shape before the question was reached.  Here
   every clause is a String literal, which needs no coercion.  Walk prints
   three four other other. *)
object Vec[\T, nat s\](x: T) end
which(v: Any): String =
  typecase v of
    Vec[\ZZ32,3\] => "three"
    Vec[\ZZ32,4\] => "four"
    else => "other"
  end
run() = do
  println(which(Vec[\ZZ32,3\](7)))
  println(which(Vec[\ZZ32,4\](7)))
  println(which(Vec[\ZZ32,5\](7)))
  println(which(Vec[\ZZ64,3\](7)))
end
end

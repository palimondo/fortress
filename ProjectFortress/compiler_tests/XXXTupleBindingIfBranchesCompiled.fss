(* A tuple binding with declared types takes an if expression whose branches are tuples of numerals (variables.tex, section "Local Variable Declarations"). *)
component XXXTupleBindingIfBranchesCompiled
export Executable

flag: Boolean = true

run(): () = do
    (m, n): (ZZ32, ZZ32) = if flag then (1, 2) else (3, 4) end
    assert(m + n, 3, "the names of the branch taken")
    println("PASS")
end

end

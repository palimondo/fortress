component XXXOverloadZZ32BesideUserTrait
export Executable

(* A declaration over (ZZ32, ZZ32) beside one over (List, List), List a trait of the program, is a valid overloading, since ZZ32 comprises the object Int, which excludes List, and a call whose arguments are both a SortedList runs the declaration over (SortedList, SortedList) (overloading.tex, section "Incompatibility Rule"). *)

trait List end
trait SortedList extends List end
object PlainL extends List end
object SortedL extends SortedList end

add(a: ZZ32, b: ZZ32): ZZ32 = a + b
add(a: ZZ32, b: ZZ32, c: ZZ32): ZZ32 = a + b + c
add(a: List, b: List): List = PlainL
add(a: SortedList, b: SortedList): SortedList = SortedL

run(): () = do
  a: List = SortedL
  b: SortedList = SortedL
  r: List = add(a, b)
  k: String = typecase r of
      SortedList => "sorted"
      else => "list"
    end
  assert(k, "sorted", "two SortedList values run add(SortedList, SortedList) (overloading.tex, section \"Overloading Resolution\")")
  assert(add(1, 2), 3, "two ZZ32 run add(ZZ32, ZZ32)")
  assert(add(1, 2, 3), 6, "three ZZ32 run add(ZZ32, ZZ32, ZZ32)")
  println("PASS")
end

end

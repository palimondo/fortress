+(* Under walk, a builtinPrimitive string under nativeHelpers that names no static method stops the program at load. *)
+component NativeHelperMisspeltWalk
+export Executable
+
+typo(a:ZZ32, b:ZZ32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleIntArith.intOverflowingAddd")
+
+run():() = println(typo(1, 2))
+
+end

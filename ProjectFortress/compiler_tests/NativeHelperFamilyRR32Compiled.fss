(* On the compiled path, the simpleFloatArith helpers that RR32's bindings name give their values at signed zeros, the largest and smallest magnitudes, the infinities and NaN. *)
component NativeHelperFamilyRR32Compiled
export Executable

fToString(a:RR32):JavaString = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatToString")
fIsNaN(a:RR32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatIsNaN")
fIsInfinite(a:RR32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatIsInfinite")
fRawBits(a:RR32):ZZ32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatRawBits")
fNextUp(a:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatNextUp")
fNextDown(a:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatNextDown")
fAbs(a:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatAbs")
fEQ(a:RR32, b:RR32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatEQ")
fNE(a:RR32, b:RR32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatNE")
fLT(a:RR32, b:RR32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatLT")
fLE(a:RR32, b:RR32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatLE")
fGT(a:RR32, b:RR32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatGT")
fGE(a:RR32, b:RR32):Boolean = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatGE")
fMin(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMin")
fMax(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMax")
fNeg(a:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatNeg")
fAdd(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatAdd")
fSub(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSub")
fMul(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMul")
fDiv(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatDiv")
fSQRT(a:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSQRT")
fAddUpNoNaN(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatAddUpNoNaN")
fSubUpNoNaN(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSubUpNoNaN")
fMulUpNoNaN(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMulUpNoNaN")
fDivUpNoNaN(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatDivUpNoNaN")
fSQRTUp(a:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSQRTUp")
fAddDownNoNaN(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatAddDownNoNaN")
fSubDownNoNaN(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSubDownNoNaN")
fMulDownNoNaN(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMulDownNoNaN")
fDivDownNoNaN(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatDivDownNoNaN")
fSQRTDown(a:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSQRTDown")
fAddUp(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatAddUp")
fSubUp(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSubUp")
fMulUp(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMulUp")
fDivUp(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatDivUp")
fAddDown(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatAddDown")
fSubDown(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatSubDown")
fMulDown(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatMulDown")
fDivDown(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatDivDown")
fPow(a:RR32, b:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatPow")
fFloor(a:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatFloor")
fCeiling(a:RR32):RR32 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatCeiling")
fIFloor(a:RR32):ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatIFloor")
fICeiling(a:RR32):ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatICeiling")
fTruncate(a:RR32):ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatTruncate")
fRound(a:RR32):ZZ64 = builtinPrimitive("com.sun.fortress.nativeHelpers.simpleFloatArith.floatRound")

run():() = do
  z: RR32 = 0.0
  nz: RR32 = fNeg(z)
  one: RR32 = 1.0
  two: RR32 = 2.0
  three: RR32 = 3.0
  half: RR32 = 0.5
  a: RR32 = 2.5
  b: RR32 = fNeg(0.75)
  tenth: RR32 = 0.1
  sq: RR32 = 6.25
  large: RR32 = 300000000000000000000000000000000000000.0
  maxf: RR32 = 340282346638528859811704183484516925440.0
  tiny: RR32 = 0.0000000000000000000000000000000000000000000014
  inf: RR32 = fMul(large, large)
  ninf: RR32 = fNeg(inf)
  nan: RR32 = fDiv(z, z)
  nmaxf: RR32 = fNeg(maxf)
  ntiny: RR32 = fNeg(tiny)
  wide: RR32 = 8589934592.0
  nwide: RR32 = fNeg(6442450944.0)
  seven: RR32 = 10000000.0
  milli: RR32 = 0.001
  small: RR32 = 0.0001
  mill: RR32 = 1234567.0
  h35: RR32 = 3.5
  nh25: RR32 = fNeg(2.5)
  p27: RR32 = 2.7
  np27: RR32 = fNeg(2.7)

  assert(fToString(a) = "2.5", "asString of a")
  assert(fToString(b) = "-0.75", "asString of b")
  assert(fToString(tenth) = "0.1", "asString of tenth")
  assert(fToString(z) = "0.0", "asString of z")
  assert(fToString(nz) = "-0.0", "asString of nz")
  assert(fToString(large) = "3.0E38", "asString of large")
  assert(fToString(maxf) = "3.4028235E38", "asString of maxf")
  assert(fToString(tiny) = "1.4E-45", "asString of tiny")
  assert(fToString(ntiny) = "-1.4E-45", "asString of ntiny")
  assert(fToString(inf) = "Infinity", "asString of inf")
  assert(fToString(ninf) = "-Infinity", "asString of ninf")
  assert(fToString(nan) = "NaN", "asString of nan")
  assert(fToString(seven) = "1.0E7", "asString of seven")
  assert(fToString(milli) = "0.001", "asString of milli")
  assert(fToString(small) = "1.0E-4", "asString of small")
  assert(fToString(mill) = "1234567.0", "asString of mill")

  assert(fIsNaN(nan), "isNaN of nan")
  assert(NOT fIsNaN(a), "isNaN of a")
  assert(NOT fIsNaN(z), "isNaN of z")
  assert(NOT fIsNaN(nz), "isNaN of nz")
  assert(NOT fIsNaN(inf), "isNaN of inf")
  assert(NOT fIsNaN(ninf), "isNaN of ninf")
  assert(NOT fIsNaN(maxf), "isNaN of maxf")
  assert(NOT fIsNaN(tiny), "isNaN of tiny")
  assert(fIsInfinite(inf), "isInfinite of inf")
  assert(fIsInfinite(ninf), "isInfinite of ninf")
  assert(NOT fIsInfinite(a), "isInfinite of a")
  assert(NOT fIsInfinite(z), "isInfinite of z")
  assert(NOT fIsInfinite(nz), "isInfinite of nz")
  assert(NOT fIsInfinite(maxf), "isInfinite of maxf")
  assert(NOT fIsInfinite(tiny), "isInfinite of tiny")
  assert(NOT fIsInfinite(nan), "isInfinite of nan")
  assert(fRawBits(a) = 1075838976, "rawBits of a")
  assert(fRawBits(one) = 1065353216, "rawBits of one")
  assert(fRawBits(b) = -1086324736, "rawBits of b")
  assert(fRawBits(z) = 0, "rawBits of z")
  assert(fRawBits(nz) = -2147483648, "rawBits of nz")
  assert(fRawBits(maxf) = 2139095039, "rawBits of maxf")
  assert(fRawBits(tiny) = 1, "rawBits of tiny")
  assert(fRawBits(ntiny) = -2147483647, "rawBits of ntiny")
  assert(fRawBits(inf) = 2139095040, "rawBits of inf")
  assert(fRawBits(ninf) = -8388608, "rawBits of ninf")

  assert(fToString(fNextUp(one)) = "1.0000001", "nextUp of one")
  assert(fToString(fNextUp(a)) = "2.5000002", "nextUp of a")
  assert(fToString(fNextUp(b)) = "-0.74999994", "nextUp of b")
  assert(fToString(fNextUp(z)) = "1.4E-45", "nextUp of z")
  assert(fToString(fNextUp(tiny)) = "2.8E-45", "nextUp of tiny")
  assert(fToString(fNextUp(ntiny)) = "-0.0", "nextUp of ntiny")
  assert(fToString(fNextUp(maxf)) = "Infinity", "nextUp of maxf")
  assert(fToString(fNextUp(nmaxf)) = "-3.4028233E38", "nextUp of nmaxf")
  assert(fToString(fNextUp(inf)) = "Infinity", "nextUp of inf")
  assert(fToString(fNextUp(ninf)) = "-3.4028235E38", "nextUp of ninf")
  assert(fToString(fNextUp(nan)) = "NaN", "nextUp of nan")
  assert(fToString(fNextDown(one)) = "0.99999994", "nextDown of one")
  assert(fToString(fNextDown(a)) = "2.4999998", "nextDown of a")
  assert(fToString(fNextDown(b)) = "-0.75000006", "nextDown of b")
  assert(fToString(fNextDown(nz)) = "-1.4E-45", "nextDown of nz")
  assert(fToString(fNextDown(tiny)) = "0.0", "nextDown of tiny")
  assert(fToString(fNextDown(ntiny)) = "-2.8E-45", "nextDown of ntiny")
  assert(fToString(fNextDown(maxf)) = "3.4028233E38", "nextDown of maxf")
  assert(fToString(fNextDown(nmaxf)) = "-Infinity", "nextDown of nmaxf")
  assert(fToString(fNextDown(inf)) = "3.4028235E38", "nextDown of inf")
  assert(fToString(fNextDown(ninf)) = "-Infinity", "nextDown of ninf")
  assert(fToString(fNextDown(nan)) = "NaN", "nextDown of nan")
  assert(fToString(fAbs(a)) = "2.5", "|x| of a")
  assert(fToString(fAbs(b)) = "0.75", "|x| of b")
  assert(fToString(fAbs(z)) = "0.0", "|x| of z")
  assert(fToString(fAbs(nz)) = "0.0", "|x| of nz")
  assert(fToString(fAbs(large)) = "3.0E38", "|x| of large")
  assert(fToString(fAbs(nmaxf)) = "3.4028235E38", "|x| of nmaxf")
  assert(fToString(fAbs(tiny)) = "1.4E-45", "|x| of tiny")
  assert(fToString(fAbs(ntiny)) = "1.4E-45", "|x| of ntiny")
  assert(fToString(fAbs(inf)) = "Infinity", "|x| of inf")
  assert(fToString(fAbs(ninf)) = "Infinity", "|x| of ninf")
  assert(fToString(fAbs(nan)) = "NaN", "|x| of nan")

  assert(fEQ(a, a), "= of a and a")
  assert(NOT fEQ(a, b), "= of a and b")
  assert(NOT fEQ(b, a), "= of b and a")
  assert(fEQ(z, nz), "= of z and nz")
  assert(fEQ(nz, z), "= of nz and z")
  assert(NOT fEQ(tiny, z), "= of tiny and z")
  assert(NOT fEQ(z, tiny), "= of z and tiny")
  assert(NOT fEQ(ntiny, nz), "= of ntiny and nz")
  assert(NOT fEQ(large, inf), "= of large and inf")
  assert(NOT fEQ(inf, large), "= of inf and large")
  assert(NOT fEQ(maxf, inf), "= of maxf and inf")
  assert(fEQ(inf, inf), "= of inf and inf")
  assert(NOT fEQ(ninf, b), "= of ninf and b")
  assert(fEQ(ninf, ninf), "= of ninf and ninf")
  assert(NOT fEQ(ninf, inf), "= of ninf and inf")
  assert(NOT fEQ(nmaxf, ninf), "= of nmaxf and ninf")
  assert(NOT fNE(a, a), "=/= of a and a")
  assert(fNE(a, b), "=/= of a and b")
  assert(fNE(b, a), "=/= of b and a")
  assert(NOT fNE(z, nz), "=/= of z and nz")
  assert(NOT fNE(nz, z), "=/= of nz and z")
  assert(fNE(tiny, z), "=/= of tiny and z")
  assert(fNE(z, tiny), "=/= of z and tiny")
  assert(fNE(ntiny, nz), "=/= of ntiny and nz")
  assert(fNE(large, inf), "=/= of large and inf")
  assert(fNE(inf, large), "=/= of inf and large")
  assert(fNE(maxf, inf), "=/= of maxf and inf")
  assert(NOT fNE(inf, inf), "=/= of inf and inf")
  assert(fNE(ninf, b), "=/= of ninf and b")
  assert(NOT fNE(ninf, ninf), "=/= of ninf and ninf")
  assert(fNE(ninf, inf), "=/= of ninf and inf")
  assert(fNE(nmaxf, ninf), "=/= of nmaxf and ninf")
  assert(NOT fLT(a, a), "< of a and a")
  assert(NOT fLT(a, b), "< of a and b")
  assert(fLT(b, a), "< of b and a")
  assert(NOT fLT(z, nz), "< of z and nz")
  assert(NOT fLT(nz, z), "< of nz and z")
  assert(NOT fLT(tiny, z), "< of tiny and z")
  assert(fLT(z, tiny), "< of z and tiny")
  assert(fLT(ntiny, nz), "< of ntiny and nz")
  assert(fLT(large, inf), "< of large and inf")
  assert(NOT fLT(inf, large), "< of inf and large")
  assert(fLT(maxf, inf), "< of maxf and inf")
  assert(NOT fLT(inf, inf), "< of inf and inf")
  assert(fLT(ninf, b), "< of ninf and b")
  assert(NOT fLT(ninf, ninf), "< of ninf and ninf")
  assert(fLT(ninf, inf), "< of ninf and inf")
  assert(NOT fLT(nmaxf, ninf), "< of nmaxf and ninf")
  assert(fLE(a, a), "<= of a and a")
  assert(NOT fLE(a, b), "<= of a and b")
  assert(fLE(b, a), "<= of b and a")
  assert(fLE(z, nz), "<= of z and nz")
  assert(fLE(nz, z), "<= of nz and z")
  assert(NOT fLE(tiny, z), "<= of tiny and z")
  assert(fLE(z, tiny), "<= of z and tiny")
  assert(fLE(ntiny, nz), "<= of ntiny and nz")
  assert(fLE(large, inf), "<= of large and inf")
  assert(NOT fLE(inf, large), "<= of inf and large")
  assert(fLE(maxf, inf), "<= of maxf and inf")
  assert(fLE(inf, inf), "<= of inf and inf")
  assert(fLE(ninf, b), "<= of ninf and b")
  assert(fLE(ninf, ninf), "<= of ninf and ninf")
  assert(fLE(ninf, inf), "<= of ninf and inf")
  assert(NOT fLE(nmaxf, ninf), "<= of nmaxf and ninf")
  assert(NOT fGT(a, a), "> of a and a")
  assert(fGT(a, b), "> of a and b")
  assert(NOT fGT(b, a), "> of b and a")
  assert(NOT fGT(z, nz), "> of z and nz")
  assert(NOT fGT(nz, z), "> of nz and z")
  assert(fGT(tiny, z), "> of tiny and z")
  assert(NOT fGT(z, tiny), "> of z and tiny")
  assert(NOT fGT(ntiny, nz), "> of ntiny and nz")
  assert(NOT fGT(large, inf), "> of large and inf")
  assert(fGT(inf, large), "> of inf and large")
  assert(NOT fGT(maxf, inf), "> of maxf and inf")
  assert(NOT fGT(inf, inf), "> of inf and inf")
  assert(NOT fGT(ninf, b), "> of ninf and b")
  assert(NOT fGT(ninf, ninf), "> of ninf and ninf")
  assert(NOT fGT(ninf, inf), "> of ninf and inf")
  assert(fGT(nmaxf, ninf), "> of nmaxf and ninf")
  assert(fGE(a, a), ">= of a and a")
  assert(fGE(a, b), ">= of a and b")
  assert(NOT fGE(b, a), ">= of b and a")
  assert(fGE(z, nz), ">= of z and nz")
  assert(fGE(nz, z), ">= of nz and z")
  assert(fGE(tiny, z), ">= of tiny and z")
  assert(NOT fGE(z, tiny), ">= of z and tiny")
  assert(NOT fGE(ntiny, nz), ">= of ntiny and nz")
  assert(NOT fGE(large, inf), ">= of large and inf")
  assert(fGE(inf, large), ">= of inf and large")
  assert(NOT fGE(maxf, inf), ">= of maxf and inf")
  assert(fGE(inf, inf), ">= of inf and inf")
  assert(NOT fGE(ninf, b), ">= of ninf and b")
  assert(fGE(ninf, ninf), ">= of ninf and ninf")
  assert(NOT fGE(ninf, inf), ">= of ninf and inf")
  assert(fGE(nmaxf, ninf), ">= of nmaxf and ninf")
  assert(NOT fLT(nan, one), "< of nan and one")
  assert(NOT fLT(one, nan), "< of one and nan")
  assert(NOT fLT(nan, nan), "< of nan and nan")
  assert(NOT fLE(nan, one), "<= of nan and one")
  assert(NOT fLE(one, nan), "<= of one and nan")
  assert(NOT fLE(nan, nan), "<= of nan and nan")
  assert(NOT fGT(nan, one), "> of nan and one")
  assert(NOT fGT(one, nan), "> of one and nan")
  assert(NOT fGT(nan, nan), "> of nan and nan")
  assert(NOT fGE(nan, one), ">= of nan and one")
  assert(NOT fGE(one, nan), ">= of one and nan")
  assert(NOT fGE(nan, nan), ">= of nan and nan")

  assert(fToString(fMin(a, b)) = "-0.75", "MIN of a and b")
  assert(fToString(fMin(b, a)) = "-0.75", "MIN of b and a")
  assert(fToString(fMin(z, nz)) = "-0.0", "MIN of z and nz")
  assert(fToString(fMin(nz, z)) = "-0.0", "MIN of nz and z")
  assert(fToString(fMin(tiny, z)) = "0.0", "MIN of tiny and z")
  assert(fToString(fMin(large, inf)) = "3.0E38", "MIN of large and inf")
  assert(fToString(fMin(ninf, tiny)) = "-Infinity", "MIN of ninf and tiny")
  assert(fToString(fMin(maxf, nmaxf)) = "-3.4028235E38", "MIN of maxf and nmaxf")
  assert(fToString(fMin(a, nan)) = "NaN", "MIN of a and nan")
  assert(fToString(fMin(nan, a)) = "NaN", "MIN of nan and a")
  assert(fToString(fMax(a, b)) = "2.5", "MAX of a and b")
  assert(fToString(fMax(b, a)) = "2.5", "MAX of b and a")
  assert(fToString(fMax(z, nz)) = "0.0", "MAX of z and nz")
  assert(fToString(fMax(nz, z)) = "0.0", "MAX of nz and z")
  assert(fToString(fMax(tiny, z)) = "1.4E-45", "MAX of tiny and z")
  assert(fToString(fMax(large, inf)) = "Infinity", "MAX of large and inf")
  assert(fToString(fMax(ninf, tiny)) = "1.4E-45", "MAX of ninf and tiny")
  assert(fToString(fMax(maxf, nmaxf)) = "3.4028235E38", "MAX of maxf and nmaxf")
  assert(fToString(fMax(a, nan)) = "NaN", "MAX of a and nan")
  assert(fToString(fMax(nan, a)) = "NaN", "MAX of nan and a")

  assert(fToString(fNeg(a)) = "-2.5", "unary - of a")
  assert(fToString(fNeg(b)) = "0.75", "unary - of b")
  assert(fToString(fNeg(z)) = "-0.0", "unary - of z")
  assert(fToString(fNeg(nz)) = "0.0", "unary - of nz")
  assert(fToString(fNeg(large)) = "-3.0E38", "unary - of large")
  assert(fToString(fNeg(maxf)) = "-3.4028235E38", "unary - of maxf")
  assert(fToString(fNeg(tiny)) = "-1.4E-45", "unary - of tiny")
  assert(fToString(fNeg(inf)) = "-Infinity", "unary - of inf")
  assert(fToString(fNeg(ninf)) = "Infinity", "unary - of ninf")
  assert(fToString(fNeg(nan)) = "NaN", "unary - of nan")
  assert(fToString(fAdd(a, b)) = "1.75", "+ of a and b")
  assert(fToString(fAdd(one, tenth)) = "1.1", "+ of one and tenth")
  assert(fToString(fAdd(z, nz)) = "0.0", "+ of z and nz")
  assert(fToString(fAdd(nz, nz)) = "-0.0", "+ of nz and nz")
  assert(fToString(fAdd(maxf, maxf)) = "Infinity", "+ of maxf and maxf")
  assert(fToString(fAdd(nmaxf, nmaxf)) = "-Infinity", "+ of nmaxf and nmaxf")
  assert(fToString(fAdd(tiny, tiny)) = "2.8E-45", "+ of tiny and tiny")
  assert(fToString(fAdd(tiny, ntiny)) = "0.0", "+ of tiny and ntiny")
  assert(fToString(fAdd(inf, one)) = "Infinity", "+ of inf and one")
  assert(fToString(fAdd(inf, ninf)) = "NaN", "+ of inf and ninf")
  assert(fToString(fAdd(nan, one)) = "NaN", "+ of nan and one")
  assert(fToString(fSub(a, b)) = "3.25", "- of a and b")
  assert(fToString(fSub(one, tenth)) = "0.9", "- of one and tenth")
  assert(fToString(fSub(z, z)) = "0.0", "- of z and z")
  assert(fToString(fSub(nz, z)) = "-0.0", "- of nz and z")
  assert(fToString(fSub(tiny, tiny)) = "0.0", "- of tiny and tiny")
  assert(fToString(fSub(nmaxf, maxf)) = "-Infinity", "- of nmaxf and maxf")
  assert(fToString(fSub(ninf, large)) = "-Infinity", "- of ninf and large")
  assert(fToString(fSub(inf, inf)) = "NaN", "- of inf and inf")
  assert(fToString(fSub(nan, one)) = "NaN", "- of nan and one")
  assert(fToString(fMul(a, b)) = "-1.875", "DOT of a and b")
  assert(fToString(fMul(tenth, tenth)) = "0.010000001", "DOT of tenth and tenth")
  assert(fToString(fMul(nz, a)) = "-0.0", "DOT of nz and a")
  assert(fToString(fMul(nz, nz)) = "0.0", "DOT of nz and nz")
  assert(fToString(fMul(tiny, tiny)) = "0.0", "DOT of tiny and tiny")
  assert(fToString(fMul(tiny, two)) = "2.8E-45", "DOT of tiny and two")
  assert(fToString(fMul(large, large)) = "Infinity", "DOT of large and large")
  assert(fToString(fMul(maxf, half)) = "1.7014117E38", "DOT of maxf and half")
  assert(fToString(fMul(inf, z)) = "NaN", "DOT of inf and z")

component MaxZZ32QQ
export Executable

typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    NN32 => "NN32"
    NN64 => "NN64"
    ZZ => "ZZ"
    QQ => "QQ"
    RR64 => "RR64"
    else => "other"
  end

run(): () = do
    z: ZZ32 = 3
    q: QQ = 7/2
    r = z MAX q
    println("z MAX q = " r " : " typeOf(r))
  end

end

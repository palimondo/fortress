component XXXFunctionalMethodMeetInherited
export Executable

(* A trait that inherits two functional methods of one name whose parameter types overlap, and provides no declaration on their meet, is no valid overloading, so the program is refused at load (row 544); Specification/advanced/overloading.tex, section "Meet Rule", paragraph "The Meet Rule for Functional Methods". *)

trait S
  tag(self): ZZ32 = 1
end
trait T
  tag(self): ZZ32 = 2
end
trait V extends { S, T } end
object Vo extends V end

run(): () = do
    println(tag(Vo))
  end

end

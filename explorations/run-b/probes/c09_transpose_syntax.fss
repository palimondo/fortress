(* c09: which spellings of a postfix ^T after a dotted field access parse?
   Each candidate on its own line so the error column names the culprit. *)
component c09_transpose_syntax
export Executable

object Row(x: Array[\RR64,ZZ32\]) end
opr (x: Array[\RR64,ZZ32\])^T: Row = Row(x)
opr (m: Array[\RR64,(ZZ32,ZZ32)\])^T: Array[\RR64,(ZZ32,ZZ32)\] = m.t()
opr juxtaposition(g: Array[\RR64,ZZ32\], xT: Row): Array[\RR64,(ZZ32,ZZ32)\] =
  array[\RR64\](|g|, |xT.x|).fill(fn (i, j) => g[i] (xT.x)[j])
object Box(v: Array[\RR64,ZZ32\]) end
object MBox(v: Array[\RR64,(ZZ32,ZZ32)\]) end

run(): () = do
  x = Box(array[\RR64\](3).fill(fn i => 1.0 (i + 1)))
  W = MBox(array[\RR64\](2, 3).fill(fn (i, j) => 1.0 (3 i + j + 1)))
  g = array[\RR64\](2).fill(1.0)
  a = (x.v)^T
  println("a = (x.v)^T ok")
  b = g (x.v)^T
  println("b = g (x.v)^T = " b)
  c = (W.v)^T g
  println("c = (W.v)^T g = " c)
  d = (W.v)^T
  println("d = (W.v)^T = " d)
  f1 = fn h => h (x.v)^T
  println("f1 ok " f1(g))
  f2 = fn h => (W.v)^T h
  println("f2 ok " f2(g))
end
end

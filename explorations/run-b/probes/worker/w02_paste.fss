component w02_paste
export Executable

run(): () = do
    a: Array[\RR64,(ZZ32,ZZ32)\] = array[\RR64\](2, 2)
    a[(0,0)] := 1.0
    a[(0,1)] := 2.0
    a[(1,0)] := 3.0
    a[(1,1)] := 4.0
    b: Array[\RR64,(ZZ32,ZZ32)\] = array[\RR64\](2, 2)
    b[(0,0)] := 5.0
    b[(0,1)] := 6.0
    b[(1,0)] := 7.0
    b[(1,1)] := 8.0
    u: Array[\RR64,ZZ32\] = array[\RR64\](2)
    u[0] := 1.0
    u[1] := 2.0
    v: Array[\RR64,ZZ32\] = array[\RR64\](2)
    v[0] := 3.0
    v[1] := 4.0
    side: Array[\RR64,(ZZ32,ZZ32)\] = [ a b ]
    println("side = " side)
    stack: Array[\RR64,(ZZ32,ZZ32)\] = [ a ; b ]
    println("stack = " stack)
    cat: Array[\RR64,ZZ32\] = [ u v ]
    println("cat = " cat)
  end

end

(* Float's bit, neighbour, narrowing, inequality, MIN, MAX and directed-rounding operations, and fromRawBits, keep their values under walk at zeros, large values, the smallest subnormal, the infinities and NaN. *)
component NativeHelperFamilyFloatBitsWalk
export Executable

run():() = do
  z: RR64 = asFloat(0.0)
  nz: RR64 = -z
  one: RR64 = asFloat(1.0)
  two: RR64 = asFloat(2.0)
  three: RR64 = asFloat(3.0)
  a: RR64 = asFloat(2.5)
  b: RR64 = asFloat(-0.75)
  p1: RR64 = asFloat(0.1)
  p2: RR64 = asFloat(0.2)
  sq: RR64 = asFloat(6.25)
  large: RR64 = asFloat(1000000000000000000000.0)
  huge: RR64 = (large DOT large) DOT (large DOT large)
  huge2: RR64 = huge DOT huge
  inf: RR64 = (huge DOT huge) DOT (huge DOT huge)
  ninf: RR64 = -inf
  nan: RR64 = z / z
  tiny: RR64 = two^(asFloat(-1074.0))
  ntiny: RR64 = -tiny

  assert(tiny.asString, "4.9E-324", "the smallest subnormal")
  assert(huge2.asString, "1.0000000000000001E168", "1.0E84 DOT 1.0E84")

  assert(z.isNaN, false, "isNaN of 0.0")
  assert(nz.isNaN, false, "isNaN of -0.0")
  assert(one.isNaN, false, "isNaN of 1.0")
  assert(large.isNaN, false, "isNaN of a large value")
  assert(tiny.isNaN, false, "isNaN of the smallest subnormal")
  assert(inf.isNaN, false, "isNaN of infinity")
  assert(ninf.isNaN, false, "isNaN of -infinity")
  assert(nan.isNaN, true, "isNaN of 0.0 / 0.0")
  assert((inf - inf).isNaN, true, "isNaN of infinity - infinity")
  assert(z.isInfinite, false, "isInfinite of 0.0")
  assert(nz.isInfinite, false, "isInfinite of -0.0")
  assert(b.isInfinite, false, "isInfinite of -0.75")
  assert(large.isInfinite, false, "isInfinite of a large value")
  assert(tiny.isInfinite, false, "isInfinite of the smallest subnormal")
  assert(inf.isInfinite, true, "isInfinite of infinity")
  assert(ninf.isInfinite, true, "isInfinite of -infinity")
  assert((huge2 DOT huge2).isInfinite, true, "isInfinite of an overflow")
  assert(nan.isInfinite, false, "isInfinite of NaN")

  assert((z.rawBits).asString, "0", "rawBits of 0.0")
  assert((nz.rawBits).asString, "-9223372036854775808", "rawBits of -0.0")
  assert((one.rawBits).asString, "4607182418800017408", "rawBits of 1.0")
  assert((a.rawBits).asString, "4612811918334230528", "rawBits of 2.5")
  assert((b.rawBits).asString, "-4618441417868443648", "rawBits of -0.75")
  assert((p1.rawBits).asString, "4591870180066957722", "rawBits of 0.1")
  assert((large.rawBits).asString, "4921056587992461136", "rawBits of a large value")
  assert((tiny.rawBits).asString, "1", "rawBits of the smallest subnormal")
  assert((inf.rawBits).asString, "9218868437227405312", "rawBits of infinity")
  assert((ninf.rawBits).asString, "-4503599627370496", "rawBits of -infinity")
  assert(fromRawBits(nan.rawBits).isNaN, true, "rawBits of NaN, read back")

  assert((z.nextUp).asString, "4.9E-324", "nextUp of 0.0")
  assert((one.nextUp).asString, "1.0000000000000002", "nextUp of 1.0")
  assert((a.nextUp).asString, "2.5000000000000004", "nextUp of 2.5")
  assert((b.nextUp).asString, "-0.7499999999999999", "nextUp of -0.75")
  assert((large.nextUp).asString, "1.0000000000000001E21", "nextUp of a large value")
  assert((tiny.nextUp).asString, "9.9E-324", "nextUp of the smallest subnormal")
  assert((ntiny.nextUp).asString, "-0.0", "nextUp of minus the smallest subnormal")
  assert((inf.nextUp).asString, "Infinity", "nextUp of infinity")
  assert((ninf.nextUp).asString, "-1.7976931348623157E308", "nextUp of -infinity")
  assert((nan.nextUp).asString, "NaN", "nextUp of NaN")
  assert((one.nextDown).asString, "0.9999999999999999", "nextDown of 1.0")
  assert((a.nextDown).asString, "2.4999999999999996", "nextDown of 2.5")
  assert((b.nextDown).asString, "-0.7500000000000001", "nextDown of -0.75")
  assert((large.nextDown).asString, "9.999999999999999E20", "nextDown of a large value")
  assert((tiny.nextDown).asString, "0.0", "nextDown of the smallest subnormal")
  assert((nz.nextDown).asString, "-4.9E-324", "nextDown of -0.0")
  assert((inf.nextDown).asString, "1.7976931348623157E308", "nextDown of infinity")
  assert((ninf.nextDown).asString, "-Infinity", "nextDown of -infinity")
  assert((nan.nextDown).asString, "NaN", "nextDown of NaN")

  assert((narrow(a)).asString, "2.5", "narrow of 2.5")
  assert((narrow(b)).asString, "-0.75", "narrow of -0.75")
  assert((narrow(p1)).asString, "0.1", "narrow of 0.1")
  assert((narrow(p1)).rawBits, 1036831949, "narrow of 0.1, its bits")
  assert((narrow(z)).asString, "0.0", "narrow of 0.0")
  assert((narrow(nz)).asString, "-0.0", "narrow of -0.0")
  assert((narrow(large)).asString, "1.0E21", "narrow of a large value")
  assert((narrow(huge)).asString, "Infinity", "narrow of 1.0E84 overflows")
  assert((narrow(tiny)).asString, "0.0", "narrow of the smallest subnormal underflows")
  assert((narrow(inf)).asString, "Infinity", "narrow of infinity")
  assert((narrow(ninf)).asString, "-Infinity", "narrow of -infinity")
  assert((narrow(nan)).asString, "NaN", "narrow of NaN")

  assert(a =/= b, true, "=/=")
  assert(a =/= a, false, "=/= of equal values")
  assert(z =/= nz, false, "0.0 =/= -0.0")
  assert(inf =/= inf, false, "infinity =/= infinity")
  assert(inf =/= ninf, true, "infinity =/= -infinity")
  assert(large =/= inf, true, "large =/= infinity")
  assert(tiny =/= z, true, "the smallest subnormal =/= 0.0")
  assert(tiny =/= tiny, false, "the smallest subnormal =/= itself")

  assert((a MIN b).asString, "-0.75", "MIN")
  assert((b MIN a).asString, "-0.75", "MIN, swapped")
  assert((z MIN nz).asString, "-0.0", "0.0 MIN -0.0")
  assert((nz MIN z).asString, "-0.0", "-0.0 MIN 0.0")
  assert((large MIN inf).asString, "1.0E21", "large MIN infinity")
  assert((ninf MIN b).asString, "-Infinity", "-infinity MIN b")
  assert((tiny MIN z).asString, "0.0", "the smallest subnormal MIN 0.0")
  assert((a MAX b).asString, "2.5", "MAX")
  assert((b MAX a).asString, "2.5", "MAX, swapped")
  assert((z MAX nz).asString, "0.0", "0.0 MAX -0.0")
  assert((nz MAX z).asString, "0.0", "-0.0 MAX 0.0")
  assert((nz MAX nz).asString, "-0.0", "-0.0 MAX -0.0")
  assert((large MAX inf).asString, "Infinity", "large MAX infinity")
  assert((ninf MAX b).asString, "-0.75", "-infinity MAX b")
  assert((tiny MAX z).asString, "4.9E-324", "the smallest subnormal MAX 0.0")

  assert((p1 PLUS_UP p2).asString, "0.30000000000000004", "PLUS_UP, inexact")
  assert((one PLUS_UP two).asString, "3.0", "PLUS_UP, exact")
  assert((large PLUS_UP one).asString, "1.0000000000000001E21", "PLUS_UP of a large value and 1")
  assert((tiny PLUS_UP one).asString, "1.0000000000000002", "PLUS_UP of the smallest subnormal and 1")
  assert((tiny PLUS_UP tiny).asString, "9.9E-324", "PLUS_UP of two smallest subnormals")
  assert((z PLUS_UP nz).asString, "0.0", "0.0 PLUS_UP -0.0")
  assert((nz PLUS_UP nz).asString, "-0.0", "-0.0 PLUS_UP -0.0")
  assert((inf PLUS_UP one).asString, "Infinity", "infinity PLUS_UP 1")
  assert((inf PLUS_UP ninf).asString, "Infinity", "infinity PLUS_UP -infinity")
  assert((nan PLUS_UP one).asString, "NaN", "NaN PLUS_UP 1")
  assert((p1 PLUS_DOWN p2).asString, "0.3", "PLUS_DOWN, inexact")
  assert((one PLUS_DOWN two).asString, "3.0", "PLUS_DOWN, exact")
  assert((large PLUS_DOWN one).asString, "1.0E21", "PLUS_DOWN of a large value and 1")
  assert((tiny PLUS_DOWN one).asString, "1.0", "PLUS_DOWN of the smallest subnormal and 1")
  assert((z PLUS_DOWN nz).asString, "-0.0", "0.0 PLUS_DOWN -0.0")
  assert((ninf PLUS_DOWN one).asString, "-Infinity", "-infinity PLUS_DOWN 1")
  assert((inf PLUS_DOWN ninf).asString, "-Infinity", "infinity PLUS_DOWN -infinity")
  assert((nan PLUS_DOWN one).asString, "NaN", "NaN PLUS_DOWN 1")
  assert((one MINUS_UP p1).asString, "0.9", "MINUS_UP, inexact")
  assert((one MINUS_UP two).asString, "-1.0", "MINUS_UP, exact")
  assert((large MINUS_UP one).asString, "1.0E21", "MINUS_UP of a large value and 1")
  assert((one MINUS_UP tiny).asString, "1.0", "MINUS_UP of 1 and the smallest subnormal")
  assert((z MINUS_UP z).asString, "0.0", "0.0 MINUS_UP 0.0")
  assert((nz MINUS_UP nz).asString, "0.0", "-0.0 MINUS_UP -0.0")
  assert((ninf MINUS_UP one).asString, "-Infinity", "-infinity MINUS_UP 1")
  assert((inf MINUS_UP inf).asString, "Infinity", "infinity MINUS_UP infinity")
  assert((nan MINUS_UP one).asString, "NaN", "NaN MINUS_UP 1")
  assert((one MINUS_DOWN p1).asString, "0.8999999999999999", "MINUS_DOWN, inexact")
  assert((one MINUS_DOWN two).asString, "-1.0", "MINUS_DOWN, exact")
  assert((large MINUS_DOWN one).asString, "9.999999999999999E20", "MINUS_DOWN of a large value and 1")
  assert((one MINUS_DOWN tiny).asString, "0.9999999999999999", "MINUS_DOWN of 1 and the smallest subnormal")
  assert((z MINUS_DOWN z).asString, "-0.0", "0.0 MINUS_DOWN 0.0")
  assert((tiny MINUS_DOWN tiny).asString, "-0.0", "MINUS_DOWN of two smallest subnormals")
  assert((inf MINUS_DOWN inf).asString, "-Infinity", "infinity MINUS_DOWN infinity")
  assert((nan MINUS_DOWN one).asString, "NaN", "NaN MINUS_DOWN 1")

  assert((p1 DOT_UP p2).asString, "0.020000000000000004", "DOT_UP, inexact")
  assert((two DOT_UP three).asString, "6.0", "DOT_UP, exact")
  assert((a DOT_UP b).asString, "-1.875", "DOT_UP of a and b")
  assert((tiny DOT_UP tiny).asString, "4.9E-324", "DOT_UP of two smallest subnormals")
  assert((large DOT_UP tiny).asString, "4.9406564584124654E-303", "DOT_UP of a large value and the smallest subnormal")
  assert((huge2 DOT_UP huge2).asString, "Infinity", "DOT_UP overflows")
  assert((z DOT_UP nz).asString, "-0.0", "0.0 DOT_UP -0.0")
  assert((nz DOT_UP nz).asString, "0.0", "-0.0 DOT_UP -0.0")
  assert((inf DOT_UP b).asString, "-Infinity", "infinity DOT_UP b")
  assert((inf DOT_UP z).asString, "Infinity", "infinity DOT_UP 0.0")
  assert((nan DOT_UP one).asString, "NaN", "NaN DOT_UP 1")
  assert((p1 DOT_DOWN p2).asString, "0.02", "DOT_DOWN, inexact")
  assert((two DOT_DOWN three).asString, "6.0", "DOT_DOWN, exact")
  assert((tiny DOT_DOWN tiny).asString, "0.0", "DOT_DOWN of two smallest subnormals")
  assert((huge2 DOT_DOWN huge2).asString, "1.7976931348623157E308", "DOT_DOWN overflows to the largest finite value")
  assert((z DOT_DOWN nz).asString, "-0.0", "0.0 DOT_DOWN -0.0")
  assert((inf DOT_DOWN z).asString, "0.0", "infinity DOT_DOWN 0.0")
  assert((ninf DOT_DOWN one).asString, "-Infinity", "-infinity DOT_DOWN 1")
  assert((nan DOT_DOWN one).asString, "NaN", "NaN DOT_DOWN 1")
  assert((one SLASH_UP three).asString, "0.33333333333333337", "SLASH_UP, inexact")
  assert((one SLASH_UP two).asString, "0.5", "SLASH_UP, exact")
  assert((a SLASH_UP b).asString, "-3.333333333333333", "SLASH_UP of a and b")
  assert((tiny SLASH_UP two).asString, "4.9E-324", "SLASH_UP of the smallest subnormal by 2")
  assert((large SLASH_UP tiny).asString, "Infinity", "SLASH_UP overflows")
  assert((z SLASH_UP two).asString, "0.0", "0.0 SLASH_UP 2")
  assert((nz SLASH_UP two).asString, "-0.0", "-0.0 SLASH_UP 2")
  assert((inf SLASH_UP inf).asString, "Infinity", "infinity SLASH_UP infinity")
  assert((inf SLASH_UP ninf).asString, "-0.0", "infinity SLASH_UP -infinity")
  assert((nan SLASH_UP one).asString, "NaN", "NaN SLASH_UP 1")
  assert((one SLASH_DOWN three).asString, "0.3333333333333333", "SLASH_DOWN, inexact")
  assert((one SLASH_DOWN two).asString, "0.5", "SLASH_DOWN, exact")
  assert((a SLASH_DOWN b).asString, "-3.3333333333333335", "SLASH_DOWN of a and b")
  assert((tiny SLASH_DOWN two).asString, "0.0", "SLASH_DOWN of the smallest subnormal by 2")
  assert((large SLASH_DOWN tiny).asString, "1.7976931348623157E308", "SLASH_DOWN overflows to the largest finite value")
  assert((inf SLASH_DOWN inf).asString, "0.0", "infinity SLASH_DOWN infinity")
  assert((inf SLASH_DOWN ninf).asString, "-Infinity", "infinity SLASH_DOWN -infinity")
  assert((nan SLASH_DOWN one).asString, "NaN", "NaN SLASH_DOWN 1")

  assert((SQRT_UP a).asString, "1.5811388300841898", "SQRT_UP, inexact")
  assert((SQRT_UP sq).asString, "2.5", "SQRT_UP, exact")
  assert((SQRT_UP two).asString, "1.4142135623730951", "SQRT_UP of 2")
  assert((SQRT_UP z).asString, "0.0", "SQRT_UP of 0.0")
  assert((SQRT_UP nz).asString, "-0.0", "SQRT_UP of -0.0")
  assert((SQRT_UP tiny).asString, "2.2227587494850775E-162", "SQRT_UP of the smallest subnormal")
  assert((SQRT_UP large).asString, "3.1622776601683796E10", "SQRT_UP of a large value")
  assert((SQRT_UP inf).asString, "Infinity", "SQRT_UP of infinity")
  assert((SQRT_UP b).asString, "NaN", "SQRT_UP of a negative")
  assert((SQRT_UP ninf).asString, "NaN", "SQRT_UP of -infinity")
  assert((SQRT_UP nan).asString, "NaN", "SQRT_UP of NaN")
  assert((SQRT_DOWN a).asString, "1.5811388300841895", "SQRT_DOWN, inexact")
  assert((SQRT_DOWN sq).asString, "2.5", "SQRT_DOWN, exact")
  assert((SQRT_DOWN two).asString, "1.414213562373095", "SQRT_DOWN of 2")
  assert((SQRT_DOWN z).asString, "0.0", "SQRT_DOWN of 0.0")
  assert((SQRT_DOWN nz).asString, "-0.0", "SQRT_DOWN of -0.0")
  assert((SQRT_DOWN tiny).asString, "2.2227587494850775E-162", "SQRT_DOWN of the smallest subnormal")
  assert((SQRT_DOWN large).asString, "3.1622776601683792E10", "SQRT_DOWN of a large value")
  assert((SQRT_DOWN inf).asString, "Infinity", "SQRT_DOWN of infinity")
  assert((SQRT_DOWN b).asString, "NaN", "SQRT_DOWN of a negative")
  assert((SQRT_DOWN nan).asString, "NaN", "SQRT_DOWN of NaN")

  assert((p1 IEEE_PLUS_UP p2).asString, "0.30000000000000004", "IEEE_PLUS_UP, inexact")
  assert((one IEEE_PLUS_UP two).asString, "3.0", "IEEE_PLUS_UP, exact")
  assert((large IEEE_PLUS_UP one).asString, "1.0000000000000001E21", "IEEE_PLUS_UP of a large value and 1")
  assert((tiny IEEE_PLUS_UP tiny).asString, "9.9E-324", "IEEE_PLUS_UP of two smallest subnormals")
  assert((z IEEE_PLUS_UP nz).asString, "0.0", "0.0 IEEE_PLUS_UP -0.0")
  assert((nz IEEE_PLUS_UP nz).asString, "-0.0", "-0.0 IEEE_PLUS_UP -0.0")
  assert((inf IEEE_PLUS_UP one).asString, "Infinity", "infinity IEEE_PLUS_UP 1")
  assert((inf IEEE_PLUS_UP ninf).asString, "NaN", "infinity IEEE_PLUS_UP -infinity")
  assert((nan IEEE_PLUS_UP one).asString, "NaN", "NaN IEEE_PLUS_UP 1")
  assert((p1 IEEE_PLUS_DOWN p2).asString, "0.3", "IEEE_PLUS_DOWN, inexact")
  assert((one IEEE_PLUS_DOWN two).asString, "3.0", "IEEE_PLUS_DOWN, exact")
  assert((large IEEE_PLUS_DOWN one).asString, "1.0E21", "IEEE_PLUS_DOWN of a large value and 1")
  assert((z IEEE_PLUS_DOWN nz).asString, "-0.0", "0.0 IEEE_PLUS_DOWN -0.0")
  assert((ninf IEEE_PLUS_DOWN one).asString, "-Infinity", "-infinity IEEE_PLUS_DOWN 1")
  assert((inf IEEE_PLUS_DOWN ninf).asString, "NaN", "infinity IEEE_PLUS_DOWN -infinity")
  assert((nan IEEE_PLUS_DOWN one).asString, "NaN", "NaN IEEE_PLUS_DOWN 1")
  assert((one IEEE_MINUS_UP p1).asString, "0.9", "IEEE_MINUS_UP, inexact")
  assert((one IEEE_MINUS_UP two).asString, "-1.0", "IEEE_MINUS_UP, exact")
  assert((one IEEE_MINUS_UP tiny).asString, "1.0", "IEEE_MINUS_UP of 1 and the smallest subnormal")
  assert((z IEEE_MINUS_UP z).asString, "0.0", "0.0 IEEE_MINUS_UP 0.0")
  assert((inf IEEE_MINUS_UP ninf).asString, "Infinity", "infinity IEEE_MINUS_UP -infinity")
  assert((inf IEEE_MINUS_UP inf).asString, "NaN", "infinity IEEE_MINUS_UP infinity")
  assert((nan IEEE_MINUS_UP one).asString, "NaN", "NaN IEEE_MINUS_UP 1")
  assert((one IEEE_MINUS_DOWN p1).asString, "0.8999999999999999", "IEEE_MINUS_DOWN, inexact")
  assert((one IEEE_MINUS_DOWN two).asString, "-1.0", "IEEE_MINUS_DOWN, exact")
  assert((large IEEE_MINUS_DOWN one).asString, "9.999999999999999E20", "IEEE_MINUS_DOWN of a large value and 1")
  assert((z IEEE_MINUS_DOWN z).asString, "-0.0", "0.0 IEEE_MINUS_DOWN 0.0")
  assert((tiny IEEE_MINUS_DOWN tiny).asString, "-0.0", "IEEE_MINUS_DOWN of two smallest subnormals")
  assert((inf IEEE_MINUS_DOWN inf).asString, "NaN", "infinity IEEE_MINUS_DOWN infinity")
  assert((nan IEEE_MINUS_DOWN one).asString, "NaN", "NaN IEEE_MINUS_DOWN 1")
  assert((p1 IEEE_DOT_UP p2).asString, "0.020000000000000004", "IEEE_DOT_UP, inexact")
  assert((two IEEE_DOT_UP three).asString, "6.0", "IEEE_DOT_UP, exact")
  assert((tiny IEEE_DOT_UP tiny).asString, "4.9E-324", "IEEE_DOT_UP of two smallest subnormals")
  assert((huge2 IEEE_DOT_UP huge2).asString, "Infinity", "IEEE_DOT_UP overflows")
  assert((z IEEE_DOT_UP nz).asString, "-0.0", "0.0 IEEE_DOT_UP -0.0")
  assert((inf IEEE_DOT_UP b).asString, "-Infinity", "infinity IEEE_DOT_UP b")
  assert((inf IEEE_DOT_UP z).asString, "NaN", "infinity IEEE_DOT_UP 0.0")
  assert((nan IEEE_DOT_UP one).asString, "NaN", "NaN IEEE_DOT_UP 1")
  assert((p1 IEEE_DOT_DOWN p2).asString, "0.02", "IEEE_DOT_DOWN, inexact")
  assert((two IEEE_DOT_DOWN three).asString, "6.0", "IEEE_DOT_DOWN, exact")
  assert((tiny IEEE_DOT_DOWN tiny).asString, "0.0", "IEEE_DOT_DOWN of two smallest subnormals")
  assert((huge2 IEEE_DOT_DOWN huge2).asString, "1.7976931348623157E308", "IEEE_DOT_DOWN overflows to the largest finite value")
  assert((nz IEEE_DOT_DOWN nz).asString, "0.0", "-0.0 IEEE_DOT_DOWN -0.0")
  assert((inf IEEE_DOT_DOWN z).asString, "NaN", "infinity IEEE_DOT_DOWN 0.0")
  assert((nan IEEE_DOT_DOWN one).asString, "NaN", "NaN IEEE_DOT_DOWN 1")
  assert((one IEEE_SLASH_UP three).asString, "0.33333333333333337", "IEEE_SLASH_UP, inexact")
  assert((one IEEE_SLASH_UP two).asString, "0.5", "IEEE_SLASH_UP, exact")
  assert((tiny IEEE_SLASH_UP two).asString, "4.9E-324", "IEEE_SLASH_UP of the smallest subnormal by 2")
  assert((large IEEE_SLASH_UP tiny).asString, "Infinity", "IEEE_SLASH_UP overflows")
  assert((nz IEEE_SLASH_UP two).asString, "-0.0", "-0.0 IEEE_SLASH_UP 2")
  assert((inf IEEE_SLASH_UP inf).asString, "NaN", "infinity IEEE_SLASH_UP infinity")
  assert((nan IEEE_SLASH_UP one).asString, "NaN", "NaN IEEE_SLASH_UP 1")
  assert((one IEEE_SLASH_DOWN three).asString, "0.3333333333333333", "IEEE_SLASH_DOWN, inexact")
  assert((one IEEE_SLASH_DOWN two).asString, "0.5", "IEEE_SLASH_DOWN, exact")
  assert((tiny IEEE_SLASH_DOWN two).asString, "0.0", "IEEE_SLASH_DOWN of the smallest subnormal by 2")
  assert((large IEEE_SLASH_DOWN tiny).asString, "1.7976931348623157E308", "IEEE_SLASH_DOWN overflows to the largest finite value")
  assert((z IEEE_SLASH_DOWN two).asString, "0.0", "0.0 IEEE_SLASH_DOWN 2")
  assert((inf IEEE_SLASH_DOWN inf).asString, "NaN", "infinity IEEE_SLASH_DOWN infinity")
  assert((nan IEEE_SLASH_DOWN one).asString, "NaN", "NaN IEEE_SLASH_DOWN 1")

  assert((ninf MINUS_DOWN one).asString, "-Infinity", "-infinity MINUS_DOWN 1")
  assert((ninf DOT_UP z).asString, "-0.0", "-infinity DOT_UP 0.0")
  assert((ntiny DOT_UP tiny).asString, "-0.0", "DOT_UP underflows to -0.0")
  assert((large DOT_DOWN tiny).asString, "4.9406564584124654E-303", "DOT_DOWN of a large value and the smallest subnormal")
  assert((ntiny DOT_DOWN tiny).asString, "-4.9E-324", "DOT_DOWN underflows to minus the smallest subnormal")
  assert((ninf DOT_DOWN z).asString, "-Infinity", "-infinity DOT_DOWN 0.0")
  assert((z SLASH_DOWN two).asString, "0.0", "0.0 SLASH_DOWN 2")
  assert((nz SLASH_DOWN two).asString, "-0.0", "-0.0 SLASH_DOWN 2")
  assert((ntiny SLASH_DOWN large).asString, "-4.9E-324", "SLASH_DOWN underflows to minus the smallest subnormal")
  assert((ntiny SLASH_UP large).asString, "-0.0", "SLASH_UP underflows to -0.0")
  assert((SQRT_DOWN ninf).asString, "NaN", "SQRT_DOWN of -infinity")
  assert((tiny IEEE_PLUS_DOWN one).asString, "1.0", "IEEE_PLUS_DOWN of the smallest subnormal and 1")
  assert((nz IEEE_MINUS_UP nz).asString, "0.0", "-0.0 IEEE_MINUS_UP -0.0")
  assert((large IEEE_MINUS_UP one).asString, "1.0E21", "IEEE_MINUS_UP of a large value and 1")
  assert((nz IEEE_MINUS_DOWN nz).asString, "-0.0", "-0.0 IEEE_MINUS_DOWN -0.0")
  assert((ninf IEEE_MINUS_DOWN one).asString, "-Infinity", "-infinity IEEE_MINUS_DOWN 1")
  assert((large IEEE_DOT_UP tiny).asString, "4.9406564584124654E-303", "IEEE_DOT_UP of a large value and the smallest subnormal")
  assert((ntiny IEEE_DOT_UP tiny).asString, "-0.0", "IEEE_DOT_UP underflows to -0.0")
  assert((ninf IEEE_DOT_UP b).asString, "Infinity", "-infinity IEEE_DOT_UP b")
  assert((large IEEE_DOT_DOWN tiny).asString, "4.9406564584124654E-303", "IEEE_DOT_DOWN of a large value and the smallest subnormal")
  assert((ntiny IEEE_DOT_DOWN tiny).asString, "-4.9E-324", "IEEE_DOT_DOWN underflows to minus the smallest subnormal")
  assert((ninf IEEE_DOT_DOWN one).asString, "-Infinity", "-infinity IEEE_DOT_DOWN 1")
  assert((z IEEE_SLASH_UP two).asString, "0.0", "0.0 IEEE_SLASH_UP 2")
  assert((ntiny IEEE_SLASH_UP large).asString, "-0.0", "IEEE_SLASH_UP underflows to -0.0")
  assert((ninf IEEE_SLASH_UP two).asString, "-Infinity", "-infinity IEEE_SLASH_UP 2")
  assert((nz IEEE_SLASH_DOWN two).asString, "-0.0", "-0.0 IEEE_SLASH_DOWN 2")
  assert((ntiny IEEE_SLASH_DOWN large).asString, "-4.9E-324", "IEEE_SLASH_DOWN underflows to minus the smallest subnormal")
  assert((ninf IEEE_SLASH_DOWN two).asString, "-Infinity", "-infinity IEEE_SLASH_DOWN 2")

  assert((fromRawBits(0)).asString, "0.0", "fromRawBits of 0")
  assert((fromRawBits(1)).asString, "4.9E-324", "fromRawBits of 1")
  assert((fromRawBits(4607182418800017408)).asString, "1.0", "fromRawBits of the bits of 1.0")
  assert((fromRawBits(-4616189618054758400)).asString, "-1.0", "fromRawBits of the bits of -1.0")
  assert((fromRawBits(-9223372036854775807 - 1)).asString, "-0.0", "fromRawBits of the bits of -0.0")
  assert((fromRawBits(9218868437227405311)).asString, "1.7976931348623157E308", "fromRawBits of the bits of the largest finite value")
  assert((fromRawBits(9218868437227405312)).asString, "Infinity", "fromRawBits of the bits of infinity")
  assert((fromRawBits(-4503599627370496)).asString, "-Infinity", "fromRawBits of the bits of -infinity")
  assert((fromRawBits(9221120237041090560)).asString, "NaN", "fromRawBits of the bits of a NaN")
  assert(((fromRawBits(9221120237041090560)).rawBits).asString, "9221120237041090560", "fromRawBits of the bits of a NaN keeps them")
end

end

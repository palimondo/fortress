(* E3c: the application form, BIG UNION applied straight to a generator. *)
component g1e_bigunion3
import Map.{...}
import List.{...}
export Executable

run(): () = do
    s1: Map[\String,ZZ32\] = {[\String,ZZ32\] "a" |-> 1, "b" |-> 2 }
    s2: Map[\String,ZZ32\] = {[\String,ZZ32\] "a" |-> 10, "c" |-> 30 }
    ss: List[\Map[\String,ZZ32\]\] = <|[\Map[\String,ZZ32\]\] s1, s2 |>
    b: Map[\String,ZZ32\] = BIG UNION[\String,ZZ32\](seq(ss))
    println("BIG UNION applied to a generator = " b)
  end
end

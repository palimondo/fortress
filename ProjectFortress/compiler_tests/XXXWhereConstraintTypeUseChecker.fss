(* A type of an object whose where clause constrains its static parameter is ill-formed where its static argument breaks the constraint: a String does not extend Shows; trait-parameters.tex, section "Where Clauses". *)
component XXXWhereConstraintTypeUseChecker
export Executable

trait Shows
  show(): String
end
object Wrap[\T\](x: T) where { T extends Shows }
  twice(): String = x.show() x.show()
end

useIt(w: Wrap[\String\]): String = "u"

run(): () = println(useIt(Wrap[\String\]("s")))

end

component SkViews
export Executable

run(): () = do
    x: ZZ32[5] = [10 20 30 40 50]
    s = x.subarray[\1,3,1\](1)
    println("s.bounds() = " s.bounds() ", s[1] = " s[1])
    r = s + 1
    println("(s + 1).bounds() = " r.bounds() ", (s + 1)[1] = " r[1] ", (s + 1)[3] = " r[3])
    q = 100 - s
    println("(100 - s)[1] = " q[1] ", an Array1 based at 1: " instanceOf[\Array1[\ZZ32,1,3\]\](q))
    w = x[1:3]
    println("x[1:3].bounds() = " w.bounds() ", (x[1:3] + 1).bounds() = " (w + 1).bounds() ", (x[1:3] + 1)[0] = " (w + 1)[0])
end

end

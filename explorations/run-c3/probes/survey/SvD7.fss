component SvD7
export Executable

run(): () = do
  a = array[\RR64\](3).fill(fn (i:ZZ32):RR64 => 1.0 + i)
  b = array[\RR64\](3).fill(fn (i:ZZ32):RR64 => 10.0 + i)
  m = array[\RR64\](2,3).fill(fn (t:(ZZ32,ZZ32)):RR64 => do (i,j) = t; 1.0 + 3 i + j end)
  r0 := m[0,:]
  println("row assign: OK " m)
end
end

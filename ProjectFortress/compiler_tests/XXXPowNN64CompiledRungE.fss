(* See explorations/compile-ladder/rung-size-range/REPORT.md. *)
component XXXPowNN64CompiledRungE
export Executable

run(): () = do
    println("REACHED")
    threeU: NN64 = unsigned(widen(3))
    twoU: NN64 = unsigned(widen(2))
    r: NN64 = threeU^twoU
    assert(r = unsigned(widen(9)), "NN64 3^2 is 9; basic-integers.tex:527-529")
    println("PASS")
  end

end

component SkStopUnbounded
export Executable

stop[\T\](s: String): T = do
    println("stop: " s)
    throw FailCalled(s)
  end

guard(x: ZZ32): ZZ32 = if x > 0 then x else stop("not positive") end

run(): () = do
    println(guard(4))
    try
        println(guard(0))
    catch e
        FailCalled => println("caught")
    end
    println("end")
  end

end

\documentclass{article}
\usepackage{fortify}
\usepackage{amsmath}
\usepackage[active,tightpage]{preview}
\setlength\PreviewBorder{5pt}
\begin{document}
\begin{preview}
`rmsn_b(dy: Array[\RR64,ZZ32\], x: Array[\RR64,ZZ32\]): Array[\RR64,ZZ32\] = do
    r = SQRT (epsilon + (SUM[t <- x] t^2) / (|x|))
    y = x / r
    (dy - y ((y DOT dy) / (|y|))) / r
  end`
\end{preview}
\end{document}

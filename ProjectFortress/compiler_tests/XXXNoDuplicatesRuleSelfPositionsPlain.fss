component XXXNoDuplicatesRuleSelfPositionsPlain
export Executable

(* Two functional methods of one trait with the same parameter types, self first in one and second in the other, break the No Duplicates Rule, a static error the type checker gives (overloading.tex, section "Declarations with Static Parameters"). *)

trait S
  f(self, y: S): ZZ32 = 1
  f(x: S, self): ZZ32 = 2
end
object O extends S end

run(): () = do
  println(f(O, O))
end

end

component RatValues
export Executable

run() = do
  a: QQ = 1/0
  b: QQ = (-1)/0
  c: QQ = 0/0
  println("1/0 is " a ", isInfinite " a.isInfinite ", isFinite " a.isFinite)
  println("-1/0 is " b ", isInfinite " b.isInfinite)
  println("0/0 is " c ", isNaN " c.isNaN)
  println("1/0 + -1/0 is " (a + b))
  k: String = typecase a of
      QQ => "QQ"
      else => "other"
    end
  println("typecase 1/0 of QQ: " k)
  e: Boolean = (c = c)
  l: Boolean = (c < c)
  println("0/0 = 0/0 is " e)
  println("0/0 < 0/0 is " l)
  println("check on 1/0: " a.check ", check_star on 0/0: " c.check_star ", check_star on 1/0: " a.check_star)
  z: ZZ = 7
  println("7/2 is " (z/2))
end
end

(* A functional method with a body beside a top-level function of its name, whose parameter types are neither related nor exclusive, needs a declaration on their meet (overloading.tex, section "Meet Rule", a functional method beside a function). *)
component XXXFunctionalMethodMeetTopLevelConcrete
export Executable

trait S
  h(self): ZZ32 = 1
end
object O extends S end
h(x: String): ZZ32 = 2

run(): () = do
  assert(h(O), 1, "h(O)")
  println("PASS")
end

end

(* The six mechanics decision D's diff rests on, one per function so that one failure hides no other. *)
component P4
import PScal.{...}
import NatReflect.{...}
export Executable
object Obj
  mk[\nat r\](): Vector[\ZZ32,r\] = vector[\ZZ32,r\](fn (i: ZZ32): ZZ32 => i)
end
mk2[\nat r\](): Vector[\ZZ32,r\] = vector[\ZZ32,r\](fn (i: ZZ32): ZZ32 => i)
mkw[\nat r\](_: N[\r\]): Vector[\ZZ32,r\] = vector[\ZZ32,r\](fn (i: ZZ32): ZZ32 => i)
twice[\nat s\](x: Vector[\RR64,s\]): Vector[\RR64,s\] = 2.0 x
rowsV[\nat r, nat c\](f: Vector[\RR64,c\] -> Vector[\RR64,c\], m: Matrix[\RR64,r,c\]): Matrix[\RR64,r,c\] = do
    out = matrix[\RR64,r,c\]()
    for i <- 0#r do
        y = f(vector[\RR64,c\](fn (j: ZZ32): RR64 => m[i,j]))
        for j <- 0#c do out[i,j] := y[j] end
    end
    out
  end
p4(): RR64 = do
    v = vector[\RR64,3\](fn (i: ZZ32): RR64 => 1.0 i)
    w = v - 1.0
    m = matrix[\RR64,2,2\](1.0)
    mm = 0.0 MAX m
    (w DOT w) + (mm[0,0])
  end
run(): () = println("P4 " p4())
end

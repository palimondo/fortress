component SizeValue
export Executable
(* A size used as a value (row 485, PLAN item 25) where the rule reads a numeral: at a numeral tie and
   at a lone type parameter beside a ZZ64. The checker types the size as a numeral
   (scala_src/typechecker/staticenv/KindEnv.scala:67-68). *)
object Box[\nat k\](v: ZZ32) end
pickn(x: NN32): String = "NN32"
pickn(x: ZZ32): String = "ZZ32"
pick[\T\](x: T, y: T): String = typeOf(x) || "," || typeOf(y)
typeOf(x: Any): String = typecase x of
    ZZ32 => "ZZ32"
    ZZ64 => "ZZ64"
    NN32 => "NN32"
    IntLiteral => "IntLiteral"
    else => "other"
  end
tie[\nat n\](b: Box[\n\]): String = pickn(n)
lone[\nat n\](b: Box[\n\], l: ZZ64): String = pick(n, l)
run(): () = do
    l: ZZ64 = 4
    println("pickn(n): " || tie(Box[\3\](0)))
    println("pick(n, l): " || lone(Box[\3\](0), l))
end
end

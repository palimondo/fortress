component AbstractMethodUndefinedObjectExpressionWalk
export Executable

(* An object expression that inherits an abstract method and declares no body for it is a static error, so the program is refused at load, under walk (traits.tex, section "Method Declarations"). *)

trait S
  tag(self, x: ZZ32): ZZ32
end

run(): () = do
    z = object extends S end
    println(tag(z, 3))
  end

end

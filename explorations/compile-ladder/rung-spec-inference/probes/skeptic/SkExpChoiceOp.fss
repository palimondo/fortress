component SkExpChoiceOp
export Executable

object BoxT[\T\](v: T) end

opr OPLUS[\T extends ZZ32\](x: T, y: ZZ32): BoxT[\T\] = do println("  ran OPLUS generic"); BoxT[\T\](x) end
opr OPLUS(x: ZZ64, y: ZZ32): BoxT[\ZZ64\] = do println("  ran OPLUS(ZZ64, ZZ32)"); BoxT[\ZZ64\](x) end

run(): () = do
  z: ZZ32 = 5
  println("P1 a: BoxT[ZZ32] = z OPLUS z")
  a: BoxT[\ZZ32\] = z OPLUS z
  println("P2 b: BoxT[ZZ64] = z OPLUS z")
  b: BoxT[\ZZ64\] = z OPLUS z
  println("done")
end

end

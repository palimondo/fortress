component BNumeralKindsCk
export Executable
(* the compiled checker over the one library: each String binding reveals the
   static type the checker gives its right-hand side *)
run(): () = do
  hd = 4
  b1 = 0.85
  t0: ZZ64 = widen(7000000)
  s1: String = 3
  s2: String = 1.5
  s3: String = 3 + 4
  s4: String = 1.5 + 2.5
  s5: String = 1 - 0.85
  s6: String = 1.0 3
  s7: String = hd
  s8: String = 1.0 hd
  s9: String = 1 - b1
  s10: String = t0 DIV 1000000
  s11: String = 3000000000
  s12: String = b1
  a: ZZ64 = 3
  r: RR64 = 3
  q: QQ = 3
  ()
end
end

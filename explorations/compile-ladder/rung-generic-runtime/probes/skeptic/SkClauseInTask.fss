component SkClauseInTask
export Executable

object Wrap(n: ZZ32) end
object Oops(code: ZZ32) extends CheckedException end
lbl(x: ZZ32): String = x.asString
boom(k: ZZ32): ZZ32 = throw Oops(k)

typecaseInArm(x: Any, suffix: String): String = do
  var r1: String := ""
  var r2: String := ""
  do
    r1 := "a"
  also do
    r2 := typecase x of
        w: Wrap => lbl(w.n) || suffix
        else => "other"
      end
  end
  r1 || r2
end

catchInArm(k: ZZ32, suffix: String): String = do
  var r1: String := ""
  var r2: String := ""
  do
    r1 := "a"
  also do
    r2 := try lbl(boom(k)) catch e Oops => lbl(e.code) || suffix end
  end
  r1 || r2
end

typecaseOperand(x: Any, suffix: String): String =
  (typecase x of
      w: Wrap => lbl(w.n) || suffix
      else => "other"
    end) || lbl(9)

run(): () = do
  println("typecaseInArm: " typecaseInArm(Wrap(7), "!"))
  println("catchInArm: " catchInArm(5, "?"))
  println("typecaseOperand: " typecaseOperand(Wrap(6), "#"))
end

end

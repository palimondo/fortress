component XXXClauseBindingRungB
export Executable

(*) See explorations/compile-ladder/rung-tryatomic/REPORT.md

thrower(): ZZ32 = throw TryAtomicFailure

run():() = do
    println("REACHED")
    caught: String =
        try
            ignore thrower()
            "NOT THROWN"
        catch e
            TryAtomicFailure => e.asString
        end
    assert(caught, "Try/atomic failure",
           "a catch clause binds the exception value, Specification/basic/expressions/try.tex:56-60")
    println("PASS")
end

end

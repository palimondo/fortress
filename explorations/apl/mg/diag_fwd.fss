(* diag_fwd -- the forward pass computed twice inside one component: once as APL
   text over AplMgSyntax, once as C4's hand-written lines, compared intermediate
   by intermediate.  Unchanged from the run that checked the focused base
   against C4's FlatArrays (checks/diag_fwd.out) BUT FOR ITS TWO IMPORT LINES,
   which now name this directory's vocabulary and loaders: so the C4 diff is the
   previous run's values, which this run must reproduce digit for digit --
   every maxdiff 0.0 here, and every printed sum equal to the FlatArrays run's.
   The two vocabularies cannot both stand in one component, under aliases or
   otherwise: FlatArrays2's index-generic monadic `rows` and FlatArrays' rank-3
   `rows` are checked against each other as one overload family and rejected,
   "have parameters with generic type, at least one pair of parameters must have
   excluding types" (NOTES-swap.md).  An import alias renames the reference, not
   the declaration. *)
component diag_fwd
import AplMg.{...}
import AplMgSyntax.{...}
import FlatArrays2.{...}
import FlatData2.{...}
import System.{...}
export Executable

(Ne, Blk, Nh, Hd, Vs, Bos) = (16, 16, 4, 4, 27, 26)
(Eps, Lr0, B1, B2, Epsa, Nsteps) = (10.0^(-5), 0.01, 0.85, 0.99, 10.0^(-8), 1000)
rmsn(x: Array[\RR64,ZZ32\]): Array[\RR64,ZZ32\] = x / SQRT (Eps + (x DOT x) / |x|)
sm(z: Array[\RR64,ZZ32\]): Array[\RR64,ZZ32\] = do e = exp(z - (BIG MAX[t <- z] t)); e / (SUM e) end
Mk = apl⦇ (-10*10)×~(⍳Blk)∘.≥⍳Blk ⦈
maskC: Array[\RR64,(ZZ32,ZZ32)\] = mat(Blk, Blk, fn (i: ZZ32, j: ZZ32): RR64 => if j > i then -(10.0^10) else 0.0 end)
matShape(i: ZZ32): (ZZ32, ZZ32) =
    if (i = 0) OR (i = 2) then (Vs, Ne) elif i = 7 then (4 Ne, Ne) elif i = 8 then (Ne, 4 Ne) else (Ne, Ne) end
matName(i: ZZ32): String =
    if i = 0 then "wte" elif i = 1 then "wpe" elif i = 2 then "lm_head" elif i = 3 then "attn_wq" elif i = 4 then "attn_wk"
    elif i = 5 then "attn_wv" elif i = 6 then "attn_wo" elif i = 7 then "mlp_fc1" else "mlp_fc2" end
matCount(i: ZZ32): ZZ32 = do (r, c) = matShape(i); r c end
matOffset(i: ZZ32): ZZ32 = SUM[j <- 0#i] matCount(j)
nParams(): ZZ32 = matOffset(9)
view(p: Array[\RR64,ZZ32\], i: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] = do (r, c) = matShape(i); view(p, matOffset(i), r, c) end
corpus: Corpus = loadCorpus("../reference/dzaima/docs.txt", Blk, Bos)
Tokm = corpus.tokm
Len = corpus.len

d2(tag: String, a: Array[\RR64,(ZZ32,ZZ32)\], c: Array[\RR64,(ZZ32,ZZ32)\]): () = do
    (r, cc) = a.sizes
    println tag " " r "x" cc " maxdiff " (BIG MAX[i <- 0#r, j <- 0#cc] |a[i,j] - c[i,j]|) " suma " (SUM[i <- 0#r, j <- 0#cc] a[i,j])
  end
d3(tag: String, a: Array[\RR64,(ZZ32,ZZ32,ZZ32)\], c: Array[\RR64,(ZZ32,ZZ32,ZZ32)\]): () = do
    (p, r, cc) = a.sizes
    println tag " " p "x" r "x" cc " maxdiff " (BIG MAX[q <- 0#p, i <- 0#r, j <- 0#cc] |a[q,i,j] - c[q,i,j]|) " suma " (SUM[q <- 0#p, i <- 0#r, j <- 0#cc] a[q,i,j])
  end
dz(tag: String, a: Array[\ZZ32,ZZ32\], c: Array[\ZZ32,ZZ32\]): () =
    println tag " |" |a| "| maxdiff " (BIG MAX[i <- 0#|a|] |a[i] - c[i]|)
dr(tag: String, a: Array[\RR64,ZZ32\], c: Array[\RR64,ZZ32\]): () =
    println tag " |" |a| "| maxdiff " (BIG MAX[i <- 0#|a|] |a[i] - c[i]|)

run(): () = do
    P: Array[\RR64,ZZ32\] = loadParams("../reference/dzaima/w", matName, 9, nParams())
    b: Array[\ZZ32,ZZ32\] = keys(1, fn (i: ZZ32): ZZ32 => 0)
    println "Mk[0,1] " Mk[0,1] " Mk[1,0] " Mk[1,0] " maskC[0,1] " maskC[0,1]
    println "apl 10*10 = " (apl⦇ 10*10 ⦈) " ; apl (-10*10) = " (apl⦇ (-10*10) ⦈) " ; apl -10 = " (apl⦇ -10 ⦈) " ; apl 2*3 = " (apl⦇ 2*3 ⦈)
    d2("mask     ", Mk, maskC)
    vw(i: ZZ32): Array[\RR64,(ZZ32,ZZ32)\] = view(P, i)
    h(m: Array[\RR64,(ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32,ZZ32)\] = heads(m, Blk, Nh, Hd)
    u(t: Array[\RR64,(ZZ32,ZZ32,ZZ32)\]): Array[\RR64,(ZZ32,ZZ32)\] = unheads(t, Nh)
    (* -- the keys, both ways -- *)
    ids = apl⦇ R←Tokm[b;] ⋄ ,R[;⍳Blk] ⦈
    tg  = apl⦇ R←Tokm[b;] ⋄ ,R[;1+⍳Blk] ⦈
    vm  = apl⦇ ,Len[b]∘.>⍳Blk ⦈
    pos = apl⦇ B←≢b ⋄ N←B×Blk ⋄ N⍴⍳Blk ⦈
    dz("ids      ", ids, corpus.tokens(b, 0))
    dz("tg       ", tg, corpus.tokens(b, 1))
    dr("vm       ", vm, corpus.valid(b))
    dz("pos      ", pos, corpus.positions(b))
    (* -- the nine views, host -- *)
    (wte, wpe, lm, wq, wk, wv, wo, f1, f2) = (vw(0), vw(1), vw(2), vw(3), vw(4), vw(5), vw(6), vw(7), vw(8))
    (* -- X, both ways -- *)
    X = apl⦇ wte[ids;]+wpe[pos;] ⦈
    xC = gather(wte, ids) + gather(wpe, pos)
    d2("X        ", X, xC)
    Xp = apl⦇ rmsn⍤1⊢X ⦈
    xpC = rows(rmsn, xC)
    d2("Xp       ", Xp, xpC)
    X1 = apl⦇ rmsn⍤1⊢Xp ⦈
    x1C = rows(rmsn, xpC)
    d2("X1       ", X1, x1C)
    (Q, K, Vv) = apl⦇ X1∘(+.×⍉)¨wq wk wv ⦈
    (qC, kC, vC) = (x1C transpose(wq), x1C transpose(wk), x1C transpose(wv))
    d2("Q        ", Q, qC)
    d2("K        ", K, kC)
    d2("Vv       ", Vv, vC)
    (Qh, Kh, Vh) = apl⦇ h¨Q K Vv ⦈
    (qhC, khC, vhC) = (h(qC), h(kC), h(vC))
    d3("Qh       ", Qh, qhC)
    A = apl⦇ sm⍤1⊢Mk+⍤2⊢(Qh+.×⍤2⊢⍉⍤2⊢Kh)÷Hd*0.5 ⦈
    aC = rows(sm, maskC + (qhC transpose(khC)) / SQRT (1.0 Hd))
    d3("A        ", A, aC)
    Hc = apl⦇ u A+.×⍤2⊢Vh ⦈
    hcC = u(aC vhC)
    d2("Hc       ", Hc, hcC)
    X2 = apl⦇ Xp+Hc+.×⍉wo ⦈
    x2C = xpC + hcC transpose(wo)
    d2("X2       ", X2, x2C)
    X3 = apl⦇ rmsn⍤1⊢X2 ⦈
    x3C = rows(rmsn, x2C)
    M0 = apl⦇ X3+.×⍉f1 ⦈
    m0C = x3C transpose(f1)
    d2("M0       ", M0, m0C)
    Mr = apl⦇ 0⌈M0 ⦈
    mrC = 0.0 MAX m0C
    d2("Mr       ", Mr, mrC)
    X4 = apl⦇ X2+Mr+.×⍉f2 ⦈
    x4C = x2C + mrC transpose(f2)
    d2("X4       ", X4, x4C)
    Pr = apl⦇ sm⍤1⊢X4+.×⍉lm ⦈
    prC = rows(sm, x4C transpose(lm))
    d2("Pr       ", Pr, prC)
    nv = apl⦇ +/vm ⦈
    lossA = apl⦇ -(+/vm×⍟tg⌷⍤0 1⊢Pr)÷nv ⦈
    lossC = -(corpus.valid(b) DOT log(pick(prC, corpus.tokens(b, 1)))) / (SUM corpus.valid(b))
    println "loss apl " lossA " loss c4 " lossC " diff " |lossA - lossC|
    println "done"
  end
end

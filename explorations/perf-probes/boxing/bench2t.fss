component bench2t
export Executable
object V(data: RR64)
  opr +(self, o: V): V = V(data + o.data)
  opr DOT(self, o: V): V = V(data o.data)
end
run() = do
  var s: V := V(0.0)
  t0 = nanoTime()
  for i <- seq(1#2000000) do s := (s + V(1.0)) DOT V(0.9999999) end
  t1 = nanoTime()
  println("bench2t " s.data)
  println("loop_ns " (t1 - t0))
end
end

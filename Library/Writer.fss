component Writer
import FlatString.FlatString
import Stream.{...}
export Writer

stdOut: Writer = Writer("<stdout>", makeJavaBufferedStdOut())
stdErr: Writer = Writer("<stderr>", makeJavaBufferedStdErr())

Writer(fileName: String): Writer = typecase fileName.asFlatString of
    f:FlatString ⇒ Writer(fileName, makeJavaBufferedWriter(f))
    f:String ⇒ fail[\Writer\]("Writer: asFlatString answered a string that is not flat")
  end

object Writer(fileName: String, under: JavaBufferedWriter) extends { WriteStream }
    getter asString(): String = "Writer on " self.fileName.asExprString
    write(s:FlatString):() = under.write(s)
    write(c:Char):() = under.write(c)
    flush():() = under.flush()
    close():() = under.close()
    (* A string that is not flat reaches the stream in one write, then a flush. *)
    write(s: String): () = do
        under.write(s)
        under.flush()
    end
end Writer

object BufferedWriter(under: WriteStream, size: ZZ32) extends { WriteStream }
    getter asString(): String = "BufferedWriter on " under.asString
    write(s: String): () = under.write(s)
    write(c: Char):() = under.write(c)
    flush():() = under.flush()
    close():() = under.close()
end BufferedWriter

end

(* P08: Leave the library's  opr SUM[\T extends Number\]()  alone, but overload
   the desugaring target  __bigOperator  (FortressLibrary.fss:1118) on the
   concrete Comprehension the library hands back for  SUM[\V\](), ignoring its
   body/reduction and substituting ours.
       SUM[\V\] [v <- vs] v
         ==>  __bigOperator(SUM[\V\](), fn (r,u) => ...)
   where SUM[\V\]() = Comprehension[\V,Number,Number,Number\](...). *)
component p08_hijack_bigoperator
import List.{...}
export Executable

object V(data: RR64)
    getter asString(): String = "V(" data ")"
    opr +(self, other: V): V = V(data + other.data)
end

object VSumReduction extends CommutativeMonoidReduction[\V\]
    getter asString(): String = "VSumReduction"
    empty(): V = V(0.0)
    join(a: V, b: V): V = a + b
end

__bigOperator(o: Comprehension[\V,Number,Number,Number\],
              desugaredClauses:(Reduction[\V\],V->V)->V): V = do
    r = VSumReduction
    desugaredClauses(r, fn (x:V):V => x)
  end

run(): () = do
    vs = <| V(1.0), V(2.0), V(3.5) |>
    println("SUM[\\V\\] [v <- vs] v = " (SUM[\V\] [v <- vs] v))
    println("builtin SUM          = " (SUM [i <- 0#5] i))
end
end

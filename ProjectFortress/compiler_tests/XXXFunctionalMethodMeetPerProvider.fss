(* Two open traits each declare a functional method of one name and the object extending both declares its own: the Meet Rule for functional methods asks the meet only of a type that provides both, so the overloading is valid. *)
component XXXFunctionalMethodMeetPerProvider
export Executable

trait AsSeq
    toSeq(self): String = "seq"
end
trait AsFilt
    toSeq(self): String = "filt"
end
object SeqFilt extends { AsSeq, AsFilt }
    toSeq(self): String = "both"
end

run() = do
    println(toSeq(SeqFilt))
end

end

component SkShapes
export Executable
import List.{...}

gtab[\E\](a: Array[\E,ZZ32\], f: ZZ32 -> E): Array[\E,ZZ32\] = a.fill(f)
gfill[\E\](a: Array[\E,ZZ32\], v: E): Array[\E,ZZ32\] = a.fill(v)

run():() = do
  a = array[\ZZ32\](3).fill(4)
  println("a value fill: " a[0] " " a[1] " " a[2])
  b = array[\ZZ32\](3).fill(fn (i:ZZ32):ZZ32 => 3 i)
  println("b function form: " b[0] " " b[1] " " b[2])
  c = immutableArray[\ZZ32\](3).fill(9)
  println("c immutable value fill: " c[0] " " c[2])
  cc = c.copy()
  println("cc immutable copy: " cc[1])
  cm = c.map[\ZZ32\](fn (x:ZZ32):ZZ32 => x + 1)
  println("cm immutable map: " cm[1])
  ct = c.thaw()
  println("ct thaw: " ct[2])
  d = array2[\ZZ32,2,3\]().fill(5)
  println("d 2-D value fill: " d[1,2])
  e = array2[\ZZ32,2,3\]().fill(fn (i:ZZ32,j:ZZ32):ZZ32 => 10 i + j).t()
  println("e 2-D function form, transposed: " e[2,1] " " e[0,1])
  f = array1[\ZZ32,3\]().fill(fn (i:ZZ32):ZZ32 => i + 1).freeze()
  g = f.thaw()
  println("f,g freeze/thaw: " f[2] " " g[2])
  h = gtab[\RR64\](array[\RR64\](2), fn (i:ZZ32):RR64 => 0.5 i)
  println("h generic function form: " h[1])
  hv = gfill[\RR64\](array[\RR64\](2), 2.5)
  println("hv generic value fill: " hv[1])
  k = array[\ZZ32->ZZ32\](3).fill(fn (i:ZZ32):(ZZ32->ZZ32) => fn (j:ZZ32):ZZ32 => i + j)
  println("k function elements by the function form: " (k[2])(10))
  p = array[\(ZZ32,ZZ32)\](2).fill((1,2))
  (p0, p1) = p[1]
  println("p tuple value fill: " p0 " " p1)
  q = array[\(ZZ32,ZZ32)\](2).fill(fn (i:ZZ32):(ZZ32,ZZ32) => (i, 2 i))
  (q0, q1) = q[1]
  println("q tuple function form: " q0 " " q1)
  r = array[\(ZZ64,ZZ32)\](2).fill(widen(0), 7)
  (r0, r1) = r[1]
  println("r two-argument tuple fill: " r0 " " r1)
  mm = matrix[\RR64,2,2\](3.0)
  println("mm matrix(v): " mm[0,0] " " mm[0,1] " " mm[1,1])
  vv = vector[\RR64,2\](fn (i:ZZ32):RR64 => 1.0 + i)
  println("vv vector function factory: " vv[0] " " vv[1])
  lm = mm.lmul(vv)
  println("lm Matrix.lmul: " lm[0] " " lm[1])
  rm = mm.rmul(vv)
  println("rm Matrix.rmul: " rm[0] " " rm[1])
  a1 = array1[\ZZ32,3\](fn (i:ZZ32):ZZ32 => i i)
  println("a1 array1 function factory: " a1[2])
  a2 = array2[\ZZ32,2,2\](fn (i:ZZ32,j:ZZ32):ZZ32 => i - j)
  println("a2 array2 function factory: " a2[0,1] " " a2[1,0])
  l = <|[\ZZ32\] 1, 2, 3|>
  lmap = l.map[\ZZ32\](fn (x:ZZ32):ZZ32 => 10 x)
  println("lmap ArrayList.map: " lmap)
  livmap = l.ivmap[\ZZ32\](fn (i:ZZ32, x:ZZ32):ZZ32 => 100 i + x)
  println("livmap ArrayList.ivmap: " livmap)
  a3c = array3[\ZZ32,2,2,2\]().fill(fn (i:ZZ32,j:ZZ32,kk:ZZ32):ZZ32 => 100 i + 10 j + kk).copy()
  println("a3c 3-D copy: " a3c[1,0,1])
  a3m = a3c.ivmap[\ZZ32\](fn (ijk:(ZZ32,ZZ32,ZZ32), x:ZZ32):ZZ32 => x + 1)
  println("a3m 3-D ivmap: " a3m[1,1,1])
end

end

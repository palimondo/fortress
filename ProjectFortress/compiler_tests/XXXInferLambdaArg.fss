(* See explorations/compile-ladder/rung-inference-checker/REPORT.md. *)
component XXXInferLambdaArg
export Executable

object BoxT[\T\](v: ZZ32) end
appl[\T\](b: BoxT[\T\], f: ZZ32 -> ZZ32, m: ZZ64): ZZ64 = m + m

run(): () = do
    bS: BoxT[\String\] = BoxT[\String\](2)
    println("untyped lambda: " || appl(bS, fn x => x, 3))
end

end

component SkChooseZZ64
export Executable
run(): () = do
  two: ZZ64 = widen(2)
  three: ZZ64 = widen(3)
  mone: ZZ64 = widen(-1)
  n3037000500: ZZ64 = 3037000500
  twoTo32: ZZ64 = 4294967296
  twoTo32p1: ZZ64 = 4294967297
  n66: ZZ64 = widen(66)
  n67: ZZ64 = widen(67)
  n62: ZZ64 = widen(62)
  maxL: ZZ64 = 9223372036854775807
  println("cl1 3037000500 CHOOSE 2 " || (try "" || (n3037000500 CHOOSE two) catch e IntegerOverflow => "OVF" end))
  println("cl2 2^32 CHOOSE 2 " || (try "" || (twoTo32 CHOOSE two) catch e IntegerOverflow => "OVF" end))
  println("cl3 (2^32+1) CHOOSE 2 " || (try "" || (twoTo32p1 CHOOSE two) catch e IntegerOverflow => "OVF" end))
  println("cl4 66 CHOOSE 33 " || (try "" || (n66 CHOOSE widen(33)) catch e IntegerOverflow => "OVF" end))
  println("cl5 67 CHOOSE 33 " || (try "" || (n67 CHOOSE widen(33)) catch e IntegerOverflow => "OVF" end))
  println("cl6 62 CHOOSE 31 " || (try "" || (n62 CHOOSE widen(31)) catch e IntegerOverflow => "OVF" end))
  println("cl7 MAX CHOOSE (MAX-1) " || (try "" || (maxL CHOOSE (maxL - widen(1))) catch e IntegerOverflow => "OVF" end))
  println("cl8 MAX CHOOSE 2 " || (try "" || (maxL CHOOSE two) catch e IntegerOverflow => "OVF" end))
  println("cl9 3 CHOOSE -1 " || (try "" || (three CHOOSE mone) catch e IntegerOverflow => "OVF" end))
  println("cl10 -1 CHOOSE 3 " || (try "" || (mone CHOOSE three) catch e IntegerOverflow => "OVF" end))
  println("END")
end
end
